// fcode (it was coderin): a text editor for the terminal, written in J2K (for the Jaric app and any ANSI terminal). Version 0.2, in the way of micro:
// the mouse (a tap or a click puts the cursor there, a drag selects, a double click takes a word, the wheel scrolls), brackets and
// quotes are closed for you, a command bar (Ctrl-E), and settings, key bindings and colour schemes in ~/.config/fcode/ (no file is made for you).
//   fcode FILE          Ctrl-S save   Ctrl-Q quit   Ctrl-F find   Ctrl-G go to a line   Ctrl-C copy   Ctrl-X cut   Ctrl-V paste
//   Shift + arrows select   Ctrl-A select all   Ctrl-D copy the line below   Ctrl-K delete the line   Home End PageUp PageDown Tab
#import <stdlib>

String[] lines;
i64 cy;                       // the cursor: the line, and the byte in the line (always at the start of a character)
i64 cx;
i64 top;                      // the first line shown
i64 left;                     // the first column shown
i64 ay;                       // the other end of the selection (when sel is true)
i64 ax;
bool sel;
String clip;
bool dirty;
String path;
String msg;
i64 rows;
i64 cols;
i64 quit_asked;
String key_text;              // the characters of the last K_TEXT key
i64 tabsize = 4;              // settings (the file ~/.config/fcode/settings, or the command  set NAME VALUE )
bool use_spaces = true;       // Tab gives spaces
bool ruler = true;            // the numbers of the lines
bool mouse_on = true;
bool autoindent = true;
bool autopair = true;         // ( ) [ ] { } " " ' ' are closed when the first is typed
String scheme;                // the name of the colour scheme (dark when empty)
String[] bind_keys;           // the key bindings: "Ctrl-s" -> "save"
String[] bind_acts;
i64 m_btn;                    // the last mouse event: the button, the place (1-based) and press / release
i64 m_x;
i64 m_y;
bool m_press;
i64 click_time;               // for the double click
i64 click_y;
i64 click_x;
i64 c_bg = 0x0D1117;
i64 c_kw;                     // the colours of the scheme: 0xRRGGBB
i64 c_str;
i64 c_num;
i64 c_com;
i64 c_typ;
i64 c_txt;
i64 c_gut;
i64 c_sel;
i64 K_MOUSE = 1020;
bool menubar;                 // the menu bar of the old programs on the first row (F10), and the keys F5 F9 F11 (set menubar on; the scheme devcpp has it)
bool helpbar = true;          // a line with the keys under the text, as nano shows it (set helpbar off)
bool ext_undo = true;         // the extensions that are on (the setting  extensions = undo j2k ): undo and redo; help for writing J2K
bool ext_j2k = true;
String[] pop_c;
i64 pop_i;
bool pop_on;
i64 pop_st;            // the list of words under the cursor
String[] undo_text;           // the states before the changes (the whole text joined by new lines) and where the cursor was
i64[] undo_cy;
i64[] undo_cx;
String[] redo_text;
i64[] redo_cy;
i64[] redo_cx;
i64 last_kind;                // what the last change was: 1 typing, 2 deleting characters, 0 anything else (it always starts a new step)
i64 last_edit_ms;
bool free_scroll;             // the wheel moved the view: it does not follow the cursor until a key comes

i64 K_TEXT = 1000;
i64 K_UP = 1001;
i64 K_DOWN = 1002;
i64 K_RIGHT = 1003;
i64 K_LEFT = 1004;
i64 K_HOME = 1005;
i64 K_END = 1006;
i64 K_PGUP = 1007;
i64 K_PGDN = 1008;
i64 K_DEL = 1009;
i64 K_ENTER = 1010;
i64 K_BS = 1011;
i64 K_TAB = 1012;
i64 K_ESC = 1013;
i64 K_F = 1500;               // + n : the function key Fn (F1 .. F12)
i64 K_SHIFT = 100;            // + K_UP .. K_END : the arrow with Shift
i64 K_CTRL = 200;             // + K_UP .. K_END : the arrow with Ctrl

String esc() {
    String e = "";
    e.push((char)27);
    return e;
}

#import "fc_term"
#import "fc_text"
#import "fc_edit"
#import "fc_ext"
#import "fc_conf"
#import "fc_draw"
#import "fc_build"
#import "fc_menu"
#import "fc_cmds"
#import "fc_set"
#import "fc_mouse"
#import "fc_popup"

void handle_key(i64 k) {
    if k == K_ESC {                                                  // Esc leaves, like Ctrl-Q (an open menu or prompt took it before)
        if dirty && quit_asked == 0 { msg = "unsaved changes: Esc again leaves without saving (Ctrl-S saves)"; quit_asked = 1; return; }
        quit_asked = 2;
        return;
    }
    String act = "";
    if k >= 1 && k <= 26 { act = binding("Ctrl-" + letter_of(k)); }
    if act != "quit" { quit_asked = 0; }
    if k != K_MOUSE { free_scroll = false; }
    if k == K_MOUSE { on_mouse(); return; }
    if k == K_TEXT {
        begin_edit(1);
        if autopair && key_text.len == 1 && type_pair(key_text[0] & 255) { msg = ""; return; }
        insert_text(key_text);
        msg = "";
        return;
    }
    if k == K_ENTER { begin_edit(0); newline(); msg = ""; return; }
    if k == K_TAB {
        if tab_help() { return; }
        begin_edit(0);
        if use_spaces { insert_text(" ".repeat(tabsize)); } else { insert_text("\t"); }
        return;
    }
    if k == K_BS {
        begin_edit(2);
        if sel { delete_selection(); return; }
        if autopair && cx > 0 && cx < lines[cy].len {
            i64 pc = lines[cy][cx - 1] & 255;
            i64 nc = lines[cy][cx] & 255;
            bool pair = (pc == '(' && nc == ')') || (pc == '[' && nc == ']') || (pc == '{' && nc == '}') || (pc == '"' && nc == '"') || (pc == 39 && nc == 39);
            if pair {                                              // delete the pair
                lines[cy] = lines[cy].slice(0, cx - 1) + lines[cy].slice(cx + 1, lines[cy].len);
                cx -= 1;
                dirty = true;
                return;
            }
        }
        if cx > 0 {
            i64 p = prev_char(lines[cy], cx);
            lines[cy] = lines[cy].slice(0, p) + lines[cy].slice(cx, lines[cy].len);
            cx = p;
            dirty = true;
        } else if cy > 0 {
            i64 len = lines[cy - 1].len;
            lines[cy - 1] = lines[cy - 1] + lines[cy];
            remove_line(cy);
            cy -= 1;
            cx = len;
            dirty = true;
        }
        return;
    }
    if k == K_DEL {
        begin_edit(2);
        if sel { delete_selection(); return; }
        if cx < lines[cy].len {
            lines[cy] = lines[cy].slice(0, cx) + lines[cy].slice(next_char(lines[cy], cx), lines[cy].len);
            dirty = true;
        } else if cy + 1 < lines.len {
            lines[cy] = lines[cy] + lines[cy + 1];
            remove_line(cy + 1);
            dirty = true;
        }
        return;
    }
    bool shift = k >= K_UP + K_SHIFT && k <= K_END + K_SHIFT;
    bool ctrl = k >= K_UP + K_CTRL && k <= K_END + K_CTRL;
    i64 base = k;
    if shift { base = k - K_SHIFT; }
    if ctrl { base = k - K_CTRL; }
    if base == K_LEFT {
        if ctrl {
            i64 x = cx;
            while x > 0 && lines[cy][x - 1] == ' ' { x -= 1; }
            while x > 0 && lines[cy][x - 1] != ' ' { x -= 1; }
            move_to(cy, x, shift);
        } else if cx > 0 { move_to(cy, prev_char(lines[cy], cx), shift); }
        else if cy > 0 { move_to(cy - 1, lines[cy - 1].len, shift); }
        else { move_to(cy, cx, shift); }
        return;
    }
    if base == K_RIGHT {
        if ctrl {
            i64 x = cx;
            while x < lines[cy].len && lines[cy][x] != ' ' { x += 1; }
            while x < lines[cy].len && lines[cy][x] == ' ' { x += 1; }
            move_to(cy, x, shift);
        } else if cx < lines[cy].len { move_to(cy, next_char(lines[cy], cx), shift); }
        else if cy + 1 < lines.len { move_to(cy + 1, 0, shift); }
        else { move_to(cy, cx, shift); }
        return;
    }
    if base == K_UP || base == K_DOWN || k == K_PGUP || k == K_PGDN {
        i64 step = 1;
        if k == K_PGUP || k == K_PGDN { step = rows - 2; }
        i64 ny = cy + step;
        if base == K_UP || k == K_PGUP { ny = cy - step; }
        if ny < 0 { ny = 0; }
        if ny >= lines.len { ny = lines.len - 1; }
        i64 want = col_of(lines[cy], cx);
        move_to(ny, byte_at_col(lines[ny], want), shift);
        return;
    }
    if base == K_HOME {
        if ctrl { move_to(0, 0, shift); return; }
        i64 ind = 0;
        while ind < lines[cy].len && lines[cy][ind] == ' ' { ind += 1; }
        if cx == ind { ind = 0; }
        move_to(cy, ind, shift);
        return;
    }
    if base == K_END {
        if ctrl { move_to(lines.len - 1, lines[lines.len - 1].len, shift); return; }
        move_to(cy, lines[cy].len, shift);
        return;
    }
    if act == "save" { save(); return; }                                // Ctrl-S
    if act == "quit" {                                              // Ctrl-Q
        if dirty && quit_asked == 0 { msg = "unsaved changes: Ctrl-Q again quits without saving"; quit_asked = 1; return; }
        quit_asked = 2;
        return;
    }
    if act == "selectall" {                                         // Ctrl-A: select all
        sel = true; ay = 0; ax = 0; cy = lines.len - 1; cx = lines[cy].len;
        return;
    }
    if act == "copy" {                                              // Ctrl-C: copy (the line when nothing is selected)
        if sel { set_clip(selected_text()); msg = "copied"; }
        else { set_clip(lines[cy] + "\n"); msg = "line copied"; }
        return;
    }
    if act == "undo" { undo_step(false); return; }
    if act == "redo" { undo_step(true); return; }
    if act == "cut" {
        begin_edit(0);                                               // Ctrl-X: cut
        if sel { set_clip(selected_text()); delete_selection(); msg = "cut"; }
        else { set_clip(lines[cy] + "\n"); remove_line(cy); if cy >= lines.len { cy = lines.len - 1; } cx = 0; dirty = true; msg = "line cut"; }
        return;
    }
    if act == "paste" {
        begin_edit(0);                                             // Ctrl-V: paste
        if clip.len > 0 { insert_text(clip); msg = "pasted"; }
        return;
    }
    if act == "deleteline" {
        begin_edit(0);                                        // Ctrl-K: delete the line
        remove_line(cy);
        if cy >= lines.len { cy = lines.len - 1; }
        cx = 0;
        dirty = true;
        return;
    }
    if act == "duplicate" {
        begin_edit(0);                                         // Ctrl-D: copy the line below
        insert_line(cy + 1, lines[cy]);
        cy += 1;
        dirty = true;
        return;
    }
    if act == "find" {                                              // Ctrl-F: find
        String w = ask("find: ");
        if w.len > 0 { find_next(w, cy, cx + 1); }
        return;
    }
    if act == "command" { command_bar(); return; }
    if act == "goto" {                                              // Ctrl-G: go to a line
        String g = ask("line: ");
        if g.len > 0 {
            i64 n = g.to_int();
            if n < 1 { n = 1; }
            if n > lines.len { n = lines.len; }
            move_to(n - 1, 0, false);
        }
        return;
    }
}

void handle(i64 k) {
    if menu_on >= 0 { menu_key(k); return; }
    if k == K_MOUSE && menubar && m_y == 1 && m_press { menu_click(); return; }
    if k == K_ESC && pane_on { pane_on = false; return; }
    if k >= K_F && k <= K_F + 12 { fkey(k - K_F); return; }
    if pop_on {
        if k == K_DOWN { pop_i = (pop_i + 1) % pop_c.len; return; }
        if k == K_UP { pop_i = (pop_i + pop_c.len - 1) % pop_c.len; return; }
        if k == K_TAB || k == K_ENTER { accept_popup(); return; }
        pop_on = false;
        if k == K_ESC { return; }
    }
    handle_key(k);
    if k == K_TEXT || k == K_BS { update_popup(); }
}

// ---------------------------------------------------------------- fcode -ex : extensions from the repository of the tools (downloaded with jget)
String ex_base() { return "https://raw.githubusercontent.com/J2k-studio/Jcmp-Tools/main/extensions"; }
i64 jget_to(String url, String file) {
    String[] ja = arr(4);
    ja.push("-q"); ja.push(url); ja.push("-o"); ja.push(file);
    switch Proc::run("jget", ja) {
        Result::Ok(code): return code;
        Result::Err(e): return 127;
    }
    return 127;
}
i64 ex_mode(String[] a) {
    if a.len < 3 {                                                   // fcode -ex : the list
        String idx = config_dir() + "/.index";
        Dir::make_all(config_dir());
        if jget_to(ex_base() + "/index.txt", idx) != 0 { jerr << "fcode: cannot get the list (is jget installed and the network on?)\n"; return 1; }
        switch Fs::read_text(idx) {
            Result::Ok(t): { jout << "extensions (fcode -ex NAME installs one, fcode -ex -r NAME removes it):\n" << t; }
            Result::Err(e): { }
        }
        Fs::remove(idx);
        return 0;
    }
    bool remove = a[2] == "-r";
    if remove && a.len < 4 { jerr << "usage: fcode -ex -r NAME\n"; return 2; }
    String name = a[a.len - 1];
    for i in 0..name.len { if !is_word(name[i] & 255) && name[i] != '-' { jerr << "fcode: bad name\n"; return 2; } }
    String dir = config_dir() + "/extensions/" + name;
    if remove {
        String[] fs = "snippets words commands".split(" ");
        for i in 0..fs.len { Fs::remove(dir + "/" + fs[i]); }
        Dir::remove(dir);
        jout << "removed " << name << "\n";
        return 0;
    }
    Dir::make_all(dir);
    String[] fs = "snippets words commands".split(" ");
    i64 got = 0;
    for i in 0..fs.len {
        if jget_to(ex_base() + "/" + name + "/" + fs[i], dir + "/" + fs[i]) == 0 { got += 1; } else { Fs::remove(dir + "/" + fs[i]); }
    }
    if got == 0 { Dir::remove(dir); jerr << "fcode: no extension " << name << " (fcode -ex shows the list)\n"; return 1; }
    jout << "installed " << name << " (" << str(got) << " files in " << dir << ")\n";
    return 0;
}

i64 main() {
    String[] a = Env::args();
    if a.len > 1 && (a[1] == "--version" || a[1] == "-V") { jout << "fcode 0.6.0\n"; return 0; }
    if a.len > 1 && (a[1] == "--help" || a[1] == "-h") {
        jout << "fcode: a text editor for the terminal.   fcode FILE   open (or make) a file;   fcode -ex [NAME]   list / install extensions\n";
        jout << "  keys: Ctrl-S save, Ctrl-Q leave, Ctrl-F find, Ctrl-Z undo, Ctrl-C/X/V copy cut paste (the full list: jget docs GUIDE.md, section fcode)\n";
        return 0;
    }
    if a.len > 2 && a[1] == "--example" { jout << example_text(a[2].to_int()); return 0; }          // the text of an example (the tests compile them)
    if a.len > 1 && a[1] == "-ex" { return ex_mode(a); }
    if a.len < 2 { jerr << "usage: fcode FILE   |   fcode -ex [NAME]\n"; return 2; }
    if Sys::isatty(0) != 0 { jerr << "fcode: it needs a terminal\n"; return 2; }
    path = a[1];
    clip = "";
    msg = "";
    undo_text = arr(16); undo_cy = arr(16); undo_cx = arr(16);
    redo_text = arr(8); redo_cy = arr(8); redo_cx = arr(8);
    menu_on = 0 - 1;
    pane = arr(1);
    pane_title = "";
    bind_default();
    apply_scheme("dark");
    err_line = arr(1);
    err_msg = arr(1);
    pop_c = arr(1);
    load_extensions();
    choose_default_scheme();
    load_settings();
    load_bindings();
    load(path);
    raw_mode(true);
    read_size();
    String e = esc();
    jout << e << "[?1049h" << bgs() << e << "[2J";
    if mouse_on { jout << e << "[?1000h" << e << "[?1002h" << e << "[?1006h"; }
    while quit_asked != 2 {
        draw();
        i64 k = read_key(200);
        if k == 0 - 2 {
            i64 orows = rows;
            i64 ocols = cols;
            read_size();
            if orows != rows || ocols != cols { jout << bgs() << e << "[2J"; }
            continue;
        }
        if k < 0 { break; }
        handle(k);
    }
    jout << e << "[?1006l" << e << "[?1002l" << e << "[?1000l" << e << "[?25h" << e << "[0m" << e << "[?1049l";
    raw_mode(false);
    return 0;
}
