// neuron: train and run small AI models on the phone, all in J2K.
//   neuron train DATA.txt -o MODEL.jw [-k 8] [-d 12] [-h 96] [-e 5] [-r 0.05]   learn to continue a text (a small language model)
//   neuron run MODEL.jw "start of a text" [-n 200] [-t 0.8]                     write on from the start
//   neuron chat [MODEL.jw] [-n 200] [-t 0.8]                                    talk with the model: a line in, a text out (no file: the assistant)
//   neuron install MODEL.jw                                                      make a model the assistant of this phone (~/.neuron/assistant.jw)
//   neuron learn | forget                                                        learn from the events the shell wrote (~/.neuron/events.txt) / delete them
//   neuron train DATA.txt -o OUT.jw -i MODEL.jw                                  go on learning from a model
//   neuron eval MODEL.jw TEST.txt [-n 200]                                      measure: the share of the test questions answered right
//   neuron info MODEL.jw                                                         what is in a model file
//   neuron ask MODEL.jw X1 X2 ...                                                a numeric model (library neuron, neuron-jw 1)
// The model: every byte of the text has a vector of d numbers; the last k bytes are put side by side, one layer of h neurons with
// relu, then one number for each byte of the vocabulary; the biggest (or a draw with temperature t) is the next byte.
// The file .jw (neuron-jw 2) is a text file: a few header lines and the numbers.   #import <neuron> is used by "ask".
#import <stdlib>
#import <math>
#import <neuron>
#import <llama>

String neuron_version() { return "0.5.0"; }

int fail(String msg) {
    cerr << "neuron: " << msg << "\n";
    return 1;
}

// ---- a small generator of random numbers (the same every run for the same seed)
int g_seed;
double rnd() {
    g_seed = (g_seed * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF;
    return (double)((g_seed >> 20) & 0xFFFFFF) / 16777216.0;
}

// ---- the model
struct CharLm {
    int k;                          // bytes of context
    int d;                          // numbers per byte
    int h;                          // neurons
    int v;                          // size of the vocabulary
    int[] bytes;                    // the byte of every word of the vocabulary
    int[] index;                    // 256 entries: the word of a byte, or -1
    double[] emb;                   // v * d
    double[] w1;                    // (k * d) * h
    double[] b1;                    // h
    double[] w2;                    // h * v
    double[] b2;                    // v
    double[] x;                     // k * d  (the input of the last step)
    double[] hid;                   // h
    double[] p;                     // v  (the probabilities of the last step)
    String[] pq;                    // the questions of the talk it learned (for the search that comes before the model)
    String[] pa;                    // and their answers
}

CharLm lm_alloc(int k, int d, int h, int v) {
    CharLm m;
    m.k = k; m.d = d; m.h = h; m.v = v;
    m.bytes = arr(v + 1);
    m.index = arr(257);
    for i in 0..256 { m.index.push(0 - 1); }
    m.emb = arr(v * d + 1); m.w1 = arr(k * d * h + 1); m.b1 = arr(h + 1);
    m.w2 = arr(h * v + 1); m.b2 = arr(v + 1);
    m.x = arr(k * d + 1); m.hid = arr(h + 1); m.p = arr(v + 1);
    m.pq = arr(16); m.pa = arr(16);
    for i in 0..v * d { m.emb.push(0.0); }
    for i in 0..k * d * h { m.w1.push(0.0); }
    for i in 0..h { m.b1.push(0.0); m.hid.push(0.0); }
    for i in 0..h * v { m.w2.push(0.0); }
    for i in 0..v { m.b2.push(0.0); m.p.push(0.0); }
    for i in 0..k * d { m.x.push(0.0); }
    return m;
}

void lm_init_weights(CharLm m) {
    double s1 = 1.0 / Math::sqrt((double)(m.k * m.d));
    double s2 = 1.0 / Math::sqrt((double)m.h);
    for i in 0..m.v * m.d { m.emb[i] = (rnd() - 0.5) * 0.5; }
    for i in 0..m.k * m.d * m.h { m.w1[i] = (rnd() - 0.5) * 2.0 * s1; }
    for i in 0..m.h * m.v { m.w2[i] = (rnd() - 0.5) * 2.0 * s2; }
}

// the probabilities of the next byte after the context ctx[0..k-1] (words of the vocabulary), in m.p
void lm_forward(CharLm m, int[] ctx) {
    int kd = m.k * m.d;
    for j in 0..m.k {
        int base = ctx[j] * m.d;
        for t in 0..m.d { m.x[j * m.d + t] = m.emb[base + t]; }
    }
    for i in 0..m.h {
        double a = m.b1[i];
        for t in 0..kd { a += m.x[t] * m.w1[t * m.h + i]; }
        if a < 0.0 { a = 0.0; }
        m.hid[i] = a;
    }
    double top = 0.0 - 1.0e30;
    for o in 0..m.v {
        double a = m.b2[o];
        for i in 0..m.h { a += m.hid[i] * m.w2[i * m.v + o]; }
        m.p[o] = a;
        if a > top { top = a; }
    }
    double sum = 0.0;
    for o in 0..m.v { double e = Math::exp(m.p[o] - top); m.p[o] = e; sum += e; }
    for o in 0..m.v { m.p[o] = m.p[o] / sum; }
}

// one step of learning for one place of the text: returns -ln(p of the right byte)
double lm_learn(CharLm m, int[] ctx, int target, double rate) {
    lm_forward(m, ctx);
    double loss = 0.0 - Math::log(m.p[target] + 1.0e-12);
    int kd = m.k * m.d;
    double[] dh = arr(m.h + 1);
    for i in 0..m.h { dh.push(0.0); }
    for o in 0..m.v {
        double g = m.p[o];
        if o == target { g -= 1.0; }
        for i in 0..m.h {
            dh[i] += g * m.w2[i * m.v + o];
            m.w2[i * m.v + o] -= rate * g * m.hid[i];
        }
        m.b2[o] -= rate * g;
    }
    for i in 0..m.h { if m.hid[i] <= 0.0 { dh[i] = 0.0; } }
    double[] dx = arr(kd + 1);
    for t in 0..kd { dx.push(0.0); }
    for i in 0..m.h {
        double g = dh[i];
        if g == 0.0 { continue; }
        for t in 0..kd {
            dx[t] += g * m.w1[t * m.h + i];
            m.w1[t * m.h + i] -= rate * g * m.x[t];
        }
        m.b1[i] -= rate * g;
    }
    for j in 0..m.k {
        int base = ctx[j] * m.d;
        for t in 0..m.d { m.emb[base + t] -= rate * dx[j * m.d + t]; }
    }
    return loss;
}

// ---- the file .jw (neuron-jw 2): lines of text; the numbers are written with spaces between
String numbers(double[] a, int n) {
    String t = "";
    for i in 0..n { t = t + str(a[i]) + " "; }
    return t + "\n";
}

bool lm_save(CharLm m, String path) {
    String t = "neuron-jw 2\nkind charlm\ncontext " + str(m.k) + "\ndim " + str(m.d) + "\nhidden " + str(m.h) + "\nvocab " + str(m.v) + "\n";
    for i in 0..m.v { t = t + str(m.bytes[i]) + " "; }
    t = t + "\n" + numbers(m.emb, m.v * m.d) + numbers(m.w1, m.k * m.d * m.h) + numbers(m.b1, m.h) + numbers(m.w2, m.h * m.v) + numbers(m.b2, m.v);
    // the questions and answers of the talk: one line each,  question <tab> answer  (the search before the model uses them)
    t = t + "pairs " + str(m.pq.len) + "\n";
    for i in 0..m.pq.len { t = t + m.pq[i].replace("\t", " ").replace("\n", " ") + "\t" + m.pa[i].replace("\t", " ").replace("\n", " ") + "\n"; }
    return Fs::write_text(path, t).is_ok();
}

int header_value(String line, String key) {
    return line.slice(key.len + 1, line.len).trim().to_int();
}

void fill(double[] dst, String line, int n) {
    String[] w = line.trim().split(" ");
    for i in 0..n { if i < w.len { dst[i] = w[i].to_double(); } }
}

// loads a model; ok = false when the file is not a model of this kind
CharLm lm_load(String path, bool^ ok) {
    ok[0] = false;
    CharLm none = lm_alloc(1, 1, 1, 1);
    Result<String, Error> r = Fs::read_text(path);
    if !r.is_ok() { return none; }
    String[] ls = r.take().split("\n");
    if ls.len < 12 || ls[0] != "neuron-jw 2" || ls[1] != "kind charlm" { return none; }
    int k = header_value(ls[2], "context");
    int d = header_value(ls[3], "dim");
    int h = header_value(ls[4], "hidden");
    int v = header_value(ls[5], "vocab");
    if k < 1 || d < 1 || h < 1 || v < 2 { return none; }
    CharLm m = lm_alloc(k, d, h, v);
    String[] vb = ls[6].trim().split(" ");
    for i in 0..v { m.bytes.push(vb[i].to_int()); m.index[m.bytes[i]] = i; }
    fill(m.emb, ls[7], v * d);
    fill(m.w1, ls[8], k * d * h);
    fill(m.b1, ls[9], h);
    fill(m.w2, ls[10], h * v);
    fill(m.b2, ls[11], v);
    if ls.len > 12 && ls[12].starts_with("pairs ") {
        int np = ls[12].slice(6, ls[12].len).to_int();
        for i in 0..np {
            if 13 + i >= ls.len { break; }
            int tab = ls[13 + i].find("\t");
            if tab <= 0 { continue; }
            m.pq.push(ls[13 + i].slice(0, tab) + "");
            m.pa.push(ls[13 + i].slice(tab + 1, ls[13 + i].len) + "");
        }
    }
    ok[0] = true;
    return m;
}

// ---- the vocabulary of a text: the bytes that are in it
CharLm lm_for_text(String text, int k, int d, int h) {
    int[] seen = arr(257);
    for i in 0..256 { seen.push(0); }
    for i in 0..text.len { seen[text[i] & 255] = 1; }
    for i in 32..127 { seen[i] = 1; }                          // every printable letter of ASCII is always in, so the model can learn commands later
    seen[10] = 1; seen[9] = 1;
    int v = 0;
    for i in 0..256 { if seen[i] == 1 { v += 1; } }
    CharLm m = lm_alloc(k, d, h, v);
    int at = 0;
    for b in 0..256 { if seen[b] == 1 { m.bytes.push(b); m.index[b] = at; at += 1; } }
    lm_init_weights(m);
    return m;
}

// the lines  You: question  and  Bot: answer  that follow each other become pairs (the same question again is kept once)
void lm_collect_pairs(CharLm m, String text) {
    String[] ls = text.split("\n");
    for i in 0..ls.len - 1 {
        if ls[i].starts_with("You: ") && ls[i + 1].starts_with("Bot: ") {
            String q = ls[i].slice(5, ls[i].len).trim();
            String a = ls[i + 1].slice(5, ls[i + 1].len).trim();
            if q.len == 0 || a.len == 0 { continue; }
            bool seen = false;
            for k in 0..m.pq.len { if m.pq[k] == q { seen = true; m.pa[k] = a + ""; } }
            if !seen { m.pq.push(q + ""); m.pa.push(a + ""); }
        }
    }
}

// a question in a simple form for the comparison: small letters, only letters, digits and bytes of other scripts, one space between words
String simple_form(String t) {
    String r = " ";
    bool space = true;
    for i in 0..t.len {
        int c = t[i] & 255;
        if c >= 65 && c <= 90 { c += 32; }
        bool word = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c >= 128;
        if word { r.push((char)c); space = false; }
        else if !space { r.push(' '); space = true; }
    }
    if !space { r.push(' '); }
    return r;
}

// the likeness of two forms, 0 .. 1: how many of the groups of three letters they have in common (Dice)
double likeness(String x, String y) {
    int nx = x.len - 2;
    int ny = y.len - 2;
    if nx < 1 || ny < 1 { return 0.0; }
    int[] used = arr(ny + 1);
    for j in 0..ny { used.push(0); }
    int common = 0;
    for i in 0..nx {
        for j in 0..ny {
            if used[j] == 0 && x[i] == y[j] && x[i + 1] == y[j + 1] && x[i + 2] == y[j + 2] { used[j] = 1; common += 1; break; }
        }
    }
    return 2.0 * (double)common / (double)(nx + ny);
}

// the answer of the question that is the most like q, "" when none is like enough (limit 0..1)
String search_answer(CharLm m, String q, double limit) {
    String fq = simple_form(q);
    double best = 0.0;
    int at = 0 - 1;
    for i in 0..m.pq.len {
        double s = likeness(fq, simple_form(m.pq[i]));
        if s > best { best = s; at = i; }
    }
    if at >= 0 && best >= limit { return m.pa[at] + ""; }
    return "";
}

int word_of(CharLm m, int byte) {
    int w = m.index[byte & 255];
    if w < 0 { return 0; }
    return w;
}

// the next byte after the text so far (the last k bytes); t = temperature (0: always the most probable)
int lm_next(CharLm m, String text, double t) {
    int[] ctx = arr(m.k + 1);
    int space = word_of(m, 32);
    for j in 0..m.k {
        int at = text.len - m.k + j;
        if at >= 0 { ctx.push(word_of(m, text[at])); } else { ctx.push(space); }
    }
    lm_forward(m, ctx);
    int best = 0;
    for o in 1..m.v { if m.p[o] > m.p[best] { best = o; } }
    if t <= 0.0 { return m.bytes[best]; }
    double sum = 0.0;
    double[] q = arr(m.v + 1);
    for o in 0..m.v { double e = Math::exp(Math::log(m.p[o] + 1.0e-12) / t); q.push(e); sum += e; }
    double r = rnd() * sum;
    for o in 0..m.v { r -= q[o]; if r <= 0.0 { return m.bytes[o]; } }
    return m.bytes[best];
}

// writes on from text: n bytes at most; stop_line = stop at the first line end
String lm_write(CharLm m, String start, int n, double t, bool stop_line) {
    String text = start + "";
    String made = "";
    for i in 0..n {
        int b = lm_next(m, text, t);
        if stop_line && b == 10 { break; }
        text.push((char)b);
        made.push((char)b);
    }
    return made;
}

String option(String[] a, String name, String fallback) {
    for i in 2..a.len - 1 { if a[i] == name { return a[i + 1] + ""; } }
    return fallback;
}

int do_train(String[] a) {
    if a.len < 3 { return fail("usage: neuron train DATA.txt -o MODEL.jw [-k 8] [-d 12] [-h 96] [-e 5] [-r 0.05]"); }
    Result<String, Error> rd = Fs::read_bytes(a[2]);
    if !rd.is_ok() { return fail("cannot read " + a[2]); }
    String text = rd.take();
    if text.len < 20 { return fail("the text is too short to learn from (" + str(text.len) + " bytes)"); }
    String out = option(a, "-o", "model.jw");
    int k = option(a, "-k", "8").to_int();
    int d = option(a, "-d", "12").to_int();
    int h = option(a, "-h", "96").to_int();
    int epochs = option(a, "-e", "5").to_int();
    double rate = option(a, "-r", "0.05").to_double();
    g_seed = option(a, "-s", "12345").to_int();
    CharLm m = lm_for_text(text, k, d, h);
    String from = option(a, "-i", "");
    if from.len > 0 {                                          // -i MODEL: go on learning from a model (its sizes and vocabulary stay)
        bool okm = false;
        m = lm_load(from, @okm);
        if !okm { return fail(from + " is not a model of neuron"); }
        k = m.k; d = m.d; h = m.h;
    }
    lm_collect_pairs(m, text);
    cout << "text " << text.len << " bytes, " << m.pq.len << " questions with answers, vocabulary " << m.v << ", model: context " << k << ", dim " << d << ", hidden " << h << ", " << epochs << " rounds\n";
    int[] ctx = arr(k + 1);
    for j in 0..k { ctx.push(0); }
    int space = word_of(m, 32);
    int started = Time::now_ms();
    for e in 0..epochs {
        double total = 0.0;
        int n = 0;
        for at in 0..text.len {
            for j in 0..k {
                int src = at - k + j;
                if src >= 0 { ctx[j] = word_of(m, text[src]); } else { ctx[j] = space; }
            }
            total += lm_learn(m, ctx, word_of(m, text[at]), rate);
            n += 1;
            if at % 5000 == 4999 {
                cout << "\r  round " << e + 1 << "  " << at * 100 / text.len << " %   loss " << total / (double)n << "   " << (Time::now_ms() - started) / 1000 << " s   ";
            }
        }
        cout << "\rround " << e + 1 << " of " << epochs << ": loss " << total / (double)n << "   (" << (Time::now_ms() - started) / 1000 << " s)                    \n";
        if !lm_save(m, out) { return fail("cannot write " + out); }
        rate = rate * 0.9;                                    // a little slower every round
    }
    cout << "saved " << out << "\n";
    String sample = lm_write(m, text.slice(0, k), 120, 0.8, false);
    cout << "a sample: " << text.slice(0, k) << sample << "\n";
    return 0;
}

CharLm open_model(String path, bool^ ok) {
    CharLm m = lm_load(path, ok);
    if !ok[0] { fail(path + " is not a model of neuron (neuron-jw 2, kind charlm); for a numeric model use: neuron ask"); }
    return m;
}

int do_run(String[] a) {
    if a.len < 4 { return fail("usage: neuron run MODEL.jw \"start of a text\" [-n 200] [-t 0.8]"); }
    bool ok = false;
    CharLm m = open_model(a[2], @ok);
    if !ok { return 1; }
    g_seed = Time::now_ms();
    int n = option(a, "-n", "200").to_int();
    double t = option(a, "-t", "0.8").to_double();
    cout << a[3] << lm_write(m, a[3], n, t, false) << "\n";
    return 0;
}

// the assistant of this phone: ~/.neuron/assistant.jw (neuron install FILE.jw puts a model there); neuron chat without a file uses it
String assistant_path() {
    String home = ".";
    switch Env::get("HOME") {
        Option::Some(h): { if h.len > 0 { home = h; } }
        Option::None: { }
    }
    return home + "/.neuron/assistant.jw";
}

// neuron eval MODEL.jw TEST.txt [-n 200]: how many of the questions of the test text (never learned) are answered right,
// by the search alone, by the model alone (the most likely byte each time) and by both together as xr does it
int do_eval(String[] a) {
    if a.len < 4 { return fail("usage: neuron eval MODEL.jw TEST.txt [-n 200]"); }
    bool ok = false;
    CharLm m = open_model(a[2], @ok);
    if !ok { return 1; }
    Result<String, Error> rd = Fs::read_bytes(a[3]);
    if !rd.is_ok() { return fail("cannot read " + a[3]); }
    CharLm probe = lm_alloc(1, 1, 1, 1);
    lm_collect_pairs(probe, rd.take());
    int total = probe.pq.len;
    if total == 0 { return fail("no pairs (You: / Bot:) in " + a[3]); }
    int maxn = option(a, "-n", "200").to_int();
    if maxn > total { maxn = total; }
    String lim_text = jash_get("xr", "match", "0.5");
    double limit = lim_text.to_double();
    int by_search = 0;
    int by_model = 0;
    int by_both = 0;
    int answered = 0;
    int step = total / maxn;
    if step < 1 { step = 1; }
    int done = 0;
    int at = 0;
    while at < total && done < maxn {
        String q = probe.pq[at];
        String want = probe.pa[at];
        String found = search_answer(m, q, limit);
        if found.len > 0 { answered += 1; }
        if found == want { by_search += 1; }
        String gen = lm_write(m, "You: " + q + "\nBot: ", want.len + 20, 0.0, true);
        if gen == want { by_model += 1; }
        if found.len > 0 { if found == want { by_both += 1; } } else if gen == want { by_both += 1; }
        done += 1;
        at += step;
    }
    cout << "questions tested: " << done << " (never learned in that form)\n";
    cout << "  search alone: " << by_search * 100 / done << " % right  (" << answered * 100 / done << " % were answered by the search)\n";
    cout << "  model alone:  " << by_model * 100 / done << " % right\n";
    cout << "  both (as xr): " << by_both * 100 / done << " % right\n";
    return 0;
}

int do_install(String[] a) {
    if a.len < 3 { return fail("usage: neuron install MODEL.jw   (it becomes the assistant: neuron chat)"); }
    bool ok = false;
    CharLm m = lm_load(a[2], @ok);
    if !ok { return fail(a[2] + " is not a model of neuron (neuron-jw 2, kind charlm)"); }
    String target = assistant_path();
    Dir::make_all(Path::parent(target));
    Result<String, Error> r = Fs::read_bytes(a[2]);
    if !r.is_ok() { return fail("cannot read " + a[2]); }
    if !Fs::write_bytes(target, r.take()).is_ok() { return fail("cannot write " + target); }
    cout << "installed " << a[2] << " as the assistant: " << target << "  (neuron chat talks with it)\n";
    return 0;
}

int do_chat(String[] a) {
    String model = assistant_path();
    if a.len >= 3 && a[2].len > 0 && a[2][0] != '-' { model = a[2]; }
    if !Fs::exists(model) { return fail("no model: neuron chat MODEL.jw, or install one: neuron install MODEL.jw"); }
    bool ok = false;
    CharLm m = open_model(model, @ok);
    if !ok { return 1; }
    g_seed = Time::now_ms();
    int n = option(a, "-n", "200").to_int();
    double t = option(a, "-t", "0.8").to_double();
    String talk = "";
    cout << "neuron chat: type a line, an empty line leaves. (the model was taught with lines like  You: ...  Bot: ...)\n";
    while true {
        cout << "You: ";
        String line = Input::line().trim();
        if line.len == 0 { break; }
        talk = talk + "You: " + line + "\nBot: ";
        String reply = reply_to(m, talk, line, n, t);
        talk = talk + reply + "\n";
        cout << "Bot: " << reply << "\n";
        if talk.len > 4000 { talk = talk.slice(talk.len - 2000, talk.len); }
    }
    return 0;
}

int do_info(String[] a) {
    if a.len < 3 { return fail("usage: neuron info MODEL.jw"); }
    Result<String, Error> r = Fs::read_text(a[2]);
    if !r.is_ok() { return fail("cannot read " + a[2]); }
    String[] ls = r.take().split("\n");
    if ls.len > 0 && ls[0] == "neuron-jw 1" { cout << a[2] << ": a numeric network (neuron-jw 1), " << ls[1] << "\n"; return 0; }
    bool ok = false;
    CharLm m = lm_load(a[2], @ok);
    if !ok { return fail(a[2] + " is not a model of neuron"); }
    int numbers_n = m.v * m.d + m.k * m.d * m.h + m.h + m.h * m.v + m.v;
    cout << a[2] << ": a language model (neuron-jw 2): context " << m.k << " bytes, dim " << m.d << ", hidden " << m.h << ", vocabulary " << m.v << ", " << numbers_n << " numbers\n";
    return 0;
}

int do_ask(String[] a) {
    if a.len < 4 { return fail("usage: neuron ask MODEL.jw X1 X2 ..."); }
    Network net = Network::load(a[2]);
    if net.count == 0 { return fail(a[2] + " is not a numeric model (neuron-jw 1)"); }
    int n = a.len - 3;
    Tensor q = Tensor::zeros(1, n);
    for i in 0..n { q.set(0, i, a[3 + i].to_double()); }
    Tensor out = net.predict(q);
    String line = "";
    for i in 0..out.cols { line = line + str(out.get(0, i)) + " "; }
    cout << line.trim() << "\n";
    return 0;
}

// ---- xaiorin (xr): the assistant of the phone. A small server on this machine (127.0.0.1) keeps the model in memory and answers;
//      xr start puts it in the background, xr ask / xr chat talk to it (or load the model themselves when it does not run).
String jash_get(String section, String key, String fallback) {
    String home = ".";
    switch Env::get("HOME") {
        Option::Some(h): { if h.len > 0 { home = h; } }
        Option::None: { }
    }
    Result<String, Error> r = Fs::read_text(home + "/.jash");
    if !r.is_ok() { return fallback; }
    String[] ls = r.take().split("\n");
    String cur = "";
    for i in 0..ls.len {
        String ln = ls[i].trim();
        if ln.len == 0 || ln[0] == '#' { continue; }
        if ln[0] == '[' { if ln != "[#jash]" { cur = ln.slice(1, ln.len - 1).trim(); } continue; }
        int eq = ln.find("=");
        if eq <= 0 || cur != section { continue; }
        if ln.slice(0, eq).trim() == key { return ln.slice(eq + 1, ln.len).trim().replace("\"", ""); }
    }
    return fallback;
}

String xr_dir() {
    String home = ".";
    switch Env::get("HOME") {
        Option::Some(h): { if h.len > 0 { home = h; } }
        Option::None: { }
    }
    return home + "/.neuron";
}

int xr_port() { return jash_get("xr", "port", "7790").to_int(); }

// the reply to a question: the answer of the question that is the most like it (settings [xr] search = on, match = 0.5), else the model writes on
String reply_to(CharLm m, String talk, String question, int n, double t) {
    if jash_get("xr", "search", "on") != "off" {
        String found = search_answer(m, question, jash_get("xr", "match", "0.5").to_double());
        if found.len > 0 { return found; }
        // nothing is like the question: a model with a talk (pairs) says so; free writing of a small model is noise (setting [xr] free_text = on brings it back)
        String free = jash_get("xr", "free_text", "off");
        if m.pq.len > 0 && free != "on" { return "I do not know that. Ask me about the tools of Jaric (for example: how do I install a tool)."; }
    }
    return lm_write(m, talk, n, t, true);
}


String read_line_from(Connection c) {
    String got = "";
    while got.find("\n") < 0 && got.len < 8000 {
        String piece = c.receive_max(2000);
        if piece.len == 0 { break; }
        got = got + piece;
    }
    int nl = got.find("\n");
    if nl >= 0 { got = got.slice(0, nl); }
    return got.trim();
}

// the server: one request line in, one answer out.   ask TEXT | reset | ping | stop
int xr_serve(String model, int port) {
    bool ok = false;
    CharLm m = lm_load(model, @ok);
    if !ok { return fail("no model to serve: " + model + "  (neuron install MODEL.jw)"); }
    Listener l;
    try { l = Listener::on(port); } catch (e) { return fail("cannot listen on port " + str(port) + ": " + e); }
    if l.fd < 0 { return fail("cannot listen on port " + str(port)); }
    g_seed = Time::now_ms();
    double t = jash_get("xr", "temperature", "0.7").to_double();
    int n = jash_get("xr", "max", "200").to_int();
    String talk = "";
    while true {
        Connection c = l.accept();
        if c.fd < 0 { continue; }
        String req = read_line_from(c);
        String answer = "";
        if req == "ping" { answer = "pong"; }
        else if req == "reset" { talk = ""; answer = "ok"; }
        else if req == "stop" { c.send("bye\n"); c.close(); l.close(); return 0; }
        else if req.starts_with("ask ") {
            talk = talk + "You: " + req.slice(4, req.len) + "\nBot: ";
            answer = reply_to(m, talk, req.slice(4, req.len), n, t);
            talk = talk + answer + "\n";
            if talk.len > 4000 { talk = talk.slice(talk.len - 2000, talk.len); }
        } else { answer = "?"; }
        c.send(answer + "\n");
        c.close();
    }
    return 0;
}

// asks the server; ok = false when none answers
String xr_call(String request, bool^ ok) {
    ok[0] = false;
    Connection c;
    try { c = Connection::to("127.0.0.1", xr_port()); } catch (e) { return ""; }          // nobody listens: the program does not run
    if c.fd < 0 { return ""; }
    c.send(request + "\n");
    String got = "";
    while true {
        String piece = c.receive_max(2000);
        if piece.len == 0 { break; }
        got = got + piece;
        if got.len > 20000 { break; }
    }
    c.close();
    ok[0] = true;
    return got.trim();
}

bool xr_running() {
    bool ok = false;
    String r = xr_call("ping", @ok);
    return ok && r == "pong";
}

int xr_start() {
    if xr_running() { cout << "xaiorin runs already (port " << xr_port() << ")\n"; return 0; }
    String model = assistant_path();
    if !Fs::exists(model) { return fail("no assistant yet: neuron install MODEL.jw  (or: makej init -ai, makej train, makej install)"); }
    int pid = Sys::fork();
    if pid < 0 { return fail("cannot start the background program"); }
    if pid > 0 { Time::sleep_ms(400); cout << "xaiorin runs in the background (port " << xr_port() << ", stop it with: xr stop)\n"; return 0; }
    Sys::call(157, 0, 0, 0, 0, 0, 0);                              // setsid: no terminal any more
    int nul_in = Sys::open_read("/dev/null".c());
    int nul_out = Sys::open_write("/dev/null".c());
    Sys::call(24, nul_in, 0, 0, 0, 0, 0);                          // dup3 onto 0, 1, 2
    Sys::call(24, nul_out, 1, 0, 0, 0, 0);
    Sys::call(24, nul_out, 2, 0, 0, 0, 0);
    int rc = xr_serve(model, xr_port());
    Sys::exit(rc);
    return rc;
}

int xr_stop() {
    bool ok = false;
    xr_call("stop", @ok);
    if ok { cout << "xaiorin stopped\n"; } else { cout << "xaiorin was not running\n"; }
    return 0;
}

// one question: through the server when it runs, else the model is loaded here
String xr_answer(String question, CharLm^ own, bool^ have_own) {
    bool ok = false;
    String r = xr_call("ask " + question, @ok);
    if ok { return r; }
    return "";
}

int xr_main(String[] a) {
    String cmd = "";
    if a.len > 1 { cmd = a[1]; }
    if cmd == "--version" || cmd == "-V" { cout << "xaiorin (xr) " << neuron_version() << " (the tool neuron)\n"; return 0; }
    if cmd == "start" { return xr_start(); }
    if cmd == "stop" { return xr_stop(); }
    if cmd == "status" { if xr_running() { cout << "xaiorin runs (port " << xr_port() << ")\n"; } else { cout << "xaiorin is not running (xr start)\n"; } return 0; }
    if cmd == "reset" { bool ok = false; xr_call("reset", @ok); if ok { cout << "forgot the talk\n"; } else { cout << "xaiorin is not running\n"; } return 0; }
    if cmd == "serve" { return xr_serve(assistant_path(), xr_port()); }
    if cmd == "learn" {
        String[] la = arr(4);
        la.push("neuron"); la.push("learn");
        int rc = do_learn(la);
        if rc == 0 && xr_running() { xr_stop(); xr_start(); }          // the background program loads the new model
        return rc;
    }
    if cmd == "forget" { return do_forget(); }
    if cmd == "where" { return do_where(); }
    if cmd == "help" || cmd == "--help" || cmd == "-h" {
        cout << "xaiorin (xr): the AI assistant of this phone\n";
        cout << "  xr                      talk (lines in, answers out; an empty line leaves)\n";
        cout << "  xr \"question\"          one answer\n";
        cout << "  xr start | stop | status | reset    the background program (it keeps the model in memory)\n";
        cout << "  xr learn | forget       learn from what the shell saw (the setting in jaric setting must be on) / delete what it saw\n";
        cout << "Settings in ~/.jash, section [xr]: port (7790), temperature (0.7), max (200 bytes of an answer), autostart (on / off, used by the Jaric app)\n";
        cout << "The model: neuron install MODEL.jw  (train it with neuron train, or makej -ai)\n";
        return 0;
    }
    bool server = xr_running();
    String model = assistant_path();
    CharLm own = lm_alloc(1, 1, 1, 1);
    bool have = false;
    if !server {
        if !Fs::exists(model) { return fail("no assistant yet: neuron install MODEL.jw"); }
        own = lm_load(model, @have);
        if !have { return fail(model + " is not a model of neuron"); }
        g_seed = Time::now_ms();
    }
    double t = jash_get("xr", "temperature", "0.7").to_double();
    int n = jash_get("xr", "max", "200").to_int();
    if cmd.len > 0 {                                                     // xr "question words"
        String q = cmd;
        for i in 2..a.len { q = q + " " + a[i]; }
        if server { bool ok = false; cout << xr_call("ask " + q, @ok) << "\n"; }
        else { cout << reply_to(own, "You: " + q + "\nBot: ", q, n, t) << "\n"; }
        return 0;
    }
    String talk = "";
    cout << "xaiorin: type a line, an empty line leaves.";
    if server { cout << "  (the background program answers)"; }
    cout << "\n";
    while true {
        cout << "you> ";
        String line = Input::line().trim();
        if line.len == 0 { break; }
        String reply = "";
        if server { bool ok = false; reply = xr_call("ask " + line, @ok); }
        else {
            talk = talk + "You: " + line + "\nBot: ";
            reply = reply_to(own, talk, line, n, t);
            talk = talk + reply + "\n";
            if talk.len > 4000 { talk = talk.slice(talk.len - 2000, talk.len); }
        }
        cout << "xr> " << reply << "\n";
    }
    return 0;
}

// ---- learning from what happens in the shell. jsh (when the setting is on) writes one line for each command into ~/.neuron/events.txt:
//        COMMAND <tab> EXIT-STATUS <tab> MESSAGE        (the message is what jsh itself said, for example "command not found")
//      neuron learn turns them into a talk to learn: a wrong command followed by a right one that is almost the same
//      ("You: gti status" / "Bot: Did you mean: git status") and the commands that follow each other again and again.
int edits(String x, String y) {
    int n = x.len;
    int m = y.len;
    if n > 30 || m > 30 { return 99; }
    int[] prev = arr(m + 2);
    int[] cur = arr(m + 2);
    for j in 0..m + 1 { prev.push(j); cur.push(0); }
    for i in 1..n + 1 {
        cur[0] = i;
        for j in 1..m + 1 {
            int cost = 1;
            if x[i - 1] == y[j - 1] { cost = 0; }
            int best = prev[j - 1] + cost;
            if prev[j] + 1 < best { best = prev[j] + 1; }
            if cur[j - 1] + 1 < best { best = cur[j - 1] + 1; }
            cur[j] = best;
        }
        for j in 0..m + 1 { prev[j] = cur[j]; }
    }
    return prev[m];
}

String first_word(String cmd) {
    int sp = cmd.find(" ");
    if sp < 0 { return cmd; }
    return cmd.slice(0, sp);
}

int do_learn(String[] a) {
    String events = xr_dir() + "/events.txt";
    String out = xr_dir() + "/learned.txt";
    if !Fs::exists(events) { return fail("nothing to learn from yet: no " + events + "  (turn it on in jaric setting: assistant learns from the shell)"); }
    Result<String, Error> r = Fs::read_text(events);
    if !r.is_ok() { return fail("cannot read " + events); }
    String[] ls = r.take().split("\n");
    int from = 0;
    if ls.len > 3000 { from = ls.len - 3000; }                  // the last 3000 events
    String[] cmd = arr(ls.len + 1);
    int[] st = arr(ls.len + 1);
    String[] msg = arr(ls.len + 1);
    for i in from..ls.len {
        String[] f = ls[i].split("\t");
        if f.len < 2 { continue; }
        String c0 = f[0].trim();
        if c0.len == 0 { continue; }
        cmd.push(c0 + "");
        st.push(f[1].trim().to_int());
        if f.len > 2 { msg.push(f[2].trim() + ""); } else { msg.push(""); }
    }
    String text = "";
    int fixes = 0;
    int habits = 0;
    for i in 0..cmd.len {
        if st[i] != 0 {
            // the next right command within 3 that is almost the same word
            for k in i + 1..i + 4 {
                if k >= cmd.len { break; }
                String wi = first_word(cmd[i]);
                String wk = first_word(cmd[k]);
                bool close_word = edits(wi, wk) <= 2;
                bool other_cmd = cmd[i] != cmd[k];
                if st[k] == 0 && close_word && other_cmd {
                    text = text + "You: " + cmd[i] + "\nBot: Did you mean: " + cmd[k] + "\n";
                    fixes += 1;
                    break;
                }
            }
            if msg[i].len > 0 { text = text + "You: " + cmd[i] + " gave: " + msg[i] + "\nBot: that did not work\n"; }
        } else if i + 1 < cmd.len && st[i + 1] == 0 && cmd[i] != cmd[i + 1] {
            text = text + "You: after " + cmd[i] + "\nBot: " + cmd[i + 1] + "\n";
            habits += 1;
        }
    }
    if text.len < 20 { return fail("too little to learn from (" + str(cmd.len) + " events, " + str(fixes) + " fixes)"); }
    Fs::write_text(out, text);
    cout << "learned.txt: " << fixes << " fixes, " << habits << " habits from " << cmd.len << " events -> " << out << "\n";
    String model = assistant_path();
    String no_train = option(a, "--no-train", "");
    if Fs::exists(model) && no_train.len == 0 {
        String[] t = arr(10);
        t.push("neuron"); t.push("train"); t.push(out); t.push("-o"); t.push(model); t.push("-i"); t.push(model); t.push("-e"); t.push("3"); t.push("-r"); t.push("0.03");
        cout << "going on learning from the assistant model (3 rounds) ...\n";
        return do_train(t);
    }
    return 0;
}

// where everything of the assistant lies, and how big it is
int do_where() {
    String dir = xr_dir();
    String home = ".";
    switch Env::get("HOME") {
        Option::Some(h): { if h.len > 0 { home = h; } }
        Option::None: { }
    }
    String[] names = arr(8);
    String[] what = arr(8);
    names.push(dir + "/assistant.jw"); what.push("the model of the assistant (neuron install puts it here)");
    names.push(dir + "/events.txt"); what.push("what jsh saw in the shell (only when the setting is on)");
    names.push(dir + "/learned.txt"); what.push("the talk made from the events (xr learn)");
    names.push(home + "/.jash"); what.push("the settings, section [xr]");
    cout << "folder of the assistant: " << dir << "\n";
    for i in 0..names.len {
        String size = "-";
        if Fs::exists(names[i]) {
            Result<int, Error> r = Fs::size(names[i]);
            if r.is_ok() { size = str(r.take() / 1024) + " KB"; }
        }
        String line = size;
        while line.len < 10 { line = " " + line; }
        cout << line << "  " << names[i] << "   " << what[i] << "\n";
    }
    cout << "(the folder starts with a dot, so a list does not show it: dir -a " << home << ")\n";
    return 0;
}

int do_forget() {
    String dir = xr_dir();
    int n = 0;
    String[] names = arr(3);
    names.push(dir + "/events.txt"); names.push(dir + "/learned.txt");
    for i in 0..names.len { if Fs::exists(names[i]) { Fs::remove(names[i]); n += 1; } }
    cout << "forgot " << n << " files of what was seen in the shell (the model stays; a model that learned from it keeps what it learned: train a new one to lose it)\n";
    return 0;
}

// the name this program was started with (neuron, xr or xaiorin)
String program_name() {
    char buf[600];
    int n = Sys::readlink("/proc/self/exe", @buf, 590);
    String path = "";
    for i in 0..n { path.push(buf[i]); }
    int cut = -1;
    for i in 0..path.len { if path[i] == '/' { cut = i; } }
    return path.slice(cut + 1, path.len);
}

int gpt_rng;
int gpt_rand() {
    int x = gpt_rng;
    x = x xor (x << 13);
    x = x xor ((x >> 7) & 72057594037927935);
    x = x xor (x << 17);
    gpt_rng = x;
    return x & 2147483647;
}

String gopt(String[] a, int from, String name, String fallback) {
    String key = name + "=";
    for i in from..a.len { if a[i].starts_with(key) { return a[i].slice(key.len, a[i].len) + ""; } }
    return fallback;
}

// the text of a file, or of every text file of a folder (and its folders): .md .txt .j .jk .sh .toml .json .c .h .py .html .css .js .rs .java
bool text_name(String n) {
    String[] ext = arr(16);
    ext.push(".md"); ext.push(".txt"); ext.push(".j"); ext.push(".jk"); ext.push(".sh"); ext.push(".toml"); ext.push(".json"); ext.push(".c"); ext.push(".h");
    ext.push(".py"); ext.push(".html"); ext.push(".css"); ext.push(".js"); ext.push(".rs"); ext.push(".java");
    for i in 0..ext.len { if n.ends_with(ext[i]) { return true; } }
    return false;
}

String gathered;
int gathered_files;

void gather(String path, int depth) {
    if Dir::exists(path) {
        if depth > 6 { return; }
        String[] names = arr(64);
        switch Dir::list(path) {
            Result::Ok(ls): { for i in 0..ls.len { names.push(ls[i] + ""); } }
            Result::Err(e): { }
        }
        for i in 0..names.len {
            if names[i].starts_with(".") { continue; }
            gather(path + "/" + names[i], depth + 1);
        }
        return;
    }
    if !text_name(path) { return; }
    Result<String, Error> r = Fs::read_bytes(path);
    if r.is_ok() {
        String t = r.take();
        if t.len > 0 && t.len < 2000000 { gathered = gathered + t + "\n\n"; gathered_files += 1; }
    }
}

String text_of_path(String path) {
    gathered = "";
    gathered_files = 0;
    if Dir::exists(path) {
        gather(path, 0);
        return gathered + "";
    }
    Result<String, Error> r = Fs::read_bytes(path);
    if r.is_ok() { gathered_files = 1; return r.take(); }
    return "";
}

int gpt_train(String[] a) {
    if a.len < 3 { cerr << "usage: neuron gpt train FILE|FOLDER [size=small|tiny|medium|large] [steps=2000] [minutes=0] [batch=8] [lr=0.003] [out=model.gpt] [resume=1] [every=100] [prompt=text]\n"; return 1; }
    String text = text_of_path(a[2]);
    if text.len == 0 { cerr << "neuron gpt: no text found in " << a[2] << "\n"; return 1; }
    String size = gopt(a, 3, "size", "small");
    int ctx = 64; int d = 64; int heads = 4; int layers = 2;
    if size == "tiny" { ctx = 32; d = 32; heads = 2; layers = 1; }
    else if size == "medium" { ctx = 128; d = 128; heads = 4; layers = 4; }
    else if size == "large" { ctx = 256; d = 192; heads = 6; layers = 6; }
    else if size != "small" { cerr << "neuron: size is tiny, small, medium or large\n"; return 1; }
    ctx = gopt(a, 3, "ctx", str(ctx)).to_int();
    d = gopt(a, 3, "d", str(d)).to_int();
    heads = gopt(a, 3, "heads", str(heads)).to_int();
    layers = gopt(a, 3, "layers", str(layers)).to_int();
    int steps = gopt(a, 3, "steps", "2000").to_int();
    double minutes = gopt(a, 3, "minutes", "0").to_double();
    int batch = gopt(a, 3, "batch", "8").to_int();
    double lr = gopt(a, 3, "lr", "0.003").to_double();
    String out = gopt(a, 3, "out", "model.gpt");
    int every = gopt(a, 3, "every", "100").to_int();
    String prompt = gopt(a, 3, "prompt", "");
    if d % heads != 0 || (d / heads) % 4 != 0 { cerr << "neuron: d must be a multiple of 4 * heads (the width of a head a multiple of 4)\n"; return 1; }
    int[] data = Gpt::bytes(text);
    if data.len < ctx * 4 + 2 { cerr << "neuron: the text is too short for ctx=" << ctx << " (" << data.len << " bytes)\n"; return 1; }
    int cut = data.len * 9 / 10;
    gpt_rng = 88172645463325252;
    Gpt m = Gpt::make(256, ctx, d, heads, layers, 1);
    if gopt(a, 3, "resume", "0") == "1" {
        Gpt old = Gpt::load(out);
        if old.vocab == 256 { m = old; cout << "resumed from " << out << "\n"; }
    }
    int params = 0;
    for n in 0..m.g.keep { params += m.g.value(n).d.len; }
    cout << gathered_files << " file(s), " << data.len << " bytes (" << cut << " to learn from, the rest to check), model: " << params << " numbers, ctx " << m.ctx << ", width " << m.d << ", " << m.heads << " heads, " << m.layers << " layers\n";
    int t0 = Time::now_ms();
    double window = 0.0;
    int count = 0;
    int step = 0;
    int warm = 10;
    bool timed = minutes > 0.0;
    if timed { steps = 1000000; }
    while step < steps {
        if timed && step == 8 {                                      // 8 steps measured: how many fit in the time
            double per = (double)(Time::now_ms() - t0) / 8.0;
            steps = (int)(minutes * 60000.0 / per);
            if steps < 20 { steps = 20; }
            cout << "about " << per << " ms per step: " << steps << " steps in " << minutes << " minutes\n";
            warm = steps / 20 + 1;
        }
        if !timed && step == 0 { warm = steps / 20 + 1; }
        int[] starts = arr(batch + 1);
        for q in 0..batch { starts.push(gpt_rand() % (cut - m.ctx - 1)); }
        double rate = lr;
        if !timed || step >= 8 { rate = Sched::cosine(step, steps, warm, lr, lr / 10.0); }
        window += m.step(data, starts, rate, 0.01, 1.0);
        count += 1;
        step += 1;
        if step % every == 0 || step == steps {
            int[] vs = arr(9);
            for q in 0..8 { vs.push(cut + (q * (data.len - cut - m.ctx - 1)) / 8); }
            double val = m.loss_on(data, vs);
            double ms = (double)(Time::now_ms() - t0) / (double)step;
            cout << "step " << step << "/" << steps << "  loss " << window / (double)count << "  check " << val << "  " << ms << " ms/step\n";
            window = 0.0;
            count = 0;
            m.save(out);
            int[] pr = Gpt::bytes(prompt);
            if pr.len == 0 { for i in 0..8 { pr.push(data[i]); } }
            cout << "  [" << Gpt::text_of(pr) << m.write(pr, 120, 0.8, 20, step) << "]\n";
        }
    }
    m.save(out);
    cout << "saved " << out << " (write with:  neuron gpt write " << out << " \"start\")\n";
    return 0;
}

int gpt_write(String[] a) {
    if a.len < 3 { cerr << "usage: neuron gpt write MODEL \"start of the text\" [n=200] [temp=0.8] [topk=20] [seed=1]\n"; return 1; }
    Gpt m = Gpt::load(a[2]);
    if m.vocab != 256 { cerr << "neuron: cannot read the model " << a[2] << "\n"; return 1; }
    String start = "";
    if a.len >= 4 && !a[3].contains("=") { start = a[3] + ""; }
    int n = gopt(a, 3, "n", "200").to_int();
    double temp = gopt(a, 3, "temp", "0.8").to_double();
    int topk = gopt(a, 3, "topk", "20").to_int();
    int seed = gopt(a, 3, "seed", "1").to_int();
    int[] pr = Gpt::bytes(start);
    if pr.len == 0 { pr.push(10); }
    cout << start << m.write(pr, n, temp, topk, seed) << "\n";
    return 0;
}

int gpt_info(String[] a) {
    if a.len < 3 { cerr << "usage: neuron gpt info MODEL\n"; return 1; }
    Gpt m = Gpt::load(a[2]);
    if m.vocab != 256 { cerr << "neuron: cannot read the model " << a[2] << "\n"; return 1; }
    int params = 0;
    for n in 0..m.g.keep { params += m.g.value(n).d.len; }
    cout << a[2] << ": a byte-level GPT, " << params << " numbers (" << params * 4 / 1024 << " KB as float32), context " << m.ctx << ", width " << m.d << ", " << m.heads << " heads, " << m.layers << " layers\n";
    return 0;
}

int llama_run(String[] a) {
    if a.len < 3 { cerr << "usage: neuron llama MODEL.gguf \"start of the text\" [n=100] [temp=0.8] [topk=40] [topp=0.95] [seed=1]\n"; return 1; }
    String start = "Once upon a time";
    if a.len >= 4 && !a[3].contains("=") { start = a[3] + ""; }
    int n = gopt(a, 3, "n", "100").to_int();
    double temp = gopt(a, 3, "temp", "0.8").to_double();
    int topk = gopt(a, 3, "topk", "40").to_int();
    double topp = gopt(a, 3, "topp", "0.95").to_double();
    int seed = gopt(a, 3, "seed", "1").to_int();
    switch Lm::load(a[2]) {
        Result::Ok(m): {
            int[] ids = m.encode(start);
            cout << start << m.generate(ids, n, temp, topk, topp, seed) << "\n";
            return 0;
        }
        Result::Err(e): { cerr << "neuron: cannot load " << a[2] << ": " << e.message << "\n"; return 1; }
    }
    return 1;
}

int llama_bench(String[] a) {
    if a.len < 3 { cerr << "usage: neuron bench MODEL.gguf [n=64]\n"; return 1; }
    int n = gopt(a, 3, "n", "64").to_int();
    int t0 = Time::now_ms();
    switch Lm::load(a[2]) {
        Result::Ok(m): {
            int t1 = Time::now_ms();
            cout << "model: " << m.embd << " wide, " << m.layers << " layers, " << m.heads << " heads (" << m.kv_heads << " kv), vocab " << m.vocab << ", load " << (t1 - t0) << " ms\n";
            int[] ids = m.encode("Once upon a time");
            m.reset();
            Tensor32 lg = Tensor32::zeros(1, 1);
            int p0 = Time::now_ms();
            for i in 0..ids.len { lg = m.step(ids[i]); }
            int p1 = Time::now_ms();
            int made = 0;
            for k in 0..n {
                if m.pos >= m.ctx { break; }
                lg = m.step(m.sample(lg, 0.0, 0, 1.0));
                made += 1;
            }
            int p2 = Time::now_ms();
            double dg = (double)(p2 - p1);
            if dg < 1.0 { dg = 1.0; }
            cout << "prompt: " << ids.len << " tokens in " << (p1 - p0) << " ms; new tokens: " << made << " in " << (p2 - p1) << " ms = " << (double)made * 1000.0 / dg << " tokens/s\n";
            return 0;
        }
        Result::Err(e): { cerr << "neuron: cannot load " << a[2] << ": " << e.message << "\n"; return 1; }
    }
    return 1;
}

int main() {
    String[] a = Env::args();
    String me = program_name();
    if me == "xr" || me == "xaiorin" { return xr_main(a); }
    if a.len > 1 && (a[1] == "--version" || a[1] == "-V") { cout << "neuron " << neuron_version() << "\n"; return 0; }
    if a.len < 2 || a[1] == "--help" || a[1] == "-h" || a[1] == "help" {
        cout << "neuron: small AI models, trained and run on the phone, all in J2K\n";
        cout << "  neuron train DATA.txt -o MODEL.jw [-k 8] [-d 12] [-h 96] [-e 5] [-r 0.05]   learn a text\n";
        cout << "  neuron run MODEL.jw \"start\" [-n 200] [-t 0.8]       write on from a start\n";
        cout << "  neuron chat [MODEL.jw]                              talk with the model (no file: the assistant)\n";
        cout << "  neuron install MODEL.jw                             make it the assistant of this phone\n";
        cout << "  neuron eval MODEL.jw TEST.txt                       how many questions that were never learned are answered right\n";
        cout << "  neuron info MODEL.jw      neuron ask MODEL.jw X1 X2 ...   (a numeric model)\n";
        cout << "  neuron gpt train FILE|FOLDER [size=small|tiny|medium|large] [steps=2000] [minutes=0] [batch=8] [lr=0.003] [out=model.gpt] [resume=1]   a GPT (attention), byte by byte\n";
        cout << "  neuron gpt write MODEL \"start\" [n=200] [temp=0.8] [topk=20] [seed=1]      neuron gpt info MODEL\n";
        cout << "  neuron llama MODEL.gguf \"start\" [n=100] [temp=0.8] [topk=40] [topp=0.95]   run a GGUF model (Llama family)      neuron bench MODEL.gguf\n";
        return 0;
    }
    if a[1] == "gpt" {                                                    // the GPT of the library gpt: neuron gpt train | write | info
        String[] b = arr(a.len);
        for i in 1..a.len { b.push(a[i] + ""); }
        if b.len >= 2 && b[1] == "train" { return gpt_train(b); }
        if b.len >= 2 && b[1] == "write" { return gpt_write(b); }
        if b.len >= 2 && b[1] == "info" { return gpt_info(b); }
        cerr << "usage: neuron gpt train FILE|FOLDER [size=small] ... | neuron gpt write MODEL \"start\" | neuron gpt info MODEL  (neuron help)\n";
        return 1;
    }
    if a[1] == "llama" { return llama_run(a); }
    if a[1] == "bench" { return llama_bench(a); }
    if a[1] == "train" { return do_train(a); }
    if a[1] == "run" { return do_run(a); }
    if a[1] == "chat" { return do_chat(a); }
    if a[1] == "info" { return do_info(a); }
    if a[1] == "install" { return do_install(a); }
    if a[1] == "eval" { return do_eval(a); }
    if a[1] == "learn" { return do_learn(a); }
    if a[1] == "forget" { return do_forget(); }
    if a[1] == "where" { return do_where(); }
    if a[1] == "xr" { String[] b = arr(a.len); for i in 1..a.len { b.push(a[i]); } return xr_main(b); }
    if a[1] == "ask" { return do_ask(a); }
    cerr << "neuron: unknown command '" << a[1] << "' (neuron help)\n";
    return 2;
}
