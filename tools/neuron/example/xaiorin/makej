# xaiorin: the AI assistant of Jaric (project of the tool neuron).   jget tool neuron
#   makej train     learns the talk in data/chat.txt (about 15 minutes on a phone) and writes assistant.jw
#   makej chat      talks with the model;   makej install   makes it the assistant: then  xr "question"  and  xr start
[makej]
out = "_out"

[step.train]
run = "neuron train data/chat.txt -o assistant.jw -k 16 -d 10 -h 96 -e 14 -r 0.02"

[step.chat]
run = "neuron chat assistant.jw -t 0.2"

[step.install]
run = "neuron install assistant.jw"
