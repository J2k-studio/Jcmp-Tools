#import <stdlib>
#import <files>
#import <deflate>
#import <png>
using stdlib;
#import "jpeg"
#import "qr"
// cam 0.3.0 -- the camera of the phone for the programs of the terminal of the Jaric app: pictures and QR codes.   (license: MPL-2.0)
//   cam                                               the camera with two tabs (PHOTO, SCAN): point it at a code and a card shows what it is; touch a link to open it
//   cam photo [OUT.jpg] [--front] [--after SECONDS]   shows the camera; touch the round button to take the picture (or --after: it is taken by itself)
//   cam scan [--front] [--timeout 60] [--keep FILE]  shows the camera and reads QR codes until one is read; prints its text (exit 1: none)
//   cam flip                                          (while a camera is open in another tab) not needed: the button on the screen turns it
// It talks to the app with  ESC ] 7777 ; camera ; ... BEL  (the app shows the camera over the terminal and asks the phone for the permission).
// The pictures are JPEG files; the codes are read by the library qr inside this program (the JPEG of the picture is read by jpeg).

char g_tio[64];
bool g_raw;

void raw_on() {
    if g_raw || Sys::isatty(0) != 0 { return; }
    Sys::call(29, 0, 21505, (int)@g_tio, 0, 0, 0);
    char r[64];
    for i in 0..64 { r[i] = g_tio[i]; }
    r[12] = r[12] & 244;                                          // no signals, no line editing, no echo
    Sys::call(29, 0, 21506, (int)@r, 0, 0, 0);
    g_raw = true;
}

void raw_off() {
    if !g_raw { return; }
    Sys::call(29, 0, 21506, (int)@g_tio, 0, 0, 0);
    g_raw = false;
}

int read_byte(int wait_ms) {
    if !Input::ready(wait_ms) { return -1; }
    char b[2];
    int n = Sys::read(0, @b, 1);
    if n <= 0 { return -9; }
    return b[0] & 255;
}

// the next message of the app (the text between ESC ] 7777 ; and BEL), "" when none came in wait_ms; "#key" when the owner touched a key (Esc, q or Ctrl-C: "#quit")
String next_message(int wait_ms) {
    int c = read_byte(wait_ms);
    if c == -1 { return ""; }
    if c == -9 { return "#quit"; }
    if c == 3 || c == 'q' { return "#quit"; }
    if c != 27 { return ""; }
    int d = read_byte(40);
    if d < 0 { return "#quit"; }                                   // a lone Esc
    if d != ']' { return ""; }
    String m = "";
    int e = read_byte(200);
    while e >= 0 && e != 7 && e != 27 { m.push((char)e); e = read_byte(200); }
    if e == 27 { read_byte(40); }
    if m.starts_with("7777;") { return m.slice(5, m.len); }
    return "";
}

void send(String cmd) { cout << "\e]7777;camera;" << cmd << "\a"; }

String opt(String[] a, String name, String dflt) {
    for i in 0..a.len { if a[i] == name && i + 1 < a.len { return a[i + 1]; } }
    return dflt;
}

bool flag(String[] a, String name) {
    for i in 0..a.len { if a[i] == name { return true; } }
    return false;
}

int now_ms() { return Time::now_ms(); }

// the codes that were read are kept (the time and the text) in ~/.cache/jaric/cam-history.txt; cam history lists them, the newest first
String history_file() {
    switch Env::get("HOME") { Option::Some(h): { return h + "/.cache/jaric/cam-history.txt"; } Option::None: { } }
    return "/tmp/cam-history.txt";
}

void history_add(String text) {
    String file = history_file();
    Dir::make_all(Path::parent(file));
    String one = text.replace("\t", " ").replace("\n", " ");
    Fs::append_text(file, str(Time::now_ms() / 1000) + "\t" + one + "\n");
}

int do_history(String[] a) {
    int n = 20;
    for i in 2..a.len { if a[i] == "-n" && i + 1 < a.len { n = a[i + 1].to_int(); } }
    Result<String, Error> r = Fs::read_text(history_file());
    if r.is_err() { cout << "no codes were read yet (cam scan)\n"; return 0; }
    String[] ls = r.take().split("\n");
    int shown = 0;
    int i = ls.len - 1;
    while i >= 0 && shown < n {
        if ls[i].len > 0 {
            int tab = ls[i].find("\t");
            if tab > 0 { cout << ls[i].slice(tab + 1, ls[i].len) << "\n"; shown += 1; }
        }
        i -= 1;
    }
    if shown == 0 { cout << "no codes were read yet (cam scan)\n"; }
    return 0;
}

// where the photos go: u:/DCIM/Jaric (the gallery of the phone shows it); CAM_DIR changes it
String photo_dir() {
    Option<String> d = Env::get("CAM_DIR");
    if d.is_some() { String x = d.unwrap(); if !x.ends_with("/") { x = x + "/"; } return x; }
    return "/sdcard/DCIM/Jaric/";
}

String work_dir() {
    Option<String> t = Env::get("TMPDIR");
    if t.is_some() { return t.unwrap(); }
    Option<String> h = Env::get("HOME");
    if h.is_some() { return h.unwrap(); }
    return "/tmp";
}

void usage() {
    cout << "cam 0.3.0: the camera of the phone (the terminal of the Jaric app)\n";
    cout << "  cam photo [OUT.jpg] [--front] [--after SECONDS]    touch the round button (or wait --after seconds): the picture is saved\n";
    cout << "  cam scan [--front] [--timeout 60] [--keep FILE]    reads a QR code with the camera and prints its text\n";
    cout << "  cam history [-n N]                                 the codes that were read, the newest first\n";
    cout << "  In the camera: tap = focus, double tap = zoom, pinch = zoom, the volume keys = the shutter, the clock = a timer, # = a grid\n";
    cout << "  Esc, q or Ctrl-C closes the camera; the cross on the screen too\n";
}

// waits for the camera to be ready: true; false with the reason printed
bool open_camera(bool front, String path, String megadots, String modes) {
    String side = "back";
    if front { side = "front"; }
    send("open;" + side + ";" + path + ";" + megadots + ";" + modes);
    int t0 = now_ms();
    while now_ms() - t0 < 20000 {
        String m = next_message(300);
        if m.len == 0 { continue; }
        if m == "#quit" { return false; }
        if m.starts_with("camera-ready") { return true; }
        if m.starts_with("camera-error") { cerr << "cam: " << m.slice(13, m.len) << "\n"; return false; }
        if m == "camera-closed" { return false; }
    }
    cerr << "cam: the app did not answer (is this the terminal of the Jaric app?)\n";
    return false;
}

// the text of the QR code in a picture file (JPEG or PNG): ok = false when the file is no picture or has no code
String scan_file(String path, bool^ ok) {
    ok[0] = false;
    Result<String, Error> rd = Fs::read_bytes(path);
    if rd.is_err() { return ""; }
    String bytes = rd.take();
    bool pok = false;
    Image im;
    im.w = 0; im.h = 0; im.px = "";
    if bytes.len > 4 && (bytes[0] & 255) == 255 && (bytes[1] & 255) == 216 { im = Jpeg::decode(bytes, @pok); }
    else { im = Png::decode(bytes, @pok); }
    if !pok { return ""; }
    bool good = false;
    String text = Qr::scan(im.px, im.w, im.h, @good);
    ok[0] = good;
    return text;
}

// the camera with both tabs: the app shows the card of a code that was read; the person touches what to do (open, copy, add to authj, use)
int interactive(bool front) {
    String folder = photo_dir();
    String tmp = work_dir() + "/cam-scan.jpg";
    raw_on();
    if !open_camera(front, folder, "2", "both") { raw_off(); return 1; }
    bool scan_mode = true;
    bool paused = false;
    bool waiting = false;
    int next_shot = now_ms() + 600;
    String last = "";
    int last_at = 0;
    int rc = 0;
    String out_text = "";
    String add_text = "";
    bool done = false;
    while !done {
        if scan_mode && !paused && !waiting && now_ms() >= next_shot { send("shot;" + tmp); waiting = true; }
        String m = next_message(120);
        if m.len == 0 { continue; }
        if m == "#quit" || m == "camera-closed" { done = true; rc = 0; }
        else if m.starts_with("camera-error") { cerr << "cam: " << m.slice(13, m.len) << "\n"; rc = 1; done = true; }
        else if m.starts_with("camera-mode;") { scan_mode = m == "camera-mode;scan"; if scan_mode { paused = false; } }
        else if m == "camera-resume" { paused = false; next_shot = now_ms() + 300; }
        else if m == "camera-busy" { waiting = false; next_shot = now_ms() + 700; }
        else if m.starts_with("camera-picked;") {
            // a picture of the gallery: its code is read like a code in front of the camera
            String pfile = m.slice(14, m.len);
            bool pgood = false;
            String ptext = scan_file(pfile, @pgood);
            Sys::unlink(pfile.c());
            if pgood { last = ptext + ""; last_at = now_ms(); paused = true; history_add(ptext); send("result;" + Base64::encode(ptext)); }
            else { send("toast;No QR code was read in this picture"); }
        }
        else if m.starts_with("camera-shot") {
            String[] p = m.split(";");
            if p.len > 1 && p[1] == tmp {
                waiting = false;
                Result<String, Error> rd = Fs::read_bytes(tmp);
                if rd.is_ok() {
                    String bytes = rd.take();
                    bool pok = false;
                    Image im = Jpeg::decode(bytes, @pok);
                    if pok {
                        bool good = false;
                        String text = Qr::scan(im.px, im.w, im.h, @good);
                        if good && (text != last || now_ms() - last_at > 4000) {
                            last = text + "";
                            last_at = now_ms();
                            paused = true;
                            history_add(text);
                            send("result;" + Base64::encode(text));
                        }
                    }
                }
                next_shot = now_ms() + 250;
            } else if p.len > 1 {
                cout << "photo: " << p[1] << "\n";
            }
        }
        else if m.starts_with("camera-action;") {
            String[] p = m.split(";");
            if p.len >= 3 {
                Result<String, Error> dec = Base64::decode(p[2]);
                if dec.is_ok() {
                    String text = dec.take();
                    if p[1] == "use" { out_text = text + ""; done = true; }
                    else if p[1] == "add" { add_text = text + ""; done = true; }
                }
            }
        }
    }
    send("close");
    raw_off();
    if add_text.len > 0 {
        String[] aargs = arr(2);
        aargs.push("add-uri");
        aargs.push(add_text + "");
        Result<int, Error> pr = Proc::run("authj", aargs);
        if pr.is_err() { cerr << "cam: authj is not installed (jc install authj)\n"; return 1; }
        return pr.take();
    }
    if out_text.len > 0 { cout << out_text << "\n"; }
    if unlink_ok(tmp) { }
    return rc;
}

bool unlink_ok(String p) { return Sys::unlink(p.c()) == 0; }

int main() {
    String[] a = Env::args();
    if a.len >= 2 && (a[1] == "--version" || a[1] == "-V") { cout << "cam 0.3.0\n"; return 0; }
    if a.len >= 2 && (a[1] == "help" || a[1] == "--help" || a[1] == "-h") { usage(); return 0; }
    String cmd = "ui";
    if a.len >= 2 { cmd = a[1]; }
    bool front = flag(a, "--front");
    if a.len >= 2 && a[1] == "--front" { cmd = "ui"; }
    if cmd == "history" { return do_history(a); }
    if Sys::isatty(0) != 0 { cerr << "cam: it needs the terminal of the Jaric app\n"; return 1; }
    if cmd == "ui" || cmd == "camera" {
        return interactive(front);
    }
    if cmd == "photo" {
        String out = "";
        if a.len > 2 && a[2].len > 0 && a[2][0] != '-' { out = a[2] + ""; }
        if out.len == 0 { out = photo_dir() + "photo-" + str(now_ms() / 1000) + ".jpg"; }
        raw_on();
        if !open_camera(front, out, "12", "photo") { raw_off(); return 1; }
        String after = opt(a, "--after", "");
        int shot_at = 0 - 1;
        if after.len > 0 { shot_at = now_ms() + (int)(after.to_double() * 1000.0); }
        int rc = 1;
        bool done = false;
        while !done {
            if shot_at > 0 && now_ms() >= shot_at { send("shot;" + out); shot_at = 0 - 1; }
            String m = next_message(200);
            if m.len == 0 { continue; }
            if m == "#quit" || m == "camera-closed" { done = true; }
            if m.starts_with("camera-shot") {
                String[] p = m.split(";");
                cout << p[1] << "\n";
                rc = 0; done = true;
            }
            if m.starts_with("camera-error") { cerr << "cam: " << m.slice(13, m.len) << "\n"; done = true; }
        }
        send("close");
        raw_off();
        return rc;
    }
    if cmd == "scan" {
        String keep = opt(a, "--keep", "");
        String tmp = keep;
        if tmp.len == 0 { tmp = work_dir() + "/cam-scan.jpg"; }
        String tos = opt(a, "--timeout", "60");
        int deadline = now_ms() + tos.to_int() * 1000;
        raw_on();
        if !open_camera(front, tmp, "2", "scan") { raw_off(); return 1; }
        int rc = 1;
        bool done = false;
        bool waiting = false;                         // a picture was asked for and has not come yet
        int next_shot = now_ms() + 800;
        String found = "";
        while !done {
            if now_ms() > deadline { cerr << "cam: no QR code was read in " << tos << " seconds\n"; break; }
            if !waiting && now_ms() >= next_shot { send("shot;" + tmp); waiting = true; }
            String m = next_message(150);
            if m.len == 0 { continue; }
            if m == "#quit" || m == "camera-closed" { break; }
            if m.starts_with("camera-error") { cerr << "cam: " << m.slice(13, m.len) << "\n"; break; }
            if m.starts_with("camera-shot") {
                waiting = false;
                Result<String, Error> rd = Fs::read_bytes(tmp);
                if rd.is_ok() {
                    String bytes = rd.take();
                    bool pok = false;
                    Image im = Jpeg::decode(bytes, @pok);
                    if pok {
                        bool good = false;
                        String text = Qr::scan(im.px, im.w, im.h, @good);
                        if good { found = text + ""; rc = 0; done = true; }
                    }
                }
                next_shot = now_ms() + 300;
            }
        }
        send("close");
        raw_off();
        if rc == 0 { history_add(found); cout << found << "\n"; }
        if keep.len == 0 { Sys::unlink(tmp.c()); }
        return rc;
    }
    usage();
    return 1;
}
