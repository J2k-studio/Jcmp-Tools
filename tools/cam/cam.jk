#import <stdlib>
#import <files>
#import <deflate>
#import <png>
using stdlib;
#import "jpeg"
#import "qr"
// cam 0.1.0 -- the camera of the phone for the programs of the terminal of the Jaric app: pictures and QR codes.   (license: MPL-2.0)
//   cam photo [OUT.jpg] [--front] [--after SECONDS]   shows the camera; touch the round button to take the picture (or --after: it is taken by itself)
//   cam scan [--front] [--timeout 60] [--keep FILE]  shows the camera and reads QR codes until one is read; prints its text (exit 1: none)
//   cam flip                                          (while a camera is open in another tab) not needed: the button on the screen turns it
// It talks to the app with  ESC ] 7777 ; camera ; ... BEL  (the app shows the camera over the terminal and asks the phone for the permission).
// The pictures are JPEG files; the codes are read by the library qr inside this program (the JPEG of the picture is read by jpeg).

char g_tio[64];
bool g_raw;

void raw_on() {
    if g_raw || Sys::isatty(0) != 0 { return; }
    Sys::call(29, 0, 21505, (int)@g_tio, 0, 0, 0);
    char r[64];
    for i in 0..64 { r[i] = g_tio[i]; }
    r[12] = r[12] & 244;                                          // no signals, no line editing, no echo
    Sys::call(29, 0, 21506, (int)@r, 0, 0, 0);
    g_raw = true;
}

void raw_off() {
    if !g_raw { return; }
    Sys::call(29, 0, 21506, (int)@g_tio, 0, 0, 0);
    g_raw = false;
}

int read_byte(int wait_ms) {
    if !Input::ready(wait_ms) { return -1; }
    char b[2];
    int n = Sys::read(0, @b, 1);
    if n <= 0 { return -9; }
    return b[0] & 255;
}

// the next message of the app (the text between ESC ] 7777 ; and BEL), "" when none came in wait_ms; "#key" when the owner touched a key (Esc, q or Ctrl-C: "#quit")
String next_message(int wait_ms) {
    int c = read_byte(wait_ms);
    if c == -1 { return ""; }
    if c == -9 { return "#quit"; }
    if c == 3 || c == 'q' { return "#quit"; }
    if c != 27 { return ""; }
    int d = read_byte(40);
    if d < 0 { return "#quit"; }                                   // a lone Esc
    if d != ']' { return ""; }
    String m = "";
    int e = read_byte(200);
    while e >= 0 && e != 7 && e != 27 { m.push((char)e); e = read_byte(200); }
    if e == 27 { read_byte(40); }
    if m.starts_with("7777;") { return m.slice(5, m.len); }
    return "";
}

void send(String cmd) { cout << "\e]7777;camera;" << cmd << "\a"; }

String opt(String[] a, String name, String dflt) {
    for i in 0..a.len { if a[i] == name && i + 1 < a.len { return a[i + 1]; } }
    return dflt;
}

bool flag(String[] a, String name) {
    for i in 0..a.len { if a[i] == name { return true; } }
    return false;
}

int now_ms() { return Time::now_ms(); }

String work_dir() {
    Option<String> t = Env::get("TMPDIR");
    if t.is_some() { return t.unwrap(); }
    Option<String> h = Env::get("HOME");
    if h.is_some() { return h.unwrap(); }
    return "/tmp";
}

void usage() {
    cout << "cam 0.1.0: the camera of the phone (the terminal of the Jaric app)\n";
    cout << "  cam photo [OUT.jpg] [--front] [--after SECONDS]    touch the round button (or wait --after seconds): the picture is saved\n";
    cout << "  cam scan [--front] [--timeout 60] [--keep FILE]    reads a QR code with the camera and prints its text\n";
    cout << "  Esc, q or Ctrl-C closes the camera; the cross on the screen too\n";
}

// waits for the camera to be ready: true; false with the reason printed
bool open_camera(bool front, String path, String megadots) {
    String side = "back";
    if front { side = "front"; }
    send("open;" + side + ";" + path + ";" + megadots);
    int t0 = now_ms();
    while now_ms() - t0 < 20000 {
        String m = next_message(300);
        if m.len == 0 { continue; }
        if m == "#quit" { return false; }
        if m.starts_with("camera-ready") { return true; }
        if m.starts_with("camera-error") { cerr << "cam: " << m.slice(13, m.len) << "\n"; return false; }
        if m == "camera-closed" { return false; }
    }
    cerr << "cam: the app did not answer (is this the terminal of the Jaric app?)\n";
    return false;
}

int main() {
    String[] a = Env::args();
    if a.len >= 2 && (a[1] == "--version" || a[1] == "-V") { cout << "cam 0.1.0\n"; return 0; }
    if a.len < 2 || a[1] == "help" || a[1] == "--help" || a[1] == "-h" { usage(); return 0; }
    String cmd = a[1];
    bool front = flag(a, "--front");
    if Sys::isatty(0) != 0 { cerr << "cam: it needs the terminal of the Jaric app\n"; return 1; }
    if cmd == "photo" {
        String out = "";
        if a.len > 2 && a[2].len > 0 && a[2][0] != '-' { out = a[2] + ""; }
        if out.len == 0 { out = work_dir() + "/photo-" + str(now_ms() / 1000) + ".jpg"; }
        raw_on();
        if !open_camera(front, out, "12") { raw_off(); return 1; }
        String after = opt(a, "--after", "");
        int shot_at = 0 - 1;
        if after.len > 0 { shot_at = now_ms() + (int)(after.to_double() * 1000.0); }
        int rc = 1;
        bool done = false;
        while !done {
            if shot_at > 0 && now_ms() >= shot_at { send("shot;" + out); shot_at = 0 - 1; }
            String m = next_message(200);
            if m.len == 0 { continue; }
            if m == "#quit" || m == "camera-closed" { done = true; }
            if m.starts_with("camera-shot") {
                String[] p = m.split(";");
                cout << p[1] << "\n";
                rc = 0; done = true;
            }
            if m.starts_with("camera-error") { cerr << "cam: " << m.slice(13, m.len) << "\n"; done = true; }
        }
        send("close");
        raw_off();
        return rc;
    }
    if cmd == "scan" {
        String keep = opt(a, "--keep", "");
        String tmp = keep;
        if tmp.len == 0 { tmp = work_dir() + "/cam-scan.jpg"; }
        String tos = opt(a, "--timeout", "60");
        int deadline = now_ms() + tos.to_int() * 1000;
        raw_on();
        if !open_camera(front, tmp, "2") { raw_off(); return 1; }
        int rc = 1;
        bool done = false;
        bool waiting = false;                         // a picture was asked for and has not come yet
        int next_shot = now_ms() + 800;
        String found = "";
        while !done {
            if now_ms() > deadline { cerr << "cam: no QR code was read in " << tos << " seconds\n"; break; }
            if !waiting && now_ms() >= next_shot { send("shot;" + tmp); waiting = true; }
            String m = next_message(150);
            if m.len == 0 { continue; }
            if m == "#quit" || m == "camera-closed" { break; }
            if m.starts_with("camera-error") { cerr << "cam: " << m.slice(13, m.len) << "\n"; break; }
            if m.starts_with("camera-shot") {
                waiting = false;
                Result<String, Error> rd = Fs::read_bytes(tmp);
                if rd.is_ok() {
                    String bytes = rd.take();
                    bool pok = false;
                    Image im = Jpeg::decode(bytes, @pok);
                    if pok {
                        bool good = false;
                        String text = Qr::scan(im.px, im.w, im.h, @good);
                        if good { found = text + ""; rc = 0; done = true; }
                    }
                }
                next_shot = now_ms() + 300;
            }
        }
        send("close");
        raw_off();
        if rc == 0 { cout << found << "\n"; }
        if keep.len == 0 { Sys::unlink(tmp.c()); }
        return rc;
    }
    usage();
    return 1;
}
