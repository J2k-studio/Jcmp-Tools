#!library
// F2: the start of Jaric OS. A dark screen; a ring of light grows out of the dark, then "Jaric OS" appears, then "powered by Jaric" (like the start screen of a phone).
// The kernel draws everything itself (no files): a ring with a glow (integer maths on the square of the distance), letters from a 5x7 font (one letter = 35 bits),
// and shows each frame with FLUSH. The pictures are the same size as the screen of F1 (360 x 640, phone mode).
int W;
int H;
char^ fbm;

naked void start() {
    x28 = 0x4010_0000;
    call kmain;
}

void putc(int c) {
    char^ uart = (char^)0x09000000;
    uart[0] = (char)c;
}

void say(int w) {
    for k in 0..8 {
        int c = (w >> (k * 8)) & 255;
        if c == 0 { return; }
        putc(c);
    }
}

// the 5x7 letters: 35 bits, the first row in the highest bits
int glyph(int c) {
    if c == 74 { return 0x1c4210a4c; }
    if c == 97 { return 0xe0be2f; }
    if c == 114 { return 0x16cc210; }
    if c == 105 { return 0x100c2108e; }
    if c == 99 { return 0xe8422e; }
    if c == 79 { return 0x3a318c62e; }
    if c == 83 { return 0x3e107043e; }
    if c == 112 { return 0x1e8fa10; }
    if c == 111 { return 0xe8c62e; }
    if c == 119 { return 0x118d6aa; }
    if c == 101 { return 0xe8fe0e; }
    if c == 100 { return 0x42d9c66d; }
    if c == 98 { return 0x4216cc736; }
    if c == 121 { return 0x118bc2e; }
    return 0;
}

void pixel(int x, int y, int r, int g, int b) {
    if r > 255 { r = 255; }
    if g > 255 { g = 255; }
    if b > 255 { b = 255; }
    char^ p = fbm + (y * W + x) * 4;
    p[0] = (char)b;
    p[1] = (char)g;
    p[2] = (char)r;
    p[3] = 0;
}

// the light: a ring and a glow round it, at the middle (cx, cy); level 0..255
void logo(int cx, int cy, int level) {
    for y in 0..181 {
        for x in 0..181 {
            int dx = x - 90;
            int dy = y - 90;
            int d2 = dx * dx + dy * dy;
            int v = 0;
            if d2 < 2116 { v = 12; }
            else if d2 <= 3600 { v = 255; }
            else if d2 < 8100 { v = ((8100 - d2) * 110) / 4500; }
            v = (v * level) / 255;
            pixel(cx - 90 + x, cy - 90 + y, 8 + (v * 90) / 255, 10 + (v * 170) / 255, 20 + v);
        }
    }
}

// eight letters (a number: the first letter in the lowest byte) at (x, y), each dot of the font is scale x scale pixels; level 0..255 of white
void text(int word, int x, int y, int scale, int level) {
    for k in 0..8 {
        int c = (word >> (k * 8)) & 255;
        if c == 0 { return; }
        int gl = glyph(c);
        for row in 0..7 {
            for col in 0..5 {
                int on = (gl >> (34 - (row * 5 + col))) & 1;
                int v = 0;
                if on == 1 { v = level; }
                for sy in 0..scale {
                    for sx in 0..scale {
                        pixel(x + (k * 6 + col) * scale + sx, y + row * scale + sy, 8 + v, 10 + v, 20 + v);
                    }
                }
            }
        }
    }
}

void kmain() {
    W = 360;
    H = 640;
    fbm = (char^)0x41000000;
    int^ fb = (int^)0x0B000000;
    fb[0] = 0x41000000;
    fb[1] = W;
    fb[2] = H;
    for i in 0..(W * H) { pixel(i % 360, i / 360, 8, 10, 20); }
    for t in 0..101 {
        int a = (t * 255) / 40;
        if a > 255 { a = 255; }
        if t <= 40 { logo(180, 250, a); }
        int b = ((t - 35) * 255) / 30;
        if b < 0 { b = 0; }
        if b > 255 { b = 255; }
        if b > 0 { text(0x534f20636972614a, 84, 380, 4, b); }
        int c = ((t - 65) * 255) / 30;
        if c < 0 { c = 0; }
        if c > 255 { c = 255; }
        if c > 0 {
            int dim = (c * 150) / 255;
            text(0x2064657265776f70, 84, 480, 2, dim);
            text(0x636972614a207962, 180, 480, 2, dim);
        }
        fb[3] = 1;
    }
    say(0x6b6f203246); putc(10);
    char^ stop = (char^)0x09100000;
    stop[0] = 0;
    while true { }
}
