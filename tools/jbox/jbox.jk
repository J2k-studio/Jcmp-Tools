// jbox: the small commands of Jaric in ONE program (like busybox). `jbox ls -l`, or a link/copy named ls.
// jsh runs `jbox NAME args` for the commands it does not find in PATH. Only the library and Sys:: calls are used.
#import <stdlib>

int fail(String app, String msg) {
    cerr << app << ": " << msg << "\n";
    return 1;
}

String stdin_all() {
    String r = "";
    char b[4097];
    int n = Sys::read(0, @b, 4096);
    while n > 0 {
        b[n] = 0;
        r.append((char^)@b);
        n = Sys::read(0, @b, 4096);
    }
    return r;
}

// the text of a file, or of the standard input when the name is "-" or missing
String load(String app, String path, int^ rc) {
    if path == "-" { return stdin_all(); }
    String out = "";
    Result<String, Error> r = Fs::read_text(path);
    switch r {
        Result::Ok(t): out = t;
        Result::Err(e): rc[0] = fail(app, e.message);
    }
    return out;
}

// the lines of a text without the empty piece after the last newline
String[] lines_of(String text) {
    String[] parts = text.split("\n");
    String[] r = arr(parts.len + 1);
    for i in 0..parts.len {
        if i == parts.len - 1 && parts[i].len == 0 { continue; }
        r.push(parts[i]);
    }
    return r;
}

bool is_flag(String a) { return a.len > 1 && a[0] == 45; }
bool has_flag(String[] a, char f) {
    for i in 1..a.len {
        if is_flag(a[i]) {
            for k in 1..a[i].len { if a[i][k] == f { return true; } }
        }
    }
    return false;
}
// the arguments that are not flags (and not the values after -n)
// a command that reads files, called without one while the input is the keyboard, would wait for typing for ever: say what is needed
bool needs_file(String app, String[] ops) {
    if ops.len > 0 || Sys::isatty(0) != 0 { return false; }
    cerr << app << ": a file name is needed (or text piped in: cat file | " << app << ")\n";
    return true;
}

String[] operands(String[] a, bool valued) {
    String[] r = arr(a.len + 1);
    int i = 1;
    while i < a.len {
        if valued && a[i] == "-n" { i += 2; continue; }
        if !is_flag(a[i]) { r.push(a[i]); }
        i += 1;
    }
    return r;
}
// the value after -n, or the default
int count_of(String[] a, int dflt) {
    for i in 1..a.len - 1 {
        if a[i] == "-n" { return a[i + 1].to_int(); }
    }
    return dflt;
}

// ---------------------------------------------------------------- the commands
int do_ls(String[] a) {
    bool all = has_flag(a, 'a');
    bool lng = has_flag(a, 'l');
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("."); }
    int rc = 0;
    for p in 0..ops.len {
        String[] names = arr(4);
        String base = ops[p];
        if Dir::exists(base) {
            Result<String[], Error> r = Dir::list(base);
            if r.is_ok() { names = r.take(); }
            else { rc = fail("dir", base + ": cannot read the folder"); }
            if ops.len > 1 { cout << base << ":\n"; }
        } else if Fs::exists(base) {
            names.push(base);
            base = "";
        } else { rc = fail("dir", base + ": no such file or folder"); }
        for i in 0..names.len {
            String n = names[i];
            if !all && n.len > 0 && n[0] == 46 { continue; }
            String full = n;
            if base.len > 0 { full = Path::join(base, n); }
            if lng {
                if Dir::exists(full) { cout << "d        - " << n << "/\n"; }
                else {
                    int sz = 0;
                    Result<int, Error> s = Fs::size(full);
                    switch s {
                        Result::Ok(v): sz = v;
                        Result::Err(e): sz = 0;
                    }
                    String num = str(sz);
                    cout << "- " << " ".repeat(8 - num.len) << num << " " << n << "\n";
                }
            } else {
                if Dir::exists(full) { cout << n << "/\n"; } else { cout << n << "\n"; }
            }
        }
    }
    return rc;
}

int do_cat(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("-"); }
    int rc = 0;
    for i in 0..ops.len { cout << load("cat", ops[i], @rc); }
    return rc;
}

int do_head_tail(String[] a, bool head) {
    int n = count_of(a, 10);
    String[] ops = operands(a, true);
    if needs_file(Path::name(a[0]), ops) { return 2; }
    if ops.len == 0 { ops.push("-"); }
    int rc = 0;
    for p in 0..ops.len {
        String who = "tail";
        if head { who = "head"; }
        String[] ls = lines_of(load(who, ops[p], @rc));
        int first = 0;
        int last = ls.len;
        if head { if n < last { last = n; } } else { if ls.len > n { first = ls.len - n; } }
        for i in first..last { cout << ls[i] << "\n"; }
    }
    return rc;
}

int do_wc(String[] a) {
    bool l = has_flag(a, 'l');
    bool w = has_flag(a, 'w');
    bool c = has_flag(a, 'c');
    if !l && !w && !c { l = true; w = true; c = true; }
    String[] ops = operands(a, false);
    if needs_file("wc", ops) { return 2; }
    if ops.len == 0 { ops.push("-"); }
    int rc = 0;
    for p in 0..ops.len {
        String t = load("wc", ops[p], @rc);
        int nl = 0;
        int nw = 0;
        bool inw = false;
        for i in 0..t.len {
            char ch = t[i];
            if ch == 10 { nl += 1; }
            bool sp = ch == 32 || ch == 10 || ch == 9 || ch == 13;
            if sp { inw = false; } else { if !inw { nw += 1; } inw = true; }
        }
        if l { cout << nl << " "; }
        if w { cout << nw << " "; }
        if c { cout << t.len << " "; }
        if ops[p] != "-" { cout << ops[p]; }
        cout << "\n";
    }
    return rc;
}

// nl [FILE]: the lines with numbers in front (empty lines are not numbered, like nl);   tac [FILE]: the lines from the last to the first
int do_nl(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("-"); }
    int rc = 0;
    int n = 0;
    for p in 0..ops.len {
        String t = load("nl", ops[p], @rc);
        String[] lines = t.split("\n");
        int last = lines.len;
        if last > 0 && lines[last - 1].len == 0 { last -= 1; }
        for i in 0..last {
            if lines[i].len == 0 { cout << "       \n"; continue; }
            n += 1;
            String num = str(n);
            for k in num.len..6 { cout << " "; }
            cout << num << "  " << lines[i] << "\n";
        }
    }
    return rc;
}

int do_tac(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("-"); }
    int rc = 0;
    for p in 0..ops.len {
        String t = load("tac", ops[p], @rc);
        String[] lines = t.split("\n");
        int last = lines.len;
        if last > 0 && lines[last - 1].len == 0 { last -= 1; }
        int i = last - 1;
        while i >= 0 { cout << lines[i] << "\n"; i -= 1; }
    }
    return rc;
}

int do_mkdir(String[] a) {
    bool deep = has_flag(a, 'p');
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("mkdir", "a folder name is needed"); }
    int rc = 0;
    for i in 0..ops.len {
        Result<int, Error> r = Dir::make(ops[i]);
        if deep { r = Dir::make_all(ops[i]); }
        switch r {
            Result::Ok(v): rc = rc;
            Result::Err(e): rc = fail("mkdir", ops[i] + ": " + e.message);
        }
    }
    return rc;
}

int do_rm(String[] a) {
    bool force = has_flag(a, 'f');
    String[] ops = operands(a, false);
    if ops.len == 0 && !force { return fail("rm", "a file name is needed"); }
    int rc = 0;
    for i in 0..ops.len {
        Result<int, Error> r = Fs::remove(ops[i]);
        if Dir::exists(ops[i]) { r = Dir::remove(ops[i]); }
        switch r {
            Result::Ok(v): rc = rc;
            Result::Err(e): if !force { rc = fail("rm", ops[i] + ": " + e.message); }
        }
    }
    return rc;
}

int do_rmdir(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("rmdir", "a folder name is needed"); }
    int rc = 0;
    for i in 0..ops.len {
        Result<int, Error> r = Dir::remove(ops[i]);
        switch r {
            Result::Ok(v): rc = rc;
            Result::Err(e): rc = fail("rmdir", e.message);
        }
    }
    return rc;
}

int do_touch(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("touch", "a file name is needed"); }
    int rc = 0;
    for i in 0..ops.len {
        if !Fs::exists(ops[i]) {
            Result<int, Error> r = Fs::write_text(ops[i], "");
            switch r {
                Result::Ok(v): rc = rc;
                Result::Err(e): rc = fail("touch", ops[i] + ": " + e.message);
            }
        }
    }
    return rc;
}

int do_cp(String[] a) {
    String[] ops = operands(a, false);
    if ops.len != 2 { return fail("cp", "usage: cp FROM TO"); }
    int rc = 0;
    String t = load("cp", ops[0], @rc);
    if rc != 0 { return rc; }
    String to = ops[1];
    if Dir::exists(to) { to = Path::join(to, Path::name(ops[0])); }
    Result<int, Error> r = Fs::write_text(to, t);
    switch r {
        Result::Ok(v): rc = rc;
        Result::Err(e): rc = fail("cp", to + ": " + e.message);
    }
    return rc;
}

int do_mv(String[] a) {
    String[] ops = operands(a, false);
    if ops.len != 2 { return fail("mv", "usage: mv FROM TO"); }
    String to = ops[1];
    if Dir::exists(to) { to = Path::join(to, Path::name(ops[0])); }
    int rc = 0;
    Result<int, Error> r = Fs::rename(ops[0], to);
    switch r {
        Result::Ok(v): rc = rc;
        Result::Err(e): rc = fail("mv", ops[0] + ": " + e.message);
    }
    return rc;
}

int do_grep(String[] a) {
    bool number = has_flag(a, 'n');
    bool invert = has_flag(a, 'v');
    bool icase = has_flag(a, 'i');
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("grep", "usage: grep [-n -v -i] PATTERN [FILE]"); }
    String pat = ops[0];
    if icase { pat = pat.lower(); }
    int rc = 1;
    int errs = 0;
    int nfiles = ops.len - 1;
    if ops.len == 1 && Sys::isatty(0) == 0 { cerr << "grep: a file name is needed (or text piped in)\n"; return 2; }
    if nfiles == 0 { ops.push("-"); nfiles = 1; }
    for p in 1..ops.len {
        String[] ls = lines_of(load("grep", ops[p], @errs));
        for i in 0..ls.len {
            String line = ls[i];
            if icase { line = line.lower(); }
            bool hit = Regex::find(pat, line) >= 0;
            if hit != invert {
                rc = 0;
                if nfiles > 1 { cout << ops[p] << ":"; }
                if number { cout << i + 1 << ":"; }
                cout << ls[i] << "\n";
            }
        }
    }
    if errs != 0 { return 2; }
    return rc;
}

int do_sort(String[] a) {
    String[] ops = operands(a, false);
    if needs_file("sort", ops) { return 2; }
    if ops.len == 0 { ops.push("-"); }
    int rc = 0;
    String[] all = arr(16);
    for p in 0..ops.len {
        String[] ls = lines_of(load("sort", ops[p], @rc));
        for i in 0..ls.len { all.push(ls[i]); }
    }
    all.sort();
    bool rev = has_flag(a, 'r');
    if rev { for i in 0..all.len { cout << all[all.len - 1 - i] << "\n"; } }
    else { for i in 0..all.len { cout << all[i] << "\n"; } }
    return rc;
}

int do_uniq(String[] a) {
    String[] ops = operands(a, false);
    if needs_file("uniq", ops) { return 2; }
    if ops.len == 0 { ops.push("-"); }
    int rc = 0;
    String[] ls = lines_of(load("uniq", ops[0], @rc));
    for i in 0..ls.len {
        if i == 0 || ls[i] != ls[i - 1] { cout << ls[i] << "\n"; }
    }
    return rc;
}

int do_tee(String[] a) {
    bool append = has_flag(a, 'a');
    String[] ops = operands(a, false);
    String t = stdin_all();
    cout << t;
    int rc = 0;
    for i in 0..ops.len {
        Result<int, Error> r = Fs::write_text(ops[i], t);
        if append { r = Fs::append_text(ops[i], t); }
        switch r {
            Result::Ok(v): rc = rc;
            Result::Err(e): rc = fail("tee", ops[i] + ": " + e.message);
        }
    }
    return rc;
}

int do_seq(String[] a) {
    String[] ops = operands(a, false);
    int lo = 1;
    int hi = 0;
    if ops.len == 1 { hi = ops[0].to_int(); }
    else if ops.len >= 2 { lo = ops[0].to_int(); hi = ops[1].to_int(); }
    else { return fail("seq", "usage: seq [FIRST] LAST"); }
    for i in lo..hi + 1 { cout << i << "\n"; }
    return 0;
}

int do_basename(String[] a) {
    if a.len < 2 { return fail("basename", "a path is needed"); }
    cout << Path::name(a[1]) << "\n";
    return 0;
}

int do_dirname(String[] a) {
    if a.len < 2 { return fail("dirname", "a path is needed"); }
    cout << Path::parent(a[1]) << "\n";
    return 0;
}

int do_sleep(String[] a) {
    if a.len < 2 { return fail("sleep", "seconds are needed"); }
    Time::sleep_ms(a[1].to_int() * 1000);
    return 0;
}

int do_clear() {
    cout << (char)27 << "[2J" << (char)27 << "[H";
    return 0;
}

int do_env() {
    int ne = 0;
    while Sys::arg(Sys::argc() + 1 + ne) != null {
        String e = "";
        e.append((char^)Sys::arg(Sys::argc() + 1 + ne));
        cout << e << "\n";
        ne += 1;
    }
    return 0;
}

int do_kill(String[] a) {
    int sig = 15;
    int rc = 0;
    int count = 0;
    for i in 1..a.len {
        String w = a[i];
        if w.len > 1 && w[0] == '-' {
            String n = w.slice(1, w.len);
            if is_digits(n) { sig = n.to_int(); }
            else if n == "KILL" { sig = 9; }
            else if n == "TERM" { sig = 15; }
            else if n == "INT" { sig = 2; }
            else if n == "HUP" { sig = 1; }
            else if n == "STOP" { sig = 19; }
            else if n == "CONT" { sig = 18; }
            else { return fail("kill", "unknown signal " + n); }
        } else if is_digits(w) {
            count += 1;
            if Sys::call(129, w.to_int(), sig, 0, 0, 0, 0) < 0 { rc = fail("kill", w + ": no such process (or not yours)"); }
        } else { return fail("kill", "usage: kill [-9] PID ..."); }
    }
    if count == 0 { return fail("kill", "usage: kill [-9] PID ..."); }
    return rc;
}

bool is_digits(String s) {
    if s.len == 0 { return false; }
    for i in 0..s.len { if s[i] < '0' || s[i] > '9' { return false; } }
    return true;
}

int do_help() {
    cout << "jbox commands: dir tree find date du stat xargs sed less ln chmod cut tr diff cat head tail wc nl tac mkdir rmdir rm touch cp mv grep sort uniq tee seq basename dirname sleep clear env kill true false\n";
    cout << "flags: dir -a -l   tree -a -L N   find -name P -type f|d -maxdepth N   ln -s   cut -d X -f N   tr -d   head/tail -n N   wc -l -w -c   mkdir -p   rm -f   grep -n -v -i   sort -r   tee -a\n";
    return 0;
}

// jbox --install [DIR]: a link in DIR for every command (DIR = the folder of jbox), so that any program or shell finds them in the PATH
// tree [-a] [-L N] [FOLDER]: the folders and files under a folder, drawn as a tree (the root first); -a also the names that start with a dot
int tree_walk(String dir, String prefix, bool all, int depth, int maxd, int^ nd, int^ nf) {
    if depth >= maxd { return 0; }
    Result<String[], Error> r = Dir::list(dir);
    if !r.is_ok() { return 1; }
    String[] names = r.take();
    names.sort();
    String[] shown = arr(names.len + 1);
    for i in 0..names.len {
        if !all && names[i].len > 0 && names[i][0] == '.' { continue; }
        shown.push(names[i] + "");
    }
    for i in 0..shown.len {
        bool last = i == shown.len - 1;
        String full = Path::join(dir, shown[i]);
        bool isdir = Dir::exists(full);
        String mark = "|-- ";
        if last { mark = "`-- "; }
        if isdir { cout << prefix << mark << shown[i] << "/\n"; nd[0] += 1; }
        else { cout << prefix << mark << shown[i] << "\n"; nf[0] += 1; }
        if isdir {
            String next = prefix + "|   ";
            if last { next = prefix + "    "; }
            tree_walk(full, next, all, depth + 1, maxd, nd, nf);
        }
    }
    return 0;
}
int do_tree(String[] a) {
    bool all = has_flag(a, 'a');
    int maxd = 64;
    String root = ".";
    int i = 1;
    while i < a.len {
        if a[i] == "-L" && i + 1 < a.len { maxd = a[i + 1].to_int(); i += 2; continue; }
        if !is_flag(a[i]) { root = a[i] + ""; }
        i += 1;
    }
    if !Dir::exists(root) { return fail("tree", root + ": no such folder"); }
    cout << root << "\n";
    int nd = 0;
    int nf = 0;
    int rc = tree_walk(root, "", all, 0, maxd, @nd, @nf);
    cout << "\n" << nd << " folders, " << nf << " files\n";
    return rc;
}

// ---------------------------------------------------------------- more commands: find ln chmod cut tr diff
bool glob_match(String p, int pi, String s, int si) {
    while pi < p.len {
        if p[pi] == '*' {
            for k in si..s.len + 1 { if glob_match(p, pi + 1, s, k) { return true; } }
            return false;
        }
        if si >= s.len { return false; }
        if p[pi] != '?' && p[pi] != s[si] { return false; }
        pi += 1;
        si += 1;
    }
    return si == s.len;
}

// find [FOLDER] [-name PATTERN] [-type f|d] [-maxdepth N]
void find_walk(String dir, String pat, char kind, int depth, int maxd) {
    Result<String[], Error> r = Dir::list(dir);
    if !r.is_ok() { return; }
    String[] names = r.take();
    names.sort();
    for i in 0..names.len {
        String full = Path::join(dir, names[i]);
        bool isdir = Dir::exists(full);
        bool ok = true;
        if pat.len > 0 && !glob_match(pat, 0, names[i], 0) { ok = false; }
        if kind == 'f' && isdir { ok = false; }
        if kind == 'd' && !isdir { ok = false; }
        if ok { cout << full << "\n"; }
        if isdir && depth + 1 < maxd { find_walk(full, pat, kind, depth + 1, maxd); }
    }
}
int do_find(String[] a) {
    String root = ".";
    String pat = "";
    char kind = 0;
    int maxd = 64;
    int i = 1;
    while i < a.len {
        if a[i] == "-name" && i + 1 < a.len { pat = a[i + 1] + ""; i += 2; }
        else if a[i] == "-type" && i + 1 < a.len { kind = a[i + 1][0]; i += 2; }
        else if a[i] == "-maxdepth" && i + 1 < a.len { maxd = a[i + 1].to_int(); i += 2; }
        else { root = a[i] + ""; i += 1; }
    }
    if !Dir::exists(root) { return fail("find", root + ": no such folder"); }
    find_walk(root, pat, kind, 0, maxd);
    return 0;
}

int do_ln(String[] a) {
    bool sym = has_flag(a, 's');
    String[] ops = operands(a, false);
    if ops.len != 2 { return fail("ln", "usage: ln -s TARGET LINK"); }
    if !sym { return fail("ln", "only symbolic links (ln -s TARGET LINK) are made here"); }
    if Sys::call(36, (int)ops[0].c(), 0 - 100, (int)ops[1].c(), 0, 0, 0) < 0 { return fail("ln", "cannot make " + ops[1]); }
    return 0;
}

int do_chmod(String[] a) {
    String[] ops = operands(a, false);
    if ops.len < 2 { return fail("chmod", "usage: chmod 755 FILE   or   chmod +x FILE"); }
    int rc = 0;
    for i in 1..ops.len {
        int mode = 0;
        if ops[0] == "+x" || ops[0] == "a+x" || ops[0] == "u+x" { mode = 493; }
        else if ops[0] == "-x" { mode = 420; }
        else {
            for k in 0..ops[0].len { mode = mode * 8 + (ops[0][k] - '0'); }
        }
        if Sys::chmod(ops[i].c(), mode) < 0 { rc = fail("chmod", "cannot change " + ops[i]); }
    }
    return rc;
}

// cut -d DELIM -f N [FILE]  (one field; fields count from 1)
int do_cut(String[] a) {
    String delim = "\t";
    int field = 1;
    String file = "-";
    int i = 1;
    while i < a.len {
        if a[i] == "-d" && i + 1 < a.len { delim = a[i + 1] + ""; i += 2; }
        else if a[i] == "-f" && i + 1 < a.len { field = a[i + 1].to_int(); i += 2; }
        else if a[i].len > 2 && a[i].starts_with("-d") { delim = a[i].slice(2, a[i].len); i += 1; }
        else if a[i].len > 2 && a[i].starts_with("-f") { field = a[i].slice(2, a[i].len).to_int(); i += 1; }
        else { file = a[i] + ""; i += 1; }
    }
    int rc = 0;
    String[] ls = lines_of(load("cut", file, @rc));
    for k in 0..ls.len {
        String[] parts = ls[k].split(delim);
        if field >= 1 && field <= parts.len { cout << parts[field - 1] << "\n"; } else { cout << "\n"; }
    }
    return rc;
}

// tr FROM TO : each letter of FROM becomes the letter at the same place of TO (from the standard input); tr -d SET deletes
int do_tr(String[] a) {
    String[] ops = operands(a, false);
    bool del = has_flag(a, 'd');
    if (del && ops.len < 1) || (!del && ops.len < 2) { return fail("tr", "usage: tr FROM TO   or   tr -d SET"); }
    String text = stdin_all();
    String out = "";
    for i in 0..text.len {
        char c = text[i];
        int at = 0 - 1;
        for k in 0..ops[0].len { if ops[0][k] == c && at < 0 { at = k; } }
        if at < 0 { out.push(c); }
        else if !del { char t = ops[1][ops[1].len - 1]; if at < ops[1].len { t = ops[1][at]; } out.push(t); }
    }
    cout << out;
    return 0;
}

// diff A B : the lines that differ ("< line" only in A, "> line" only in B), found with the longest common part
int do_diff(String[] a) {
    String[] ops = operands(a, false);
    if ops.len != 2 { return fail("diff", "usage: diff FILE1 FILE2"); }
    int rc = 0;
    String[] x = lines_of(load("diff", ops[0], @rc));
    String[] y = lines_of(load("diff", ops[1], @rc));
    if rc != 0 { return 2; }
    int n = x.len;
    int m = y.len;
    int[] lcs = arr((n + 1) * (m + 1) + 1);
    for i in 0..(n + 1) * (m + 1) { lcs.push(0); }
    int i = n - 1;
    while i >= 0 {
        int j = m - 1;
        while j >= 0 {
            if x[i] == y[j] { lcs[i * (m + 1) + j] = lcs[(i + 1) * (m + 1) + j + 1] + 1; }
            else {
                int d1 = lcs[(i + 1) * (m + 1) + j];
                int d2 = lcs[i * (m + 1) + j + 1];
                if d1 >= d2 { lcs[i * (m + 1) + j] = d1; } else { lcs[i * (m + 1) + j] = d2; }
            }
            j -= 1;
        }
        i -= 1;
    }
    int p = 0;
    int q = 0;
    int diffs = 0;
    while p < n || q < m {
        if p < n && q < m && x[p] == y[q] { p += 1; q += 1; }
        else if q >= m || (p < n && lcs[(p + 1) * (m + 1) + q] >= lcs[p * (m + 1) + q + 1]) { cout << "< " << x[p] << "\n"; p += 1; diffs += 1; }
        else { cout << "> " << y[q] << "\n"; q += 1; diffs += 1; }
    }
    if diffs > 0 { return 1; }
    return 0;
}

// ---------------------------------------------------------------- date du xargs sed less stat
int do_date(String[] a) {                                       // date [+%s]: the time now (UTC); +%s the seconds since 1970
    int ms = Time::now_ms();
    if a.len > 1 && a[1] == "+%s" { cout << ms / 1000 << "\n"; return 0; }
    Date d;
    d.set_unix(ms / 1000);
    cout << d.text() << " UTC\n";
    return 0;
}

int du_size(String path) {
    if !Dir::exists(path) {
        Result<int, Error> r = Fs::size(path);
        if r.is_ok() { return r.unwrap(); }
        return 0;
    }
    int total = 0;
    Result<String[], Error> l = Dir::list(path);
    if l.is_ok() {
        String[] names = l.take();
        for i in 0..names.len { total += du_size(Path::join(path, names[i])); }
    }
    return total;
}
int do_du(String[] a) {                                         // du [-h] [FOLDER...]: the bytes under each (the sum of the sizes of the files)
    bool human = has_flag(a, 'h');
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("."); }
    for i in 0..ops.len {
        int n = du_size(ops[i]);
        if human {
            if n >= 1048576 { cout << n / 1048576 << "M\t" << ops[i] << "\n"; }
            else if n >= 1024 { cout << n / 1024 << "K\t" << ops[i] << "\n"; }
            else { cout << n << "\t" << ops[i] << "\n"; }
        } else { cout << n << "\t" << ops[i] << "\n"; }
    }
    return 0;
}

int do_stat(String[] a) {
    String[] ops = operands(a, false);
    int rc = 0;
    for i in 0..ops.len {
        if Dir::exists(ops[i]) { cout << ops[i] << ": folder\n"; }
        else if Fs::exists(ops[i]) {
            Result<int, Error> r = Fs::size(ops[i]);
            cout << ops[i] << ": file, " << r.unwrap() << " bytes\n";
        } else { rc = fail("stat", ops[i] + ": no such file or folder"); }
    }
    return rc;
}

// xargs COMMAND [args]: the words of the input are added to the command as arguments (one run for all)
int do_xargs(String[] a) {
    if a.len < 2 { return fail("xargs", "usage: xargs COMMAND [args]   (the words of the input become more arguments)"); }
    String text = stdin_all();
    String[] words = text.replace("\n", " ").split(" ");
    String[] argv = arr(a.len + words.len + 1);
    for i in 1..a.len { argv.push(a[i] + ""); }
    for i in 0..words.len { if words[i].len > 0 { argv.push(words[i] + ""); } }
    String[] rest = arr(argv.len);
    for i in 1..argv.len { rest.push(argv[i]); }
    switch Proc::run(argv[0], rest) {
        Result::Ok(code): return code;
        Result::Err(e): return fail("xargs", "cannot run " + argv[0]);
    }
    return 1;
}

// sed 's/old/new/[g]' [FILE]: replaces text in every line (the old text is plain text, not a pattern)
int do_sed(String[] a) {
    String[] ops = operands(a, false);
    if ops.len < 1 || ops[0].len < 4 || ops[0][0] != 's' { return fail("sed", "usage: sed 's/old/new/g' [FILE]   (only the replacement s/// is here)"); }
    char sep = ops[0][1];
    String[] parts = ops[0].slice(2, ops[0].len).split(sep);
    if parts.len < 2 { return fail("sed", "bad expression"); }
    String from = parts[0];
    String to = parts[1];
    bool all = parts.len > 2 && parts[2].contains("g");
    String file = "-";
    if ops.len > 1 { file = ops[1] + ""; }
    int rc = 0;
    String[] ls = lines_of(load("sed", file, @rc));
    for i in 0..ls.len {
        String l = ls[i];
        if from.len > 0 {
            if all { l = l.replace(from, to); }
            else {
                int at = 0;
                bool found = false;
                while at + from.len <= l.len && !found { if l.slice(at, at + from.len) == from { found = true; } else { at += 1; } }
                if found { l = l.slice(0, at) + to + l.slice(at + from.len, l.len); }
            }
        }
        cout << l << "\n";
    }
    return rc;
}

int last_shown(int top, int page, int total) { if top + page < total { return top + page; } return total; }

// less FILE: one page at a time; space = next page, Enter = next line, b = back a page, q = quit
int do_less(String[] a) {
    String[] ops = operands(a, false);
    int rc = 0;
    String file = "-";
    if ops.len > 0 { file = ops[0] + ""; }
    String[] ls = lines_of(load("less", file, @rc));
    if Sys::isatty(1) != 0 || Sys::isatty(0) == 0 && file == "-" {          // not a screen: just show it
        for i in 0..ls.len { cout << ls[i] << "\n"; }
        return rc;
    }
    char t[64];
    int fdin = Sys::open_read("/dev/tty".c());
    if fdin < 0 { for i in 0..ls.len { cout << ls[i] << "\n"; } return rc; }
    Sys::call(29, fdin, 21505, (int)@t, 0, 0, 0);
    char raw[64];
    for i in 0..64 { raw[i] = t[i]; }
    raw[12] = raw[12] & 245;
    raw[23] = 1;
    raw[22] = 0;
    Sys::call(29, fdin, 21506, (int)@raw, 0, 0, 0);
    char w[8];
    Sys::call(29, 1, 21523, (int)@w, 0, 0, 0);
    int rows = (w[0] & 255) | ((w[1] & 255) << 8);
    if rows < 3 { rows = 24; }
    int page = rows - 1;
    int top = 0;
    String e = "\e";
    while true {
        cout << e << "[2J" << e << "[H";
        for i in top..top + page { if i < ls.len { cout << ls[i] << "\r\n"; } }
        cout << e << "[7m" << " " << file << "  lines " << top + 1 << "-" << last_shown(top, page, ls.len) << " of " << ls.len << "   (space next, b back, Enter line, q quit)" << e << "[0m";
        char k[2];
        int n = Sys::read(fdin, @k, 1);
        if n <= 0 || k[0] == 'q' { break; }
        if k[0] == ' ' || k[0] == 'f' { top += page; if top >= ls.len { top = ls.len - 1; if top < 0 { top = 0; } break; } }
        else if k[0] == 13 || k[0] == 10 || k[0] == 'j' { if top + 1 < ls.len { top += 1; } }
        else if k[0] == 'k' { if top > 0 { top -= 1; } }
        else if k[0] == 'b' { top = top - page; if top < 0 { top = 0; } }
    }
    Sys::call(29, fdin, 21506, (int)@t, 0, 0, 0);
    cout << "\n";
    return rc;
}

int do_install(String[] args) {
    String names_text = "dir tree find date du stat xargs sed less ln chmod cut tr diff cat head tail wc nl tac mkdir rmdir rm touch cp mv grep sort uniq tee seq basename dirname sleep clear env kill true false";
    String[] names = names_text.split(" ");
    String dir = ".";
    if args.len > 2 { dir = args[2]; }
    else {
        String self = "";
        self.append((char^)Sys::arg(0));
        dir = Path::parent(self);
        if dir.len == 0 { dir = "."; }
    }
    int rc = 0;
    for i in 0..names.len {
        String link = Path::join(dir, names[i]);
        if Fs::exists(link) { continue; }
        if Sys::call(36, (int)"jbox".c(), 0 - 100, (int)link.c(), 0, 0, 0) < 0 { rc = fail("jbox", "cannot make " + link); }
    }
    if rc == 0 { cout << "jbox: " << names.len << " commands linked in " << dir << "\n"; }
    return rc;
}

int main() {
    String[] args = Env::args();
    if args.len > 1 && args[1] == "--version" { cout << "jbox 0.5.1\n"; return 0; }
    if args.len > 1 && (args[1] == "--install" || args[1] == "--post-install") { return do_install(args); }
    String app = Path::name(args[0]);
    String[] a = args;
    if app == "jbox" {
        if args.len < 2 { return do_help(); }
        app = args[1];
        a = arr(args.len);
        for i in 1..args.len { a.push(args[i]); }
    }
    if app == "dir" { return do_ls(a); }
    if app == "cat" { return do_cat(a); }
    if app == "tree" { return do_tree(a); }
    if app == "find" { return do_find(a); }
    if app == "date" { return do_date(a); }
    if app == "du" { return do_du(a); }
    if app == "stat" { return do_stat(a); }
    if app == "xargs" { return do_xargs(a); }
    if app == "sed" { return do_sed(a); }
    if app == "less" { return do_less(a); }
    if app == "ln" { return do_ln(a); }
    if app == "chmod" { return do_chmod(a); }
    if app == "cut" { return do_cut(a); }
    if app == "tr" { return do_tr(a); }
    if app == "diff" { return do_diff(a); }
    if app == "head" { return do_head_tail(a, true); }
    if app == "tail" { return do_head_tail(a, false); }
    if app == "wc" { return do_wc(a); }
    if app == "nl" { return do_nl(a); }
    if app == "tac" { return do_tac(a); }
    if app == "mkdir" { return do_mkdir(a); }
    if app == "rm" { return do_rm(a); }
    if app == "rmdir" { return do_rmdir(a); }
    if app == "touch" { return do_touch(a); }
    if app == "cp" { return do_cp(a); }
    if app == "mv" { return do_mv(a); }
    if app == "grep" { return do_grep(a); }
    if app == "sort" { return do_sort(a); }
    if app == "uniq" { return do_uniq(a); }
    if app == "tee" { return do_tee(a); }
    if app == "seq" { return do_seq(a); }
    if app == "basename" { return do_basename(a); }
    if app == "dirname" { return do_dirname(a); }
    if app == "sleep" { return do_sleep(a); }
    if app == "clear" { return do_clear(); }
    if app == "env" { return do_env(); }
    if app == "kill" { return do_kill(a); }
    if app == "true" { return 0; }
    if app == "false" { return 1; }
    if app == "help" { return do_help(); }
    cerr << "jsh: " << app << ": command not found\n";
    return 127;
}
