// distributed with this file, You can obtain one at https://mozilla.org/MPL/2.0/.
// jbox: the small commands of Jaric in ONE program (like busybox). `jbox ls -l`, or a link/copy named ls.
// jsh runs `jbox NAME args` for the commands it does not find in PATH. Only the library and Sys:: calls are used.
#import <stdlib>

i64 fail(String app, String msg) {
    jerr << app << ": " << msg << "\n";
    return 1;
}

String stdin_all() {
    String r = "";
    char b[4097];
    i64 n = Sys::read(0, @b, 4096);
    while n > 0 {
        b[n] = 0;
        r.append((char^)@b);
        n = Sys::read(0, @b, 4096);
    }
    return r;
}

// the text of a file, or of the standard input when the name is "-" or missing
String load(String app, String path, i64^ rc) {
    if path == "-" { return stdin_all(); }
    String out = "";
    Result<String, Error> r = Fs::read_text(path);
    switch r {
        Result::Ok(t): out = t;
        Result::Err(e): rc[0] = fail(app, e.message);
    }
    return out;
}

// the lines of a text without the empty piece after the last newline
String[] lines_of(String text) {
    String[] parts = text.split("\n");
    String[] r = arr(parts.len + 1);
    for i in 0..parts.len {
        if i == parts.len - 1 && parts[i].len == 0 { continue; }
        r.push(parts[i]);
    }
    return r;
}

bool is_flag(String a) { return a.len > 1 && a[0] == 45; }
bool has_flag(String[] a, char f) {
    for i in 1..a.len {
        if is_flag(a[i]) {
            for k in 1..a[i].len { if a[i][k] == f { return true; } }
        }
    }
    return false;
}
// the arguments that are not flags (and not the values after -n)
// a command that reads files, called without one while the input is the keyboard, would wait for typing for ever: say what is needed
bool needs_file(String app, String[] ops) {
    if ops.len > 0 || Sys::isatty(0) != 0 { return false; }
    jerr << app << ": a file name is needed (or text piped in: cat file | " << app << ")\n";
    return true;
}

String[] operands(String[] a, bool valued) {
    String[] r = arr(a.len + 1);
    i64 i = 1;
    while i < a.len {
        if valued && a[i] == "-n" { i += 2; continue; }
        if !is_flag(a[i]) { r.push(a[i]); }
        i += 1;
    }
    return r;
}
// the value after -n, or the default
i64 count_of(String[] a, i64 dflt) {
    for i in 1..a.len - 1 {
        if a[i] == "-n" { return a[i + 1].to_int(); }
    }
    return dflt;
}

// ---------------------------------------------------------------- the commands
// ---- dir (ls): at a terminal the names stand in columns that fit the width of the screen (like ls), folders in blue and programs in green;
//      -l one line for each with the rights and the size (-h: 1.5 KB), -1 one name on a line, -a also the names that start with a dot.
//      Into a pipe or a file: one name on a line (a folder has a / after it).
i64 name_cells(String n) {
    // the width on the screen: a letter is one cell, a combining mark of Thai (a vowel above or below, a tone mark) is none
    i64 w = 0;
    i64 i = 0;
    while i < n.len {
        i64 c = n[i] & 255;
        if c < 128 { w += 1; i += 1; }
        else if c >= 224 && i + 2 < n.len {
            i64 cp = ((c & 15) << 12) | ((n[i + 1] & 63) << 6) | (n[i + 2] & 63);
            bool mark = cp == 3633 || (cp >= 3636 && cp <= 3642) || (cp >= 3655 && cp <= 3662);
            if !mark { w += 1; }
            i += 3;
        } else if c >= 192 { w += 1; i += 2; }
        else if c >= 240 { w += 2; i += 4; }
        else { i += 1; }
    }
    return w;
}

String rights_of(i64 mode) {
    String t = "-";
    i64 kind = mode & 61440;
    if kind == 16384 { t = "d"; } else if kind == 40960 { t = "l"; }
    String r = t;
    String bits = "rwxrwxrwx";
    for k in 0..9 { if (mode & (256 >> k)) != 0 { r.push(bits[k]); } else { r.push('-'); } }
    return r;
}

String ls_size(i64 sz, bool human) {
    if !human { return str(sz); }
    if sz < 1024 { return str(sz); }
    if sz < 1048576 { return str(sz / 1024) + "." + str((sz % 1024) * 10 / 1024) + "K"; }
    if sz < 1073741824 { return str(sz / 1048576) + "." + str((sz % 1048576) * 10 / 1048576) + "M"; }
    return str(sz / 1073741824) + "." + str((sz % 1073741824) * 10 / 1073741824) + "G";
}

i64 do_ls(String[] a) {
    bool all = has_flag(a, 'a');
    bool lng = has_flag(a, 'l');
    bool human = has_flag(a, 'h');
    bool one = has_flag(a, '1');
    bool tty = Sys::isatty(1) == 0;
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("."); }
    i64 rc = 0;
    for p in 0..ops.len {
        String[] raw = arr(4);
        String base = ops[p];
        if Dir::exists(base) {
            Result<String[], Error> r = Dir::list(base);
            if r.is_ok() { raw = r.take(); }
            else { rc = fail("dir", base + ": cannot read the folder"); }
            if ops.len > 1 { if p > 0 { jout << "\n"; } jout << base << ":\n"; }
        } else if Fs::exists(base) {
            raw.push(base);
            base = "";
        } else { rc = fail("dir", base + ": no such file or folder"); }
        // the names to show, sorted without regard to small or capital letters
        String[] names = arr(raw.len + 1);
        for i in 0..raw.len {
            String n = raw[i];
            if !all && n.len > 0 && n[0] == 46 { continue; }
            names.push(n + "");
        }
        i64 cnt = names.len;
        i64[] order = arr(cnt + 1);
        for i in 0..cnt { order.push(i); }
        for i in 1..cnt {
            i64 cur = order[i];
            String key = names[cur].lower();
            i64 k = i - 1;
            while k >= 0 {
                String before = names[order[k]].lower();
                if !(before > key) { break; }
                order[k + 1] = order[k];
                k -= 1;
            }
            order[k + 1] = cur;
        }
        // what each one is: folder?, program?, size, rights
        bool[] isdir = arr(cnt + 1);
        bool[] isexe = arr(cnt + 1);
        i64[] sizes = arr(cnt + 1);
        i64[] modes = arr(cnt + 1);
        String[] shown = arr(cnt + 1);
        i64[] cells = arr(cnt + 1);
        for q in 0..cnt {
            String n = names[order[q]];
            String full = n;
            if base.len > 0 { full = Path::join(base, n); }
            char st[128];
            i64 mode = 0;
            i64 sz = 0;
            if Sys::stat(full.c(), @st) == 0 {
                mode = (st[16] & 255) | ((st[17] & 255) << 8) | ((st[18] & 255) << 16);
                for z in 0..8 { sz = sz | ((st[48 + z] & 255) << (8 * z)); }
            }
            bool d = (mode & 61440) == 16384;
            isdir.push(d);
            isexe.push(!d && (mode & 73) != 0 && (mode & 61440) == 32768);
            sizes.push(sz);
            modes.push(mode);
            String label = n;
            if d { label = n + "/"; }
            shown.push(label + "");
            cells.push(name_cells(label));
        }
        // colour only at a terminal
        String blue = "";
        String green = "";
        String off = "";
        if tty { blue = "\e[1;34m"; green = "\e[1;32m"; off = "\e[0m"; }
        if lng {
            i64 sw = 0;
            for q in 0..cnt { i64 l = ls_size(sizes[q], human).len; if l > sw { sw = l; } }
            for q in 0..cnt {
                String sz = ls_size(sizes[q], human);
                String col = "";
                if isdir[q] { col = blue; } else if isexe[q] { col = green; }
                String endc = "";
                if col.len > 0 { endc = off; }
                jout << rights_of(modes[q]) << " " << " ".repeat(sw - sz.len) << sz << " " << col << shown[q] << endc << "\n";
            }
        } else if !tty || one || cnt < 2 {
            for q in 0..cnt {
                String col = "";
                if isdir[q] { col = blue; } else if isexe[q] { col = green; }
                String endc = "";
                if col.len > 0 { endc = off; }
                jout << col << shown[q] << endc << "\n";
            }
        } else {
            i64 width = Term::cols();
            if width < 20 { width = 80; }
            // as many columns as fit: the names go down the first column, then the next (like ls)
            i64 ncols = cnt;
            i64 rows = 1;
            i64[] colw = arr(cnt + 1);
            while ncols >= 1 {
                rows = (cnt + ncols - 1) / ncols;
                i64 total = 0;
                colw = arr(ncols + 1);
                for c in 0..ncols {
                    i64 m = 0;
                    for r in 0..rows { i64 idx = c * rows + r; if idx < cnt && cells[idx] > m { m = cells[idx]; } }
                    colw.push(m + 2);
                    total += m + 2;
                }
                if total - 2 <= width || ncols == 1 { break; }
                ncols -= 1;
            }
            for r in 0..rows {
                String line = "";
                for c in 0..ncols {
                    i64 idx = c * rows + r;
                    if idx >= cnt { continue; }
                    String col = "";
                    if isdir[idx] { col = blue; } else if isexe[idx] { col = green; }
                    String endc = "";
                    if col.len > 0 { endc = off; }
                    line = line + col + shown[idx] + endc;
                    bool last = c == ncols - 1 || (c + 1) * rows + r >= cnt;
                    if !last { line = line + " ".repeat(colw[c] - cells[idx]); }
                }
                jout << line << "\n";
            }
        }
    }
    return rc;
}

i64 do_cat(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    for i in 0..ops.len { jout << load("cat", ops[i], @rc); }
    return rc;
}

i64 do_head_tail(String[] a, bool head) {
    i64 n = count_of(a, 10);
    String[] ops = operands(a, true);
    if needs_file(Path::name(a[0]), ops) { return 2; }
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    for p in 0..ops.len {
        String who = "tail";
        if head { who = "head"; }
        String[] ls = lines_of(load(who, ops[p], @rc));
        i64 first = 0;
        i64 last = ls.len;
        if head { if n < last { last = n; } } else { if ls.len > n { first = ls.len - n; } }
        for i in first..last { jout << ls[i] << "\n"; }
    }
    return rc;
}

i64 do_wc(String[] a) {
    bool l = has_flag(a, 'l');
    bool w = has_flag(a, 'w');
    bool c = has_flag(a, 'c');
    if !l && !w && !c { l = true; w = true; c = true; }
    String[] ops = operands(a, false);
    if needs_file("wc", ops) { return 2; }
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    for p in 0..ops.len {
        String t = load("wc", ops[p], @rc);
        i64 nl = 0;
        i64 nw = 0;
        bool inw = false;
        for i in 0..t.len {
            char ch = t[i];
            if ch == 10 { nl += 1; }
            bool sp = ch == 32 || ch == 10 || ch == 9 || ch == 13;
            if sp { inw = false; } else { if !inw { nw += 1; } inw = true; }
        }
        if l { jout << nl << " "; }
        if w { jout << nw << " "; }
        if c { jout << t.len << " "; }
        if ops[p] != "-" { jout << ops[p]; }
        jout << "\n";
    }
    return rc;
}

// nl [FILE]: the lines with numbers in front (empty lines are not numbered, like nl);   tac [FILE]: the lines from the last to the first
i64 do_nl(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    i64 n = 0;
    for p in 0..ops.len {
        String t = load("nl", ops[p], @rc);
        String[] lines = t.split("\n");
        i64 last = lines.len;
        if last > 0 && lines[last - 1].len == 0 { last -= 1; }
        for i in 0..last {
            if lines[i].len == 0 { jout << "       \n"; continue; }
            n += 1;
            String num = str(n);
            for k in num.len..6 { jout << " "; }
            jout << num << "  " << lines[i] << "\n";
        }
    }
    return rc;
}

i64 do_tac(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    for p in 0..ops.len {
        String t = load("tac", ops[p], @rc);
        String[] lines = t.split("\n");
        i64 last = lines.len;
        if last > 0 && lines[last - 1].len == 0 { last -= 1; }
        i64 i = last - 1;
        while i >= 0 { jout << lines[i] << "\n"; i -= 1; }
    }
    return rc;
}

// ---------------------------------------------------------------- 0.6.0: more of the small commands
String read_all_bin(String path, bool^ ok) {
    ok[0] = false;
    if path == "-" { String r0 = ""; char b0[8192]; i64 n0 = Sys::read(0, @b0, 8192); while n0 > 0 { for i in 0..n0 { r0.push(b0[i]); } n0 = Sys::read(0, @b0, 8192); } ok[0] = true; return r0; }
    i64 fd = Sys::open_read(path.c());
    if fd < 0 { return ""; }
    String r = "";
    char buf[8192];
    i64 n = Sys::read(fd, @buf, 8192);
    while n > 0 {
        for i in 0..n { r.push(buf[i]); }
        n = Sys::read(fd, @buf, 8192);
    }
    Sys::close(fd);
    ok[0] = n == 0;
    return r;
}

String first_line_of(String path, String fallback) {
    bool ok = false;
    String t = read_all_bin(path, @ok);
    if !ok || t.len == 0 { return fallback; }
    String[] l = t.split("\n");
    if l.len == 0 || l[0].len == 0 { return fallback; }
    return l[0];
}

// rev: every line backwards (by letters, so Thai and others stay whole)
i64 do_rev(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    for p in 0..ops.len {
        String t = load("rev", ops[p], @rc);
        String[] lines = t.split("\n");
        i64 last = lines.len;
        if last > 0 && lines[last - 1].len == 0 { last -= 1; }
        for i in 0..last {
            String[] ch = lines[i].chars();
            String[] units = arr(ch.len + 1);                          // a letter with the marks above and below it is one unit
            for q in 0..ch.len {
                String c = ch[q];
                bool mark = c.len == 3 && (c[0] & 255) == 224 && (((c[1] & 255) == 184 && ((c[2] & 255) == 177 || ((c[2] & 255) >= 180 && (c[2] & 255) <= 186))) || ((c[1] & 255) == 185 && (c[2] & 255) >= 135 && (c[2] & 255) <= 142));
                if mark && units.len > 0 { units[units.len - 1] = units[units.len - 1] + c; } else { units.push(c + ""); }
            }
            String o = "";
            i64 k = units.len - 1;
            while k >= 0 { o = o + units[k]; k -= 1; }
            jout << o << "\n";
        }
    }
    return rc;
}

i64 do_yes(String[] a) {
    String w = "y";
    if a.len > 1 { w = a[1]; for i in 2..a.len { w = w + " " + a[i]; } }
    String line = w + "\n";
    while true {
        if Sys::write(1, line.c(), line.len) <= 0 { break; }          // a closed pipe ends it
    }
    return 0;
}

i64 do_uname(String[] a) {
    String os = first_line_of("/proc/sys/kernel/ostype", "Linux");
    String host = first_line_of("/proc/sys/kernel/hostname", "localhost");
    String rel = first_line_of("/proc/sys/kernel/osrelease", "");
    if has_flag(a, 'a') { jout << os << " " << host << " " << rel << " aarch64\n"; }
    else if has_flag(a, 'r') { jout << rel << "\n"; }
    else if has_flag(a, 'n') { jout << host << "\n"; }
    else if has_flag(a, 'm') { jout << "aarch64\n"; }
    else { jout << os << "\n"; }
    return 0;
}

i64 do_hostname(String[] a) {
    jout << first_line_of("/proc/sys/kernel/hostname", "localhost") << "\n";
    return 0;
}

i64 do_whoami(String[] a) {
    switch Env::get("USER") {
        Option::Some(u): { if u.len > 0 { jout << u << "\n"; return 0; } }
        Option::None: { }
    }
    jout << "uid" << str(Sys::call(174, 0, 0, 0, 0, 0, 0)) << "\n";
    return 0;
}

// realpath: the full path with . and .. worked out (the file need not exist)
i64 do_realpath(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("realpath", "a path is needed"); }
    for k in 0..ops.len {
        String p = ops[k];
        if !p.starts_with("/") {
            String cwd = "/";
            Result<String, Error> c = Dir::current();
            if c.is_ok() { cwd = c.take(); }
            p = Path::join(cwd, p);
        }
        String[] parts = p.split("/");
        String[] out = arr(parts.len + 1);
        for i in 0..parts.len {
            if parts[i].len == 0 || parts[i] == "." { continue; }
            if parts[i] == ".." { if out.len > 0 { out.pop(); } continue; }
            out.push(parts[i] + "");
        }
        String r = "";
        for i in 0..out.len { r = r + "/" + out[i]; }
        if r.len == 0 { r = "/"; }
        jout << r << "\n";
    }
    return 0;
}

i64 do_base64(String[] a) {
    bool dec = has_flag(a, 'd');
    String[] ops = operands(a, false);
    String path = "-";
    if ops.len > 0 { path = ops[0]; }
    bool ok = false;
    String t = read_all_bin(path, @ok);
    if !ok { return fail("base64", "cannot read " + path); }
    if dec {
        Result<String, Error> r = Base64::decode(t.replace("\n", "").trim());
        if !r.is_ok() { return fail("base64", "not valid base64"); }
        String d = r.take();
        for i in 0..d.len { char one[2]; one[0] = d[i]; Sys::write(1, @one, 1); }
        return 0;
    }
    String e = Base64::encode(t);
    i64 at = 0;
    while at < e.len {                                                  // lines of 76 letters, like the others
        i64 to = at + 76;
        if to > e.len { to = e.len; }
        jout << e.slice(at, to) << "\n";
        at = to;
    }
    return 0;
}

i64 do_sha256sum(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    for p in 0..ops.len {
        bool ok = false;
        String t = read_all_bin(ops[p], @ok);
        if !ok { rc = fail("sha256sum", "cannot read " + ops[p]); continue; }
        jout << Sha256::hex(t) << "  " << ops[p] << "\n";
    }
    return rc;
}

// cmp A B: the first byte that differs
i64 do_cmp(String[] a) {
    String[] ops = operands(a, false);
    if ops.len < 2 { return fail("cmp", "two files are needed"); }
    bool ok1 = false;
    bool ok2 = false;
    String x = read_all_bin(ops[0], @ok1);
    String y = read_all_bin(ops[1], @ok2);
    if !ok1 { return fail("cmp", "cannot read " + ops[0]); }
    if !ok2 { return fail("cmp", "cannot read " + ops[1]); }
    i64 n = x.len;
    if y.len < n { n = y.len; }
    for i in 0..n {
        if x[i] != y[i] { jout << ops[0] << " " << ops[1] << " differ: byte " << i + 1 << "\n"; return 1; }
    }
    if x.len != y.len {
        String shorter = ops[1];
        if x.len < y.len { shorter = ops[0]; }
        jout << "cmp: EOF on " << shorter << "\n";
        return 1;
    }
    return 0;
}

// paste A B: the lines side by side with a tab
i64 do_paste(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("paste", "files are needed"); }
    i64 rc = 0;
    String[] all = arr(64);
    i64[] starts = arr(ops.len + 1);
    i64[] lens = arr(ops.len + 1);
    i64 most = 0;
    for k in 0..ops.len {
        String t = load("paste", ops[k], @rc);
        String[] l = t.split("\n");
        i64 n = l.len;
        if n > 0 && l[n - 1].len == 0 { n -= 1; }
        starts.push(all.len);
        lens.push(n);
        for q in 0..n { all.push(l[q] + ""); }
        if n > most { most = n; }
    }
    for i in 0..most {
        String line = "";
        for k in 0..ops.len {
            if k > 0 { line = line + "\t"; }
            if i < lens[k] { line = line + all[starts[k] + i]; }
        }
        jout << line << "\n";
    }
    return rc;
}

// fold -w N: lines cut at N letters
i64 do_fold(String[] a) {
    i64 w = 80;
    String[] ops = arr(a.len + 1);
    i64 i = 1;
    while i < a.len {
        if a[i] == "-w" && i + 1 < a.len { w = a[i + 1].to_int(); i += 2; }
        else { ops.push(a[i] + ""); i += 1; }
    }
    if w < 1 { w = 80; }
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    for p in 0..ops.len {
        String t = load("fold", ops[p], @rc);
        String[] lines = t.split("\n");
        i64 last = lines.len;
        if last > 0 && lines[last - 1].len == 0 { last -= 1; }
        for k in 0..last {
            String[] ch = lines[k].chars();
            i64 n = 0;
            String cur = "";
            for q in 0..ch.len {
                if n == w { jout << cur << "\n"; cur = ""; n = 0; }
                cur = cur + ch[q];
                n += 1;
            }
            jout << cur << "\n";
        }
    }
    return rc;
}

// printf FORMAT args...: %s %d %x %c %% and \n \t \\ ; the format is used again while arguments are left
i64 do_printf(String[] a) {
    if a.len < 2 { return fail("printf", "a format is needed"); }
    String f = a[1];
    i64 arg = 2;
    bool again = true;
    while again {
        again = false;
        i64 used = 0;
        i64 i = 0;
        while i < f.len {
            char c = f[i];
            if c == '\\' && i + 1 < f.len {
                char d = f[i + 1];
                if d == 'n' { jout << "\n"; } else if d == 't' { jout << "\t"; } else if d == '\\' { jout << "\\"; } else if d == 'e' { jout << "\e"; } else if d == 'r' { jout << "\r"; } else { jout << "\\" << d; }
                i += 2;
            } else if c == '%' && i + 1 < f.len {
                char d = f[i + 1];
                String v = "";
                if d != '%' && arg < a.len { v = a[arg]; arg += 1; used += 1; }
                if d == 's' { jout << v; }
                else if d == 'd' { jout << str(v.to_int()); }
                else if d == 'x' {
                    i64 hv = v.to_int();
                    String hs = "";
                    String hd = "0123456789abcdef";
                    if hv == 0 { hs = "0"; }
                    while hv > 0 { hs = hd.slice(hv & 15, (hv & 15) + 1) + hs; hv = hv >> 4; }
                    jout << hs;
                }
                else if d == 'c' { if v.len > 0 { jout << v.slice(0, 1); } }
                else if d == '%' { jout << "%"; }
                else { jout << "%" << d; }
                i += 2;
            } else { jout << c; i += 1; }
        }
        if used > 0 && arg < a.len { again = true; }
    }
    return 0;
}

i64 do_uptime(String[] a) {
    String u = first_line_of("/proc/uptime", "0 0");
    String[] p = u.split(" ");
    String[] whole = p[0].split(".");
    i64 secs = whole[0].to_int();
    jout << "up " << secs / 86400 << " days, " << (secs % 86400) / 3600 << ":" << two_digits((secs % 3600) / 60) << "\n";
    return 0;
}

String two_digits(i64 n) {
    String r = str(n);
    if r.len < 2 { r = "0" + r; }
    return r;
}

// the words of a line (any number of blanks between them)
String[] words_of(String line) {
    String[] r = arr(8);
    String cur = "";
    for i in 0..line.len {
        if line[i] == ' ' || line[i] == 9 { if cur.len > 0 { r.push(cur + ""); cur = ""; } }
        else { cur.push(line[i]); }
    }
    if cur.len > 0 { r.push(cur + ""); }
    return r;
}

// free: the memory of the phone in MB (from /proc/meminfo)
i64 do_free(String[] a) {
    bool mok = false;
    String mt = read_all_bin("/proc/meminfo", @mok);
    if !mok { return fail("free", "cannot read /proc/meminfo"); }
    String[] lines = mt.split("\n");
    i64 total = 0;
    i64 avail = 0;
    i64 swap = 0;
    for i in 0..lines.len {
        String l = lines[i];
        String[] p = words_of(l);
        if p.len < 2 { continue; }
        if p[0] == "MemTotal:" { total = p[1].to_int(); }
        if p[0] == "MemAvailable:" { avail = p[1].to_int(); }
        if p[0] == "SwapTotal:" { swap = p[1].to_int(); }
    }
    jout << "memory  total " << total / 1024 << " MB   available " << avail / 1024 << " MB   used " << (total - avail) / 1024 << " MB   swap " << swap / 1024 << " MB\n";
    return 0;
}

i64 do_nproc(String[] a) {
    bool cok = false;
    String ct = read_all_bin("/proc/cpuinfo", @cok);
    i64 n = 0;
    if cok {
        String[] lines = ct.split("\n");
        for i in 0..lines.len { if lines[i].starts_with("processor") { n += 1; } }
    }
    if n == 0 { n = 1; }
    jout << n << "\n";
    return 0;
}

// the commands of the system (usr/bin, usr/lib, usr/etc of the app) are changed by root only: login root, or  root rm ...  in jsh (it sets JC_ROOT=1).
// A rule that the tools keep, not a wall.
bool needs_root(String path) {
    switch Env::get("JC_ROOT") { Option::Some(v): { if v == "1" { return false; } } Option::None: { } }
    String abs = path;
    if !abs.starts_with("/") {
        char buf[512];
        if Sys::getcwd(@buf, 512) > 0 { abs = Path::join((char^)@buf, path); }
    }
    String prefix = "";
    switch Env::get("PREFIX") { Option::Some(v): { prefix = v; } Option::None: { } }
    if prefix.len == 0 {
        switch Env::get("HOME") { Option::Some(h): { prefix = Path::parent(h) + "/usr"; } Option::None: { return false; } }
    }
    String[] parts = "bin lib etc".split(" ");
    for i in 0..parts.len {
        String dir = prefix + "/" + parts[i];
        String under = dir + "/";
        if abs == dir || abs.starts_with(under) { return true; }
    }
    return false;
}

i64 need_root_fail(String app, String path) { return fail(app, path + ": the commands of the system are changed by root (login root, or  root " + app + " ...)"); }

i64 do_mkdir(String[] a) {
    bool deep = has_flag(a, 'p');
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("mkdir", "a folder name is needed"); }
    i64 rc = 0;
    for i in 0..ops.len {
        Result<i64, Error> r = Dir::make(ops[i]);
        if deep { r = Dir::make_all(ops[i]); }
        switch r {
            Result::Ok(v): rc = rc;
            Result::Err(e): rc = fail("mkdir", ops[i] + ": " + e.message);
        }
    }
    return rc;
}

bool is_link(String p) {                                  // a symbolic link: readlink works on it
    char buf[8];
    return Sys::readlink(p.c(), @buf, 8) >= 0;
}

// rm -r: a folder and everything in it (symbolic links are removed, not followed)
i64 remove_tree(String dir) {
    i64 rc = 0;
    switch Dir::list(dir) {
        Result::Ok(names): {
            for i in 0..names.len {
                String p = Path::join(dir, names[i]);
                bool sub = Dir::exists(p) && !is_link(p);
                if sub { if remove_tree(p) != 0 { rc = 1; } }
                else { switch Fs::remove(p) { Result::Ok(v): rc = rc; Result::Err(e): rc = 1; } }
            }
        }
        Result::Err(e): rc = 1;
    }
    switch Dir::remove(dir) { Result::Ok(v): rc = rc; Result::Err(e): rc = 1; }
    return rc;
}

i64 do_rm(String[] a) {
    bool force = has_flag(a, 'f');
    bool deep = has_flag(a, 'r') || has_flag(a, 'R');
    String[] ops = operands(a, false);
    if ops.len == 0 && !force { return fail("rm", "a file name is needed"); }
    i64 rc = 0;
    for i in 0..ops.len {
        String target = ops[i];
        if needs_root(target) { rc = need_root_fail("rm", target); continue; }
        if target == "/" || target == "." || target == ".." || target.ends_with("/..") || target.ends_with("/.") {
            rc = fail("rm", "refusing to remove '" + target + "'");
            continue;
        }
        bool is_dir = Dir::exists(target);
        if is_dir && !deep {
            if !force { rc = fail("rm", target + ": is a folder (rm -r removes a folder and what is in it)"); }
            continue;
        }
        if is_dir {
            if remove_tree(target) != 0 && !force { rc = fail("rm", target + ": could not remove everything"); }
            continue;
        }
        Result<i64, Error> r = Fs::remove(target);
        switch r {
            Result::Ok(v): rc = rc;
            Result::Err(e): if !force { rc = fail("rm", target + ": " + e.message); }
        }
    }
    return rc;
}

i64 do_rmdir(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("rmdir", "a folder name is needed"); }
    i64 rc = 0;
    for i in 0..ops.len {
        Result<i64, Error> r = Dir::remove(ops[i]);
        switch r {
            Result::Ok(v): rc = rc;
            Result::Err(e): rc = fail("rmdir", e.message);
        }
    }
    return rc;
}

i64 do_touch(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("touch", "a file name is needed"); }
    i64 rc = 0;
    for i in 0..ops.len {
        if !Fs::exists(ops[i]) {
            Result<i64, Error> r = Fs::write_text(ops[i], "");
            switch r {
                Result::Ok(v): rc = rc;
                Result::Err(e): rc = fail("touch", ops[i] + ": " + e.message);
            }
        }
    }
    return rc;
}

// copies one file byte for byte; an executable stays executable. Returns 0 or 1 (the message is printed)
i64 copy_file(String app, String from, String to) {
    String data = "";
    if from == "-" { data = stdin_all(); }
    else {
        Result<String, Error> r = Fs::read_bytes(from);
        switch r {
            Result::Ok(v): data = v;
            Result::Err(e): return fail(app, from + ": " + e.message);
        }
    }
    Result<i64, Error> w = Fs::write_bytes(to, data);
    switch w {
        Result::Ok(v): data = data;
        Result::Err(e): return fail(app, to + ": " + e.message);
    }
    char st[128];
    if from != "-" && Sys::stat(from.c(), @st) == 0 {
        i64 mode = (st[16] & 255) | ((st[17] & 255) << 8);
        Sys::chmod(to.c(), mode & 511);
    }
    return 0;
}

// copies a folder and everything in it (links are copied as what they point to only when they are files; a link to a folder is skipped, so there is no loop)
i64 copy_tree(String app, String from, String to, i64 depth) {
    if depth > 64 { return fail(app, from + ": the folders are nested too deep"); }
    i64 rc = 0;
    if !Dir::exists(to) {
        switch Dir::make(to) {
            Result::Ok(v): rc = rc;
            Result::Err(e): return fail(app, to + ": " + e.message);
        }
    }
    switch Dir::list(from) {
        Result::Ok(names): {
            for i in 0..names.len {
                String src = Path::join(from, names[i]);
                String dst = Path::join(to, names[i]);
                if Dir::exists(src) {
                    if is_link(src) { continue; }
                    if copy_tree(app, src, dst, depth + 1) != 0 { rc = 1; }
                } else if copy_file(app, src, dst) != 0 { rc = 1; }
            }
        }
        Result::Err(e): return fail(app, from + ": " + e.message);
    }
    return rc;
}

// cp for one source: to is the name given on the line (a folder: the source goes into it)
i64 cp_one(String from, String to0, bool deep, bool verbose, bool noclobber) {
    String to = to0;
    if needs_root(to) { return need_root_fail("cp", to); }
    if Dir::exists(from) {
        if !deep { return fail("cp", from + ": is a folder (cp -r copies a folder and what is in it)"); }
        if Dir::exists(to) { to = Path::join(to, Path::name(from)); }
        String inner = from + "/";
        if to == from || to.starts_with(inner) { return fail("cp", "cannot copy a folder into itself"); }
        if noclobber && Fs::exists(to) { return 0; }
        if verbose { cout << from << " -> " << to << "\n"; }
        return copy_tree("cp", from, to, 0);
    }
    if Dir::exists(to) { to = Path::join(to, Path::name(from)); }
    if noclobber && Fs::exists(to) { return 0; }
    if verbose { cout << from << " -> " << to << "\n"; }
    return copy_file("cp", from, to);
}

// cp [-r] [-v] [-n] FROM... TO   (with several sources TO is a folder)
i64 do_cp(String[] a) {
    bool deep = has_flag(a, 'r') || has_flag(a, 'R');
    bool verbose = has_flag(a, 'v');
    bool noclobber = has_flag(a, 'n');
    String[] ops = operands(a, false);
    if ops.len < 2 { return fail("cp", "usage: cp [-r -v -n] FROM... TO   (several sources: TO is a folder; a file is copied byte for byte, also a song or a picture; -r copies a folder; -n keeps a file that is there)"); }
    String to = ops[ops.len - 1];
    if ops.len > 2 && !Dir::exists(to) { return fail("cp", to + ": is not a folder (several files go into a folder)"); }
    i64 rc = 0;
    for i in 0..ops.len - 1 {
        if cp_one(ops[i], to, deep, verbose, noclobber) != 0 { rc = 1; }
    }
    return rc;
}

// mv for one source: a rename; when the other drive is meant (error 18: the system cannot rename between drives, for example f:/ and 0:/) the file or
// folder is copied and the old one removed, but only after the copy was made without an error
i64 mv_one(String from, String to0, bool verbose, bool noclobber) {
    String to = to0;
    if needs_root(to) { return need_root_fail("mv", to); }
    if needs_root(from) { return need_root_fail("mv", from); }
    if Dir::exists(to) { to = Path::join(to, Path::name(from)); }
    if to == from { return 0; }
    if noclobber && Fs::exists(to) { return 0; }
    String inner = from + "/";
    if Dir::exists(from) && to.starts_with(inner) { return fail("mv", "cannot move a folder into itself"); }
    if verbose { cout << from << " -> " << to << "\n"; }
    String why = "";
    switch Fs::rename(from, to) {
        Result::Ok(v): return 0;
        Result::Err(e): why = e.message;
    }
    if !why.contains("error 18") { return fail("mv", from + ": " + why); }
    i64 rc = 0;
    if Dir::exists(from) {
        rc = copy_tree("mv", from, to, 0);
        if rc == 0 && remove_tree(from) != 0 { rc = fail("mv", from + ": copied, but the old folder could not be removed completely"); }
    } else {
        rc = copy_file("mv", from, to);
        if rc == 0 {
            switch Fs::remove(from) {
                Result::Ok(v): rc = rc;
                Result::Err(e): rc = fail("mv", from + ": copied, but the old file could not be removed: " + e.message);
            }
        }
    }
    return rc;
}

// mv [-v] [-n] FROM... TO   (with several sources TO is a folder)
i64 do_mv(String[] a) {
    bool verbose = has_flag(a, 'v');
    bool noclobber = has_flag(a, 'n');
    String[] ops = operands(a, false);
    if ops.len < 2 { return fail("mv", "usage: mv [-v -n] FROM... TO   (several sources: TO is a folder; -n keeps a file that is there)"); }
    String to = ops[ops.len - 1];
    if ops.len > 2 && !Dir::exists(to) { return fail("mv", to + ": is not a folder (several files go into a folder)"); }
    i64 rc = 0;
    for i in 0..ops.len - 1 {
        if mv_one(ops[i], to, verbose, noclobber) != 0 { rc = 1; }
    }
    return rc;
}

// ---------------------------------------------------------------- jq: pick things out of JSON
// jq [-r] [-c] FILTER [FILE]   FILTER: a path (.a.b[0].c  .[]  .["key"]), stages joined by |, and length keys type not select(PATH == VALUE)
// Every value travels as JSON text; a step parses it, takes the node and writes it back.
String jq_pretty(String t, i64 indent_step) {
    String out = "";
    i64 depth = 0;
    bool in_str = false;
    i64 i = 0;
    while i < t.len {
        i64 c = t[i];
        if in_str {
            out.push(c);
            if c == 92 { i += 1; if i < t.len { out.push(t[i]); } }
            else if c == 34 { in_str = false; }
        } else if c == 34 {
            in_str = true;
            out.push(c);
        } else if c == 123 || c == 91 {
            bool empty = i + 1 < t.len && (t[i + 1] == 125 || t[i + 1] == 93);
            out.push(c);
            if empty { i += 1; out.push(t[i]); }
            else { depth += 1; out.push(10); for k in 0..depth * indent_step { out.push(32); } }
        } else if c == 125 || c == 93 {
            depth -= 1;
            out.push(10);
            for k in 0..depth * indent_step { out.push(32); }
            out.push(c);
        } else if c == 44 {
            out.push(c);
            out.push(10);
            for k in 0..depth * indent_step { out.push(32); }
        } else if c == 58 {
            out.push(c);
            out.push(32);
        } else {
            out.push(c);
        }
        i += 1;
    }
    return out;
}

// one step of a path on a JSON text: the key, or the index, or "[]" for every element; the results are added to out
void jq_step(String text, String kind, String arg, String[] out) {
    Result<JsonDoc, Error> pr = Json::parse(text);
    switch pr {
        Result::Ok(d): {
            i64 n = d.root();
            i64 k = d.kind_of(n);
            if kind == "key" {
                if k == 6 { i64 c = d.get(n, arg); if c >= 0 { out.push(d.dump(c)); } else { out.push("null"); } }
                else if k == 0 { out.push("null"); }
            } else if kind == "idx" {
                if k == 5 {
                    i64 ix = arg.to_int();
                    i64 len = d.len(n);
                    if ix < 0 { ix = len + ix; }
                    if ix >= 0 && ix < len { out.push(d.dump(d.at(n, ix))); } else { out.push("null"); }
                }
            } else if kind == "all" {
                if k == 5 { for i in 0..d.len(n) { out.push(d.dump(d.at(n, i))); } }
                else if k == 6 {
                    i64 c = d.first[n];
                    while c >= 0 { out.push(d.dump(c)); c = d.next[c]; }
                }
            }
        }
        Result::Err(e): { cerr << "jq: not valid JSON: " << e.message << "\n"; }
    }
}

// the path ".a.b[0][]" applied to a JSON text
String[] jq_path(String path, String input) {
    String[] cur = arr(4);
    cur.push(input + "");
    i64 i = 0;
    while i < path.len {
        String kind = "";
        String arg = "";
        i64 c = path[i];
        if c == 46 {
            i += 1;
            if i < path.len && path[i] == 34 {
                i64 j = i + 1;
                while j < path.len && path[j] != 34 { arg.push(path[j]); j += 1; }
                i = j + 1;
                kind = "key";
            } else if i < path.len && path[i] != 46 && path[i] != 91 {
                while i < path.len && path[i] != 46 && path[i] != 91 && path[i] != 63 { arg.push(path[i]); i += 1; }
                kind = "key";
            } else { continue; }
        } else if c == 91 {
            i += 1;
            if i < path.len && path[i] == 93 { kind = "all"; i += 1; }
            else if i < path.len && path[i] == 34 {
                i += 1;
                while i < path.len && path[i] != 34 { arg.push(path[i]); i += 1; }
                i += 2;
                kind = "key";
            } else {
                while i < path.len && path[i] != 93 { arg.push(path[i]); i += 1; }
                i += 1;
                kind = "idx";
            }
        } else if c == 63 { i += 1; continue; }
        else { cerr << "jq: cannot read the filter at: " << path.slice(i, path.len) << "\n"; String[] none = arr(1); return none; }
        String[] next = arr(cur.len + 1);
        for v in 0..cur.len { jq_step(cur[v], kind, arg, next); }
        cur = next;
    }
    return cur;
}

// a JSON text made the same way (a number 1.0 and 1 are the same)
String jq_norm(String t) {
    Result<JsonDoc, Error> pr = Json::parse(t);
    switch pr {
        Result::Ok(d): { return d.dump(d.root()); }
        Result::Err(e): { return t; }
    }
    return t;
}

bool jq_truthy(String t) { return t != "null" && t != "false"; }

// a condition: PATH, or PATH OP VALUE  (== != < > <= >=)
bool jq_cond(String cond, String input) {
    String[] ops = "== != <= >= < >".split(" ");
    for o in 0..6 {
        String op = ops[o] + "";
        i64 at = cond.find(op);
        if at > 0 {
            String left = cond.slice(0, at).trim();
            String right = cond.slice(at + op.len, cond.len).trim();
            String[] lv = jq_path(left, input);
            if lv.len == 0 { return false; }
            String a = jq_norm(lv[0]);
            String b = jq_norm(right);
            if op == "==" { return a == b; }
            if op == "!=" { return a != b; }
            double x = a.to_double();
            double y = b.to_double();
            if op == "<" { return x < y; }
            if op == ">" { return x > y; }
            if op == "<=" { return x <= y; }
            return x >= y;
        }
    }
    String[] pv = jq_path(cond.trim(), input);
    if pv.len == 0 { return false; }
    return jq_truthy(pv[0]);
}

String[] jq_stage(String st, String[] inputs) {
    String[] out = arr(inputs.len + 1);
    String s = st.trim();
    for v in 0..inputs.len {
        String in0 = inputs[v];
        if s == "." || s.len == 0 { out.push(in0 + ""); }
        else if s.starts_with(".") { String[] r = jq_path(s, in0); for q in 0..r.len { out.push(r[q] + ""); } }
        else if s == "length" || s == "keys" || s == "type" || s == "not" {
            Result<JsonDoc, Error> pr = Json::parse(in0);
            switch pr {
                Result::Ok(d): {
                    i64 n = d.root();
                    i64 k = d.kind_of(n);
                    if s == "length" {
                        if k == 5 || k == 6 { out.push(str(d.len(n))); }
                        else if k == 4 { out.push(str(d.text(n).len)); }
                        else if k == 0 { out.push("0"); }
                        else { out.push(in0 + ""); }
                    } else if s == "type" {
                        String tn = "null";
                        if k == 1 || k == 2 { tn = "boolean"; }
                        else if k == 3 { tn = "number"; }
                        else if k == 4 { tn = "string"; }
                        else if k == 5 { tn = "array"; }
                        else if k == 6 { tn = "object"; }
                        out.push("\"" + tn + "\"");
                    } else if s == "not" {
                        if jq_truthy(in0) { out.push("false"); } else { out.push("true"); }
                    } else {
                        String ks = "[";
                        i64 c = d.first[n];
                        bool firstk = true;
                        while k == 6 && c >= 0 {
                            if !firstk { ks.push(','); }
                            ks.append(Json::quote(d.key[c]));
                            firstk = false;
                            c = d.next[c];
                        }
                        ks.push(']');
                        out.push(ks);
                    }
                }
                Result::Err(e): { cerr << "jq: not valid JSON\n"; }
            }
        } else if s.starts_with("select(") && s.ends_with(")") {
            if jq_cond(s.slice(7, s.len - 1), in0) { out.push(in0 + ""); }
        } else { cerr << "jq: unknown filter: " << s << "\n"; }
    }
    return out;
}

// the filter split at the | that is not inside brackets or quotes
String[] jq_stages(String f) {
    String[] r = arr(4);
    String cur = "";
    i64 depth = 0;
    bool q = false;
    for i in 0..f.len {
        i64 c = f[i];
        if c == 34 { q = !q; }
        if !q && (c == 40 || c == 91) { depth += 1; }
        if !q && (c == 41 || c == 93) { depth -= 1; }
        if !q && depth == 0 && c == 124 { r.push(cur + ""); cur = ""; }
        else { cur.push(c); }
    }
    r.push(cur + "");
    return r;
}

i64 do_jq(String[] a) {
    bool raw = has_flag(a, 'r');
    bool compact = has_flag(a, 'c');
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("jq", "usage: jq [-r -c] FILTER [FILE]   (.a.b[0]  .[]  keys  length  select(.k == \"v\")  stages joined by |)"); }
    String filter = ops[0];
    i64 rc = 0;
    String text = "";
    if ops.len > 1 { text = load("jq", ops[1], @rc); } else { text = stdin_all(); }
    if rc != 0 { return rc; }
    String[] cur = arr(2);
    cur.push(text.trim() + "");
    String[] st = jq_stages(filter);
    for i in 0..st.len { cur = jq_stage(st[i], cur); }
    for v in 0..cur.len {
        String o = cur[v];
        if raw && o.len >= 2 && o[0] == 34 {
            Result<JsonDoc, Error> pr = Json::parse(o);
            switch pr {
                Result::Ok(d): { cout << d.text(d.root()) << "\n"; }
                Result::Err(e): { cout << o << "\n"; }
            }
        } else if compact { cout << o << "\n"; }
        else { cout << jq_pretty(o, 2) << "\n"; }
    }
    return rc;
}

i64 do_grep(String[] a) {
    bool number = has_flag(a, 'n');
    bool invert = has_flag(a, 'v');
    bool icase = has_flag(a, 'i');
    String[] ops = operands(a, false);
    if ops.len == 0 { return fail("grep", "usage: grep [-n -v -i] PATTERN [FILE]"); }
    String pat = ops[0];
    if icase { pat = pat.lower(); }
    i64 rc = 1;
    i64 errs = 0;
    i64 nfiles = ops.len - 1;
    if ops.len == 1 && Sys::isatty(0) == 0 { jerr << "grep: a file name is needed (or text piped in)\n"; return 2; }
    if nfiles == 0 { ops.push("-"); nfiles = 1; }
    for p in 1..ops.len {
        String[] ls = lines_of(load("grep", ops[p], @errs));
        for i in 0..ls.len {
            String line = ls[i];
            if icase { line = line.lower(); }
            bool hit = Regex::find(pat, line) >= 0;
            if hit != invert {
                rc = 0;
                if nfiles > 1 { jout << ops[p] << ":"; }
                if number { jout << i + 1 << ":"; }
                jout << ls[i] << "\n";
            }
        }
    }
    if errs != 0 { return 2; }
    return rc;
}

i64 do_sort(String[] a) {
    String[] ops = operands(a, false);
    if needs_file("sort", ops) { return 2; }
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    String[] all = arr(16);
    for p in 0..ops.len {
        String[] ls = lines_of(load("sort", ops[p], @rc));
        for i in 0..ls.len { all.push(ls[i]); }
    }
    all.sort();
    bool rev = has_flag(a, 'r');
    if rev { for i in 0..all.len { jout << all[all.len - 1 - i] << "\n"; } }
    else { for i in 0..all.len { jout << all[i] << "\n"; } }
    return rc;
}

i64 do_uniq(String[] a) {
    String[] ops = operands(a, false);
    if needs_file("uniq", ops) { return 2; }
    if ops.len == 0 { ops.push("-"); }
    i64 rc = 0;
    String[] ls = lines_of(load("uniq", ops[0], @rc));
    for i in 0..ls.len {
        if i == 0 || ls[i] != ls[i - 1] { jout << ls[i] << "\n"; }
    }
    return rc;
}

i64 do_tee(String[] a) {
    bool append = has_flag(a, 'a');
    String[] ops = operands(a, false);
    String t = stdin_all();
    jout << t;
    i64 rc = 0;
    for i in 0..ops.len {
        Result<i64, Error> r = Fs::write_text(ops[i], t);
        if append { r = Fs::append_text(ops[i], t); }
        switch r {
            Result::Ok(v): rc = rc;
            Result::Err(e): rc = fail("tee", ops[i] + ": " + e.message);
        }
    }
    return rc;
}

i64 do_seq(String[] a) {
    String[] ops = operands(a, false);
    i64 lo = 1;
    i64 hi = 0;
    if ops.len == 1 { hi = ops[0].to_int(); }
    else if ops.len >= 2 { lo = ops[0].to_int(); hi = ops[1].to_int(); }
    else { return fail("seq", "usage: seq [FIRST] LAST"); }
    for i in lo..hi + 1 { jout << i << "\n"; }
    return 0;
}

i64 do_basename(String[] a) {
    if a.len < 2 { return fail("basename", "a path is needed"); }
    jout << Path::name(a[1]) << "\n";
    return 0;
}

i64 do_dirname(String[] a) {
    if a.len < 2 { return fail("dirname", "a path is needed"); }
    jout << Path::parent(a[1]) << "\n";
    return 0;
}

i64 do_sleep(String[] a) {
    if a.len < 2 { return fail("sleep", "seconds are needed"); }
    Time::sleep_ms(a[1].to_int() * 1000);
    return 0;
}

i64 do_clear() {
    jout << (char)27 << "[2J" << (char)27 << "[H";
    return 0;
}

i64 do_env() {
    i64 ne = 0;
    while Sys::arg(Sys::argc() + 1 + ne) != null {
        String e = "";
        e.append((char^)Sys::arg(Sys::argc() + 1 + ne));
        jout << e << "\n";
        ne += 1;
    }
    return 0;
}

i64 do_kill(String[] a) {
    i64 sig = 15;
    i64 rc = 0;
    i64 count = 0;
    for i in 1..a.len {
        String w = a[i];
        if w.len > 1 && w[0] == '-' {
            String n = w.slice(1, w.len);
            if is_digits(n) { sig = n.to_int(); }
            else if n == "KILL" { sig = 9; }
            else if n == "TERM" { sig = 15; }
            else if n == "INT" { sig = 2; }
            else if n == "HUP" { sig = 1; }
            else if n == "STOP" { sig = 19; }
            else if n == "CONT" { sig = 18; }
            else { return fail("kill", "unknown signal " + n); }
        } else if is_digits(w) {
            count += 1;
            if Sys::call(129, w.to_int(), sig, 0, 0, 0, 0) < 0 { rc = fail("kill", w + ": no such process (or not yours)"); }
        } else { return fail("kill", "usage: kill [-9] PID ..."); }
    }
    if count == 0 { return fail("kill", "usage: kill [-9] PID ..."); }
    return rc;
}

bool is_digits(String s) {
    if s.len == 0 { return false; }
    for i in 0..s.len { if s[i] < '0' || s[i] > '9' { return false; } }
    return true;
}

i64 do_help() {
    jout << "jbox commands: dir tree find date du stat xargs sed less man ln chmod cut tr diff cat head tail wc nl tac rev yes uname hostname whoami realpath base64 sha256sum cmp paste fold printf uptime free nproc mkdir rmdir rm touch cp mv grep sort jq patch uniq tee seq basename dirname sleep clear env kill true false df ps hex\n";
    jout << "flags: dir -a -l   tree -a -d -s -L N   find -name P -type f|d -maxdepth N   ln -s   cut -d X -f N   tr -d   head/tail -n N   wc -l -w -c   mkdir -p   rm -f -r   cp -r -v -n   mv -v -n   diff -u   patch -p N -R -i FILE   jq -r -c FILTER   grep -n -v -i   sort -r   tee -a\n";
    jout << "more: man NAME shows a longer text with examples for cp mv rm diff patch jq\n";
    return 0;
}

// jbox --install [DIR]: a link in DIR for every command (DIR = the folder of jbox), so that any program or shell finds them in the PATH
// tree [-a] [-L N] [FOLDER]: the folders and files under a folder, drawn as a tree (the root first); -a also the names that start with a dot
bool tree_dirs_only;        // -d : folders only
bool tree_sizes;            // -s : the size of each file
bool tree_denied;           // a folder could not be read

String size_text(i64 n) {
    if n < 1024 { return str(n) + " B"; }
    if n < 1024 * 1024 { return str(n / 1024) + " KB"; }
    return str(n / (1024 * 1024)) + " MB";
}

i64 tree_walk(String dir, String prefix, bool all, i64 depth, i64 maxd, i64^ nd, i64^ nf) {
    if depth >= maxd { return 0; }
    Result<String[], Error> r = Dir::list(dir);
    if !r.is_ok() { jout << prefix << "`-- [cannot read this folder]\n"; tree_denied = true; return 1; }
    String[] names = r.take();
    names.sort();
    String[] shown = arr(names.len + 1);
    for i in 0..names.len {
        if !all && names[i].len > 0 && names[i][0] == '.' { continue; }
        if tree_dirs_only {
            String pth = Path::join(dir, names[i]);
            if !Dir::exists(pth) { continue; }
        }
        shown.push(names[i] + "");
    }
    for i in 0..shown.len {
        bool last = i == shown.len - 1;
        String full = Path::join(dir, shown[i]);
        bool isdir = Dir::exists(full);
        String mark = "|-- ";
        if last { mark = "`-- "; }
        if isdir { jout << prefix << mark << shown[i] << "/\n"; nd[0] += 1; }
        else {
            String extra = "";
            if tree_sizes { Result<i64, Error> sz = Fs::size(full); if sz.is_ok() { extra = "  (" + size_text(sz.take()) + ")"; } }
            jout << prefix << mark << shown[i] << extra << "\n";
            nf[0] += 1;
        }
        if isdir {
            String next = prefix + "|   ";
            if last { next = prefix + "    "; }
            tree_walk(full, next, all, depth + 1, maxd, nd, nf);
        }
    }
    return 0;
}
i64 do_tree(String[] a) {
    bool all = has_flag(a, 'a');
    tree_dirs_only = has_flag(a, 'd');
    tree_sizes = has_flag(a, 's');
    tree_denied = false;
    i64 maxd = 64;
    String root = ".";
    i64 i = 1;
    while i < a.len {
        if a[i] == "-L" && i + 1 < a.len { maxd = a[i + 1].to_int(); i += 2; continue; }
        if !is_flag(a[i]) { root = a[i] + ""; }
        i += 1;
    }
    if !Dir::exists(root) { return fail("tree", root + ": no such folder"); }
    jout << root << "\n";
    i64 nd = 0;
    i64 nf = 0;
    i64 rc = tree_walk(root, "", all, 0, maxd, @nd, @nf);
    jout << "\n" << nd << " folders, " << nf << " files\n";
    if tree_denied && nd == 0 && nf == 0 { jerr << "tree: " << root << " cannot be listed here (Android hides it); try a folder under $HOME or $PREFIX\n"; }
    return rc;
}

// ---------------------------------------------------------------- more commands: find ln chmod cut tr diff
bool glob_match(String p, i64 pi, String s, i64 si) {
    while pi < p.len {
        if p[pi] == '*' {
            for k in si..s.len + 1 { if glob_match(p, pi + 1, s, k) { return true; } }
            return false;
        }
        if si >= s.len { return false; }
        if p[pi] != '?' && p[pi] != s[si] { return false; }
        pi += 1;
        si += 1;
    }
    return si == s.len;
}

// find [FOLDER] [-name PATTERN] [-type f|d] [-maxdepth N]
void find_walk(String dir, String pat, char kind, i64 depth, i64 maxd) {
    Result<String[], Error> r = Dir::list(dir);
    if !r.is_ok() { return; }
    String[] names = r.take();
    names.sort();
    for i in 0..names.len {
        String full = Path::join(dir, names[i]);
        bool isdir = Dir::exists(full);
        bool ok = true;
        if pat.len > 0 && !glob_match(pat, 0, names[i], 0) { ok = false; }
        if kind == 'f' && isdir { ok = false; }
        if kind == 'd' && !isdir { ok = false; }
        if ok { jout << full << "\n"; }
        if isdir && depth + 1 < maxd { find_walk(full, pat, kind, depth + 1, maxd); }
    }
}
i64 do_find(String[] a) {
    String root = ".";
    String pat = "";
    char kind = 0;
    i64 maxd = 64;
    i64 i = 1;
    while i < a.len {
        if a[i] == "-name" && i + 1 < a.len { pat = a[i + 1] + ""; i += 2; }
        else if a[i] == "-type" && i + 1 < a.len { kind = a[i + 1][0]; i += 2; }
        else if a[i] == "-maxdepth" && i + 1 < a.len { maxd = a[i + 1].to_int(); i += 2; }
        else { root = a[i] + ""; i += 1; }
    }
    if !Dir::exists(root) { return fail("find", root + ": no such folder"); }
    find_walk(root, pat, kind, 0, maxd);
    return 0;
}

i64 do_ln(String[] a) {
    bool sym = has_flag(a, 's');
    String[] ops = operands(a, false);
    if ops.len != 2 { return fail("ln", "usage: ln -s TARGET LINK"); }
    if !sym { return fail("ln", "only symbolic links (ln -s TARGET LINK) are made here"); }
    if Sys::call(36, (i64)ops[0].c(), 0 - 100, (i64)ops[1].c(), 0, 0, 0) < 0 { return fail("ln", "cannot make " + ops[1]); }
    return 0;
}

i64 do_chmod(String[] a) {
    String[] ops = operands(a, false);
    if ops.len < 2 { return fail("chmod", "usage: chmod 755 FILE   or   chmod +x FILE"); }
    i64 rc = 0;
    for i in 1..ops.len {
        i64 mode = 0;
        if ops[0] == "+x" || ops[0] == "a+x" || ops[0] == "u+x" { mode = 493; }
        else if ops[0] == "-x" { mode = 420; }
        else {
            for k in 0..ops[0].len { mode = mode * 8 + (ops[0][k] - '0'); }
        }
        if Sys::chmod(ops[i].c(), mode) < 0 { rc = fail("chmod", "cannot change " + ops[i]); }
    }
    return rc;
}

// cut -d DELIM -f N [FILE]  (one field; fields count from 1)
i64 do_cut(String[] a) {
    String delim = "\t";
    i64 field = 1;
    String file = "-";
    i64 i = 1;
    while i < a.len {
        if a[i] == "-d" && i + 1 < a.len { delim = a[i + 1] + ""; i += 2; }
        else if a[i] == "-f" && i + 1 < a.len { field = a[i + 1].to_int(); i += 2; }
        else if a[i].len > 2 && a[i].starts_with("-d") { delim = a[i].slice(2, a[i].len); i += 1; }
        else if a[i].len > 2 && a[i].starts_with("-f") { field = a[i].slice(2, a[i].len).to_int(); i += 1; }
        else { file = a[i] + ""; i += 1; }
    }
    i64 rc = 0;
    String[] ls = lines_of(load("cut", file, @rc));
    for k in 0..ls.len {
        String[] parts = ls[k].split(delim);
        if field >= 1 && field <= parts.len { jout << parts[field - 1] << "\n"; } else { jout << "\n"; }
    }
    return rc;
}

// tr FROM TO : each letter of FROM becomes the letter at the same place of TO (from the standard input); tr -d SET deletes
i64 do_tr(String[] a) {
    String[] ops = operands(a, false);
    bool del = has_flag(a, 'd');
    if (del && ops.len < 1) || (!del && ops.len < 2) { return fail("tr", "usage: tr FROM TO   or   tr -d SET"); }
    String text = stdin_all();
    String out = "";
    for i in 0..text.len {
        char c = text[i];
        i64 at = 0 - 1;
        for k in 0..ops[0].len { if ops[0][k] == c && at < 0 { at = k; } }
        if at < 0 { out.push(c); }
        else if !del { char t = ops[1][ops[1].len - 1]; if at < ops[1].len { t = ops[1][at]; } out.push(t); }
    }
    jout << out;
    return 0;
}

// diff A B : the lines that differ ("< line" only in A, "> line" only in B), found with the longest common part
// the edit script of two files: ot[k] is 32 (the same line), 45 (only in the first) or 43 (only in the second); ol[k] is the line
void diff_script(String[] x, String[] y, i64[] ot, String[] ol) {
    i64 n = x.len;
    i64 m = y.len;
    i64[] lcs = arr((n + 1) * (m + 1) + 1);
    for i in 0..(n + 1) * (m + 1) { lcs.push(0); }
    i64 i = n - 1;
    while i >= 0 {
        i64 j = m - 1;
        while j >= 0 {
            if x[i] == y[j] { lcs[i * (m + 1) + j] = lcs[(i + 1) * (m + 1) + j + 1] + 1; }
            else {
                i64 d1 = lcs[(i + 1) * (m + 1) + j];
                i64 d2 = lcs[i * (m + 1) + j + 1];
                if d1 >= d2 { lcs[i * (m + 1) + j] = d1; } else { lcs[i * (m + 1) + j] = d2; }
            }
            j -= 1;
        }
        i -= 1;
    }
    i64 p = 0;
    i64 q = 0;
    while p < n || q < m {
        if p < n && q < m && x[p] == y[q] { ot.push(32); ol.push(x[p] + ""); p += 1; q += 1; }
        else if q >= m || (p < n && lcs[(p + 1) * (m + 1) + q] >= lcs[p * (m + 1) + q + 1]) { ot.push(45); ol.push(x[p] + ""); p += 1; }
        else { ot.push(43); ol.push(y[q] + ""); q += 1; }
    }
}

// diff -u: the hunks of the changes with 3 lines of the same around them (the form that patch reads)
i64 diff_unified(String name1, String name2, String[] x, String[] y, i64 ctx) {
    i64[] ot = arr(x.len + y.len + 2);
    String[] ol = arr(x.len + y.len + 2);
    diff_script(x, y, ot, ol);
    i64 total = ot.len;
    i64 first = 0 - 1;
    for k in 0..total { if ot[k] != 32 && first < 0 { first = k; } }
    if first < 0 { return 0; }
    jout << "--- " << name1 << "\n+++ " << name2 << "\n";
    i64 k = first;
    while k < total {
        if ot[k] == 32 { k += 1; continue; }
        // a hunk: from ctx lines before the change to ctx lines after the last change that is close to the next
        i64 s = k - ctx;
        if s < 0 { s = 0; }
        i64 last = k;
        i64 scan = k;
        while scan < total {
            if ot[scan] != 32 { last = scan; }
            if scan - last > 2 * ctx { break; }
            scan += 1;
        }
        i64 e = last + ctx + 1;
        if e > total { e = total; }
        i64 xb = 0;
        i64 yb = 0;
        for t in 0..s {
            if ot[t] != 43 { xb += 1; }
            if ot[t] != 45 { yb += 1; }
        }
        i64 xl = 0;
        i64 yl = 0;
        for t in s..e {
            if ot[t] != 43 { xl += 1; }
            if ot[t] != 45 { yl += 1; }
        }
        i64 xs = xb + 1;
        i64 ys = yb + 1;
        if xl == 0 { xs = xb; }
        if yl == 0 { ys = yb; }
        jout << "@@ -" << xs << "," << xl << " +" << ys << "," << yl << " @@\n";
        for t in s..e {
            String sign = " ";
            if ot[t] == 45 { sign = "-"; }
            if ot[t] == 43 { sign = "+"; }
            jout << sign << ol[t] << "\n";
        }
        k = e;
    }
    return 1;
}

i64 do_diff(String[] a) {
    bool unified = has_flag(a, 'u');
    String[] ops = operands(a, false);
    if ops.len != 2 { return fail("diff", "usage: diff [-u] FILE1 FILE2"); }
    i64 rc = 0;
    String[] x = lines_of(load("diff", ops[0], @rc));
    String[] y = lines_of(load("diff", ops[1], @rc));
    if rc != 0 { return 2; }
    if unified { return diff_unified(ops[0], ops[1], x, y, 3); }
    i64[] ot = arr(x.len + y.len + 2);
    String[] ol = arr(x.len + y.len + 2);
    diff_script(x, y, ot, ol);
    i64 diffs = 0;
    for k in 0..ot.len {
        if ot[k] == 45 { jout << "< " << ol[k] << "\n"; diffs += 1; }
        else if ot[k] == 43 { jout << "> " << ol[k] << "\n"; diffs += 1; }
    }
    if diffs > 0 { return 1; }
    return 0;
}

// ---------------------------------------------------------------- patch: apply the changes of a unified diff (diff -u, git diff)
// the number that starts at s[at] (at is moved past it)
i64 patch_num(String s, i64^ at) {
    i64 n = 0;
    while at[0] < s.len && s[at[0]] >= 48 && s[at[0]] <= 57 { n = n * 10 + (s[at[0]] - 48); at[0] += 1; }
    return n;
}

// the name of a file from a --- / +++ line: the first word, p folders cut off
String patch_name(String line, i64 strip) {
    String rest = line.slice(4, line.len);
    i64 tab = rest.find("\t");
    if tab >= 0 { rest = rest.slice(0, tab); }
    String r = rest.trim();
    i64 cut = 0;
    while cut < strip {
        i64 sl = r.find("/");
        if sl < 0 { break; }
        r = r.slice(sl + 1, r.len);
        cut += 1;
    }
    return r;
}

// does the old text of a hunk stand in the lines at pos?
bool patch_fits(String[] lines, String[] old, i64 pos) {
    if pos < 0 || pos + old.len > lines.len { return false; }
    for i in 0..old.len { if lines[pos + i] != old[i] { return false; } }
    return true;
}

i64 do_patch(String[] a) {
    bool reverse = has_flag(a, 'R');
    i64 strip = 0;
    String infile = "-";
    String target = "";
    i64 ai = 1;
    while ai < a.len {
        if a[ai].starts_with("-p") && a[ai].len > 2 { strip = a[ai].slice(2, a[ai].len).to_int(); }
        else if a[ai] == "-p" && ai + 1 < a.len { strip = a[ai + 1].to_int(); ai += 1; }
        else if (a[ai] == "-i" || a[ai] == "--input") && ai + 1 < a.len { infile = a[ai + 1]; ai += 1; }
        else if !is_flag(a[ai]) { target = a[ai] + ""; }
        ai += 1;
    }
    i64 rc = 0;
    String[] dl = lines_of(load("patch", infile, @rc));
    if rc != 0 { return 2; }
    i64 li = 0;
    i64 bad = 0;
    i64 files = 0;
    while li < dl.len {
        if !(dl[li].starts_with("--- ") && li + 1 < dl.len && dl[li + 1].starts_with("+++ ")) { li += 1; continue; }
        String oldname = patch_name(dl[li], strip);
        String newname = patch_name(dl[li + 1], strip);
        String path = newname;
        if reverse { path = oldname; }
        if newname == "/dev/null" || oldname == "/dev/null" { path = newname; if path == "/dev/null" { path = oldname; } }
        if target.len > 0 { path = target; }
        li += 2;
        String[] lines = arr(8);
        if Fs::exists(path) { lines = lines_of(load("patch", path, @rc)); }
        if rc != 0 { return 2; }
        i64 shift = 0;
        i64 hunk = 0;
        bool failed = false;
        while li < dl.len && dl[li].starts_with("@@") {
            hunk += 1;
            String h = dl[li];
            i64 hp = h.find("-");
            hp += 1;
            i64 os = patch_num(h, @hp);
            i64 ol = 1;
            if hp < h.len && h[hp] == 44 { hp += 1; ol = patch_num(h, @hp); }
            i64 hq = h.find("+");
            hq += 1;
            i64 ns = patch_num(h, @hq);
            i64 nl = 1;
            if hq < h.len && h[hq] == 44 { hq += 1; nl = patch_num(h, @hq); }
            li += 1;
            String[] old = arr(8);
            String[] fresh = arr(8);
            i64 want_old = ol;
            i64 want_new = nl;
            if reverse { want_old = nl; want_new = ol; }
            while li < dl.len && (old.len < want_old || fresh.len < want_new) {
                String ln = dl[li];
                if ln.len == 0 { ln = " "; }
                i64 c = ln[0];
                String body = ln.slice(1, ln.len) + "";
                if c == 92 { li += 1; continue; }
                if c == 32 { old.push(body); fresh.push(body); }
                else if c == 45 { if reverse { fresh.push(body); } else { old.push(body); } }
                else if c == 43 { if reverse { old.push(body); } else { fresh.push(body); } }
                else { break; }
                li += 1;
            }
            while li < dl.len && dl[li].starts_with("\\") { li += 1; }
            i64 expect = os - 1 + shift;
            if reverse { expect = ns - 1 + shift; }
            if old.len == 0 && (os == 0 || (reverse && ns == 0)) { expect = lines.len; }
            i64 found = 0 - 1;
            i64 d = 0;
            while found < 0 && d <= lines.len + 1 {
                if patch_fits(lines, old, expect + d) { found = expect + d; }
                else if d > 0 && patch_fits(lines, old, expect - d) { found = expect - d; }
                d += 1;
            }
            if found < 0 { cerr << "patch: " << path << ": hunk " << hunk << " does not fit\n"; failed = true; bad += 1; continue; }
            String[] merged = arr(lines.len + fresh.len + 2);
            for i in 0..found { merged.push(lines[i] + ""); }
            for i in 0..fresh.len { merged.push(fresh[i] + ""); }
            for i in found + old.len..lines.len { merged.push(lines[i] + ""); }
            lines = merged;
            shift += fresh.len - old.len;
        }
        if failed { cerr << "patch: " << path << ": not changed\n"; rc = 1; continue; }
        String out = "";
        for i in 0..lines.len { out.append(lines[i]); out.push(10); }
        Result<i64, Error> wr = Fs::write_text(path, out);
        switch wr {
            Result::Ok(v): { files += 1; jout << "patching file " << path << "\n"; }
            Result::Err(e): { rc = fail("patch", path + ": " + e.message); }
        }
    }
    if files == 0 && bad == 0 && rc == 0 { return fail("patch", "no unified diff found (make one with diff -u, or git diff)"); }
    return rc;
}

// ---------------------------------------------------------------- date du xargs sed less stat
i64 do_date(String[] a) {                                       // date [+%s]: the time now (UTC); +%s the seconds since 1970
    i64 ms = Time::now_ms();
    if a.len > 1 && a[1] == "+%s" { jout << ms / 1000 << "\n"; return 0; }
    Date d;
    d.set_unix(ms / 1000);
    jout << d.text() << " UTC\n";
    return 0;
}

i64 du_size(String path) {
    if !Dir::exists(path) {
        Result<i64, Error> r = Fs::size(path);
        if r.is_ok() { return r.unwrap(); }
        return 0;
    }
    i64 total = 0;
    Result<String[], Error> l = Dir::list(path);
    if l.is_ok() {
        String[] names = l.take();
        for i in 0..names.len { total += du_size(Path::join(path, names[i])); }
    }
    return total;
}
i64 do_du(String[] a) {                                         // du [-h] [FOLDER...]: the bytes under each (the sum of the sizes of the files)
    bool human = has_flag(a, 'h');
    String[] ops = operands(a, false);
    if ops.len == 0 { ops.push("."); }
    for i in 0..ops.len {
        i64 n = du_size(ops[i]);
        if human {
            if n >= 1048576 { jout << n / 1048576 << "M\t" << ops[i] << "\n"; }
            else if n >= 1024 { jout << n / 1024 << "K\t" << ops[i] << "\n"; }
            else { jout << n << "\t" << ops[i] << "\n"; }
        } else { jout << n << "\t" << ops[i] << "\n"; }
    }
    return 0;
}

i64 do_stat(String[] a) {
    String[] ops = operands(a, false);
    i64 rc = 0;
    for i in 0..ops.len {
        if Dir::exists(ops[i]) { jout << ops[i] << ": folder\n"; }
        else if Fs::exists(ops[i]) {
            Result<i64, Error> r = Fs::size(ops[i]);
            jout << ops[i] << ": file, " << r.unwrap() << " bytes\n";
        } else { rc = fail("stat", ops[i] + ": no such file or folder"); }
    }
    return rc;
}

// xargs COMMAND [args]: the words of the input are added to the command as arguments (one run for all)
i64 do_xargs(String[] a) {
    if a.len < 2 { return fail("xargs", "usage: xargs COMMAND [args]   (the words of the input become more arguments)"); }
    String text = stdin_all();
    String[] words = text.replace("\n", " ").split(" ");
    String[] argv = arr(a.len + words.len + 1);
    for i in 1..a.len { argv.push(a[i] + ""); }
    for i in 0..words.len { if words[i].len > 0 { argv.push(words[i] + ""); } }
    String[] rest = arr(argv.len);
    for i in 1..argv.len { rest.push(argv[i]); }
    switch Proc::run(argv[0], rest) {
        Result::Ok(code): return code;
        Result::Err(e): return fail("xargs", "cannot run " + argv[0]);
    }
    return 1;
}

// sed 's/old/new/[g]' [FILE]: replaces text in every line (the old text is plain text, not a pattern)
i64 do_sed(String[] a) {
    String[] ops = operands(a, false);
    if ops.len < 1 || ops[0].len < 4 || ops[0][0] != 's' { return fail("sed", "usage: sed 's/old/new/g' [FILE]   (only the replacement s/// is here)"); }
    char sep = ops[0][1];
    String[] parts = ops[0].slice(2, ops[0].len).split(sep);
    if parts.len < 2 { return fail("sed", "bad expression"); }
    String from = parts[0];
    String to = parts[1];
    bool all = parts.len > 2 && parts[2].contains("g");
    String file = "-";
    if ops.len > 1 { file = ops[1] + ""; }
    i64 rc = 0;
    String[] ls = lines_of(load("sed", file, @rc));
    for i in 0..ls.len {
        String l = ls[i];
        if from.len > 0 {
            if all { l = l.replace(from, to); }
            else {
                i64 at = 0;
                bool found = false;
                while at + from.len <= l.len && !found { if l.slice(at, at + from.len) == from { found = true; } else { at += 1; } }
                if found { l = l.slice(0, at) + to + l.slice(at + from.len, l.len); }
            }
        }
        jout << l << "\n";
    }
    return rc;
}

i64 last_shown(i64 top, i64 page, i64 total) { if top + page < total { return top + page; } return total; }

// less FILE: one page at a time; space = next page, Enter = next line, b = back a page, q = quit
// ---------------------------------------------------------------- the pager (less, man)
// the keys come from /dev/tty (the text may come from a pipe); the lines are cut to the width of the screen at a letter, not in the middle of one
String[] wrap_lines(String[] ls, i64[] style, i64 width, i64[] out_style) {
    String[] out = arr(ls.len + 8);
    for i in 0..ls.len {
        String l = ls[i].replace("\t", "    ").replace("\r", "");
        i64 st = 0;
        if i < style.len { st = style[i]; }
        if l.len <= width { out.push(l); out_style.push(st); continue; }
        i64 at = 0;
        while at < l.len {
            i64 to = at + width;
            if to >= l.len { out.push(l.slice(at, l.len)); out_style.push(st); break; }
            while to > at + 1 && (l[to] & 192) == 128 { to -= 1; }                    // not in the middle of a letter
            out.push(l.slice(at, to));
            out_style.push(st);
            at = to;
        }
    }
    return out;
}

String hilite(String line, String pat) {
    if pat.len == 0 { return line; }
    String r = "";
    i64 at = 0;
    String low = line.lower();
    String lp = pat.lower();
    while at < line.len {
        i64 k = Net::http_find_from(low, lp, at);
        if k < 0 { break; }
        r = r + line.slice(at, k) + "\e[7m" + line.slice(k, k + pat.len) + "\e[27m";
        at = k + pat.len;
    }
    return r + line.slice(at, line.len);
}

// shows the lines; style 1 = a heading (bold), 2 = code (grey), 0 = plain
i64 pager(String title, String[] raw, i64[] raw_style) {
    i64 fdin = Sys::open_read("/dev/tty".c());
    if fdin < 0 || Sys::isatty(1) != 0 {
        for i in 0..raw.len { jout << raw[i] << "\n"; }
        return 0;
    }
    char t[64];
    Sys::call(29, fdin, 21505, (i64)@t, 0, 0, 0);
    char rw[64];
    for i in 0..64 { rw[i] = t[i]; }
    rw[12] = rw[12] & 245;
    rw[23] = 1;
    rw[22] = 0;
    Sys::call(29, fdin, 21506, (i64)@rw, 0, 0, 0);
    char w[8];
    Sys::call(29, 1, 21523, (i64)@w, 0, 0, 0);
    i64 rows = (w[0] & 255) | ((w[1] & 255) << 8);
    i64 cols = (w[2] & 255) | ((w[3] & 255) << 8);
    if rows < 4 { rows = 24; }
    if cols < 20 { cols = 80; }
    i64[] st = arr(raw.len + 8);
    String[] ls = wrap_lines(raw, raw_style, cols - 1, st);
    i64 page = rows - 1;
    i64 top = 0;
    String pat = "";
    String note = "";
    String e = "\e";
    jout << e << "[?1049h";
    bool done = false;
    while !done {
        String o = e + "[H";
        for i in 0..page {
            i64 k = top + i;
            String ln = "";
            if k < ls.len {
                ln = hilite(ls[k], pat);
                if st[k] == 1 { ln = e + "[1m" + ln + e + "[22m"; }
                else if st[k] == 2 { ln = e + "[2m" + ln + e + "[22m"; }
            }
            o = o + e + "[2K" + ln + "\r\n";
        }
        i64 pct = 100;
        if ls.len > page { pct = (top + page) * 100 / ls.len; if pct > 100 { pct = 100; } }
        String foot = " " + title + "  " + str(pct) + "%";
        if note.len > 0 { foot = foot + "  " + note; } else { foot = foot + "   (space next, b back, / find, n next match, g top, G end, h help, q quit)"; }
        if foot.len > cols - 1 { foot = foot.slice(0, cols - 1); }
        o = o + e + "[7m" + foot + e + "[0m" + e + "[K";
        jout << o;
        note = "";
        char k[2];
        i64 n = Sys::read(fdin, @k, 1);
        if n <= 0 || k[0] == 'q' { break; }
        i64 c = k[0] & 255;
        if c == 27 {
            if !Input::ready(40) { break; }
            char k2[2];
            Sys::read(fdin, @k2, 1);
            Sys::read(fdin, @k2, 1);
            i64 d = k2[0] & 255;
            if d == 'A' { c = 'k'; } else if d == 'B' { c = 'j'; } else if d == 'H' { c = 'g'; } else if d == 'F' { c = 'G'; }
            else if d == '5' { Sys::read(fdin, @k2, 1); c = 'b'; } else if d == '6' { Sys::read(fdin, @k2, 1); c = ' '; }
            else if d == '1' { Sys::read(fdin, @k2, 1); c = 'g'; } else if d == '4' { Sys::read(fdin, @k2, 1); c = 'G'; }
            else { continue; }
        }
        i64 maxtop = ls.len - page;
        if maxtop < 0 { maxtop = 0; }
        if c == ' ' || c == 'f' { top += page; if top > maxtop { top = maxtop; } }
        else if c == 13 || c == 10 || c == 'j' { if top < maxtop { top += 1; } }
        else if c == 'k' { if top > 0 { top -= 1; } }
        else if c == 'b' { top -= page; if top < 0 { top = 0; } }
        else if c == 'd' { top += page / 2; if top > maxtop { top = maxtop; } }
        else if c == 'u' { top -= page / 2; if top < 0 { top = 0; } }
        else if c == 'g' { top = 0; }
        else if c == 'G' { top = maxtop; }
        else if c == 'h' {
            note = "";
            String[] hl = arr(12);
            hl.push("jbox pager"); hl.push(""); hl.push("space / f   next page        b   back a page"); hl.push("Enter / j   next line        k   back a line (the arrows too)");
            hl.push("d / u       half a page         g / G   top / end"); hl.push("/ TEXT      find (not caring about capitals)     n   next match    N   back");
            hl.push("q           leave"); hl.push("");
            i64[] hs = arr(12);
            for i in 0..hl.len { hs.push(0); }
            hs[0] = 1;
            pager("help", hl, hs);
            jout << e << "[?1049h";
        }
        else if c == '/' {
            jout << e << "[" << rows << ";1H" << e << "[7m/" << e << "[0m" << e << "[K";
            String q = "";
            while true {
                char ch[2];
                if Sys::read(fdin, @ch, 1) <= 0 { break; }
                i64 cc = ch[0] & 255;
                if cc == 13 || cc == 10 { break; }
                if cc == 27 { q = ""; break; }
                if cc == 127 || cc == 8 { if q.len > 0 { q = q.slice(0, q.len - 1); } }
                else { q.push((char)cc); }
                jout << e << "[" << rows << ";1H" << e << "[7m/" << q << e << "[0m" << e << "[K";
            }
            if q.len > 0 { pat = q + ""; }
            c = 'n';
        }
        if c == 'n' || c == 'N' {
            if pat.len == 0 { note = "no search yet: / TEXT"; }
            else {
                bool found = false;
                String lp = pat.lower();
                if c == 'n' {
                    for k2 in (top + 1)..ls.len { if !found { String ll = ls[k2].lower(); if ll.contains(lp) { top = k2; found = true; } } }
                    if !found { for k2 in 0..(top + 1) { if !found { String ll = ls[k2].lower(); if ll.contains(lp) { top = k2; found = true; note = "(from the top)"; } } } }
                } else {
                    i64 k2 = top - 1;
                    while k2 >= 0 && !found { String ll = ls[k2].lower(); if ll.contains(lp) { top = k2; found = true; } k2 -= 1; }
                }
                if !found { note = "not found: " + pat; }
                if top > maxtop && found { top = maxtop; }
            }
        }
    }
    jout << e << "[?1049l";
    Sys::call(29, fdin, 21506, (i64)@t, 0, 0, 0);
    return 0;
}

i64 do_less(String[] a) {
    String[] ops = operands(a, false);
    i64 rc = 0;
    String file = "-";
    if ops.len > 0 { file = ops[0] + ""; }
    String[] ls = lines_of(load("less", file, @rc));
    if Sys::isatty(1) != 0 || Sys::isatty(0) == 0 && file == "-" {          // not a screen: just show it
        for i in 0..ls.len { jout << ls[i] << "\n"; }
        return rc;
    }
    i64[] none = arr(2);
    pager(file, ls, none);
    return rc;
}

// ---------------------------------------------------------------- man: the manuals of Jaric
// a manual is a Markdown text: a file on the phone (~/.jaric/man/NAME.md, $PREFIX/share/man/NAME.md), else the README of the tool or the page of the library
// from GitHub (kept in ~/.cache/jaric/man/ for the next time)
String man_cache_dir() {
    switch Env::get("HOME") { Option::Some(h): { return h + "/.cache/jaric/man"; } Option::None: { } }
    return "/tmp/jaric-man";
}

// the manuals of the commands that jbox itself holds (markdown, shown by man NAME without the network)
String builtin_man(String name) {
    if name == "cp" {
        return "# cp\n\nCopy files and folders.\n\n```\ncp FROM TO\ncp FROM... FOLDER\ncp -r FOLDER TO\n```\n* A file is copied byte for byte (songs, pictures and programs too); a program stays executable.\n* Several sources: the last name must be a folder. `cp a.mp3 b.mp3 music/`\n* `-r` copies a folder and everything in it. Without it a folder is refused.\n* `-v` says what is copied, `-n` keeps a file that is already there.\n* Between drives it works as well: `cp -r Jcmp 0:/Jcmp`.\n";
    }
    if name == "mv" {
        return "# mv\n\nMove or rename files and folders.\n\n```\nmv FROM TO\nmv FROM... FOLDER\n```\n* Several sources: the last name must be a folder. `mv *.txt notes/`\n* To another drive (`mv Jcmp 0:/`) the system cannot rename, so jbox copies and removes the old one only when the copy had no error.\n* `-v` says what is moved, `-n` keeps a file that is already there.\n* A folder cannot be moved into itself.\n";
    }
    if name == "rm" {
        return "# rm\n\nRemove files and folders.\n\n```\nrm FILE...\nrm -r FOLDER\nrm -rf FOLDER\n```\n* `-r` removes a folder and what is in it (a link is removed, not what it points to).\n* `-f` says nothing about names that are not there.\n* `rm /`, `rm .` and `rm ..` are refused.\n";
    }
    if name == "diff" {
        return "# diff\n\nShow what differs between two files.\n\n```\ndiff FILE1 FILE2\ndiff -u FILE1 FILE2 > my.patch\n```\n* Without `-u`: lines only in the first file start with `<`, in the second with `>`.\n* `-u` writes a unified diff: 3 lines of the same around each change, the form that `patch` and `git apply` read.\n* Exit code 0 when the files are the same, 1 when they differ, 2 for an error.\n";
    }
    if name == "patch" {
        return "# patch\n\nApply the changes of a unified diff (from `diff -u` or `git diff`).\n\n```\npatch FILE -i my.patch\ndiff -u a.txt b.txt | patch a.txt\npatch -p1 -i fix.patch\npatch -R FILE -i my.patch\n```\n* The file names come from the `+++` lines; `-p N` cuts N folders off the front (`-p1` for git diffs). A FILE on the line overrides them.\n* The old lines of a hunk are looked for near the place the hunk names, so a file that moved a few lines still takes it.\n* When a hunk does not fit, that file is not changed at all and the exit code is 1.\n* `-R` takes a patch back.\n";
    }
    if name == "jq" {
        return "# jq\n\nPick things out of JSON.\n\n```\njq FILTER [FILE]\njq -r .name data.json\njget URL -o - | jq '.items[] | select(.v > 2) | .n'\n```\n* Paths: `.a.b`, `.a[0]`, `.[]` (every element), `.[\"a-b\"]`. A key that is not there gives `null`.\n* Stages joined by `|`. Functions: `length`, `keys`, `type`, `not`, `select(PATH == VALUE)` (also `!= < > <= >=`).\n* `-r` writes a string without quotes, `-c` writes each result on one line.\n* Not in this jq: `map`, `if`, building new objects.\n";
    }
    return "";
}

String man_find(String name, bool^ from_net) {
    from_net[0] = false;
    String own = builtin_man(name);
    if own.len > 0 { return own; }
    String[] places = arr(6);
    switch Env::get("HOME") { Option::Some(h): { places.push(h + "/.jaric/man/" + name + ".md"); } Option::None: { } }
    switch Env::get("PREFIX") { Option::Some(p): { places.push(p + "/share/man/" + name + ".md"); } Option::None: { } }
    places.push(man_cache_dir() + "/" + name + ".md");
    for i in 0..places.len {
        if Fs::exists(places[i]) { Result<String, Error> r = Fs::read_text(places[i]); if r.is_ok() { return r.take(); } }
    }
    String[] urls = arr(6);
    urls.push("https://raw.githubusercontent.com/J2k-studio/Jcmp-Tools/main/tools/" + name + "/README.md");
    urls.push("https://raw.githubusercontent.com/J2k-studio/Jcmp-libs/main/docs/" + name + ".md");
    if name == "language" { urls.push("https://raw.githubusercontent.com/J2k-studio/Jcmp/main/docs/LANGUAGE.md"); }
    if name == "usage" { urls.push("https://raw.githubusercontent.com/J2k-studio/Jcmp/main/docs/USAGE.md"); }
    if name == "jcmp" { urls.push("https://raw.githubusercontent.com/J2k-studio/Jcmp/main/docs/USAGE.md"); }
    for i in 0..urls.len {
        Result<String, Error> r = Net::http_try_get(urls[i]);
        if r.is_ok() {
            String t = r.take();
            if t.len > 0 {
                Dir::make_all(man_cache_dir());
                Fs::write_text(man_cache_dir() + "/" + name + ".md", t);
                from_net[0] = true;
                return t;
            }
        }
    }
    return "";
}

// a Markdown text as lines with a style each: headings bold, code grey, the marks of Markdown taken away
void man_render(String md, String[] out, i64[] st) {
    String[] ls = md.split("\n");
    bool code = false;
    for i in 0..ls.len {
        String l = ls[i].replace("\r", "");
        if l.starts_with("```") { code = !code; if code { out.push(""); st.push(0); } continue; }
        if code { out.push("    " + l); st.push(2); continue; }
        if l.starts_with("# ") { out.push(l.slice(2, l.len).upper()); st.push(1); out.push(""); st.push(0); continue; }
        if l.starts_with("## ") { out.push(""); st.push(0); out.push(l.slice(3, l.len)); st.push(1); continue; }
        if l.starts_with("### ") { out.push(l.slice(4, l.len)); st.push(1); continue; }
        String t = l.replace("**", "").replace("`", "").replace("__", "");
        if t.starts_with("* ") || t.starts_with("- ") { t = "  - " + t.slice(2, t.len); }
        // [text](address) -> text
        String r = "";
        i64 p = 0;
        while p < t.len {
            if t[p] == '[' {
                i64 close = Net::http_find_from(t, "](", p);
                i64 endp = 0 - 1;
                if close > 0 { endp = Net::http_find_from(t, ")", close); }
                if close > 0 && endp > 0 { r = r + t.slice(p + 1, close); p = endp + 1; continue; }
            }
            r.push(t[p]);
            p += 1;
        }
        out.push(r); st.push(0);
    }
}

i64 do_man(String[] a) {
    String[] ops = operands(a, false);
    if ops.len == 0 {
        // the list of the manuals: the tools and the libraries
        String[] out = arr(40); i64[] st = arr(40);
        out.push("MANUALS OF JARIC"); st.push(1);
        out.push(""); st.push(0);
        out.push("man NAME shows the manual of a tool or a library (from the phone, else from GitHub once)."); st.push(0);
        out.push("Also: man language, man usage (the language J2K and the compiler jcmp)."); st.push(0);
        out.push(""); st.push(0);
        out.push("The tools:"); st.push(1);
        Result<String, Error> tt = Net::http_try_get("https://raw.githubusercontent.com/J2k-studio/Jcmp-Tools/main/tools.txt");
        if tt.is_ok() {
            String[] tl = tt.take().split("\n");
            for i in 0..tl.len { if tl[i].len > 0 && !tl[i].starts_with("#") { i64 bar = tl[i].find("|"); if bar > 0 { out.push("  " + tl[i].slice(0, bar) + "   " + tl[i].slice(bar + 1, tl[i].len)); st.push(0); } } }
        } else { out.push("  (the list needs the network)"); st.push(0); }
        pager("man", out, st);
        return 0;
    }
    String name = ops[0].lower();
    bool net = false;
    String md = man_find(name, @net);
    if md.len == 0 { return fail("man", "no manual for " + ops[0] + " (man shows the list; " + ops[0] + " --help may tell something)"); }
    String[] out = arr(100); i64[] st = arr(100);
    man_render(md, out, st);
    if Sys::isatty(1) != 0 { for i in 0..out.len { jout << out[i] << "\n"; } return 0; }
    pager("man " + name, out, st);
    return 0;
}

// ---------------------------------------------------------------- df, ps, hex
// df [-h] [FOLDER...]: the size, the use and the free place of the drives that hold the folders (home, /sdcard, /data and / without an argument)
String df_size(i64 kb, bool human) {
    if !human { return str(kb); }
    if kb >= 1048576 { return str(kb / 1048576) + "." + str((kb % 1048576) * 10 / 1048576) + "G"; }
    if kb >= 1024 { return str(kb / 1024) + "." + str((kb % 1024) * 10 / 1024) + "M"; }
    return str(kb) + "K";
}

i64 do_df(String[] a) {
    bool human = false;
    String[] ops = arr(4);
    for i in 1..a.len { if a[i] == "-h" { human = true; } else if !a[i].starts_with("-") { ops.push(a[i] + ""); } }
    if ops.len == 0 {
        switch Env::get("HOME") { Option::Some(h): { ops.push(h + ""); } Option::None: { } }
        ops.push("/sdcard"); ops.push("/data"); ops.push("/");
    }
    jout << "  SIZE    USED   AVAIL USE%  FOLDER\n";
    for i in 0..ops.len {
        char buf[128];
        if Sys::call(43, (i64)ops[i].c(), (i64)@buf, 0, 0, 0, 0) != 0 { continue; }
        i64 bsize = 0; i64 blocks = 0; i64 avail = 0; i64 freeb = 0;
        for k in 0..8 { bsize = bsize | ((buf[8 + k] & 255) << (8 * k)); blocks = blocks | ((buf[16 + k] & 255) << (8 * k)); freeb = freeb | ((buf[24 + k] & 255) << (8 * k)); avail = avail | ((buf[32 + k] & 255) << (8 * k)); }
        i64 size = blocks / 1024 * bsize;
        i64 usedkb = (blocks - freeb) / 1024 * bsize;
        i64 availkb = avail / 1024 * bsize;
        i64 pct = 0;
        if blocks > 0 { pct = (blocks - freeb) * 100 / blocks; }
        jout << lpad(df_size(size, human), 6) << " " << lpad(df_size(usedkb, human), 7) << " " << lpad(df_size(availkb, human), 7) << " " << lpad(str(pct) + "%", 4) << "  " << ops[i] << "\n";
    }
    return 0;
}

String lpad(String s, i64 w) { String r = s; while r.len < w { r = " " + r; } return r; }

// ps: the programs you can see: pid, state, memory (MB), cpu seconds, name
i64 do_ps(String[] a) {
    Result<String[], Error> r = Dir::list("/proc");
    if r.is_err() { return fail("ps", "cannot read /proc"); }
    String[] names = r.take();
    names.sort();
    jout << lpad("PID", 7) << " S " << lpad("MEM MB", 7) << lpad("CPU s", 7) << "  NAME\n";
    i64 shown = 0;
    for i in 0..names.len {
        String pid = names[i];
        bool digits = pid.len > 0;
        for k in 0..pid.len { if pid[k] < '0' || pid[k] > '9' { digits = false; } }
        if !digits { continue; }
        i64 fd = Sys::open_read(("/proc/" + pid + "/stat").c());
        if fd < 0 { continue; }
        String st = "";
        char b[1024];
        i64 n = Sys::read(fd, @b, 1024);
        Sys::close(fd);
        for k in 0..n { st.push(b[k]); }
        i64 op = st.find("(");
        i64 cl = 0 - 1;
        for k in 0..st.len { if st[k] == ')' { cl = k; } }
        if op < 0 || cl < op { continue; }
        String[] f = st.slice(cl + 2, st.len).trim().split(" ");
        if f.len < 22 { continue; }
        jout << lpad(pid, 7) << " " << f[0] << " " << lpad(str(f[21].to_int() * 4 / 1024), 7) << lpad(str((f[11].to_int() + f[12].to_int()) / 100), 7) << "  " << st.slice(op + 1, cl) << "\n";
        shown += 1;
    }
    jout << shown << " programs visible (Android shows only your own)\n";
    return 0;
}

// hex FILE: the bytes of a file in hex, 16 on a line, with the letters at the right
i64 do_hex(String[] a) {
    String[] ops = operands(a, false);
    i64 rc = 0;
    String file = "-";
    if ops.len > 0 { file = ops[0] + ""; }
    String data = load("hex", file, @rc);
    if rc != 0 { return rc; }
    String hx = "0123456789abcdef";
    i64 at = 0;
    while at < data.len {
        String line = "";
        String off = "";
        i64 v = at;
        for k in 0..8 { off = str(0) + off; }
        off = "";
        for k in 0..8 { off = hx.slice(v % 16, v % 16 + 1) + off; v = v / 16; }
        String hexs = "";
        String asc = "";
        for k in 0..16 {
            if at + k < data.len {
                i64 c = data[at + k] & 255;
                hexs = hexs + hx.slice(c >> 4, (c >> 4) + 1) + hx.slice(c & 15, (c & 15) + 1);
                if k % 2 == 1 { hexs = hexs + " "; }
                if c >= 32 && c < 127 { asc.push((char)c); } else { asc.push('.'); }
            } else {
                hexs = hexs + "  ";
                if k % 2 == 1 { hexs = hexs + " "; }
            }
        }
        jout << off << ": " << hexs << " " << asc << "\n";
        at += 16;
    }
    return 0;
}

i64 do_install(String[] args) {
    String names_text = "dir tree find date du stat xargs sed less man ln chmod cut tr diff cat head tail wc nl tac rev yes uname hostname whoami realpath base64 sha256sum cmp paste fold printf uptime free nproc mkdir rmdir rm touch cp mv grep sort uniq tee seq basename dirname sleep clear env kill true false df ps hex jq patch";
    String[] names = names_text.split(" ");
    String dir = ".";
    if args.len > 2 { dir = args[2]; }
    else {
        String self = "";
        self.append((char^)Sys::arg(0));
        dir = Path::parent(self);
        if dir.len == 0 { dir = "."; }
    }
    i64 rc = 0;
    for i in 0..names.len {
        String link = Path::join(dir, names[i]);
        // a link that points somewhere else than jbox (left by an older install, or a wrong one) is made again; a real file or a link to jbox stays
        char tgt[256];
        i64 tn = Sys::call(78, 0 - 100, (i64)link.c(), (i64)@tgt, 255, 0, 0);
        if tn >= 0 {
            tgt[tn] = 0;
            String target = "";
            target.append((char^)@tgt);
            if target == "jbox" { continue; }
            Sys::unlink(link.c());
        } else if Fs::exists(link) { continue; }
        if Sys::call(36, (i64)"jbox".c(), 0 - 100, (i64)link.c(), 0, 0, 0) < 0 { rc = fail("jbox", "cannot make " + link); }
    }
    if rc == 0 { jout << "jbox: " << names.len << " commands linked in " << dir << "\n"; }
    return rc;
}

i64 main() {
    String[] args = Env::args();
    if args.len > 1 && (args[1] == "--version" || args[1] == "-V") { jout << "jbox 0.15.0\n"; return 0; }
    String self_name = Path::name(args[0]);
    if args.len > 1 && (args[1] == "--help" || args[1] == "-h") && self_name == "jbox" { return do_help(); }
    if args.len > 1 && (args[1] == "--install" || args[1] == "--post-install") { return do_install(args); }
    String app = Path::name(args[0]);
    String[] a = args;
    if app == "jbox" {
        if args.len < 2 { return do_help(); }
        app = args[1];
        a = arr(args.len);
        for i in 1..args.len { a.push(args[i]); }
    }
    if app == "dir" { return do_ls(a); }
    if app == "cat" { return do_cat(a); }
    if app == "tree" { return do_tree(a); }
    if app == "find" { return do_find(a); }
    if app == "date" { return do_date(a); }
    if app == "du" { return do_du(a); }
    if app == "stat" { return do_stat(a); }
    if app == "xargs" { return do_xargs(a); }
    if app == "sed" { return do_sed(a); }
    if app == "less" { return do_less(a); }
    if app == "man" { return do_man(a); }
    if app == "df" { return do_df(a); }
    if app == "ps" { return do_ps(a); }
    if app == "hex" { return do_hex(a); }
    if app == "ln" { return do_ln(a); }
    if app == "chmod" { return do_chmod(a); }
    if app == "cut" { return do_cut(a); }
    if app == "tr" { return do_tr(a); }
    if app == "diff" { return do_diff(a); }
    if app == "head" { return do_head_tail(a, true); }
    if app == "tail" { return do_head_tail(a, false); }
    if app == "rev" { return do_rev(a); }
    if app == "yes" { return do_yes(a); }
    if app == "uname" { return do_uname(a); }
    if app == "hostname" { return do_hostname(a); }
    if app == "whoami" { return do_whoami(a); }
    if app == "realpath" { return do_realpath(a); }
    if app == "base64" { return do_base64(a); }
    if app == "sha256sum" { return do_sha256sum(a); }
    if app == "cmp" { return do_cmp(a); }
    if app == "paste" { return do_paste(a); }
    if app == "fold" { return do_fold(a); }
    if app == "printf" { return do_printf(a); }
    if app == "uptime" { return do_uptime(a); }
    if app == "free" { return do_free(a); }
    if app == "nproc" { return do_nproc(a); }
    if app == "wc" { return do_wc(a); }
    if app == "nl" { return do_nl(a); }
    if app == "tac" { return do_tac(a); }
    if app == "mkdir" { return do_mkdir(a); }
    if app == "rm" { return do_rm(a); }
    if app == "rmdir" { return do_rmdir(a); }
    if app == "touch" { return do_touch(a); }
    if app == "cp" { return do_cp(a); }
    if app == "mv" { return do_mv(a); }
    if app == "grep" { return do_grep(a); }
    if app == "sort" { return do_sort(a); }
    if app == "jq" { return do_jq(a); }
    if app == "patch" { return do_patch(a); }
    if app == "uniq" { return do_uniq(a); }
    if app == "tee" { return do_tee(a); }
    if app == "seq" { return do_seq(a); }
    if app == "basename" { return do_basename(a); }
    if app == "dirname" { return do_dirname(a); }
    if app == "sleep" { return do_sleep(a); }
    if app == "clear" { return do_clear(); }
    if app == "env" { return do_env(); }
    if app == "kill" { return do_kill(a); }
    if app == "true" { return 0; }
    if app == "false" { return 1; }
    if app == "help" { return do_help(); }
    jerr << "jsh: " << app << ": command not found\n";
    return 127;
}
