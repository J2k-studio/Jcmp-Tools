// coderin: a text editor for the terminal, written in J2K (for the Jaric app and any ANSI terminal). Version 0.2, in the way of micro:
// the mouse (a tap or a click puts the cursor there, a drag selects, a double click takes a word, the wheel scrolls), brackets and
// quotes are closed for you, a command bar (Ctrl-E), and settings, key bindings and colour schemes in ~/.config/coderin/ (no file is made for you).
//   coderin FILE          Ctrl-S save   Ctrl-Q quit   Ctrl-F find   Ctrl-G go to a line   Ctrl-C copy   Ctrl-X cut   Ctrl-V paste
//   Shift + arrows select   Ctrl-A select all   Ctrl-D copy the line below   Ctrl-K delete the line   Home End PageUp PageDown Tab
#import <stdlib>

String[] lines;
int cy;                       // the cursor: the line, and the byte in the line (always at the start of a character)
int cx;
int top;                      // the first line shown
int left;                     // the first column shown
int ay;                       // the other end of the selection (when sel is true)
int ax;
bool sel;
String clip;
bool dirty;
String path;
String msg;
int rows;
int cols;
int quit_asked;
String key_text;              // the characters of the last K_TEXT key
int tabsize = 4;              // settings (the file ~/.config/coderin/settings, or the command  set NAME VALUE )
bool use_spaces = true;       // Tab gives spaces
bool ruler = true;            // the numbers of the lines
bool mouse_on = true;
bool autoindent = true;
bool autopair = true;         // ( ) [ ] { } " " ' ' are closed when the first is typed
String scheme;                // the name of the colour scheme (dark when empty)
String[] bind_keys;           // the key bindings: "Ctrl-s" -> "save"
String[] bind_acts;
int m_btn;                    // the last mouse event: the button, the place (1-based) and press / release
int m_x;
int m_y;
bool m_press;
int click_time;               // for the double click
int click_y;
int click_x;
int c_kw;                     // the colours of the scheme: 0xRRGGBB
int c_str;
int c_num;
int c_com;
int c_typ;
int c_txt;
int c_gut;
int c_sel;
int K_MOUSE = 1020;
bool helpbar = true;          // a line with the keys under the text, as nano shows it (set helpbar off)
bool ext_undo = true;         // the extensions that are on (the setting  extensions = undo j2k ): undo and redo; help for writing J2K
bool ext_j2k = true;
String[] undo_text;           // the states before the changes (the whole text joined by new lines) and where the cursor was
int[] undo_cy;
int[] undo_cx;
String[] redo_text;
int[] redo_cy;
int[] redo_cx;
int last_kind;                // what the last change was: 1 typing, 2 deleting characters, 0 anything else (it always starts a new step)
int last_edit_ms;
bool free_scroll;             // the wheel moved the view: it does not follow the cursor until a key comes

int K_TEXT = 1000;
int K_UP = 1001;
int K_DOWN = 1002;
int K_RIGHT = 1003;
int K_LEFT = 1004;
int K_HOME = 1005;
int K_END = 1006;
int K_PGUP = 1007;
int K_PGDN = 1008;
int K_DEL = 1009;
int K_ENTER = 1010;
int K_BS = 1011;
int K_TAB = 1012;
int K_ESC = 1013;
int K_SHIFT = 100;            // + K_UP .. K_END : the arrow with Shift
int K_CTRL = 200;             // + K_UP .. K_END : the arrow with Ctrl

String esc() {
    String e = "";
    e.push((char)27);
    return e;
}

// ---------------------------------------------------------------- the terminal
void raw_mode(bool on) {
    char t[64];
    Sys::call(29, 0, 21505, (int)@t, 0, 0, 0);                    // TCGETS
    if on {
        t[0] = t[0] & 0xFA;                                       // iflag: no ICRNL (0x100 is in byte 1), no IXON (0x400 in byte 1)
        t[1] = t[1] & 0xFA;                                       // 0x100 and 0x400 -> bits 0 and 2 of byte 1
        t[12] = t[12] & 0xF4;                                     // lflag: no ISIG (1), no ICANON (2), no ECHO (8)
        t[23] = 1;                                                // VMIN
        t[22] = 0;                                                // VTIME
    } else {
        t[1] = t[1] | 5;
        t[12] = t[12] | 11;
    }
    Sys::call(29, 0, 21506, (int)@t, 0, 0, 0);                    // TCSETS
}

void read_size() {
    char w[8];
    for i in 0..8 { w[i] = 0; }
    Sys::call(29, 1, 21523, (int)@w, 0, 0, 0);                    // TIOCGWINSZ
    rows = (w[0] & 255) | ((w[1] & 255) << 8);
    cols = (w[2] & 255) | ((w[3] & 255) << 8);
    if rows < 5 { rows = 24; }
    if cols < 20 { cols = 80; }
}

int rd() {
    char b[4];
    int n = Sys::read(0, @b, 1);
    if n <= 0 { return 0 - 1; }
    return b[0] & 255;
}

// one key: a code from the list above, a control letter (1 .. 26), or K_TEXT with the characters in key_text; -2 when nothing came in ms
int read_key(int ms) {
    if !Input::ready(ms) { return 0 - 2; }
    int c = rd();
    if c < 0 { return 0 - 1; }
    if c == 27 {
        if !Input::ready(30) { return K_ESC; }
        int c2 = rd();
        if c2 == 79 {                                             // ESC O H / F
            int c3 = rd();
            if c3 == 72 { return K_HOME; }
            if c3 == 70 { return K_END; }
            return K_ESC;
        }
        if c2 != 91 { return K_ESC; }
        int p1 = 0;
        int p2 = 0;
        int p3 = 0;
        int field = 1;
        int last = rd();
        bool sgr = false;
        while (last >= 48 && last <= 59) || last == 63 || last == 60 {
            if last == 60 { sgr = true; }
            else if last == 59 { field += 1; }
            else if field == 1 { p1 = p1 * 10 + (last - 48); }
            else if field == 2 { p2 = p2 * 10 + (last - 48); }
            else { p3 = p3 * 10 + (last - 48); }
            last = rd();
        }
        if sgr && (last == 77 || last == 109) {                   // the mouse (SGR): ESC [ < button ; x ; y M (press) or m (release)
            m_btn = p1;
            m_x = p2;
            m_y = p3;
            m_press = last == 77;
            return K_MOUSE;
        }
        int mod = 0;
        if p2 == 2 { mod = K_SHIFT; }
        else if p2 == 5 { mod = K_CTRL; }
        if last == 65 { return K_UP + mod; }
        if last == 66 { return K_DOWN + mod; }
        if last == 67 { return K_RIGHT + mod; }
        if last == 68 { return K_LEFT + mod; }
        if last == 72 { return K_HOME + mod; }
        if last == 70 { return K_END + mod; }
        if last == 126 {
            if p1 == 1 || p1 == 7 { return K_HOME + mod; }
            if p1 == 4 || p1 == 8 { return K_END + mod; }
            if p1 == 3 { return K_DEL; }
            if p1 == 5 { return K_PGUP; }
            if p1 == 6 { return K_PGDN; }
        }
        return K_ESC;
    }
    if c == 13 || c == 10 { return K_ENTER; }
    if c == 127 || c == 8 { return K_BS; }
    if c == 9 { return K_TAB; }
    if c < 32 { return c; }
    key_text = "";
    key_text.push((char)c);
    if c >= 192 {                                                 // the bytes that follow in a character of UTF-8
        int more = 1;
        if c >= 224 { more = 2; }
        if c >= 240 { more = 3; }
        for i in 0..more {
            int cb = rd();
            if cb >= 0 { key_text.push((char)cb); }
        }
    }
    return K_TEXT;
}

// ---------------------------------------------------------------- characters and columns
bool is_cont(String s, int i) { return i >= 0 && i < s.len && (s[i] & 192) == 128; }
int prev_char(String s, int at) {
    if at <= 0 { return 0; }
    at -= 1;
    while at > 0 && is_cont(s, at) { at -= 1; }
    return at;
}
int next_char(String s, int at) {
    if at >= s.len { return s.len; }
    at += 1;
    while at < s.len && is_cont(s, at) { at += 1; }
    return at;
}
// a Thai vowel above or below a letter, or a tone mark, takes no column of its own
bool zero_width(String s, int i) {
    if i + 2 >= s.len + 0 { if i + 2 > s.len - 1 { return false; } }
    int b0 = s[i] & 255;
    int b1 = s[i + 1] & 255;
    int b2 = s[i + 2] & 255;
    if b0 != 224 { return false; }
    if b1 == 184 { return b2 == 177 || (b2 >= 180 && b2 <= 186); }
    if b1 == 185 { return b2 >= 135 && b2 <= 142; }
    return false;
}
// the column on the screen of the byte at upto (a tab goes to the next multiple of 4)
int col_of(String s, int upto) {
    int col = 0;
    int i = 0;
    while i < upto && i < s.len {
        int c = s[i] & 255;
        if c == 9 { col = (col / tabsize + 1) * tabsize; }
        else if !is_cont(s, i) && !zero_width(s, i) { col += 1; }
        i += 1;
    }
    return col;
}
// the byte of the line that is at the column (the nearest character start)
int byte_at_col(String s, int want) {
    int i = 0;
    while i < s.len {
        int n = next_char(s, i);
        if col_of(s, n) > want { return i; }
        i = n;
    }
    return s.len;
}

// ---------------------------------------------------------------- the text
void insert_line(int at, String s) {
    String[] n = arr(lines.len + 16);
    for i in 0..lines.len {
        if i == at { n.push(s); }
        n.push(lines[i]);
    }
    if at >= lines.len { n.push(s); }
    lines = n;
}
void remove_line(int at) {
    String[] n = arr(lines.len + 16);
    for i in 0..lines.len { if i != at { n.push(lines[i]); } }
    if n.len == 0 { n.push(""); }
    lines = n;
}

void load(String p) {
    lines = arr(64);
    Result<String, Error> r = Fs::read_text(p);
    String text = "";
    if r.is_ok() { text = r.take(); msg = "opened " + p; }
    else { msg = "new file " + p; }
    if text.len > 0 {
        String[] parts = text.split("\n");
        int n = parts.len;
        if n > 0 && parts[n - 1].len == 0 { n -= 1; }
        for i in 0..n {
            String l = parts[i];
            if l.len > 0 && l[l.len - 1] == 13 { l = l.slice(0, l.len - 1); }
            lines.push(l);
        }
    }
    if lines.len == 0 { lines.push(""); }
}

void save() {
    String text = "";
    for i in 0..lines.len { text = text + lines[i] + "\n"; }
    Result<int, Error> r = Fs::write_text(path, text);
    if r.is_ok() { dirty = false; msg = "saved " + path + " (" + str(lines.len) + " lines)"; }
    else { msg = "cannot save " + path; }
}

// ---------------------------------------------------------------- selection and clipboard
void order_sel(int^ y1, int^ x1, int^ y2, int^ x2) {
    bool swap = ay < cy || (ay == cy && ax < cx);
    if swap { y1[0] = ay; x1[0] = ax; y2[0] = cy; x2[0] = cx; }
    else { y1[0] = cy; x1[0] = cx; y2[0] = ay; x2[0] = ax; }
}
bool selected(int y, int x) {
    if !sel { return false; }
    int y1 = 0; int x1 = 0; int y2 = 0; int x2 = 0;
    order_sel(@y1, @x1, @y2, @x2);
    if y < y1 || y > y2 { return false; }
    if y == y1 && x < x1 { return false; }
    if y == y2 && x >= x2 { return false; }
    return true;
}
String selected_text() {
    int y1 = 0; int x1 = 0; int y2 = 0; int x2 = 0;
    order_sel(@y1, @x1, @y2, @x2);
    if y1 == y2 { return lines[y1].slice(x1, x2); }
    String t = lines[y1].slice(x1, lines[y1].len);
    for y in y1 + 1..y2 { t = t + "\n" + lines[y]; }
    t = t + "\n" + lines[y2].slice(0, x2);
    return t;
}
void delete_selection() {
    int y1 = 0; int x1 = 0; int y2 = 0; int x2 = 0;
    order_sel(@y1, @x1, @y2, @x2);
    String head = lines[y1].slice(0, x1);
    String tail = lines[y2].slice(x2, lines[y2].len);
    for k in 0..y2 - y1 { remove_line(y1 + 1); }
    lines[y1] = head + tail;
    cy = y1;
    cx = x1;
    sel = false;
    dirty = true;
}
// the text also goes to the clipboard of the terminal (OSC 52) when the terminal knows it
void set_clip(String t) {
    clip = t;
    cout << esc() << "]52;c;" << Base64::encode(t) << (char)7;
}
// ---------------------------------------------------------------- the extension undo / redo
String join_lines() {
    String t = "";
    for i in 0..lines.len {
        if i > 0 { t = t + "\n"; }
        t = t + lines[i];
    }
    return t;
}
void set_from_text(String t) {
    lines = arr(64);
    String[] p = t.split("\n");
    for i in 0..p.len { lines.push(p[i]); }
    if lines.len == 0 { lines.push(""); }
}
// called before a change: the state is kept so that Ctrl-Z can come back to it (typing in one go, or deleting in one go, is one step)
void begin_edit(int kind) {
    if !ext_undo { return; }
    int now = Time::now_ms();
    if kind != 0 && kind == last_kind && now - last_edit_ms < 900 { last_edit_ms = now; return; }
    undo_text.push(join_lines());
    undo_cy.push(cy);
    undo_cx.push(cx);
    if undo_text.len > 200 {                                      // only the last 200 steps
        String[] t2 = arr(256);
        int[] y2 = arr(256);
        int[] x2 = arr(256);
        for i in 1..undo_text.len { t2.push(undo_text[i]); y2.push(undo_cy[i]); x2.push(undo_cx[i]); }
        undo_text = t2; undo_cy = y2; undo_cx = x2;
    }
    redo_text = arr(8);
    redo_cy = arr(8);
    redo_cx = arr(8);
    last_kind = kind;
    last_edit_ms = now;
}
void undo_step(bool redo) {
    if !ext_undo { msg = "the extension undo is off (set extensions undo j2k)"; return; }
    if redo {
        if redo_text.len == 0 { msg = "nothing to redo"; return; }
        undo_text.push(join_lines()); undo_cy.push(cy); undo_cx.push(cx);
        int n = redo_text.len - 1;
        set_from_text(redo_text[n]);
        cy = redo_cy[n]; cx = redo_cx[n];
        redo_text.pop(); redo_cy.pop(); redo_cx.pop();
        msg = "redo";
    } else {
        if undo_text.len == 0 { msg = "nothing to undo"; return; }
        redo_text.push(join_lines()); redo_cy.push(cy); redo_cx.push(cx);
        int n = undo_text.len - 1;
        set_from_text(undo_text[n]);
        cy = undo_cy[n]; cx = undo_cx[n];
        undo_text.pop(); undo_cy.pop(); undo_cx.pop();
        msg = "undo";
    }
    if cy >= lines.len { cy = lines.len - 1; }
    if cx > lines[cy].len { cx = lines[cy].len; }
    sel = false;
    dirty = true;
    last_kind = 0;
}

// ---------------------------------------------------------------- the extension j2k: snippets and word completion with Tab
// ---------------------------------------------------------------- extensions that you write: ~/.config/coderin/extensions/NAME/
// NAME/snippets   lines  prefix = body   (\n is a new line, | is where the cursor goes)
// NAME/words      words for the Tab completion (any spaces and lines)
// NAME/commands   lines  name = shell command   (%f is the file; the command bar runs it:  run name )
String[] xs_pre;
String[] xs_body;
String[] xs_words;
String[] xc_name;
String[] xc_cmd;
String[] xs_loaded;
void load_extensions() {
    xs_pre = arr(8); xs_body = arr(8); xs_words = arr(8); xc_name = arr(8); xc_cmd = arr(8); xs_loaded = arr(4);
    load_ext_root(config_dir() + "/extensions");
    Option<String> pe = Env::get("PATH");                                     // a tool brings its own: DIR/coderin-extensions/NAME (DIR is on the PATH)
    if pe.is_some() {
        String[] pd = pe.unwrap().split(":");
        for k in 0..pd.len { if pd[k].len > 0 { load_ext_root(pd[k] + "/coderin-extensions"); } }
    }
}
void load_ext_root(String root) {
    if !Dir::exists(root) { return; }
    Result<String[], Error> r = Dir::list(root);
    if !r.is_ok() { return; }
    String[] names = r.take();
    for n in 0..names.len {
        String d = root + "/" + names[n];
        if !Dir::exists(d) { continue; }
        xs_loaded.push(names[n] + "");
        Result<String, Error> a = Fs::read_text(d + "/snippets");
        if a.is_ok() {
            String[] ls = a.take().split("\n");
            for i in 0..ls.len {
                String l = ls[i].trim();
                int eq = 0;
                while eq < l.len && l[eq] != '=' { eq += 1; }
                if l.len == 0 || l[0] == '#' || eq >= l.len { continue; }
                xs_pre.push(l.slice(0, eq).trim());
                xs_body.push(l.slice(eq + 1, l.len).trim().replace("\\n", "\n"));
            }
        }
        Result<String, Error> b = Fs::read_text(d + "/words");
        if b.is_ok() {
            String[] ws = b.take().replace("\n", " ").split(" ");
            for i in 0..ws.len { if ws[i].len > 0 { xs_words.push(ws[i] + ""); } }
        }
        Result<String, Error> c = Fs::read_text(d + "/commands");
        if c.is_ok() {
            String[] ls = c.take().split("\n");
            for i in 0..ls.len {
                String l = ls[i].trim();
                int eq = 0;
                while eq < l.len && l[eq] != '=' { eq += 1; }
                if l.len == 0 || l[0] == '#' || eq >= l.len { continue; }
                xc_name.push(l.slice(0, eq).trim());
                xc_cmd.push(l.slice(eq + 1, l.len).trim());
            }
        }
    }
}
void run_ext_command(String name) {
    for i in 0..xc_name.len {
        if xc_name[i] == name {
            if dirty { save(); }
            String[] args = arr(4);
            args.push("-c");
            args.push(xc_cmd[i].replace("%f", path));
            Result<String, Error> r = Proc::output("sh", args);
            if !r.is_ok() { msg = name + ": failed"; return; }
            String out = r.take().trim();
            String[] ol = out.split("\n");
            if ol.len == 0 || out.len == 0 { msg = name + ": done"; }
            else { msg = ol[ol.len - 1] + ""; }
            return;
        }
    }
    msg = "no command " + name + " (extensions: " + str(xc_name.len) + " commands)";
}

String snippet_for(String w) {
    for i in 0..xs_pre.len { if xs_pre[i] == w { return xs_body[i] + ""; } }
    if w == "main" { return "void main() {\n    |\n}"; }
    if w == "for" { return "for i in 0..n {\n    |\n}"; }
    if w == "while" { return "while cond {\n    |\n}"; }
    if w == "if" { return "if cond {\n    |\n}"; }
    if w == "ife" { return "if cond {\n    |\n} else {\n    \n}"; }
    if w == "struct" { return "struct Name {\n    int field;\n    |\n}"; }
    if w == "enum" { return "enum class Name { First, Second;\n}"; }
    if w == "switch" { return "switch value {\n    |\n}"; }
    if w == "try" { return "try {\n    |\n} catch (e) {\n    \n}"; }
    if w == "cout" { return "cout << |\"\\n\";"; }
    if w == "fn" { return "int name(int a) {\n    |\n}"; }
    if w == "exp" { return "export int name(int a) {\n    |\n}"; }
    return "";
}
bool tab_help() {
    if !ext_j2k && xs_loaded.len == 0 { return false; }
    String l = lines[cy];
    int st = cx;
    while st > 0 && is_word(l[st - 1] & 255) { st -= 1; }
    if st == cx { return false; }
    String w = l.slice(st, cx);
    String snip = snippet_for(w);
    String lead = l.slice(0, st).trim();
    if snip.len > 0 && lead.len == 0 {                                        // a snippet is for the start of a line
        begin_edit(0);
        int base = 0;
        while base < l.len && l[base] == ' ' { base += 1; }
        String text = snip.replace("\n", "\n" + " ".repeat(base));
        int m = 0;
        while m < text.len && text[m] != '|' { m += 1; }
        String before = text.slice(0, m);
        String after = "";
        if m < text.len { after = text.slice(m + 1, text.len); } else { before = text; }
        lines[cy] = l.slice(0, st) + l.slice(cx, l.len);
        cx = st;
        int y0 = cy;
        insert_text(before + after);
        String[] bl = before.split("\n");
        cy = y0 + bl.len - 1;
        if bl.len == 1 { cx = st + before.len; } else { cx = bl[bl.len - 1].len; }
        return true;
    }
    if w.len < 2 { return false; }
    // word completion: the words of the J2K language and the words of the text
    String kws = "if else while for in return break continue switch case default struct enum using module import defer try catch throw new delete true false null sizeof export operator String Result Option Error double float bool char void int";
    String[] cands = arr(16);
    String[] kw = kws.split(" ");
    for i in 0..kw.len { if kw[i].starts_with(w) && kw[i].len > w.len { add_cand(cands, kw[i]); } }
    for i in 0..xs_words.len { if xs_words[i].starts_with(w) && xs_words[i].len > w.len { add_cand(cands, xs_words[i]); } }
    for y in 0..lines.len {
        String t = lines[y];
        int i = 0;
        while i < t.len {
            if is_word(t[i] & 255) {
                int j = i;
                while j < t.len && is_word(t[j] & 255) { j += 1; }
                String x = t.slice(i, j);
                if x.starts_with(w) && x.len > w.len { add_cand(cands, x); }
                i = j;
            } else { i += 1; }
        }
    }
    if cands.len == 0 { return false; }
    String common = cands[0];
    for i in 1..cands.len {
        int n = 0;
        while n < common.len && n < cands[i].len && common[n] == cands[i][n] { n += 1; }
        common = common.slice(0, n);
    }
    if common.len > w.len {
        begin_edit(0);
        lines[cy] = l.slice(0, st) + common + l.slice(cx, l.len);
        cx = st + common.len;
        dirty = true;
        if cands.len > 1 { msg = str(cands.len) + " words: " + cands[0] + " " + cands[1] + " ..."; }
        return true;
    }
    msg = "words: ";
    for i in 0..cands.len { if i < 6 { msg = msg + cands[i] + " "; } }
    return true;
}
void add_cand(String[] c, String x) {
    for i in 0..c.len { if c[i] == x { return; } }
    c.push(x);
}

void insert_text(String t) {
    if sel { delete_selection(); }
    if t == "}" && cx >= tabsize && use_spaces {                  // a closing brace at the start of a line steps back one level
        String before = lines[cy].slice(0, cx);
        if before.trim().len == 0 { lines[cy] = lines[cy].slice(tabsize, lines[cy].len); cx -= tabsize; }
    }
    String[] parts = t.split("\n");
    String tail = lines[cy].slice(cx, lines[cy].len);
    String head = lines[cy].slice(0, cx);
    if parts.len == 1 {
        lines[cy] = head + t + tail;
        cx = head.len + t.len;
    } else {
        lines[cy] = head + parts[0];
        for i in 1..parts.len - 1 { insert_line(cy + i, parts[i]); }
        int last = cy + parts.len - 1;
        insert_line(last, parts[parts.len - 1] + tail);
        cy = last;
        cx = parts[parts.len - 1].len;
    }
    dirty = true;
}

// ---------------------------------------------------------------- the colours of J2K
bool is_word(int c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }
bool in_list(String list, String w) {
    String[] ws = list.split(" ");
    for i in 0..ws.len { if ws[i] == w { return true; } }
    return false;
}
// kinds: 0 text, 1 keyword, 2 text in quotes, 3 number, 4 comment, 5 type
int[] kinds_of(String s) {
    int[] k = arr(s.len + 1);
    for i in 0..s.len { k.push(0); }
    int i = 0;
    while i < s.len {
        int c = s[i] & 255;
        if c == '/' && i + 1 < s.len && s[i + 1] == '/' {
            for j in i..s.len { k[j] = 4; }
            return k;
        }
        if c == '"' || c == 39 {
            int j = i + 1;
            while j < s.len && (s[j] & 255) != c {
                if s[j] == '\\' { j += 1; }
                j += 1;
            }
            if j >= s.len { j = s.len - 1; }
            for q in i..j + 1 { k[q] = 2; }
            i = j + 1;
        } else if c >= '0' && c <= '9' {
            int j = i;
            while j < s.len && (is_word(s[j] & 255) || s[j] == '.') { k[j] = 3; j += 1; }
            i = j;
        } else if is_word(c) {
            int j = i;
            while j < s.len && is_word(s[j] & 255) { j += 1; }
            String w = s.slice(i, j);
            int kind = 0;
            if in_list("if else while for in return break continue switch case default struct enum using module import defer try catch throw new delete true false null sizeof asm reg export operator naked loop", w) { kind = 1; }
            else if in_list("int uint double float bool char void String u8 u16 u32 u64 i8 i16 i32 i64 Result Option Error", w) { kind = 5; }
            if kind != 0 { for q in i..j { k[q] = kind; } }
            i = j;
        } else {
            i += 1;
        }
    }
    return k;
}
String rgb(int c) {
    return esc() + "[38;2;" + str((c >> 16) & 255) + ";" + str((c >> 8) & 255) + ";" + str(c & 255) + "m";
}
String color_of(int kind) {
    if kind == 1 { return rgb(c_kw); }
    if kind == 2 { return rgb(c_str); }
    if kind == 3 { return rgb(c_num); }
    if kind == 4 { return rgb(c_com); }
    if kind == 5 { return rgb(c_typ); }
    return rgb(c_txt);
}
// the colours of a scheme: dark (the default), light, mono, amber; a file ~/.config/coderin/colors/NAME with lines  keyword = #RRGGBB  changes or adds one
void apply_scheme(String name) {
    scheme = name;
    c_kw = 0xFF7B72; c_str = 0xA5D6FF; c_num = 0xD2A8FF; c_com = 0x7D8590; c_typ = 0x79C0FF; c_txt = 0xF2F2F2; c_gut = 0x7D8590; c_sel = 0x3C4666;
    if name == "light" { c_kw = 0xCF222E; c_str = 0x0A3069; c_num = 0x8250DF; c_com = 0x6E7781; c_typ = 0x0550AE; c_txt = 0x1F2328; c_gut = 0x8C959F; c_sel = 0xB6D6F2; }
    else if name == "mono" { c_kw = 0xFFFFFF; c_str = 0xCCCCCC; c_num = 0xCCCCCC; c_com = 0x808080; c_typ = 0xFFFFFF; c_txt = 0xE0E0E0; c_gut = 0x808080; c_sel = 0x444444; }
    else if name == "amber" { c_kw = 0xFFB000; c_str = 0xFFD060; c_num = 0xFFD060; c_com = 0x9A6B00; c_typ = 0xFFC030; c_txt = 0xFFB000; c_gut = 0x9A6B00; c_sel = 0x553A00; }
    String file = config_dir() + "/colors/" + name;
    Result<String, Error> r = Fs::read_text(file);
    if r.is_ok() {
        String[] ls = r.take().split("\n");
        for i in 0..ls.len {
            String[] kv = ls[i].split("=");
            if kv.len != 2 { continue; }
            String key = kv[0].trim();
            String val = kv[1].trim();
            if val.len != 7 || val[0] != '#' { continue; }
            int v = hex_value(val.slice(1, 7));
            if key == "keyword" { c_kw = v; } else if key == "string" { c_str = v; } else if key == "number" { c_num = v; }
            else if key == "comment" { c_com = v; } else if key == "type" { c_typ = v; } else if key == "text" { c_txt = v; }
            else if key == "gutter" { c_gut = v; } else if key == "selection" { c_sel = v; }
        }
    }
}
int hex_value(String h) {
    int v = 0;
    for i in 0..h.len {
        int c = h[i] & 255;
        int d = 0;
        if c >= '0' && c <= '9' { d = c - '0'; }
        else if c >= 'a' && c <= 'f' { d = c - 'a' + 10; }
        else if c >= 'A' && c <= 'F' { d = c - 'A' + 10; }
        v = v * 16 + d;
    }
    return v;
}
String config_dir() {
    Option<String> h = Env::get("HOME");
    String home = "";
    if h.is_some() { home = h.unwrap(); }
    return home + "/.config/coderin";
}

// ---------------------------------------------------------------- drawing
int gutter() {
    if !ruler { return 0; }
    String nstr = str(lines.len);
    return nstr.len + 2;
}

int text_rows_count() {
    if helpbar { return rows - 2; }
    return rows - 1;
}

void scroll_to_cursor() {
    if free_scroll { return; }
    int g = gutter();
    int text_rows = text_rows_count();
    if cy < top { top = cy; }
    if cy >= top + text_rows { top = cy - text_rows + 1; }
    int cc = col_of(lines[cy], cx);
    int text_cols = cols - g;
    if cc < left { left = cc; }
    if cc >= left + text_cols { left = cc - text_cols + 1; }
}

String draw_line(int y) {
    String s = lines[y];
    int[] k = kinds_of(s);
    String e = esc();
    String out = "";
    int g = gutter();
    if ruler {
        String num = str(y + 1);
        String pad = " ".repeat(g - 1 - num.len);
        out = out + rgb(c_gut) + pad + num + " " + e + "[0m";
    }
    int col = 0;
    int i = 0;
    int last = 0 - 1;
    bool rev = false;
    int text_cols = cols - g;
    while i < s.len {
        int n = next_char(s, i);
        int c = s[i] & 255;
        int w = 1;
        if c == 9 { w = (col / tabsize + 1) * tabsize - col; }
        else if zero_width(s, i) { w = 0; }
        bool s_on = selected(y, i);
        if col + w > left && col < left + text_cols {
            if k[i] != last || s_on != rev {
                out = out + e + "[0m";
                if s_on { out = out + e + "[48;2;" + str((c_sel >> 16) & 255) + ";" + str((c_sel >> 8) & 255) + ";" + str(c_sel & 255) + "m"; }
                out = out + color_of(k[i]);
                last = k[i];
                rev = s_on;
            }
            if c == 9 { out = out + " ".repeat(w); }
            else { out = out + s.slice(i, n); }
        }
        col += w;
        i = n;
    }
    out = out + e + "[0m" + e + "[K";
    return out;
}

void draw() {
    scroll_to_cursor();
    String e = esc();
    String f = e + "[?25l";
    for r in 0..text_rows_count() {
        int y = top + r;
        f = f + e + "[" + str(r + 1) + ";1H";
        if y < lines.len { f = f + draw_line(y); }
        else { f = f + rgb(c_gut) + "~" + e + "[0m" + e + "[K"; }
    }
    if helpbar {                                                  // the keys, in the way of nano: the key reversed, then what it does
        String hints = "";
        String acts = "save:Save quit:Quit find:Find goto:Goto undo:Undo copy:Copy cut:Cut paste:Paste command:Command";
        String[] as = acts.split(" ");
        for i in 0..as.len {
            String[] an = as[i].split(":");
            String keyname = binding_key_of(an[0]);
            if keyname.len > 0 { hints = hints + e + "[7m" + keyname + e + "[0m " + an[1] + "  "; }
        }
        f = f + e + "[" + str(rows - 1) + ";1H" + hints + e + "[K";
    }
    String name = path;
    if dirty { name = name + " *"; }
    String right = "  " + str(cy + 1) + ":" + str(col_of(lines[cy], cx) + 1) + " ";
    String left_text = " " + name + "  " + msg;
    int room = cols - right.len;
    if left_text.len > room { left_text = left_text.slice(0, room); }
    String bar = left_text + " ".repeat(room - left_text.len) + right;
    f = f + e + "[" + str(rows) + ";1H" + e + "[7m" + bar + e + "[0m";
    int g = gutter();
    int sr = cy - top + 1;
    int sc = col_of(lines[cy], cx) - left + g + 1;
    f = f + e + "[" + str(sr) + ";" + str(sc) + "H" + e + "[?25h";
    cout << f;
}

// ---------------------------------------------------------------- the commands
void move_to(int y, int x, bool extend) {
    if extend { if !sel { sel = true; ay = cy; ax = cx; } }
    else { sel = false; }
    cy = y;
    cx = x;
}

String ask(String prompt) {
    String e = esc();
    String text = "";
    while true {
        String line = prompt + text;
        cout << e << "[" << str(rows) << ";1H" << e << "[7m" << line << " ".repeat(cols - line.len) << e << "[0m" << e << "[" << str(rows) << ";" << str(line.len + 1) << "H";
        int k = read_key(0 - 1);
        if k == K_ENTER { return text; }
        if k == K_ESC { return ""; }
        if k == K_BS { if text.len > 0 { text = text.slice(0, prev_char(text, text.len)); } }
        else if k == K_TEXT { text = text + key_text; }
    }
    return text;
}

void find_next(String what, int from_y, int from_x) {
    if what.len == 0 { return; }
    for step in 0..lines.len + 1 {
        int y = (from_y + step) % lines.len;
        int start = 0;
        if step == 0 { start = from_x; }
        String l = lines[y];
        for x in start..l.len + 1 {
            bool fits = x + what.len <= l.len;
            bool same = false;
            if fits {
                String piece = l.slice(x, x + what.len);
                same = piece == what;
            }
            if same && !is_cont(l, x) {
                move_to(y, x, false);
                msg = "found: " + what;
                return;
            }
        }
    }
    msg = "not found: " + what;
}

void newline() {
    if sel { delete_selection(); }
    String l = lines[cy];
    int ind = 0;
    while ind < l.len && l[ind] == ' ' && ind < cx { ind += 1; }
    String head = l.slice(0, cx);
    String tail = l.slice(cx, l.len);
    bool between = autopair && head.len > 0 && tail.len > 0 && head[head.len - 1] == '{' && tail[0] == '}';
    if !autoindent { ind = 0; }
    String head_trim = head.trim();
    if autoindent && head_trim.len > 0 && head[head.len - 1] == '{' { ind += tabsize; }
    lines[cy] = head;
    if between {                                                  // {|} : the closing brace goes to a line of its own, the cursor to an indented empty line
        int base = ind - tabsize;
        if base < 0 { base = 0; }
        insert_line(cy + 1, " ".repeat(base) + tail);
        insert_line(cy + 1, " ".repeat(ind));
        cy += 1;
        cx = ind;
        dirty = true;
        return;
    }
    insert_line(cy + 1, " ".repeat(ind) + tail);
    cy += 1;
    cx = ind;
    dirty = true;
}

// ---------------------------------------------------------------- settings, key bindings, the command bar
String letter_of(int k) {
    String l = "";
    l.push((char)(k + 96));
    return l;
}

void bind_default() {
    bind_keys = arr(16);
    bind_acts = arr(16);
    String pairs = "Ctrl-s=save Ctrl-q=quit Ctrl-f=find Ctrl-g=goto Ctrl-c=copy Ctrl-x=cut Ctrl-v=paste Ctrl-a=selectall Ctrl-d=duplicate Ctrl-k=deleteline Ctrl-e=command Ctrl-z=undo Ctrl-y=redo";
    String[] ps = pairs.split(" ");
    for i in 0..ps.len {
        String[] kv = ps[i].split("=");
        bind_keys.push(kv[0]);
        bind_acts.push(kv[1]);
    }
}
// the key of an action, as ^S (the last binding of the action)
String binding_key_of(String act) {
    int i = bind_keys.len - 1;
    while i >= 0 {
        if bind_acts[i] == act && bind_keys[i].starts_with("Ctrl-") && bind_keys[i].len == 6 {
            String k = "^";
            k.push((char)(bind_keys[i][5] - 32));
            return k;
        }
        i -= 1;
    }
    return "";
}
// the action of a key; the last binding of a key counts (the file of the user comes after the defaults)
String binding(String key) {
    int i = bind_keys.len - 1;
    while i >= 0 {
        if bind_keys[i] == key { return bind_acts[i] + ""; }              // a copy (jcmp 1.0.0.0 gives away the String of the array itself: fixed after it)
        i -= 1;
    }
    return "";
}
bool on_off(String v) { return v == "on" || v == "true" || v == "yes" || v == "1"; }

void set_option(String name, String val) {
    if name == "tabsize" { int n = val.to_int(); if n >= 1 && n <= 16 { tabsize = n; } }
    else if name == "tabstospaces" { use_spaces = on_off(val); }
    else if name == "ruler" { ruler = on_off(val); }
    else if name == "autoindent" { autoindent = on_off(val); }
    else if name == "autopair" { autopair = on_off(val); }
    else if name == "helpbar" { helpbar = on_off(val); }
    else if name == "extensions" { ext_undo = false; ext_j2k = false; String[] ex = val.split(" "); for i in 0..ex.len { if ex[i] == "undo" { ext_undo = true; } if ex[i] == "j2k" { ext_j2k = true; } } }
    else if name == "mouse" {
        mouse_on = on_off(val);
        String e = esc();
        if mouse_on { cout << e << "[?1000h" << e << "[?1002h" << e << "[?1006h"; } else { cout << e << "[?1006l" << e << "[?1002l" << e << "[?1000l"; }
    }
    else if name == "colorscheme" { apply_scheme(val); }
    else { msg = "unknown setting " + name; }
}

void load_settings() {
    Result<String, Error> r = Fs::read_text(config_dir() + "/settings");
    if !r.is_ok() { return; }
    String[] ls = r.take().split("\n");
    for i in 0..ls.len {
        String l = ls[i].trim();
        if l.len == 0 || l[0] == '#' { continue; }
        String[] kv = l.split("=");
        if kv.len == 2 { set_option(kv[0].trim(), kv[1].trim()); }
    }
}
void load_bindings() {
    Result<String, Error> r = Fs::read_text(config_dir() + "/bindings");
    if !r.is_ok() { return; }
    String[] ls = r.take().split("\n");
    for i in 0..ls.len {
        String l = ls[i].trim();
        if l.len == 0 || l[0] == '#' { continue; }
        String[] kv = l.split("=");
        if kv.len == 2 { bind_keys.push(kv[0].trim()); bind_acts.push(kv[1].trim()); }
    }
}
// the command  set NAME VALUE  is kept in the file settings (this is the only time coderin writes in ~/.config/coderin)
void save_setting(String name, String val) {
    Dir::make_all(config_dir());
    String file = config_dir() + "/settings";
    String out = "";
    bool done = false;
    Result<String, Error> r = Fs::read_text(file);
    if r.is_ok() {
        String[] ls = r.take().split("\n");
        for i in 0..ls.len {
            if ls[i].len == 0 { continue; }
            String[] kv = ls[i].split("=");
            bool same = false;
            if kv.len == 2 {
                String key = kv[0].trim();
                same = key == name;
            }
            if same { out = out + name + " = " + val + "\n"; done = true; }
            else { out = out + ls[i] + "\n"; }
        }
    }
    if !done { out = out + name + " = " + val + "\n"; }
    Fs::write_text(file, out);
}

void command_bar() {
    String c = ask("> ").trim();
    if c.len == 0 { return; }
    String[] w = c.split(" ");
    String cmd = w[0];
    if cmd == "save" { save(); }
    else if cmd == "quit" { if dirty { msg = "unsaved changes: use Ctrl-Q twice, or  q!"; } else { quit_asked = 2; } }
    else if cmd == "q!" { quit_asked = 2; }
    else if cmd == "goto" && w.len > 1 { int n = w[1].to_int(); if n < 1 { n = 1; } if n > lines.len { n = lines.len; } move_to(n - 1, 0, false); }
    else if cmd == "find" && w.len > 1 { find_next(c.slice(5, c.len), cy, cx + 1); }
    else if cmd == "replace" && w.len == 3 {
        begin_edit(0);
        int n = 0;
        for y in 0..lines.len {
            String l = lines[y];
            String nl = l.replace(w[1], w[2]);
            if nl != l { lines[y] = nl; n += 1; dirty = true; }
        }
        msg = "replaced in " + str(n) + " lines";
    }
    else if cmd == "set" && w.len == 3 { set_option(w[1], w[2]); save_setting(w[1], w[2]); if msg.len == 0 { msg = w[1] + " = " + w[2]; } }
    else if cmd == "bind" && w.len == 3 { bind_keys.push(w[1]); bind_acts.push(w[2]); msg = w[1] + " does " + w[2] + " (put it in ~/.config/coderin/bindings to keep it)"; }
    else if cmd == "run" && w.len > 1 { run_ext_command(w[1]); }
    else if cmd == "extensions" { msg = "loaded: "; for i in 0..xs_loaded.len { msg = msg + xs_loaded[i] + " "; } if xs_loaded.len == 0 { msg = "none in ~/.config/coderin/extensions/"; } }
    else if cmd == "help" { msg = "run NAME (extension command) extensions save quit goto N find TEXT replace A B set NAME VALUE bind Ctrl-x ACTION; settings: tabsize tabstospaces ruler autoindent autopair helpbar mouse colorscheme"; }
    else { msg = "unknown command: " + cmd + " (help)"; }
}

// ---------------------------------------------------------------- the mouse
void mouse_pos(int^ yy, int^ xx) {
    int y = top + m_y - 1;
    if y >= lines.len { y = lines.len - 1; }
    if y < 0 { y = 0; }
    int col = m_x - 1 - gutter() + left;
    if col < 0 { col = 0; }
    yy[0] = y;
    xx[0] = byte_at_col(lines[y], col);
}

void on_mouse() {
    if !mouse_on { return; }
    if m_btn >= 64 {                                              // the wheel scrolls (the cursor stays)
        if m_btn == 64 { top -= 3; } else { top += 3; }
        if top < 0 { top = 0; }
        if top > lines.len - 1 { top = lines.len - 1; }
        free_scroll = true;
        return;
    }
    if m_y > text_rows_count() { return; }                        // the lines of keys and of status
    int y = 0;
    int x = 0;
    mouse_pos(@y, @x);
    if m_btn == 0 && m_press {
        int now = Time::now_ms();
        if now - click_time < 400 && y == click_y && x == click_x {   // a double click takes the word
            String l = lines[y];
            int a = x;
            int b = x;
            while a > 0 && is_word(l[a - 1] & 255) { a -= 1; }
            while b < l.len && is_word(l[b] & 255) { b += 1; }
            if b > a { sel = true; ay = y; ax = a; cy = y; cx = b; }
        } else {
            move_to(y, x, false);
        }
        click_time = now;
        click_y = y;
        click_x = x;
    } else if m_btn == 32 && m_press {                           // a drag with the button held selects from the place of the click
        if !sel { sel = true; ay = click_y; ax = click_x; }
        cy = y;
        cx = x;
    }
}

// ( ) [ ] { } " ' : typing the first one closes it; typing the closing one when it is the next character only steps over it.
// Returns true when the key was taken here.
bool type_pair(int c) {
    String line = lines[cy];
    int next = 0;
    if cx < line.len { next = line[cx] & 255; }
    int prev = 0;
    if cx > 0 { prev = line[cx - 1] & 255; }
    if !sel && (c == ')' || c == ']' || c == '}' || c == '"' || c == 39) && next == c {
        cx += 1;
        return true;
    }
    String closer = "";
    if c == '(' { closer = ")"; }
    else if c == '[' { closer = "]"; }
    else if c == '{' { closer = "}"; }
    else if (c == '"' || c == 39) && !is_word(prev) && !is_word(next) {
        closer = "";
        closer.push((char)c);
    }
    if closer.len == 0 { return false; }
    if sel { return false; }
    String open = "";
    open.push((char)c);
    insert_text(open + closer);
    cx -= 1;
    return true;
}

void handle(int k) {
    String act = "";
    if k >= 1 && k <= 26 { act = binding("Ctrl-" + letter_of(k)); }
    if act != "quit" { quit_asked = 0; }
    if k != K_MOUSE { free_scroll = false; }
    if k == K_MOUSE { on_mouse(); return; }
    if k == K_TEXT {
        begin_edit(1);
        if autopair && key_text.len == 1 && type_pair(key_text[0] & 255) { msg = ""; return; }
        insert_text(key_text);
        msg = "";
        return;
    }
    if k == K_ENTER { begin_edit(0); newline(); msg = ""; return; }
    if k == K_TAB {
        if tab_help() { return; }
        begin_edit(0);
        if use_spaces { insert_text(" ".repeat(tabsize)); } else { insert_text("\t"); }
        return;
    }
    if k == K_BS {
        begin_edit(2);
        if sel { delete_selection(); return; }
        if autopair && cx > 0 && cx < lines[cy].len {
            int pc = lines[cy][cx - 1] & 255;
            int nc = lines[cy][cx] & 255;
            bool pair = (pc == '(' && nc == ')') || (pc == '[' && nc == ']') || (pc == '{' && nc == '}') || (pc == '"' && nc == '"') || (pc == 39 && nc == 39);
            if pair {                                              // delete the pair
                lines[cy] = lines[cy].slice(0, cx - 1) + lines[cy].slice(cx + 1, lines[cy].len);
                cx -= 1;
                dirty = true;
                return;
            }
        }
        if cx > 0 {
            int p = prev_char(lines[cy], cx);
            lines[cy] = lines[cy].slice(0, p) + lines[cy].slice(cx, lines[cy].len);
            cx = p;
            dirty = true;
        } else if cy > 0 {
            int len = lines[cy - 1].len;
            lines[cy - 1] = lines[cy - 1] + lines[cy];
            remove_line(cy);
            cy -= 1;
            cx = len;
            dirty = true;
        }
        return;
    }
    if k == K_DEL {
        begin_edit(2);
        if sel { delete_selection(); return; }
        if cx < lines[cy].len {
            lines[cy] = lines[cy].slice(0, cx) + lines[cy].slice(next_char(lines[cy], cx), lines[cy].len);
            dirty = true;
        } else if cy + 1 < lines.len {
            lines[cy] = lines[cy] + lines[cy + 1];
            remove_line(cy + 1);
            dirty = true;
        }
        return;
    }
    bool shift = k >= K_UP + K_SHIFT && k <= K_END + K_SHIFT;
    bool ctrl = k >= K_UP + K_CTRL && k <= K_END + K_CTRL;
    int base = k;
    if shift { base = k - K_SHIFT; }
    if ctrl { base = k - K_CTRL; }
    if base == K_LEFT {
        if ctrl {
            int x = cx;
            while x > 0 && lines[cy][x - 1] == ' ' { x -= 1; }
            while x > 0 && lines[cy][x - 1] != ' ' { x -= 1; }
            move_to(cy, x, shift);
        } else if cx > 0 { move_to(cy, prev_char(lines[cy], cx), shift); }
        else if cy > 0 { move_to(cy - 1, lines[cy - 1].len, shift); }
        else { move_to(cy, cx, shift); }
        return;
    }
    if base == K_RIGHT {
        if ctrl {
            int x = cx;
            while x < lines[cy].len && lines[cy][x] != ' ' { x += 1; }
            while x < lines[cy].len && lines[cy][x] == ' ' { x += 1; }
            move_to(cy, x, shift);
        } else if cx < lines[cy].len { move_to(cy, next_char(lines[cy], cx), shift); }
        else if cy + 1 < lines.len { move_to(cy + 1, 0, shift); }
        else { move_to(cy, cx, shift); }
        return;
    }
    if base == K_UP || base == K_DOWN || k == K_PGUP || k == K_PGDN {
        int step = 1;
        if k == K_PGUP || k == K_PGDN { step = rows - 2; }
        int ny = cy + step;
        if base == K_UP || k == K_PGUP { ny = cy - step; }
        if ny < 0 { ny = 0; }
        if ny >= lines.len { ny = lines.len - 1; }
        int want = col_of(lines[cy], cx);
        move_to(ny, byte_at_col(lines[ny], want), shift);
        return;
    }
    if base == K_HOME {
        if ctrl { move_to(0, 0, shift); return; }
        int ind = 0;
        while ind < lines[cy].len && lines[cy][ind] == ' ' { ind += 1; }
        if cx == ind { ind = 0; }
        move_to(cy, ind, shift);
        return;
    }
    if base == K_END {
        if ctrl { move_to(lines.len - 1, lines[lines.len - 1].len, shift); return; }
        move_to(cy, lines[cy].len, shift);
        return;
    }
    if act == "save" { save(); return; }                                // Ctrl-S
    if act == "quit" {                                              // Ctrl-Q
        if dirty && quit_asked == 0 { msg = "unsaved changes: Ctrl-Q again quits without saving"; quit_asked = 1; return; }
        quit_asked = 2;
        return;
    }
    if act == "selectall" {                                         // Ctrl-A: select all
        sel = true; ay = 0; ax = 0; cy = lines.len - 1; cx = lines[cy].len;
        return;
    }
    if act == "copy" {                                              // Ctrl-C: copy (the line when nothing is selected)
        if sel { set_clip(selected_text()); msg = "copied"; }
        else { set_clip(lines[cy] + "\n"); msg = "line copied"; }
        return;
    }
    if act == "undo" { undo_step(false); return; }
    if act == "redo" { undo_step(true); return; }
    if act == "cut" {
        begin_edit(0);                                               // Ctrl-X: cut
        if sel { set_clip(selected_text()); delete_selection(); msg = "cut"; }
        else { set_clip(lines[cy] + "\n"); remove_line(cy); if cy >= lines.len { cy = lines.len - 1; } cx = 0; dirty = true; msg = "line cut"; }
        return;
    }
    if act == "paste" {
        begin_edit(0);                                             // Ctrl-V: paste
        if clip.len > 0 { insert_text(clip); msg = "pasted"; }
        return;
    }
    if act == "deleteline" {
        begin_edit(0);                                        // Ctrl-K: delete the line
        remove_line(cy);
        if cy >= lines.len { cy = lines.len - 1; }
        cx = 0;
        dirty = true;
        return;
    }
    if act == "duplicate" {
        begin_edit(0);                                         // Ctrl-D: copy the line below
        insert_line(cy + 1, lines[cy]);
        cy += 1;
        dirty = true;
        return;
    }
    if act == "find" {                                              // Ctrl-F: find
        String w = ask("find: ");
        if w.len > 0 { find_next(w, cy, cx + 1); }
        return;
    }
    if act == "command" { command_bar(); return; }
    if act == "goto" {                                              // Ctrl-G: go to a line
        String g = ask("line: ");
        if g.len > 0 {
            int n = g.to_int();
            if n < 1 { n = 1; }
            if n > lines.len { n = lines.len; }
            move_to(n - 1, 0, false);
        }
        return;
    }
}

int main() {
    String[] a = Env::args();
    if a.len > 1 && a[1] == "--version" { cout << "coderin 0.3.0\n"; return 0; }
    if a.len < 2 { cerr << "usage: coderin FILE\n"; return 2; }
    if Sys::isatty(0) != 0 { cerr << "coderin: it needs a terminal\n"; return 2; }
    path = a[1];
    clip = "";
    msg = "";
    undo_text = arr(16); undo_cy = arr(16); undo_cx = arr(16);
    redo_text = arr(8); redo_cy = arr(8); redo_cx = arr(8);
    bind_default();
    apply_scheme("dark");
    load_extensions();
    load_settings();
    load_bindings();
    load(path);
    raw_mode(true);
    read_size();
    String e = esc();
    cout << e << "[?1049h" << e << "[2J";
    if mouse_on { cout << e << "[?1000h" << e << "[?1002h" << e << "[?1006h"; }
    while quit_asked != 2 {
        draw();
        int k = read_key(200);
        if k == 0 - 2 {
            int orows = rows;
            int ocols = cols;
            read_size();
            if orows != rows || ocols != cols { cout << e << "[2J"; }
            continue;
        }
        if k < 0 { break; }
        handle(k);
    }
    cout << e << "[?1006l" << e << "[?1002l" << e << "[?1000l" << e << "[?25h" << e << "[?1049l";
    raw_mode(false);
    return 0;
}
