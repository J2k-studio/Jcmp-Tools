// ascode: a harness for a model (like the claude command): the model asks for a tool (read, list, search, write, edit, run), ascode asks
// the person when the tool changes something, does it, and gives the result back, until the model is done.
//   ascode [--model mock:FILE] [--mode ask|read|auto] [TASK ...]
// The models: claude (the Messages API, claude.j) and a scripted one for tests (mock:FILE). llama comes next.
#import <stdlib>
using stdlib;

String ascode_version() { return "0.3.0"; }

String g_mode;          // ask: ask before a change (write, edit, run); read: changes are refused; auto: changes inside the folder are done
String g_root;          // the folder of the work: a path outside it is always asked, also in auto

// ---------------------------------------------------------------- the person
bool g_eof;               // the input has ended

// a line the person types ("" at the end of the input); hidden: nothing is shown while it is typed
String read_text_line(bool hidden) {
    char old[64];
    bool tty = hidden && Sys::isatty(0) == 0;
    if tty {
        Sys::call(29, 0, 21505, (i64)@old, 0, 0, 0);          // TCGETS
        char raw[64];
        for i in 0..64 { raw[i] = old[i]; }
        raw[12] = raw[12] & 245;                              // no ECHO, no ICANON
        Sys::call(29, 0, 21506, (i64)@raw, 0, 0, 0);
    }
    String out = "";
    char b[2];
    while true {
        i64 n = Sys::read(0, @b, 1);
        if n <= 0 { g_eof = true; break; }
        if b[0] == 10 || (tty && b[0] == 13) { break; }
        if b[0] == 127 || b[0] == 8 { if out.len > 0 { out = out.slice(0, out.len - 1); if tty { jout << "\b \b"; Sys::write(1, null, 0); } } continue; }
        out.push(b[0]);
        if tty && b[0] > 32 && b[0] < 127 { jout << "*"; Sys::write(1, null, 0); }          // a star for each letter: it arrived
    }
    if tty { Sys::call(29, 0, 21506, (i64)@old, 0, 0, 0); }
    return out;
}

bool person_says_yes(String what) {
    jout << "ascode: " << what << " [y/n] ";
    String line = read_text_line(false);
    String a = line.trim();
    return a == "y" || a == "Y" || a == "yes";
}

// a change (kind 1) is asked in ask, refused in read, done in auto when the path is inside the folder
bool permitted(String what, String path, i64 kind) {
    if kind == 0 { return true; }                                   // reading, listing, searching
    if g_mode == "read" { jout << "ascode: refused (mode read): " << what << nl; return false; }
    bool inside = path.len == 0 || (!path.starts_with("/") && !path.contains("..")) || path.starts_with(g_root);
    if g_mode == "auto" && inside { return true; }
    return person_says_yes(what);
}

// ---------------------------------------------------------------- the tools: each gives the text that goes back to the model
String tool_read(String path) {
    Result<String, Error> r = Fs::read_text(path);
    if r.is_err() { return "error: cannot read " + path; }
    return r.take();
}

String tool_list(String dir) {
    if !Dir::exists(dir) { return "error: no folder " + dir; }
    Result<String[], Error> r = Dir::list(dir);
    if r.is_err() { return "error: cannot list " + dir; }
    String[] names = r.take();
    names.sort();
    String out = "";
    for i in 0..names.len {
        String full = Path::join(dir, names[i]);
        out = out + names[i];
        if Dir::exists(full) { out = out + "/"; }
        out = out + "\n";
    }
    return out;
}

// the lines of the files of a folder that hold the text (plain text, not a pattern): file:line: text
String tool_search(String text, String dir) {
    String out = "";
    i64 hits = 0;
    Result<String[], Error> r = Dir::list(dir);
    if r.is_err() { return "error: cannot list " + dir; }
    String[] names = r.take();
    names.sort();
    for i in 0..names.len {
        String full = Path::join(dir, names[i]);
        if Dir::exists(full) { continue; }
        Result<String, Error> t = Fs::read_text(full);
        if t.is_err() { continue; }
        String[] ls = t.take().split("\n");
        for k in 0..ls.len {
            if ls[k].contains(text) && hits < 100 { out = out + full + ":" + stg(k + 1) + ": " + ls[k] + "\n"; hits += 1; }
        }
    }
    if hits == 0 { return "no match"; }
    return out;
}

String tool_write(String path, String text) {
    if !permitted("write " + path + " (" + stg(text.len) + " bytes)", path, 1) { return "refused: the person did not allow it"; }
    Result<i64, Error> w = Fs::write_text(path, text);
    if w.is_err() { return "error: cannot write " + path; }
    return "wrote " + path;
}

// the old text must be in the file exactly once (a second place would be a guess)
String tool_edit(String path, String old, String fresh) {
    Result<String, Error> r = Fs::read_text(path);
    if r.is_err() { return "error: cannot read " + path; }
    String text = r.take();
    i64 parts = text.split(old).len;
    if old.len == 0 || parts < 2 { return "error: the old text is not in " + path; }
    if parts > 2 { return "error: the old text is in " + path + " " + stg(parts - 1) + " times (give more of the lines around it)"; }
    if !permitted("edit " + path, path, 1) { return "refused: the person did not allow it"; }
    Result<i64, Error> w = Fs::write_text(path, text.replace(old, fresh));
    if w.is_err() { return "error: cannot write " + path; }
    return "edited " + path;
}

// a command of the shell jsh; the output (and the errors) come back, at most 4000 bytes
String tool_run(String cmd) {
    if !permitted("run: " + cmd, "", 1) { return "refused: the person did not allow it"; }
    String tmp = Path::join(Env::get("TMPDIR").or("/tmp"), "ascode_out." + stg(Sys::getpid()));
    String[] args = arr(4);
    args.push("-c");
    args.push(cmd + " > " + tmp + " 2>&1");
    Result<i64, Error> r = Proc::run("jsh", args);
    String out = "";
    Result<String, Error> t = Fs::read_text(tmp);
    if t.is_ok() { out = t.take(); }
    Fs::remove(tmp);
    if out.len > 4000 { out = out.slice(0, 4000) + "\n... (cut)"; }
    if r.is_err() { return "error: cannot start the shell\n" + out; }
    return out + "exit code " + stg(r.take());
}

// ---------------------------------------------------------------- the model: a scripted one for tests (claude and llama come next)
// lines:  say TEXT | tool NAME ARG1 | ARG2 | ARG3 | done        (the argument separator is " | ")
String[] mock_lines;
i64 mock_at;

bool mock_open(String file) {
    Result<String, Error> r = Fs::read_text(file);
    if r.is_err() { return false; }
    mock_lines = r.take().split("\n");
    mock_at = 0;
    return true;
}

// the next step of the model: kind 0 done, 1 says text, 2 asks for a tool (name and arguments in g_name, g_args)
String g_text;
String g_name;
String[] g_args;

i64 model_turn(String lastresult) {
    String line = "";
    bool have = false;
    while mock_at < mock_lines.len && !have {
        String cand = mock_lines[mock_at].trim();
        mock_at += 1;
        if cand.len > 0 && !cand.starts_with("#") { line = cand; have = true; }
    }
    if !have { return 0; }
    if line == "done" { return 0; }
    if line.starts_with("say ") { g_text = line.slice(4, line.len); return 1; }
    if line.starts_with("tool ") {
        String rest = line.slice(5, line.len);
        i64 sp = rest.find(" ");
        if sp < 0 { g_name = rest; g_args = arr(1); return 2; }
        g_name = rest.slice(0, sp);
        g_args = rest.slice(sp + 1, rest.len).split(" | ");
        for i in 0..g_args.len { g_args[i] = g_args[i].replace("\\n", "\n"); }
        return 2;
    }
    g_text = "(the script has a line that is not understood: " + line + ")";
    return 1;
}

// ---------------------------------------------------------------- the loop
String arg_of(i64 i) {
    if i < g_args.len { return g_args[i] + ""; }
    return "";
}

String do_tool(String name) {
    if name == "read" { return tool_read(arg_of(0)); }
    if name == "list" { String d = arg_of(0); if d.len == 0 { d = "."; } return tool_list(d); }
    if name == "search" { String d = arg_of(1); if d.len == 0 { d = "."; } return tool_search(arg_of(0), d); }
    if name == "write" { return tool_write(arg_of(0), arg_of(1)); }
    if name == "edit" { return tool_edit(arg_of(0), arg_of(1), arg_of(2)); }
    if name == "run" { return tool_run(arg_of(0)); }
    return "error: there is no tool " + name + " (read list search write edit run)";
}

i64 run_loop(String task) {
    jout << "ascode: " << task << nl;
    String last = "";
    for turn in 0..40 {
        i64 k = model_turn(last);
        if k == 0 { jout << "ascode: done" << nl; return 0; }
        if k == 1 { jout << g_text << nl; last = ""; continue; }
        jout << "> " << g_name << " " << arg_of(0) << nl;
        last = do_tool(g_name);
        String shown = last;
        if shown.len > 300 { shown = shown.slice(0, 300) + "..."; }
        jout << shown << nl;
    }
    jout << "ascode: stopped after 40 steps" << nl;
    return 1;
}

i64 usage() {
    jout << "ascode: a harness for a model\n\n";
    jout << "  ascode          a session (the\n                  first time:\n                  who, key, model)\n";
    jout << "  ascode \"task\"   one task\n";
    jout << "  ascode setup    choose again\n";
    jout << "  ascode config   the settings\n\n";
    jout << "Options:\n";
    jout << "  --provider NAME claude openrouter\n    openai gemini groq deepseek\n    mistral together local ollama\n    custom\n";
    jout << "  --model ID      its model\n";
    jout << "  --url ADDRESS   local, custom\n";
    jout << "  --mode ask      ask before a\n                  change (default)\n";
    jout << "  --mode read     refuse changes\n";
    jout << "  --mode auto     change inside\n                  the folder\n";
    jout << "  --version       the version\n\n";
    jout << "Tools of the model: read list\n";
    jout << "search write edit run\n";
    return 0;
}

#import "config"
#import "claude"
#import "openai"
#import "chat"

i64 main() {
    String[] a = Env::args();
    g_root = "";
    String model = "";
    String provider = "";
    String url = "";
    String mode = "";
    String task = "";
    i64 i = 1;
    while i < a.len {
        if a[i] == "--version" || a[i] == "-V" { jout << "ascode " << ascode_version() << "\n"; return 0; }
        else if a[i] == "-h" || a[i] == "--help" { return usage(); }
        else if a[i] == "--model" && i + 1 < a.len { model = a[i + 1] + ""; i += 2; continue; }
        else if a[i] == "--provider" && i + 1 < a.len { provider = a[i + 1] + ""; i += 2; continue; }
        else if a[i] == "--url" && i + 1 < a.len { url = a[i + 1] + ""; i += 2; continue; }
        else if a[i] == "--mode" && i + 1 < a.len { mode = a[i + 1] + ""; i += 2; continue; }
        else { if task.len > 0 { task = task + " "; } task = task + a[i]; }
        i += 1;
    }
    cfg_load();
    if mode.len > 0 && mode != "ask" && mode != "read" && mode != "auto" { jerr << "ascode: the mode is ask, read or auto\n"; return 2; }
    if mode.len > 0 { g_mode = mode + ""; } else { g_mode = cfg_mode + ""; }
    char cw[512];
    for q in 0..512 { cw[q] = 0; }
    Sys::getcwd(@cw, 512);
    g_root = (char^)@cw;
    if model.starts_with("mock:") {
        if !mock_open(model.slice(5, model.len)) { jerr << "ascode: cannot read the script " << model.slice(5, model.len) << "\n"; return 1; }
        return run_loop(task);
    }
    // a provider named alone ( ascode claude ) is the same as --provider
    if task == "claude" || task == "openrouter" || task == "local" || task == "ollama" { provider = task + ""; task = ""; }
    if model == "claude" { provider = "claude"; model = ""; }
    else if model.starts_with("claude:") { provider = "claude"; model = model.slice(7, model.len) + ""; }
    if provider.len > 0 {
        if !provider_known(provider) { jerr << "ascode: no provider " << provider << " (ascode --help)\n"; return 2; }
        cfg_provider = provider + "";
    }
    if url.len > 0 { cfg_url = url + ""; }
    if model.len > 0 { set_model_of(cfg_provider, model); }
    if task == "config" { cl_model = model_of(cfg_provider); show_config(); return 0; }
    bool first = false;
    if !cfg_exists && provider.len == 0 { String k = read_key_of("claude"); first = k.len == 0; }
    if task == "setup" { return chat(true); }
    if task.len == 0 { return chat(first); }
    cl_key = read_key_of(cfg_provider);
    cl_model = model_of(cfg_provider);
    cl_messages = arr(8);
    if cl_key.len == 0 && provider_needs_key(cfg_provider) { jerr << "ascode: no key. Run  ascode setup\n"; return 1; }
    if cl_model.len == 0 { jerr << "ascode: no model. Run  ascode setup\nor give --model ID\n"; return 1; }
    jout << "ascode: " << cfg_provider << " " << cl_model << nl;
    return run_model(task);
}
