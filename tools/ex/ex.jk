// distributed with this file, You can obtain one at https://mozilla.org/MPL/2.0/.
// ex: the commands of the system, one program (it was two: ex of the app for the settings, and jc for the tools).
//   ex install NAME | update [-n] | unstall NAME | tools | search WORD | list | pack ...           tools and programs (one set of words)
//   ex info FILE.jc | install FILE.jc [-y] | run ID|FILE.jc [args] | list | perm ID [NAME on|off]  programs in a .jc file
//   ex setting | set KEY [VALUE] | theme NAME | font NAME | size N | awake on|off                  the settings of exshell
// The libraries of the language are the job of jex; building a project is the job of makej. `jc` is the old name (the same program).
// A .jc is a zip file: manifest.toml (name, id, version, type, entry, permissions = ["files", "network", ...]), the program (entry) and assets/.
// A program started by ex finds JC_ASSETS (its assets folder), JC_HOME (its own folder) and JC_PERMS (the permissions it has, with commas).
#import <stdlib>
#import <deflate>
#import "zipcore"
#import "core"
#import "pkg"
#import "manage"

String ex_version() { return "0.10.0"; }

i64 fail(String msg) {
    jerr << "ex: " << msg << "\n";
    return 1;
}

String env_or(String name, String fallback) {
    switch Env::get(name) {
        Option::Some(v): { if v.len > 0 { return v; } }
        Option::None: { }
    }
    return fallback;
}

String jc_home() {
    String h = env_or("JC_ROOT", "");
    if h.len > 0 { return h; }
    return env_or("HOME", ".") + "/.local/share/jc";
}

// the value of  key = value  in the manifest ("" when none); quotes are taken away
String manifest_value(String text, String key) {
    String[] ls = text.split("\n");
    for i in 0..ls.len {
        String ln = ls[i].trim();
        i64 eq = ln.find("=");
        if eq <= 0 || ln[0] == '#' || ln[0] == '[' { continue; }
        if ln.slice(0, eq).trim() == key { return ln.slice(eq + 1, ln.len).trim().replace("\"", ""); }
    }
    return "";
}

// ["files", "network"] -> files,network
String perm_list(String text) {
    String v = manifest_value(text, "permissions").replace("[", "").replace("]", "").replace(" ", "");
    return v;
}

bool known_perm(String p) {
    return p == "files" || p == "network" || p == "audio" || p == "camera" || p == "location" || p == "clipboard" || p == "run" || p == "sessions" || p == "assistant";
}

String read_package(String path, bool^ ok) {
    ok[0] = false;
    Result<String, Error> r = Fs::read_bytes(path);
    if !r.is_ok() { fail("cannot read " + path); return ""; }
    String z = r.take();
    if !zip_list(z) { fail(path + " is not a .jc package (not a zip file)"); return ""; }
    ok[0] = true;
    return z;
}

i64 entry_index(String name) {
    for i in 0..zn_name.len { if zn_name[i] == name { return i; } }
    return 0 - 1;
}

String manifest_of(String z) {
    i64 mi = entry_index("manifest.toml");
    if mi < 0 { return ""; }
    return zip_extract(z, mi, "");
}

bool safe_name(String n) {
    if n.len == 0 || n[0] == '/' { return false; }
    for i in 0..n.len - 1 { if n[i] == '.' && n[i + 1] == '.' { return false; } }
    return true;
}

bool good_id(String id) {
    if id.len == 0 || id.len > 60 { return false; }
    for i in 0..id.len {
        char c = id[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
        if !ok { return false; }
    }
    return id[0] != '.';
}

i64 do_info(String path) {
    bool ok = false;
    String z = read_package(path, @ok);
    if !ok { return 1; }
    String m = manifest_of(z);
    if m.len == 0 { return fail(path + " has no manifest.toml"); }
    jout << "name:         " << manifest_value(m, "name") << "\n";
    jout << "id:           " << manifest_value(m, "id") << "\n";
    jout << "version:      " << manifest_value(m, "version") << "\n";
    jout << "type:         " << manifest_value(m, "type") << "\n";
    jout << "entry:        " << manifest_value(m, "entry") << "\n";
    String p = perm_list(m);
    if p.len == 0 { jout << "permissions:  (none)\n"; } else { jout << "permissions:  " << p << "\n"; }
    jout << "files:        " << zn_name.len << "\n";
    return 0;
}

String app_dir(String id) { return jc_home() + "/apps/" + id; }

// the permissions a program has (the file perms in its folder, comma separated); "" when none
String granted(String id) {
    String f = app_dir(id) + "/.perms";
    if !Fs::exists(f) { return ""; }
    Result<String, Error> r = Fs::read_text(f);
    if !r.is_ok() { return ""; }
    return r.take().trim();
}

void set_granted(String id, String list) {
    Fs::write_text(app_dir(id) + "/.perms", list + "\n");
}

i64 do_install(String path, bool yes) {
    bool ok = false;
    String z = read_package(path, @ok);
    if !ok { return 1; }
    String m = manifest_of(z);
    if m.len == 0 { return fail(path + " has no manifest.toml"); }
    String id = manifest_value(m, "id");
    String name = manifest_value(m, "name");
    String entry = manifest_value(m, "entry");
    if !good_id(id) { return fail("the id in the manifest is missing or has odd letters: '" + id + "'"); }
    if entry.len == 0 || !safe_name(entry) { return fail("the entry in the manifest is missing or not a plain name"); }
    if entry_index(entry) < 0 { return fail("the entry '" + entry + "' is not in the package"); }
    String asked = perm_list(m);
    String[] ps = asked.split(",");
    for i in 0..ps.len { if ps[i].len > 0 && !known_perm(ps[i]) { return fail("the manifest asks for an unknown permission '" + ps[i] + "'"); } }
    String old = granted(id);
    String perm_file = app_dir(id) + "/.perms";
    bool update = Fs::exists(perm_file);
    jout << name << " (" << id << ") " << manifest_value(m, "version") << "\n";
    if asked.len == 0 { jout << "  asks for no permissions\n"; }
    else { for i in 0..ps.len { if ps[i].len > 0 { jout << "  asks for: " << ps[i] << "\n"; } } }
    bool same_or_less = update;
    if same_or_less {
        // an update: asks again only for permissions that the old version did not have
        String[] os = old.split(",");
        for i in 0..ps.len {
            if ps[i].len == 0 { continue; }
            bool had = false;
            for k in 0..os.len { if os[k] == ps[i] { had = true; } }
            if !had { same_or_less = false; }
        }
    }
    if !yes && !same_or_less && Sys::isatty(0) == 0 {
        jout << "Install and give these permissions? [Y/n] ";
        String a = Input::line().trim();
        if a == "n" || a == "N" || a == "no" { jout << "not installed\n"; return 1; }
    } else if !yes && !same_or_less && asked.len > 0 {
        return fail("this package asks for permissions and there is no terminal to ask; use  ex install -y FILE.jc  to give them");
    }
    String dir = app_dir(id);
    Dir::make_all(dir);
    i64 written = 0;
    for i in 0..zn_name.len {
        String n = zn_name[i];
        if !safe_name(n) { jerr << "ex: skipped " << n << " (an odd name)\n"; continue; }
        if n.ends_with("/") { Dir::make_all(dir + "/" + n); continue; }
        String data = zip_extract(z, i, "");
        if zip_err.len > 0 { return fail(n + ": " + zip_err); }
        String full = dir + "/" + n;
        i64 slash = 0 - 1;
        for k in 0..full.len { if full[k] == '/' { slash = k; } }
        if slash > 0 { Dir::make_all(full.slice(0, slash)); }
        if !Fs::write_bytes(full, data).is_ok() { return fail("cannot write " + full); }
        written += 1;
    }
    Sys::chmod((dir + "/" + entry).c(), 493);
    Fs::write_text(dir + "/manifest.toml", m);
    set_granted(id, asked);
    jout << "installed " << id << " (" << written << " files) in " << dir << "\n";
    return 0;
}

// the folder of an installed program: the id, or "" when there is no such program
bool installed(String id) {
    if !good_id(id) { return false; }
    String dir = app_dir(id);
    String mf = dir + "/manifest.toml";
    return Dir::exists(dir) && Fs::exists(mf);
}

i64 do_run(String[] a) {
    if a.len < 3 { return fail("usage: ex run ID|FILE.jc [arguments]"); }
    String what = a[2];
    String id = what;
    if what.ends_with(".jc") {
        bool ok = false;
        String z = read_package(what, @ok);
        if !ok { return 1; }
        String m = manifest_of(z);
        id = manifest_value(m, "id");
        if !installed(id) { if do_install(what, false) != 0 { return 1; } }
    }
    if !installed(id) { return fail("no program '" + id + "' is installed (ex list; ex install FILE.jc)"); }
    Result<String, Error> mr = Fs::read_text(app_dir(id) + "/manifest.toml");
    if !mr.is_ok() { return fail("cannot read the manifest of " + id); }
    String entry = manifest_value(mr.take(), "entry");
    String dir = app_dir(id);
    String perms = granted(id);
    String[] args = arr(a.len + 6);
    args.push("-c");
    args.push("cd \"$3\" && export JC_HOME=\"$3\" JC_ASSETS=\"$3/assets\" JEC_ASSETS=\"$3/assets\" JC_PERMS=\"$2\"; e=\"$1\"; shift 4; exec \"$e\" \"$@\"");
    args.push("jc");
    args.push(dir + "/" + entry);
    args.push(perms);
    args.push(dir);
    args.push("-");
    for i in 3..a.len { args.push(a[i]); }
    Result<i64, Error> r = Proc::run("sh", args);
    if !r.is_ok() { return fail("cannot start " + entry); }
    return r.take();
}

i64 do_list() {
    String root = jc_home() + "/apps";
    if !Dir::exists(root) { jout << "nothing is installed (ex install FILE.jc)\n"; return 0; }
    Result<String[], Error> r = Dir::list(root);
    if !r.is_ok() { return 0; }
    String[] names = r.take();
    names.sort();
    i64 n = 0;
    for i in 0..names.len {
        if !installed(names[i]) { continue; }
        Result<String, Error> mr = Fs::read_text(app_dir(names[i]) + "/manifest.toml");
        String m = "";
        if mr.is_ok() { m = mr.take(); }
        String p = granted(names[i]);
        if p.len == 0 { p = "-"; }
        jout << names[i] << "  " << manifest_value(m, "version") << "  " << manifest_value(m, "name") << "   permissions: " << p << "\n";
        n += 1;
    }
    if n == 0 { jout << "nothing is installed (ex install FILE.jc)\n"; }
    return 0;
}

i64 do_perm(String[] a) {
    if a.len < 3 { return fail("usage: ex perm ID [NAME on|off]"); }
    String id = a[2];
    if !installed(id) { return fail("no program '" + id + "' is installed"); }
    if a.len == 3 { String p = granted(id); if p.len == 0 { p = "(none)"; } jout << id << " has: " << p << "\n"; return 0; }
    if a.len < 5 { return fail("usage: ex perm ID NAME on|off"); }
    String name = a[3];
    if !known_perm(name) { return fail("unknown permission '" + name + "' (files network audio camera location clipboard run sessions assistant)"); }
    String[] cur = granted(id).split(",");
    String out = "";
    bool present = false;
    for i in 0..cur.len {
        if cur[i].len == 0 { continue; }
        if cur[i] == name { present = true; if a[4] == "on" { out = out + cur[i] + ","; } }
        else { out = out + cur[i] + ","; }
    }
    if !present && a[4] == "on" { out = out + name + ","; }
    if out.len > 0 { out = out.slice(0, out.len - 1); }
    set_granted(id, out);
    jout << id << " has: " << out << "\n";
    return 0;
}

i64 do_remove(String id) {
    if !installed(id) { return fail("no program '" + id + "' is installed"); }
    String dir = app_dir(id);
    Result<String[], Error> r = Dir::list(dir);
    // the files and the folders under it, one level at a time (a program folder is not deep)
    remove_tree(dir);
    jout << "removed " << id << "\n";
    return 0;
}


i64 run_other(String prog, String[] words) {              // another program of Jaric does the work (jget for tools, jstore for the store)
    String[] args = arr(words.len + 1);
    for i in 0..words.len { args.push(words[i]); }
    Result<i64, Error> r = Proc::run(prog, args);
    if !r.is_ok() { return fail("cannot start " + prog + " (ex install " + prog + ")"); }
    return r.take();
}

bool is_package_name(String what) {                        // FILE.jc or a path: a package; NAME: a tool; ID.with.dots: the store
    return what.ends_with(".jc") || what.contains("/") || Fs::exists(what);
}

// the help (manage.j calls it when a command is used wrongly)
i64 usage() {
    jout << "ex: the commands of the system\n\n";
    jout << "Usage: ex COMMAND\n\n";
    jout << "Tools and programs:\n";
    jout << "  tools         what there is\n";
    jout << "  install NAME  get it\n";
    jout << "  update [-n]   bring them up\n                to date\n";
    jout << "  unstall NAME  remove it\n";
    jout << "  search WORD   find one\n";
    jout << "  list          installed\n";
    jout << "  pack list     sets of tools\n";
    jout << "  doctor        is all well\n\n";
    jout << "Programs in a .jc file:\n";
    jout << "  info FILE.jc  what is in it\n";
    jout << "  install FILE.jc [-y]\n";
    jout << "  run ID        start it\n";
    jout << "  perm ID       permissions\n\n";
    jout << "The app (exshell):\n";
    jout << "  setting       all settings\n";
    jout << "  set KEY VALUE change one\n";
    jout << "  theme NAME    the colours\n";
    jout << "  font NAME     the letters\n";
    jout << "  awake on|off  keep running\n";
    jout << "  app update    a new app\n\n";
    jout << "Libraries: jex lib install NAME\n";
    return 0;
}

// ------------------------------------------------------------ one world: tools and packages are installed, found and removed by the same words
// ex tools | ex search WORD: what can be installed (the tools of ex-pkg, then the built programs); with a word only what holds it
i64 search_all(String word) {
    String f = default_bin_dir() + "/.tools.look";
    if !download(tools_raw() + "/tools.txt", f, true) { return fail("cannot read the list (is the network there?)"); }
    i64 hits = 0;
    switch Fs::read_text(f) {
        Result::Ok(t): {
            String[] ls = t.split("\n");
            for i in 0..ls.len {
                if ls[i].len == 0 || ls[i][0] == '#' { continue; }
                String[] p = ls[i].split("|");
                if p.len < 2 { continue; }
                String low = ls[i].lower();
                if word.len > 0 && !low.contains(word) { continue; }
                print_item(p[0] + "", p[1] + "", 11);
                hits += 1;
            }
        }
        Result::Err(e): { }
    }
    Fs::remove(f);
    String index = pkg_fetch_index();
    if index.len > 0 {
        jout << nl << "programs (git, clang ...):" << nl;
        pkg_search(index, word);
    }
    jout << nl << "ex install NAME" << nl;
    return 0;
}

// ex list: what is installed here: tools, programs of packages, and the .jc programs
i64 list_installed() {
    String dir = default_bin_dir();
    String me = self_path();
    i64 slash = 0 - 1;
    for i in 0..me.len { if me[i] == '/' { slash = i; } }
    if slash > 0 { dir = me.slice(0, slash); }
    switch Dir::list(dir) {
        Result::Ok(names): {
            String[] marks = arr(names.len + 1);
            for i in 0..names.len { if names[i].starts_with(".") && names[i].ends_with(".version") { marks.push(names[i].slice(1, names[i].len - 8)); } }
            marks.sort();
            if marks.len > 0 { jout << "tools (updated by ex):" << nl; }
            for i in 0..marks.len { String m = marks[i] + ""; jout << "  " << m << "  " << tool_installed_version(dir, m) << nl; }
        }
        Result::Err(e): { }
    }
    if Dir::exists(pkg_state()) { jout << "programs:" << nl; pkg_list(); }
    return do_list();
}

// ------------------------------------------------------------ the app itself and a check of the system
// where the newest app is described: lines  "version X"  "code N"  "sha256 H"  "url U"  and for older apps  "patch FROMCODE SHA256 URL"
// (EX_APP_INDEX names another file, for the tests)
String app_index_address() { return env_or("EX_APP_INDEX", "https://raw.githubusercontent.com/J2k-studio/ex-pkg/main/app/exshell.txt"); }

String g_app_version;
String g_app_sha;
String g_app_url;
i64 g_app_code;
String g_patch_sha;          // the patch from the installed app to the newest one, when there is one
String g_patch_url;

i64 digits_of(String t) {
    i64 n = 0;
    for i in 0..t.len { if t[i] < '0' || t[i] > '9' { break; } n = n * 10 + (t[i] - '0'); }
    return n;
}

// the number of the installed app; 0 when the app does not say (older builds) or this is not the app
i64 app_code_here() { return digits_of(env_or("EXSHELL_CODE", "")); }

bool app_newest() {
    String f = env_or("TMPDIR", env_or("HOME", ".")) + "/.ex_app." + stg(Sys::getpid());
    if !download(app_index_address(), f, true) { return false; }
    g_app_version = "";
    g_app_sha = "";
    g_app_url = "";
    g_app_code = 0;
    g_patch_sha = "";
    g_patch_url = "";
    i64 mine = app_code_here();
    switch Fs::read_text(f) {
        Result::Ok(t): {
            String[] ls = t.split("\n");
            for i in 0..ls.len {
                String[] w = ls[i].trim().split(" ");
                if w.len < 2 { continue; }
                if w[0] == "version" { g_app_version = w[1] + ""; }
                if w[0] == "sha256" { g_app_sha = w[1] + ""; }
                if w[0] == "url" { g_app_url = w[1] + ""; }
                if w[0] == "code" { g_app_code = digits_of(w[1] + ""); }
                if w[0] == "patch" && w.len >= 4 && mine > 0 {
                    String from = w[1] + "";
                    if digits_of(from) == mine { g_patch_sha = w[2] + ""; g_patch_url = w[3] + ""; }
                }
            }
        }
        Result::Err(e): { }
    }
    Fs::remove(f);
    return g_app_version.len > 0 && g_app_url.len > 0 && g_app_sha.len == 64 && g_app_code > 0;
}

// the bytes of a file (any bytes)
bool all_bytes(String path, String out) {
    i64 fd = Sys::open_read(path.c());
    if fd < 0 { return false; }
    char buf[16384];
    i64 n = Sys::read(fd, @buf, 16384);
    while n > 0 {
        for i in 0..n { out.push(buf[i]); }
        n = Sys::read(fd, @buf, 16384);
    }
    Sys::close(fd);
    return n == 0;
}

i64 le32_at(String s, i64 at) { return ((i64)s[at] & 255) | (((i64)s[at + 1] & 255) << 8) | (((i64)s[at + 2] & 255) << 16) | (((i64)s[at + 3] & 255) << 24); }

// "EXPATCH1" new_size, then 'C' offset length (copy of the old file) | 'I' length bytes (new bytes) | 'E' (the end); made by tools/apkpatch.py
// of exshell. false when the patch is damaged or does not belong to this old file.
bool apply_patch(String old, String patch, String out) {
    if patch.len < 13 || !patch.starts_with("EXPATCH1") { return false; }
    i64 size = le32_at(patch, 8);
    i64 q = 12;
    while q < patch.len {
        char op = patch[q];
        if op == 'E' { return out.len == size; }
        if op == 'C' {
            if q + 9 > patch.len { return false; }
            i64 off = le32_at(patch, q + 1);
            i64 n = le32_at(patch, q + 5);
            if off < 0 || n < 0 || off + n > old.len || out.len + n > size { return false; }
            String part = old.slice(off, off + n);
            out.append(part);
            q += 9;
        } else if op == 'I' {
            if q + 5 > patch.len { return false; }
            i64 n = le32_at(patch, q + 1);
            if n < 0 || q + 5 + n > patch.len || out.len + n > size { return false; }
            String part = patch.slice(q + 5, q + 5 + n);
            out.append(part);
            q += 5 + n;
        } else { return false; }
    }
    return false;
}

bool file_is(String path, String sha) {
    String got = "";
    switch Sha256::file(path) {
        Result::Ok(h): { got = h; }
        Result::Err(e): { }
    }
    return got == sha;
}

// the newest app made from the installed one and the patch: only what changed is downloaded. false: the whole file has to be fetched
bool app_from_patch(String apk) {
    String mine = env_or("EXSHELL_APK", "");
    if g_patch_url.len == 0 || mine.len == 0 || !Fs::exists(mine) { return false; }
    String pf = apk + ".patch";
    jout << "only the patch is downloaded" << nl;
    if !download(g_patch_url, pf, false) { return false; }
    bool ok = file_is(pf, g_patch_sha);
    if ok {
        String old = "";
        String patch = "";
        String made = "";
        ok = all_bytes(mine, old) && all_bytes(pf, patch) && apply_patch(old, patch, made);
        if ok {
            Result<i64, Error> w = Fs::write_text(apk, made);
            ok = w.is_ok() && file_is(apk, g_app_sha);
        }
    }
    Fs::remove(pf);
    if !ok { Fs::remove(apk); jout << "the patch did not make the new app: the whole file is fetched" << nl; }
    return ok;
}

i64 app_update(bool dry) {
    if env_or("EXSHELL", "") != "1" { return fail("this is not the terminal of exshell"); }
    if !app_newest() { return fail("cannot read what the newest app is (is the network there?)"); }
    i64 have = app_code_here();
    String shown = env_or("EXSHELL_VERSION", "(it does not say)");
    jout << "app here:   " << shown << nl;
    jout << "app newest: " << g_app_version << nl;
    if have >= g_app_code { jout << "the app is up to date" << nl; return 0; }
    if dry { jout << "ex app update installs it" << nl; offer_command("ex app update"); return 0; }
    String dir = env_or("HOME", ".") + "/.cache";
    Dir::make_all(dir);
    String apk = dir + "/exshell-" + g_app_version + ".apk";
    if !app_from_patch(apk) {
        if !download(g_app_url, apk, false) { return fail("the download did not finish"); }
        if !file_is(apk, g_app_sha) { Fs::remove(apk); return fail("the checksum of the app does not match, nothing was installed"); }
    }
    jout << "the installer of Android opens: tap Update" << nl;
    jout << "(the sessions end when the app is replaced)" << nl;
    String[] ia = arr(3);
    ia.push("-ins");
    ia.push(apk + "");
    Result<i64, Error> r = Proc::run("jearlink", ia);             // jearlink talks to the app and says what it answered
    if r.is_err() { jout << "or open this file yourself: " << apk << nl; return 1; }
    return r.take();
}

fnv check_line(str name, str text) {
    str n = name + "";
    while n.len < 10 { n = n + " "; }
    jout << n << text << nl;
}

// ex doctor: is everything in place, and what to do when it is not
i64 doctor() {
    String me = self_path();
    String dir = default_bin_dir();
    i64 slash = 0 - 1;
    for i in 0..me.len { if me[i] == '/' { slash = i; } }
    if slash > 0 { dir = me.slice(0, slash); }
    i64 todo = 0;
    check_line("ex", ex_version());
    String vtext = tool_versions_text(dir);
    if vtext.len == 0 { check_line("network", "no: nothing can be fetched"); todo += 1; } else { check_line("network", "ok"); }
    String[] names = "jsh jbox jex jcmp jurl coderin".split(" ");
    for i in 0..names.len {
        String nm = names[i] + "";
        String have = tool_installed_version(dir, nm);
        if have.len == 0 { check_line(nm, "not here (ex install " + nm + ")"); continue; }
        String lat = tool_latest(vtext, nm);
        if lat.len > 0 && have != "unknown" && tool_ver_newer(lat, have) { check_line(nm, have + " -> " + lat); todo += 1; }
        else { check_line(nm, have); }
    }
    if env_or("EXSHELL", "") == "1" {
        if app_newest() {
            i64 have = app_code_here();
            if have >= g_app_code { check_line("app", env_or("EXSHELL_VERSION", "") + ""); }
            else { check_line("app", "newer: ex app update"); offer_command("ex app update"); todo += 1; }
        }
        Result<String[], Error> st = Dir::list("/storage/emulated/0");
        if st.is_err() { check_line("storage", "closed: run  cd u:/"); todo += 1; } else { check_line("storage", "open (u:/)"); }
    }
    char sf[128];
    for q in 0..128 { sf[q] = 0; }
    if Sys::call(43, (i64)dir.c(), (i64)@sf, 0, 0, 0, 0) >= 0 {                                   // statfs: the block size at 8, the free blocks at 32
        i64 bsize = 0;
        i64 avail = 0;
        for k in 0..8 { bsize = bsize | (((i64)sf[8 + k] & 255) << (8 * k)); avail = avail | (((i64)sf[32 + k] & 255) << (8 * k)); }
        i64 mb = bsize / 512 * avail / 2048;
        check_line("free", stg(mb) + " MB");
        if mb < 200 { todo += 1; }
    }
    if todo == 0 { jout << "all is well" << nl; } else { jout << stg(todo) << " thing(s) to do" << nl; }
    return 0;
}

// ------------------------------------------------------------ the settings of the app
// The app listens for `ESC ] 7777 ; words BEL`.
// writes a message of the standard to the terminal at once (the output buffer is emptied first, nothing waits for the end of the program)
fnv say(str words) {
    str s = "";
    s.push(27);
    s.append("]7777;" + words);
    s.push(7);
    jout << s;
    Sys::write(1, null, 0);
}

// a setting by a key: with a value it is changed, without one the app writes what it is now and what it can be
fn setting(str key, str value) {
    if value == "" { say("get;" + key); } else { say("set;" + key + ";" + value); }
    Time::sleep_ms(300);                                      // the answer comes on the screen: the prompt of the shell waits for it
    return 0;
}

// the real path of a file (a drive path like u:/fomas/x.png becomes the path the app can open)
str real_file(str name) {
    i64 fd = Sys::open_read(name.c());
    if fd < 0 { return ""; }
    str link = "/proc/self/fd/" + stg(fd);
    char buf[4096];
    i64 n = Sys::readlink(link.c(), (char^)@buf, 4095);
    Sys::close(fd);
    if n <= 0 { return ""; }
    buf[n] = 0;
    str r = (char^)@buf;
    return r + "";
}

// ex set KEY [VALUE] | ex set NAME... PICTURE.png COLS [ROWS]
fn cmd_set(str[] a) {
    str c = a[1];
    if c == "set" && a.len > 3 {                                                 // ex set NAME [NAME ...] FILE.png COLS [ROWS [ROW [FPS]]]: NAME is idle, walk, jump or any other name; several names share the picture
        int k = 0 - 1;
        for int q = 3; q < a.len; q++ { if k < 0 && a[q].ends_with(".png") { k = q; } }
        if k > 2 && a.len > k + 1 {
            str real2 = real_file(a[k]);
            if real2.len == 0 { jerr << "ex: there is no such file: " << a[k] << "\n"; return 1; }
            str spec = real2;
            for int q = k + 1; q < a.len; q++ { spec = spec + " " + a[q]; }
            int rcs = 0;
            for int q = 2; q < k; q++ { rcs = setting("mascot_anim_" + a[q], spec); }
            return rcs;
        }
        if k > 2 { jerr << "ex: how many pictures side by side? ex set " << a[2] << " " << a[k] << " 6   (the number of columns; then rows)\n"; return 2; }
    }
    if c == "set" && a.len > 3 && a[2].ends_with(".png") {                       // ex set nun_idle.png 4 [ROWS]: that picture is the mascot, with 4 frames side by side
        str real = real_file(a[2]);
        if real.len == 0 { jerr << "ex: there is no such file: " << a[2] << "\n"; return 1; }
        str rows = "1";
        if a.len > 4 { rows = a[4]; }
        return setting("mascot_sheet", real + " " + a[3] + " " + rows);
    }
    if c == "set" {
        if a.len < 3 { jerr << "ex: usage: ex set KEY [VALUE]   (ex setting list shows the keys)\n"; return 2; }
        str v = "";
        if a.len > 3 { v = a[3]; }
        return setting(a[2], v);
    }
    return 0;
}

i64 main() {
    String[] a = Env::args();
    if a.len > 1 && (a[1] == "--version" || a[1] == "-V") { jout << "ex " << ex_version() << "\n"; return 0; }
    if a.len < 2 {
        if env_or("PREFIX", "").contains("com.exshell") { say("settings"); return 0; }          // in the app: `ex` alone opens the settings
        return usage();
    }
    if a[1] == "--help" || a[1] == "-h" || a[1] == "help" { return usage(); }
    if a[1] == "setting" || a[1] == "settings" {
        if a.len > 2 && a[2] == "list" { say("settings;list"); Time::sleep_ms(300); } else { say("settings"); }
        return 0;
    }
    if a[1] == "doctor" { return doctor(); }
    if a[1] == "app" {
        bool dry = a.len < 3 || a[2] != "update";
        for i in 2..a.len { if a[i] == "-n" { dry = true; } }
        return app_update(dry);
    }
    if a[1] == "set" { return (i64)cmd_set(a); }
    String[] keys = "awake font theme size anim volume keys_bar storage mascot sparkle num_sprite_sheet mascot_name mascot_gender mascot_size mascot_dir mascot_sheet".split(" ");
    String val = "";
    if a.len > 2 { val = a[2] + ""; }
    for i in 0..keys.len {                                                  // ex theme black, ex setfont pixel, ex awake on ...
        String longer = "set" + keys[i];
        if a[1] == keys[i] || a[1] == longer { return (i64)setting(keys[i] + "", val); }
    }
    if a[1] == "search" { String w = ""; if a.len > 2 { w = a[2] + ""; } return search_all(w); }
    if a[1] == "remove" { a[1] = "unstall"; }
    if a[1] == "pack" { return cmd_pack(a); }
    if a[1] == "pkg" { return cmd_pkg(a); }                    // the packages of ex-pkg (git, clang, python ...)
    if a[1] == "info" && a.len >= 3 { return do_info(a[2]); }
    if a[1] == "update" || a[1] == "upgrade" {                 // jsh and every installed tool with a newer version, then the programs of the store
        String[] w = arr(a.len + 2);
        w.push("jc");
        w.push("update");
        for i in 2..a.len { w.push(a[i] + ""); }
        i64 rc = cmd_tool(w, 1);
        if env_or("EXSHELL", "") == "1" && app_newest() && app_code_here() < g_app_code {
            jout << "a new app is there: ex app update" << nl;
            offer_command("ex app update");
        }
        String[] pw = arr(4);                                  // and the packages of ex-pkg
        pw.push("jc");
        pw.push("pkg");
        pw.push("update");
        for i in 2..a.len { if a[i] == "-n" { pw.push("-n"); } }
        pw.push("--quiet");                                    // nothing to say when there are no packages or they are up to date
        if cmd_pkg(pw) != 0 { rc = 1; }
        return rc;
    }
    if (a[1] == "unstall" || a[1] == "uninstall") && a.len >= 3 {
        if a[2].contains(".") { return do_remove(a[2]); }
        String[] w = arr(a.len + 2);
        w.push("jc");
        w.push("unstall");
        for i in 2..a.len { w.push(a[i] + ""); }
        return cmd_tool(w, 1);
    }
    if a[1] == "install" && a.len >= 3 && !is_package_name(a[2]) {
        String[] w = arr(a.len + 2);
        if a[2].contains(".") {
            w.push("install");
            for i in 2..a.len { w.push(a[i] + ""); }
            return run_other("jstore", w);                       // a program of the store: ID.with.dots  ->  jstore install ID
        }
        w.push("jc");
        for i in 2..a.len { w.push(a[i] + ""); }
        return cmd_tool(w, 1);                                   // a tool of Jcmp-Tools
    }
    if a[1] == "install" && a.len >= 3 {
        bool yes = false;
        for i in 3..a.len { if a[i] == "-y" { yes = true; } }
        return do_install(a[2], yes);
    }
    if a[1] == "tools" { return search_all(""); }                          // everything that can be installed
    if a[1] == "lib" || a[1] == "libs" {                                                                      // the libraries of J2K: jex lib list | install NAME | unstall NAME | installed
        String[] w = arr(a.len + 2);
        w.push("jc");
        w.push("lib");
        for i in 2..a.len { w.push(a[i] + ""); }
        return cmd_library(w, 2);
    }
    if a[1] == "run" { return do_run(a); }
    if a[1] == "list" { return list_installed(); }
    if a[1] == "perm" { return do_perm(a); }
    if a[1] == "remove" && a.len >= 3 { return do_remove(a[2]); }
    jerr << "ex: unknown command '" << a[1] << "' (ex help)\n";
    return 2;
}
