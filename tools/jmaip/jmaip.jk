// This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0. If a copy of the MPL was not
// distributed with this file, You can obtain one at https://mozilla.org/MPL/2.0/.
// jmaip 0.1.0 -- keys and secrets for the programs of the Jaric world: a vault locked by a passphrase, passkeys (ECDSA P-256 keys that sign a challenge),
// and encryption of files with a key that comes from a passkey (so a file can be opened only by the one who has the passkey).
//   jmaip init                         make the vault (asks a passphrase)          jmaip status
//   jmaip key new NAME | list | public NAME | sign NAME CHALLENGE | verify PUBLIC CHALLENGE SIGNATURE | rm NAME
//   jmaip enc [-k NAME] IN [OUT]       encrypt (with the passkey NAME, or with the vault key)       jmaip dec IN [OUT]
//   jmaip secret put NAME VALUE | get NAME | list | rm NAME        jmaip otp ...  (the codes of authj)
// A CHALLENGE is text, or hex:... (bytes in hex), or @FILE. The passphrase comes from the environment JMAIP_PASS or is asked without an echo; JMAIP_MASTERKEY_CMD
// names a command that prints the 32-byte vault key in hex (this is how a fingerprint or face check of the phone can release the key). JMAIP_DIR is the folder
// (default ~/.jmaip, mode 700).
// The cryptography: PBKDF2-HMAC-SHA256 (100 000 rounds) wraps the vault key, AES-256-GCM seals every secret and key and file, HKDF-SHA256 makes the keys.
// A passkey is a P-256 private key; its "encryption secret" is the (deterministic) signature of a fixed text, put through HKDF.
#import <stdlib>
#import <files>
#import <crypto>
using stdlib;
#import "sign"

String jmaip_version() { return "0.3.0"; }

// ---------- bytes
String hex_of(String s) {
    String r = "";
    String d = "0123456789abcdef";
    for i in 0..s.len { int b = s[i] & 255; r.push(d[b >> 4]); r.push(d[b & 15]); }
    return r;
}

int hex_val(char c) {
    if c >= '0' && c <= '9' { return c - '0'; }
    if c >= 'a' && c <= 'f' { return c - 'a' + 10; }
    if c >= 'A' && c <= 'F' { return c - 'A' + 10; }
    return -1;
}

String from_hex(String h, bool^ ok) {
    String r = "";
    ok[0] = h.len % 2 == 0;
    int i = 0;
    while ok[0] && i + 1 < h.len {
        int a = hex_val(h[i]);
        int b = hex_val(h[i + 1]);
        if a < 0 || b < 0 { ok[0] = false; break; }
        r.push((char)(a * 16 + b));
        i += 2;
    }
    return r;
}

String zeros(int n) {
    String r = "";
    for i in 0..n { r.push((char)0); }
    return r;
}

String random_bytes(int n) {
    String r = "";
    int fd = Sys::open_read("/dev/urandom");
    if fd < 0 { return r; }
    char b[64];
    while r.len < n {
        int want = n - r.len;
        if want > 64 { want = 64; }
        int got = Sys::read(fd, @b, want);
        if got <= 0 { break; }
        for i in 0..got { r.push(b[i]); }
    }
    Sys::close(fd);
    return r;
}

String sha256_of(String s) {
    char out[32];
    Crypto::sha256(s.c(), s.len, (char^)@out);
    String r = "";
    for i in 0..32 { r.push(out[i]); }
    return r;
}

String hmac256(String key, String msg) {
    char out[32];
    Crypto::hmac(256, key.c(), key.len, msg.c(), msg.len, (char^)@out);
    String r = "";
    for i in 0..32 { r.push(out[i]); }
    return r;
}

// PBKDF2-HMAC-SHA256 (RFC 8018): 32 bytes
String pbkdf2(String pass, String salt, int rounds) {
    String u = hmac256(pass, salt + "\x00\x00\x00\x01");
    String t = u + "";
    for r in 1..rounds {
        u = hmac256(pass, u);
        for i in 0..32 { t[i] = (char)((t[i] & 255) xor (u[i] & 255)); }
    }
    return t;
}

// HKDF-SHA256: n bytes (n <= 255 * 32) from the secret ikm
String hkdf(String ikm, String salt, String info, int n) {
    char prk[32];
    Crypto::hkdf_extract(256, salt.c(), salt.len, ikm.c(), ikm.len, (char^)@prk);
    char okm[128];
    Crypto::hkdf_expand(256, (char^)@prk, 32, info.c(), info.len, (char^)@okm, n);
    String r = "";
    for i in 0..n { r.push(okm[i]); }
    return r;
}

// AES-256-GCM: iv (12) + ciphertext + tag (16); aad is authenticated but not secret
String seal(String key, String aad, String plain) {
    String iv = random_bytes(12);
    String ct = zeros(plain.len);
    char tag[16];
    Crypto::gcm_seal(key.c(), iv.c(), aad.c(), aad.len, plain.c(), plain.len, ct.c(), (char^)@tag);
    String t = "";
    for i in 0..16 { t.push(tag[i]); }
    return iv + ct + t;
}

// the plain text, or ok = false when the key is wrong or the data was changed
String unseal(String key, String aad, String blob, bool^ ok) {
    ok[0] = false;
    if blob.len < 28 { return ""; }
    String iv = blob.slice(0, 12);
    String ct = blob.slice(12, blob.len - 16);
    String tag = blob.slice(blob.len - 16, blob.len);
    String plain = zeros(ct.len);
    ok[0] = Crypto::gcm_open(key.c(), iv.c(), aad.c(), aad.len, ct.c(), ct.len, tag.c(), plain.c());
    return plain;
}

// ---------- files and places
bool ends_with(String s, String t) {
    if s.len < t.len { return false; }
    for i in 0..t.len { if s[s.len - t.len + i] != t[i] { return false; } }
    return true;
}

int fail(String msg) {
    jerr << "jmaip: " << msg << "\n";
    return 1;
}

String vault_dir() {
    Option<String> d = Env::get("JMAIP_DIR");
    if d.is_some() { return d.unwrap(); }
    Option<String> home = Env::get("HOME");
    String base = "/tmp";
    if home.is_some() { base = home.unwrap(); }
    return base + "/.jmaip";
}

bool write_private(String path, String data) {
    int fd = Sys::open_write(path.c());
    if fd < 0 { return false; }
    int n = 0;
    if data.len > 0 { n = Sys::write(fd, (void^)data.c(), data.len); }
    Sys::close(fd);
    Sys::chmod(path.c(), 384);
    return n == data.len;
}

String read_bytes(String path, bool^ ok) {
    Result<String, Error> r = Fs::read_bytes(path);
    ok[0] = r.is_ok();
    if r.is_err() { return ""; }
    return r.unwrap();
}

String read_stdin() {
    String r = "";
    char buf[4096];
    int n = Sys::read(0, @buf, 4096);
    while n > 0 {
        for i in 0..n { r.push(buf[i]); }
        n = Sys::read(0, @buf, 4096);
    }
    return r;
}

bool write_stdout(String data) {
    if data.len == 0 { return true; }
    return Sys::write(1, (void^)data.c(), data.len) == data.len;
}

void make_dirs() {
    String d = vault_dir();
    Sys::mkdir(d.c(), 448);
    String k = d + "/keys";
    Sys::mkdir(k.c(), 448);
    String s = d + "/secrets";
    Sys::mkdir(s.c(), 448);
}

bool name_ok(String n) {
    if n.len == 0 || n.len > 64 { return false; }
    for i in 0..n.len {
        char c = n[i];
        bool good = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.';
        if !good { return false; }
    }
    return n[0] != '.';
}

// ---------- the passphrase and the vault key
String ask_passphrase(String prompt) {
    Option<String> e = Env::get("JMAIP_PASS");
    if e.is_some() { return e.unwrap(); }
    jerr << prompt;
    char t[64];
    bool tty = Sys::isatty(0) == 0;
    if tty {
        Sys::call(29, 0, 21505, (int)@t, 0, 0, 0);
        char raw[64];
        for i in 0..64 { raw[i] = t[i]; }
        raw[12] = raw[12] & 245;
        Sys::call(29, 0, 21506, (int)@raw, 0, 0, 0);
    }
    String pw = "";
    char b[2];
    int n = Sys::read(0, @b, 1);
    while n > 0 && b[0] != 10 && b[0] != 13 {
        if b[0] == 127 || b[0] == 8 { if pw.len > 0 { pw = pw.slice(0, pw.len - 1); } }
        else { pw.push(b[0]); }
        n = Sys::read(0, @b, 1);
    }
    if tty { Sys::call(29, 0, 21506, (int)@t, 0, 0, 0); }
    jerr << "\n";
    return pw;
}

String g_master;               // the vault key (32 bytes) once it is open
bool g_open;

// opens the vault: the key from JMAIP_MASTERKEY_CMD, or from the passphrase; false (and a message) when it cannot be opened
bool open_vault() {
    if g_open { return true; }
    String d = vault_dir();
    bool ok = false;
    String wrapped = read_bytes(d + "/master", @ok);
    if !ok || wrapped.len < 8 + 16 + 28 + 32 { jerr << "jmaip: there is no vault here (jmaip init)\n"; return false; }
    String key = "";
    Option<String> cmd = Env::get("JMAIP_MASTERKEY_CMD");
    if cmd.is_some() {
        String[] args = arr(2);
        args.push("-c");
        args.push(cmd.unwrap());
        Result<String, Error> r = Proc::output("sh", args);
        if r.is_err() { jerr << "jmaip: the key command failed\n"; return false; }
        bool hok = false;
        key = from_hex(r.unwrap().trim(), @hok);
        if !hok || key.len != 32 { jerr << "jmaip: the key command must print 64 hex digits\n"; return false; }
    } else {
        String pass = ask_passphrase("jmaip passphrase: ");
        String salt = wrapped.slice(8, 24);
        String wk = pbkdf2(pass, salt, 100000);
        bool uok = false;
        key = unseal(wk, "jmaip master", wrapped.slice(24, wrapped.len), @uok);
        if !uok { jerr << "jmaip: the passphrase is wrong\n"; return false; }
    }
    // a key from outside is checked against the vault
    bool cok = false;
    String chk = read_bytes(d + "/check", @cok);
    bool good = false;
    String text = unseal(key, "jmaip check", chk, @good);
    if !cok || !good || text != "jmaip" { jerr << "jmaip: this key does not open the vault\n"; return false; }
    g_master = key;
    g_open = true;
    return true;
}

// a key for one purpose, from the vault key
String sub_key(String label) { return hmac256(g_master, "jmaip sub " + label); }

// ---------- passkeys
struct Passkey {
    P256 curve;
}

bool load_private(String name, char^ d) {
    bool ok = false;
    String blob = read_bytes(vault_dir() + "/keys/" + name + ".key", @ok);
    if !ok { jerr << "jmaip: there is no passkey " << name << "\n"; return false; }
    bool uok = false;
    String plain = unseal(sub_key("passkey:" + name), name, blob, @uok);
    if !uok || plain.len != 32 { jerr << "jmaip: the passkey " << name << " cannot be opened\n"; return false; }
    for i in 0..32 { d[i] = plain[i]; }
    return true;
}

// the public key as 04 + x + y in hex
String public_of(char^ d) {
    P256 c;
    p256_init(@c);
    char x[32];
    char y[32];
    if !p256_public(@c, d, (char^)@x, (char^)@y) { return ""; }
    String r = "04";
    for i in 0..32 { String h = hex_of(zeros(1)); r = r + h; }
    r = "04";
    String xs = "";
    String ys = "";
    for i in 0..32 { xs.push(x[i]); ys.push(y[i]); }
    return r + hex_of(xs) + hex_of(ys);
}

// the signature (r then s, 64 bytes) of SHA-256(message), deterministic: the same message gives the same signature
String sign_with(char^ d, String message) {
    P256 c;
    p256_init(@c);
    String h = sha256_of(message);
    char hb[32];
    for i in 0..32 { hb[i] = h[i]; }
    char r[32];
    char s[32];
    p256_sign(@c, d, (char^)@hb, (char^)@r, (char^)@s);
    String out = "";
    for i in 0..32 { out.push(r[i]); }
    for i in 0..32 { out.push(s[i]); }
    return out;
}

// the bytes of a CHALLENGE argument: text, hex:..., or @file
String challenge_of(String arg, bool^ ok) {
    ok[0] = true;
    if arg.starts_with("hex:") {
        return from_hex(arg.slice(4, arg.len), ok);
    }
    if arg.starts_with("@") {
        String path = arg.slice(1, arg.len);
        if path == "-" { return read_stdin(); }
        return read_bytes(path, ok);
    }
    return arg;
}

String key_id(String publichex) { return sha256_of(publichex).slice(0, 8); }

int cmd_key(String[] a) {
    if a.len < 3 { return fail("jmaip key new|list|public|sign|verify|rm ..."); }
    String sub = a[2];
    if sub == "verify" {
        if a.len < 6 { return fail("jmaip key verify PUBLIC CHALLENGE SIGNATURE"); }
        bool ok1 = false;
        bool ok2 = false;
        bool ok3 = false;
        String pub = from_hex(a[3], @ok1);
        String msg = challenge_of(a[4], @ok2);
        String sig = from_hex(a[5], @ok3);
        if !ok1 || pub.len != 65 || pub[0] != 4 { return fail("PUBLIC must be 04 + x + y in hex (130 digits)"); }
        if !ok2 { return fail("cannot read the challenge"); }
        if !ok3 || sig.len != 64 { return fail("SIGNATURE must be 128 hex digits"); }
        char qx[32]; char qy[32]; char hb[32]; char rb[32]; char sb[32];
        String h = sha256_of(msg);
        for i in 0..32 { qx[i] = pub[1 + i]; qy[i] = pub[33 + i]; hb[i] = h[i]; rb[i] = sig[i]; sb[i] = sig[32 + i]; }
        bool good = Crypto::ecdsa_verify(256, (char^)@qx, (char^)@qy, (char^)@hb, 32, (char^)@rb, 32, (char^)@sb, 32);
        if good { jout << "valid\n"; return 0; }
        jout << "NOT valid\n";
        return 1;
    }
    if !open_vault() { return 1; }
    String keys = vault_dir() + "/keys";
    if sub == "list" {
        String[] names = Dir::list(keys).unwrap();
        int n = 0;
        for i in 0..names.len {
            if ends_with(names[i], ".pub") {
                String nm = names[i].slice(0, names[i].len - 4);
                bool pok = false;
                String ph = read_bytes(keys + "/" + names[i], @pok);
                jout << padl(hex_of(key_id(ph.trim())), 18) << "  " << nm << "\n";
                n += 1;
            }
        }
        if n == 0 { jout << "no passkeys yet (jmaip key new NAME)\n"; }
        return 0;
    }
    if a.len < 4 { return fail("a NAME is missing"); }
    String name = a[3];
    if !name_ok(name) { return fail("a name has letters, digits, - _ . only"); }
    if sub == "new" {
        if Fs::exists(keys + "/" + name + ".key") { return fail("the passkey " + name + " exists"); }
        char d[32];
        P256 c;
        p256_init(@c);
        p256_new_key(@c, (char^)@d);
        String pub = public_of((char^)@d);
        if pub.len == 0 { return fail("could not make the key"); }
        String plain = "";
        for i in 0..32 { plain.push(d[i]); }
        make_dirs();
        if !write_private(keys + "/" + name + ".key", seal(sub_key("passkey:" + name), name, plain)) { return fail("cannot write the key"); }
        write_private(keys + "/" + name + ".pub", pub + "\n");
        jout << pub << "\n";
        return 0;
    }
    if sub == "public" {
        bool ok = false;
        String ph = read_bytes(keys + "/" + name + ".pub", @ok);
        if !ok { return fail("there is no passkey " + name); }
        jout << ph.trim() << "\n";
        return 0;
    }
    if sub == "rm" {
        if !Fs::exists(keys + "/" + name + ".key") { return fail("there is no passkey " + name); }
        Fs::remove(keys + "/" + name + ".key");
        Fs::remove(keys + "/" + name + ".pub");
        jout << "removed " << name << "\n";
        return 0;
    }
    if sub == "sign" {
        if a.len < 5 { return fail("jmaip key sign NAME CHALLENGE"); }
        bool cok = false;
        String msg = challenge_of(a[4], @cok);
        if !cok { return fail("cannot read the challenge"); }
        char d[32];
        if !load_private(name, (char^)@d) { return 1; }
        jout << hex_of(sign_with((char^)@d, msg)) << "\n";
        return 0;
    }
    return fail("unknown key command " + sub);
}

// ---------- encryption: a file is sealed with a key that comes from the vault key or from a passkey
// the file: "JMAIP1" kind(1: M the vault key, K a passkey) keyid(8) salt(16) iv(12) ciphertext tag(16);   the header is authenticated
String prf_secret(char^ d) {
    String sig = sign_with(d, "jmaip-prf-v1");
    return hkdf(sig, "jmaip", "jmaip prf", 32);
}

int cmd_enc(String[] a) {
    String name = "";
    int at = 2;
    if a.len > 3 && a[2] == "-k" { name = a[3]; at = 4; }
    if a.len <= at { return fail("jmaip enc [-k NAME] IN [OUT]"); }
    String in = a[at];
    String out = "";
    if a.len > at + 1 { out = a[at + 1]; } else if in != "-" { out = in + ".jmaip"; } else { out = "-"; }
    if !open_vault() { return 1; }
    bool ok = false;
    String plain = "";
    if in == "-" { plain = read_stdin(); ok = true; } else { plain = read_bytes(in, @ok); }
    if !ok { return fail("cannot read " + in); }
    String salt = random_bytes(16);
    String kind = "M";
    String id = sha256_of("jmaip master").slice(0, 8);
    String fk = "";
    if name.len > 0 {
        if !name_ok(name) { return fail("a name has letters, digits, - _ . only"); }
        char d[32];
        if !load_private(name, (char^)@d) { return 1; }
        bool pok = false;
        String ph = read_bytes(vault_dir() + "/keys/" + name + ".pub", @pok);
        kind = "K";
        id = key_id(ph.trim());
        fk = hkdf(prf_secret((char^)@d), salt, "jmaip file key", 32);
    } else {
        fk = hkdf(g_master, salt, "jmaip file key master", 32);
    }
    String header = "JMAIP1" + kind + id + salt;
    String blob = header + seal(fk, header, plain);
    if out == "-" {
        if !write_stdout(blob) { return fail("cannot write"); }
        return 0;
    }
    if !write_private(out, blob) { return fail("cannot write " + out); }
    jout << out << "\n";
    return 0;
}

int cmd_dec(String[] a) {
    if a.len < 3 { return fail("jmaip dec IN [OUT]"); }
    String in = a[2];
    String out = "";
    if a.len > 3 {
        out = a[3];
    } else if ends_with(in, ".jmaip") {
        out = in.slice(0, in.len - 6);
    } else if in == "-" {
        out = "-";
    } else {
        return fail("give the name of the output file");
    }
    bool ok = false;
    String blob = "";
    if in == "-" { blob = read_stdin(); ok = true; } else { blob = read_bytes(in, @ok); }
    if !ok { return fail("cannot read " + in); }
    if blob.len < 6 + 1 + 8 + 16 + 28 || !blob.starts_with("JMAIP1") { return fail("this is not a jmaip file"); }
    String kind = blob.slice(6, 7);
    String id = blob.slice(7, 15);
    String header = blob.slice(0, 31);
    String salt = blob.slice(15, 31);
    String body = blob.slice(31, blob.len);
    if !open_vault() { return 1; }
    String fk = "";
    if kind == "M" {
        fk = hkdf(g_master, salt, "jmaip file key master", 32);
    } else {
        // the passkey whose id is in the header
        String keys = vault_dir() + "/keys";
        String found = "";
        String[] names = Dir::list(keys).unwrap();
        for i in 0..names.len {
            if ends_with(names[i], ".pub") {
                bool pok = false;
                String ph = read_bytes(keys + "/" + names[i], @pok);
                String kid = key_id(ph.trim());
                if pok && kid == id { found = names[i].slice(0, names[i].len - 4); }
            }
        }
        if found.len == 0 { return fail("the passkey of this file (" + hex_of(id) + ") is not in this vault"); }
        char d[32];
        if !load_private(found, (char^)@d) { return 1; }
        fk = hkdf(prf_secret((char^)@d), salt, "jmaip file key", 32);
    }
    bool good = false;
    String plain = unseal(fk, header, body, @good);
    if !good { return fail("cannot decrypt: the key is wrong or the file was changed"); }
    if out == "-" {
        if !write_stdout(plain) { return fail("cannot write"); }
        return 0;
    }
    if !write_private(out, plain) { return fail("cannot write " + out); }
    jout << out << "\n";
    return 0;
}

// ---------- secrets: small values kept in the vault
int cmd_secret(String[] a) {
    if a.len < 3 { return fail("jmaip secret put|get|list|rm ..."); }
    if !open_vault() { return 1; }
    String dir = vault_dir() + "/secrets";
    String sub = a[2];
    if sub == "list" {
        String[] names = Dir::list(dir).unwrap();
        for i in 0..names.len { jout << names[i] << "\n"; }
        return 0;
    }
    if a.len < 4 { return fail("a NAME is missing"); }
    String name = a[3];
    if !name_ok(name) { return fail("a name has letters, digits, - _ . only"); }
    String path = dir + "/" + name;
    if sub == "put" {
        if a.len < 5 { return fail("jmaip secret put NAME VALUE   (VALUE - reads the standard input)"); }
        String v = a[4];
        if v == "-" { v = read_stdin(); }
        make_dirs();
        if !write_private(path, seal(sub_key("secret:" + name), name, v)) { return fail("cannot write"); }
        jout << "kept " << name << "\n";
        return 0;
    }
    if sub == "get" {
        bool ok = false;
        String blob = read_bytes(path, @ok);
        if !ok { return fail("there is no secret " + name); }
        bool good = false;
        String v = unseal(sub_key("secret:" + name), name, blob, @good);
        if !good { return fail("the secret " + name + " cannot be opened"); }
        jout << v;
        if v.len == 0 || v[v.len - 1] != '\n' { jout << "\n"; }
        return 0;
    }
    if sub == "rm" {
        if !Fs::exists(path) { return fail("there is no secret " + name); }
        Fs::remove(path);
        jout << "removed " << name << "\n";
        return 0;
    }
    return fail("unknown secret command " + sub);
}

int cmd_init() {
    String d = vault_dir();
    if Fs::exists(d + "/master") { return fail("there is a vault in " + d + " already"); }
    String p1 = ask_passphrase("new passphrase: ");
    if p1.len < 8 { return fail("the passphrase needs 8 characters or more"); }
    Option<String> env = Env::get("JMAIP_PASS");
    if env.is_none() {
        String p2 = ask_passphrase("again: ");
        if p1 != p2 { return fail("the two passphrases differ"); }
    }
    make_dirs();
    String master = random_bytes(32);
    String salt = random_bytes(16);
    String wk = pbkdf2(p1, salt, 100000);
    String wrapped = "JMAIP-M1" + salt + seal(wk, "jmaip master", master);
    if !write_private(d + "/master", wrapped) { return fail("cannot write the vault"); }
    write_private(d + "/check", seal(master, "jmaip check", "jmaip"));
    jout << "vault made in " << d << "\n";
    return 0;
}

int cmd_status() {
    String d = vault_dir();
    jout << "jmaip " << jmaip_version() << "\nfolder: " << d << "\n";
    if !Fs::exists(d + "/master") { jout << "vault: none (jmaip init)\n"; return 0; }
    jout << "vault: yes\n";
    String[] k = Dir::list(d + "/keys").unwrap();
    int nk = 0;
    for i in 0..k.len { if ends_with(k[i], ".key") { nk += 1; } }
    String[] s = Dir::list(d + "/secrets").unwrap();
    jout << "passkeys: " << nk << "\nsecrets: " << s.len << "\n";
    return 0;
}

// ---------- the API for other programs: jmaip serve
// One JSON object on a line in, one JSON object on a line out, on 127.0.0.1 only. Every request carries the token of the file api.token in the vault folder
// (mode 600: a program of another user of the phone cannot read it). Binary data goes in hex.
//   {"token":"...","cmd":"ping"}                                             {"ok":true,"version":"0.1.0"}
//   {"token":"...","cmd":"key.list"}   key.new (name)   key.rm (name)   key.public (name)   key.sign (name, challenge | challenge_hex)   key.verify (public, challenge | challenge_hex, signature)
//   {"token":"...","cmd":"secret.get","name":"x"}   secret.put (name, value)   secret.rm (name)   secret.list
//   {"token":"...","cmd":"enc","data_hex":"...","key":"phone"}   dec (data_hex)          -> "data_hex"
String reply_err(String msg) { return "{\"ok\":false,\"error\":" + Json::quote(msg) + "}"; }

String field(JsonDoc^ d, String name) {
    int n = d^.get(d^.root(), name);
    if n < 0 { return ""; }
    return d^.text(n);
}

String challenge_field(JsonDoc^ d, bool^ ok) {
    ok[0] = true;
    String hx = field(d, "challenge_hex");
    if hx.len > 0 { return from_hex(hx, ok); }
    return field(d, "challenge");
}

String handle(String line, String token) {
    Result<JsonDoc, Error> pr = Json::parse(line);
    if pr.is_err() { return reply_err("not JSON"); }
    JsonDoc d = pr.unwrap();
    String given = field(@d, "token");
    // a comparison that does not stop at the first different byte
    int diff = given.len xor token.len;
    for i in 0..token.len { int g = 0; if i < given.len { g = given[i] & 255; } diff = diff | (g xor (token[i] & 255)); }
    if diff != 0 { return reply_err("denied"); }
    String cmd = field(@d, "cmd");
    String keys = vault_dir() + "/keys";
    if cmd == "ping" { return "{\"ok\":true,\"version\":\"" + jmaip_version() + "\"}"; }
    if cmd == "key.verify" {
        bool ok1 = false;
        bool ok2 = false;
        String pub = from_hex(field(@d, "public"), @ok1);
        String sig = from_hex(field(@d, "signature"), @ok2);
        bool ok3 = false;
        String msg = challenge_field(@d, @ok3);
        if !ok1 || pub.len != 65 || !ok2 || sig.len != 64 || !ok3 { return reply_err("bad public key, signature or challenge"); }
        char qx[32]; char qy[32]; char hb[32]; char rb[32]; char sb[32];
        String h = sha256_of(msg);
        for i in 0..32 { qx[i] = pub[1 + i]; qy[i] = pub[33 + i]; hb[i] = h[i]; rb[i] = sig[i]; sb[i] = sig[32 + i]; }
        bool good = Crypto::ecdsa_verify(256, (char^)@qx, (char^)@qy, (char^)@hb, 32, (char^)@rb, 32, (char^)@sb, 32);
        if good { return "{\"ok\":true,\"valid\":true}"; }
        return "{\"ok\":true,\"valid\":false}";
    }
    if cmd == "key.list" {
        String out = "{\"ok\":true,\"keys\":[";
        String[] names = Dir::list(keys).unwrap();
        int n = 0;
        for i in 0..names.len {
            if ends_with(names[i], ".pub") {
                bool pok = false;
                String ph = read_bytes(keys + "/" + names[i], @pok);
                String kid = hex_of(key_id(ph.trim()));
                if n > 0 { out = out + ","; }
                out = out + "{\"name\":" + Json::quote(names[i].slice(0, names[i].len - 4)) + ",\"id\":\"" + kid + "\",\"public\":\"" + ph.trim() + "\"}";
                n += 1;
            }
        }
        return out + "]}";
    }
    String name = field(@d, "name");
    if cmd == "key.new" || cmd == "key.rm" {
        if !name_ok(name) { return reply_err("a name has letters, digits, - _ . only"); }
        if cmd == "key.rm" {
            if !Fs::exists(keys + "/" + name + ".key") { return reply_err("there is no passkey " + name); }
            Fs::remove(keys + "/" + name + ".key");
            Fs::remove(keys + "/" + name + ".pub");
            return "{\"ok\":true}";
        }
        if Fs::exists(keys + "/" + name + ".key") { return reply_err("the passkey " + name + " exists"); }
        char nk[32];
        P256 pc;
        p256_init(@pc);
        p256_new_key(@pc, (char^)@nk);
        String npub = public_of((char^)@nk);
        if npub.len == 0 { return reply_err("could not make the key"); }
        String plain = "";
        for i in 0..32 { plain.push(nk[i]); }
        make_dirs();
        if !write_private(keys + "/" + name + ".key", seal(sub_key("passkey:" + name), name, plain)) { return reply_err("cannot write the key"); }
        write_private(keys + "/" + name + ".pub", npub + "\n");
        return "{\"ok\":true,\"public\":\"" + npub + "\"}";
    }
    if cmd == "key.public" || cmd == "key.sign" {
        if !name_ok(name) { return reply_err("a name has letters, digits, - _ . only"); }
        if cmd == "key.public" {
            bool ok = false;
            String ph = read_bytes(keys + "/" + name + ".pub", @ok);
            if !ok { return reply_err("there is no passkey " + name); }
            return "{\"ok\":true,\"public\":\"" + ph.trim() + "\"}";
        }
        bool cok = false;
        String msg = challenge_field(@d, @cok);
        if !cok || msg.len == 0 { return reply_err("a challenge is needed"); }
        char k[32];
        if !load_private(name, (char^)@k) { return reply_err("the passkey cannot be opened"); }
        return "{\"ok\":true,\"signature\":\"" + hex_of(sign_with((char^)@k, msg)) + "\"}";
    }
    if cmd == "secret.list" {
        String out = "{\"ok\":true,\"secrets\":[";
        String[] names = Dir::list(vault_dir() + "/secrets").unwrap();
        for i in 0..names.len { if i > 0 { out = out + ","; } out = out + Json::quote(names[i]); }
        return out + "]}";
    }
    if cmd == "secret.get" || cmd == "secret.put" || cmd == "secret.rm" {
        if !name_ok(name) { return reply_err("a name has letters, digits, - _ . only"); }
        String path = vault_dir() + "/secrets/" + name;
        if cmd == "secret.put" {
            make_dirs();
            if !write_private(path, seal(sub_key("secret:" + name), name, field(@d, "value"))) { return reply_err("cannot write"); }
            return "{\"ok\":true}";
        }
        if cmd == "secret.rm" {
            if !Fs::exists(path) { return reply_err("there is no secret " + name); }
            Fs::remove(path);
            return "{\"ok\":true}";
        }
        bool ok = false;
        String blob = read_bytes(path, @ok);
        if !ok { return reply_err("there is no secret " + name); }
        bool good = false;
        String v = unseal(sub_key("secret:" + name), name, blob, @good);
        if !good { return reply_err("the secret cannot be opened"); }
        return "{\"ok\":true,\"value\":" + Json::quote(v) + "}";
    }
    if cmd == "enc" || cmd == "dec" {
        bool hok = false;
        String data = from_hex(field(@d, "data_hex"), @hok);
        if !hok { return reply_err("data_hex is not hex"); }
        if cmd == "enc" {
            String kname = field(@d, "key");
            String salt = random_bytes(16);
            String kind = "M";
            String id = sha256_of("jmaip master").slice(0, 8);
            String fk = "";
            if kname.len > 0 {
                if !name_ok(kname) { return reply_err("a name has letters, digits, - _ . only"); }
                char k[32];
                if !load_private(kname, (char^)@k) { return reply_err("the passkey cannot be opened"); }
                bool pok = false;
                String ph = read_bytes(keys + "/" + kname + ".pub", @pok);
                kind = "K";
                id = key_id(ph.trim());
                fk = hkdf(prf_secret((char^)@k), salt, "jmaip file key", 32);
            } else {
                fk = hkdf(g_master, salt, "jmaip file key master", 32);
            }
            String header = "JMAIP1" + kind + id + salt;
            return "{\"ok\":true,\"data_hex\":\"" + hex_of(header + seal(fk, header, data)) + "\"}";
        }
        if data.len < 6 + 1 + 8 + 16 + 28 || !data.starts_with("JMAIP1") { return reply_err("this is not a jmaip blob"); }
        String kind = data.slice(6, 7);
        String id = data.slice(7, 15);
        String header = data.slice(0, 31);
        String salt = data.slice(15, 31);
        String fk = "";
        if kind == "M" {
            fk = hkdf(g_master, salt, "jmaip file key master", 32);
        } else {
            String found = "";
            String[] names = Dir::list(keys).unwrap();
            for i in 0..names.len {
                if ends_with(names[i], ".pub") {
                    bool pok = false;
                    String ph = read_bytes(keys + "/" + names[i], @pok);
                    String kid = key_id(ph.trim());
                    if pok && kid == id { found = names[i].slice(0, names[i].len - 4); }
                }
            }
            if found.len == 0 { return reply_err("the passkey of this blob is not in this vault"); }
            char k[32];
            if !load_private(found, (char^)@k) { return reply_err("the passkey cannot be opened"); }
            fk = hkdf(prf_secret((char^)@k), salt, "jmaip file key", 32);
        }
        bool good = false;
        String plain = unseal(fk, header, data.slice(31, data.len), @good);
        if !good { return reply_err("cannot decrypt: the key is wrong or the data was changed"); }
        return "{\"ok\":true,\"data_hex\":\"" + hex_of(plain) + "\"}";
    }
    return reply_err("unknown command " + cmd);
}

int cmd_serve(String[] a) {
    int port = 7879;
    for i in 2..a.len {
        if a[i] == "--port" && i + 1 < a.len { port = a[i + 1].to_int(); }
    }
    if !open_vault() { return 1; }
    make_dirs();
    String token = hex_of(random_bytes(16));
    String tpath = vault_dir() + "/api.token";
    if !write_private(tpath, token + "\n") { return fail("cannot write " + tpath); }
    int fd = Sys::socket_tcp();
    if fd < 0 { return fail("cannot make a socket"); }
    char sa[16];
    Net::make_addr((char^)@sa, 127, 0, 0, 1, port);
    char one[4];
    one[0] = 1; one[1] = 0; one[2] = 0; one[3] = 0;
    Sys::call(54, fd, 1, 2, (int)@one, 4, 0);                       // SO_REUSEADDR
    if Sys::bind(fd, (void^)@sa, 16) < 0 { return fail("cannot listen on 127.0.0.1:" + str(port)); }
    if Sys::listen(fd, 8) < 0 { return fail("cannot listen"); }
    jerr << "jmaip " << jmaip_version() << " listening on 127.0.0.1:" << port << "   token in " << tpath << "\n";
    while true {
        int c = Sys::accept(fd);
        if c < 0 { continue; }
        String req = "";
        char buf[4096];
        bool done = false;
        while !done && req.len < 4000000 {
            int n = Sys::read(c, @buf, 4096);
            if n <= 0 { break; }
            for i in 0..n { if buf[i] == 10 { done = true; break; } req.push(buf[i]); }
        }
        String answer = handle(req, token) + "\n";
        Sys::write(c, (void^)answer.c(), answer.len);
        Sys::close(c);
    }
    return 0;
}

int usage() {
    jout << "jmaip " << jmaip_version() << ": keys, passkeys and secrets for the programs of the Jaric world\n";
    jout << "  jmaip init                              make the vault (a passphrase)\n";
    jout << "  jmaip status\n";
    jout << "  jmaip key new NAME                      a new passkey (prints its public key)\n";
    jout << "  jmaip key list | public NAME | rm NAME\n";
    jout << "  jmaip key sign NAME CHALLENGE           the signature in hex (CHALLENGE: text, hex:..., @FILE)\n";
    jout << "  jmaip key verify PUBLIC CHALLENGE SIG   valid / NOT valid\n";
    jout << "  jmaip enc [-k NAME] IN [OUT]            encrypt a file (with the passkey NAME, else the vault key); - is stdin / stdout\n";
    jout << "  jmaip dec IN [OUT]                      decrypt (the passkey is found from the file)\n";
    jout << "  jmaip secret put NAME VALUE | get NAME | list | rm NAME\n";
    jout << "  jmaip serve [--port 7879]               the API for other programs: JSON lines on 127.0.0.1 with the token of api.token\n";
    jout << "  jmaip otp ...                           the one-time codes of authj\n";
    jout << "environment: JMAIP_PASS (the passphrase), JMAIP_MASTERKEY_CMD (a command that prints the vault key in hex), JMAIP_DIR\n";
    return 0;
}

int main() {
    String[] a = Env::args();
    if a.len < 2 { return usage(); }
    String c = a[1];
    if c == "--version" || c == "-V" { jout << "jmaip " << jmaip_version() << "\n"; return 0; }
    if c == "help" || c == "--help" || c == "-h" { return usage(); }
    if c == "init" { return cmd_init(); }
    if c == "status" { return cmd_status(); }
    if c == "key" { return cmd_key(a); }
    if c == "enc" { return cmd_enc(a); }
    if c == "dec" { return cmd_dec(a); }
    if c == "secret" { return cmd_secret(a); }
    if c == "serve" { return cmd_serve(a); }
    if c == "otp" {
        String[] rest = arr(4);
        rest.push("code");
        for i in 2..a.len { rest.push(a[i]); }
        if a.len > 2 && a[2] != "get" && a[2] != "code" { rest.clear(); for i in 2..a.len { rest.push(a[i]); } }
        Result<int, Error> r = Proc::run("authj", rest);
        if r.is_err() { return fail("authj is not installed (jc install authj)"); }
        return r.unwrap();
    }
    jerr << "jmaip: unknown command " << c << "  (jmaip help)\n";
    return 2;
}
