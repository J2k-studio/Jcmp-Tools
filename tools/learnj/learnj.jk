#import <stdlib>
using stdlib;
#import <time>
#import "levels_data"

// learnj 0.3.0: a path of levels (zones: write programs, data structures, the machine and speed) with a game.
// The levels are in levels.txt (one level on a line, 16 fields separated by a tab; ~ is a new line inside a text). Add a line, get a level.
// Run:  jcmp learn.jk -o learn && ./learn        progress and XP: learnj_progress.txt     missed questions: learnj_missed.txt

bool slow = true;       // the text appears letter by letter like an old game console (run  ./learn fast  to switch it off)
bool en = false;        // English only (to practise English): the levels file and the messages
String u(String th, String e) { if en { return e; } return th; }

String[] lv;            // 16 fields for every level
i64 nl = 0;
i64 lo = 1;             // the first and the last level of the chosen track (a track is a zone)
i64 hi = 1;
i64 xp = 0;

String nl_text(String t) {                      // ~ becomes a new line
    String r = "";
    for i in 0..t.len { if t[i] == '~' { r = r + "\n"; } else { r = r + str(t[i]); } }
    return r;
}


// ---- the look of an old game console: colours (ANSI), frames and letters that appear one by one
String col(i64 n) { return str((char)27) + "[" + str(n) + "m"; }
String plain() { return col(0); }

void tw(String t) {                                       // letters appear one by one (a whole UTF-8 letter at a time)
    i64 i = 0;
    while i < t.len {
        i64 b = (i64)t[i];
        if b < 0 { b = b + 256; }
        i64 n = 1;
        if b >= 240 { n = 4; } else if b >= 224 { n = 3; } else if b >= 192 { n = 2; }
        String chunk = "";
        for k in 0..n { if i + k < t.len { chunk = chunk + str(t[i + k]); } }
        jout << chunk;
        if slow && b != 10 && b != 32 { __flush(); Time::sleep_ms(12); }
        i += n;
    }
}

String bar(i64 v, i64 mx) {                                // [#####-----]
    String r = "[";
    for i in 0..mx { if i < v { r = r + "#"; } else { r = r + "-"; } }
    return r + "]";
}

void frame(String t) {
    String line = "+";
    for i in 0..44 { line = line + "="; }
    line = line + "+";
    jout << col(33) << line << "\n| " << t << "\n" << line << plain() << "\n";
}

String f(i64 d, i64 k) { return lv[(d - 1) * 16 + k]; }
String day_title(i64 d) { return f(d, 1); }
String day_zone(i64 d) { return f(d, 0); }
String day_text(i64 d) { return nl_text(f(d, 2)); }
String q_text(i64 d, i64 q) { return f(d, 3 + 6 * q); }
String q_opts(i64 d, i64 q) {
    i64 b = 4 + 6 * q;
    return "a) " + f(d, b) + "\nb) " + f(d, b + 1) + "\nc) " + f(d, b + 2) + "\n";
}
i64 q_ans(i64 d, i64 q) { return f(d, 7 + 6 * q).to_int(); }
String q_why(i64 d, i64 q) { return f(d, 8 + 6 * q); }

bool has_task(i64 d) { return f(d, 15).len > 0; }
String task_text(i64 d) {
    String t = f(d, 15);
    String r = "";
    for i in 0..t.len { if t[i] == '#' { break; } r = r + str(t[i]); }
    return r;
}
String task_expect(i64 d) {
    String t = f(d, 15);
    String r = "";
    bool after = false;
    for i in 0..t.len {
        if after { if t[i] == '~' { r = r + "\n"; } else { r = r + str(t[i]); } }
        else if t[i] == '#' { after = true; }
    }
    return r;
}
String task_start(i64 d) {
    return "#import <stdlib>\nusing stdlib;\n\n// " + task_text(d) + "\nvoid main() {\n    " + u("// เขียนโค้ดตรงนี้", "// write your code here") + "\n}\n";
}

String progress_file() { return dp("learnj_progress.txt"); }

bool has_sub(String hay, String kw) {
    if kw.len == 0 || kw.len > hay.len { return false; }
    for i in 0..hay.len - kw.len + 1 {
        bool ok = true;
        for j in 0..kw.len { if hay[i + j] != kw[j] { ok = false; break; } }
        if ok { return true; }
    }
    return false;
}

String read_line() {
    char line[300];
    i64 n = File::read_line(0, line);
    String t = "";
    i64 i = 0;
    while i < n && line[i] != 0 { t = t + str(line[i]); i += 1; }
    return t;
}

String levels_file() { if en { return "levels_en.txt"; } return "levels.txt"; }

// the folder of the progress files: $LEARNJ_DIR or ~/.learnj
String data_dir() {
    String d = ".learnj";
    switch Env::get("LEARNJ_DIR") {
        Option::Some(v): { d = v; }
        Option::None: {
            switch Env::get("HOME") { Option::Some(h): { d = h + "/.learnj"; } Option::None: { } }
        }
    }
    if !Dir::exists(d) { Dir::make_all(d); }
    return d;
}
String dp(String name) { return data_dir() + "/" + name; }

void load_levels() {
    nl = 0;
    lv = arr(1000);
    String[] ls = embedded_levels(en).split("\n");
    if Fs::exists(levels_file()) { switch Fs::read_lines(levels_file()) { Result::Ok(x): { ls = x; } Result::Err(e): { } } }
    else if Fs::exists(dp(levels_file())) { switch Fs::read_lines(dp(levels_file())) { Result::Ok(x): { ls = x; } Result::Err(e): { } } }
    for i in 0..ls.len {
        String[] w = ls[i].split("\t");
        if w.len >= 16 { for k in 0..16 { lv.push(w[k] + ""); } nl += 1; }
    }
}

i64 load_day() {
    switch Fs::read_text(progress_file()) {
        Result::Ok(t): {
            String[] w = t.trim().split(" ");
            i64 v = w[0].to_int();
            if w.len > 1 { xp = w[1].to_int(); }
            if v >= 1 && v <= nl { return v; }
        }
        Result::Err(e): { }
    }
    return 1;
}
String lang_file() { return dp("learnj_lang.txt"); }
void save_lang() { Fs::write_text(lang_file(), u("th", "en") + "\n"); }
void choose_language() {
    jout << "ภาษา / Language:  1 ไทย (อธิบายภาษาไทย)   2 English only (practise English: every task and message in English)\n> ";
    String a = read_line();
    en = a.len > 0 && a[0] == '2';
    save_lang();
}
bool load_lang() {
    switch Fs::read_text(lang_file()) {
        Result::Ok(t): { en = t.trim() == "en"; return true; }
        Result::Err(e): { }
    }
    return false;
}

void save_day(i64 d) { Fs::write_text(progress_file(), str(d) + " " + str(xp) + "\n"); }

String rank() {
    if xp < 10 { return u("มือใหม่", "Newcomer"); }
    if xp < 50 { return u("ผู้ฝึก", "Trainee"); }
    if xp < 100 { return u("นักเขียนโค้ด", "Coder"); }
    if xp < 200 { return u("นักแก้ปัญหา", "Problem solver"); }
    return u("ปรมาจารย์", "Master");
}

void note_missed(i64 d, i64 q) { Fs::append_text(dp("learnj_missed.txt"), str(d) + " " + str(q) + "\n"); }

// one question: true when the answer is right. Type ? to buy a hint for 3 XP (it shows the reason).
bool ask_q(i64 d, i64 q, bool record) {
    jout << u("\nคำถาม: ", "\nQuestion: ") << q_text(d, q) << "\n" << q_opts(d, q) << u("ตอบ (a/b/c, ? = คำใบ้ราคา 3 XP): ", "Answer (a/b/c, ? = hint for 3 XP): ");
    String a = read_line();
    if a.len > 0 && a[0] == '?' {
        if xp >= 3 { xp -= 3; jout << u("คำใบ้: ", "Hint: ") << q_why(d, q) << "\n"; } else { jout << u("XP ไม่พอ\n", "Not enough XP\n"); }
        jout << u("ตอบ (a/b/c): ", "Answer (a/b/c): ");
        a = read_line();
    }
    i64 pick = 0 - 1;
    if a.len > 0 {
        if a[0] == 'a' { pick = 0; } else if a[0] == 'b' { pick = 1; } else if a[0] == 'c' { pick = 2; }
    }
    bool ok = pick == q_ans(d, q);
    if ok { jout << u("ถูก! ", "Right! "); } else { jout << u("ยังไม่ใช่. ", "Not yet. "); if record { note_missed(d, q); } }
    jout << q_why(d, q) << "\n";
    return ok;
}

void quiz(i64 d) {
    i64 right = 0;
    for q in 0..2 { if ask_q(d, q, true) { right += 1; } }
    jout << u("\nได้ ", "\nScore ") << right << u(" จาก 2\n", " of 2\n");
    if right < 2 { jout << u("แนะนำ: อ่านหัวข้ออีกรอบ (เมนู 1) แล้วลองตอบใหม่\n", "Tip: read the topic again (menu 1) and try again\n"); }
}

void review() {
    switch Fs::read_lines(dp("learnj_missed.txt")) {
        Result::Ok(ls): {
            if ls.len == 0 { jout << u("\nไม่มีข้อที่พลาดค้างอยู่ เยี่ยม!\n", "\nNo missed question is waiting. Great!\n"); return; }
            String keep = "";
            for i in 0..ls.len {
                String[] w = ls[i].trim().split(" ");
                if w.len < 2 { continue; }
                i64 d = w[0].to_int();
                i64 q = w[1].to_int();
                if d < 1 || d > nl { continue; }
                if !ask_q(d, q, false) { keep = keep + ls[i] + "\n"; }
            }
            Fs::write_text(dp("learnj_missed.txt"), keep);
            if keep.len == 0 { jout << u("\nทบทวนครบ ไม่มีข้อพลาดค้าง!\n", "\nReview done, nothing is missed any more!\n"); }
        }
        Result::Err(e): { jout << u("\nยังไม่มีข้อที่พลาด\n", "\nNothing missed yet\n"); }
    }
}

void summary(i64 d) {
    jout << u("\nเขียนสรุปด้วยภาษาของคุณเอง 5 บรรทัด (พิมพ์ทีละบรรทัด กด Enter):\n", "\nWrite a summary in your own words, 5 lines (type one line, press Enter):\n");
    String all = "== " + u("ระดับ ", "Level ") + str(d) + ": " + day_title(d) + " ==\n";
    for i in 0..5 {
        jout << i + 1 << "> ";
        all = all + read_line() + "\n";
    }
    Fs::append_text(dp("learnj_summaries.txt"), all);
    jout << u("บันทึกลง learnj_summaries.txt แล้ว\n", "Saved in learnj_summaries.txt\n");
}

bool code_task(i64 d) {
    if !has_task(d) {
        jout << u("\nระดับนี้ไม่มีโจทย์โค้ด\n", "\nThis level has no code task\n");
        return false;
    }
    jout << u("\nโจทย์: ", "\nTask: ") << task_text(d) << "\n";
    if !Fs::exists("learn_task.jk") { Fs::write_text("learn_task.jk", task_start(d)); }
    jout << u("แก้ไฟล์ learn_task.jk ด้วยตัวแก้ไขของคุณ (เช่น coderin) แล้วกด Enter เพื่อตรวจ (พิมพ์ s เพื่อข้าม): ", "Edit the file learn_task.jk with your editor (for example coderin), then press Enter to check (type s to skip): ");
    String go = read_line();
    if go.len > 0 && go[0] == 's' { return false; }
    String[] cargs = arr(4);
    cargs.push("learn_task.jk"); cargs.push("-o"); cargs.push("learn_task");
    switch Proc::output("jcmp", cargs) {
        Result::Err(e): { jout << u("รันคอมไพเลอร์ไม่ได้ (ต้องมี jcmp ใน PATH)\n", "Cannot run the compiler (jcmp must be in the PATH)\n"); return false; }
        Result::Ok(msg): { if msg.len > 0 { jout << u("ข้อความจากคอมไพเลอร์:\n", "Compiler messages:\n") << msg << "\n"; } }
    }
    if !Fs::exists("learn_task") { jout << u("ยังคอมไพล์ไม่ผ่าน อ่านข้อความด้านบน แก้แล้วลองใหม่\n", "It does not compile yet. Read the messages above, fix and try again\n"); return false; }
    String[] none = arr(1);
    switch Proc::output("./learn_task", none) {
        Result::Ok(out): {
            if out == task_expect(d) { jout << u("ผ่าน! ผลลัพธ์ตรงกัน: ", "Passed! The output is right: ") << out; Fs::remove("learn_task.jk"); return true; }
            else { jout << u("รันได้ แต่ผลลัพธ์ต่างจากที่ต้องการ\nได้: ", "It runs, but the output is not the one wanted\nGot: ") << out << u("ต้องการ: ", "Wanted: ") << task_expect(d); }
        }
        Result::Err(e): { jout << u("รันโปรแกรมไม่ได้\n", "Cannot run the program\n"); }
    }
    return false;
}

// ---- the game: a monster for every level; a boss at every fifth level asks from the four levels before it.
String monster_name(i64 d) {
    if d % 5 == 0 { return u("บอสเขต ", "Zone boss ") + day_zone(d) + " (Boss)"; }
    i64 k = d % 5;
    if k == 1 { return u("บั๊กจิ๋ว (Bug)", "Tiny Bug"); }
    if k == 2 { return u("ผีบิต (Bit Ghost)", "Bit Ghost"); }
    if k == 3 { return u("งูที่อยู่ (Address Snake)", "Address Snake"); }
    return u("มังกรแรมช้า (Slow RAM Dragon)", "Slow RAM Dragon");
}
bool is_boss(i64 d) { return d % 5 == 0 && d > 1; }
i64 hits_needed(i64 d) {
    if is_boss(d) { return 4; }
    if has_task(d) { return 3; }
    return 2;
}

String dragon_name(i64 d) {
    if is_boss(d) { return u("มังกรราชา (Dragon King)", "the Dragon King"); }
    i64 k = d % 4;
    if k == 0 { return u("มังกรเขียว (Green Dragon)", "Green Dragon"); }
    if k == 1 { return u("มังกรแดง (Red Dragon)", "Red Dragon"); }
    if k == 2 { return u("มังกรน้ำเงิน (Blue Dragon)", "Blue Dragon"); }
    return u("มังกรทอง (Gold Dragon)", "Gold Dragon");
}

// the questions of the fight come from this level and the levels of the track before it (round after round)
i64 pool_level(i64 d, i64 k) {                              // k-th question of the pool: levels d, d-1, ... down to the start of the track, two each
    i64 lvl = d - k / 2;
    if is_boss(d) { lvl = d - 1 - k / 2; }
    while lvl < lo { lvl = lvl + (d - lo + 1); if lvl > d { lvl = d; } }
    return lvl;
}

bool battle(i64 d) {
    i64 enemy = 3;
    if is_boss(d) { enemy = 5; }
    i64 me = 6;
    i64 qi = 2;                                             // inner force: a right answer gives one; "set the power" spends it
    i64 round = 0;
    i64 k = 0;
    jout << "\n" << col(31);
    tw(u("*** ", "*** ") + dragon_name(d) + u(" ปรากฏตัว! ***", " appears! ***"));
    jout << plain() << "\n";
    while enemy > 0 && me > 0 {
        i64 dmg = 1 + round % 2;
        round += 1;
        jout << "\n" << col(31) << dragon_name(d) << " " << bar(enemy, 5) << plain() << "   " << col(36) << u("ศิษย์ดาบ ", "Swordsman ") << bar(me, 6)
             << " " << u("พลัง ", "Qi ") << qi << plain() << "\n";
        jout << col(31);
        tw(u("มังกรเตรียมโจมตี! (แรง ", "The dragon prepares to strike! (strength ") + str(dmg) + ")");
        jout << plain() << "\n";
        jout << u("1 ท่าดาบ (ตอบคำถาม: โจมตี)  2 ค่ายกล (ตอบคำถาม: กัน)  3 กำหนดกำลัง (ใช้พลัง)", "1 sword move (answer: attack)  2 formation (answer: defend)  3 set the power (spend Qi)");
        if has_task(d) && !is_boss(d) { jout << u("  4 คาถาโค้ด", "  4 code spell"); }
        jout << "\n> ";
        String c = read_line();
        bool blocked = false;
        i64 lvl = pool_level(d, k);
        i64 qq = k % 2;
        if c.len > 0 && c[0] == '2' {
            k += 1;
            if ask_q(lvl, qq, !is_boss(d)) { blocked = true; jout << col(36) << u("ค่ายกลตั้งมั่น! กันการโจมตีได้\n", "The formation holds! The strike is blocked\n") << plain(); }
        } else if c.len > 0 && c[0] == '3' {
            if qi <= 0 { jout << u("ไม่มีพลังเหลือ ตั้งท่าไม่ได้\n", "No Qi left, the move fails\n"); }
            else {
                jout << u("ใช้พลังเท่าไร (1 ถึง ", "How much Qi (1 to ") << qi << "): ";
                String pw = read_line();
                i64 n = pw.to_int();
                if n < 1 { n = 1; }
                if n > qi { n = qi; }
                qi -= n;
                enemy -= n;
                jout << col(36) << u("ฟาดด้วยกำลัง ", "A strike with power ") << n << u("! ศัตรูเหลือ ", "! The enemy has ") << enemy << plain() << "\n";
            }
        } else if c.len > 0 && c[0] == '4' && has_task(d) && !is_boss(d) {
            jout << u("\nร่ายคาถา (โจทย์โค้ด)!", "\nCast the spell (the code task)!");
            if code_task(d) { enemy -= 2; qi += 1; jout << col(36) << u("คาถาโดนเต็มๆ! ศัตรูเหลือ ", "A clean hit! The enemy has ") << max(enemy, 0) << plain() << "\n"; }
        } else {
            k += 1;
            if ask_q(lvl, qq, !is_boss(d)) { enemy -= 1; qi += 1; jout << col(36) << u("ท่าดาบโดน! ศัตรูเหลือ ", "The sword move hits! The enemy has ") << enemy << plain() << "\n"; }
        }
        if enemy > 0 && !blocked {
            me -= dmg;
            jout << col(31);
            tw(u("มังกรโจมตี! เสียพลังชีวิต ", "The dragon strikes! You lose ") + str(dmg));
            jout << plain() << "\n";
        }
    }
    if enemy <= 0 {
        i64 gain = 10;
        if is_boss(d) { gain = 25; }
        xp += gain;
        jout << "\n" << col(32);
        tw(u("*** ชนะ ", "*** You beat ") + dragon_name(d) + u("! ได้ ", "! You get ") + str(gain) + " XP ***");
        jout << plain() << "\n";
        return true;
    }
    jout << "\n" << col(31);
    tw(u("คุณพ่ายแพ้... อ่านบทเรียนอีกรอบ (เมนู 1) แล้วกลับมาสู้ใหม่", "You lost... read the lesson again (menu 1) and come back"));
    jout << plain() << "\n";
    return false;
}

// the exam: six questions from the levels of the track so far; five right to pass (and 15 XP)
void exam(i64 d) {
    jout << "\n";
    frame(u("สอบ: 6 ข้อ ผ่านเมื่อถูก 5 ข้อ", "Exam: 6 questions, 5 right to pass"));
    i64 right = 0;
    for k in 0..6 {
        i64 lvl = lo + (k * 2 + d) % (d - lo + 1);
        if ask_q(lvl, k % 2, false) { right += 1; }
    }
    jout << "\n" << u("ผลสอบ ", "Result ") << right << "/6  ";
    if right >= 5 { xp += 15; jout << col(32) << u("ผ่าน! +15 XP", "Passed! +15 XP") << plain() << "\n"; }
    else { jout << col(31) << u("ยังไม่ผ่าน ทบทวนแล้วลองใหม่", "Not passed. Review and try again") << plain() << "\n"; }
    Fs::append_text(dp("learnj_exams.txt"), str(d) + " " + str(right) + "\n");
}

void ask() {
    jout << u("\nพิมพ์คำที่อยากค้นในบทเรียน (เช่น cache, ไบต์, ijk): ", "\nType a word to look for in the lessons (for example cache, byte, ijk): ");
    String kw = read_line();
    i64 found = 0;
    for d in 1..nl + 1 {
        String[] lines = day_text(d).split("\n");
        for i in 0..lines.len {
            if has_sub(lines[i], kw) { jout << u("ระดับ ", "Level ") << d << ": " << lines[i] << "\n"; found += 1; }
        }
    }
    if found == 0 { jout << u("ไม่เจอคำนี้ ลองคำอื่น\n", "Not found. Try another word\n"); }
}

// ---- tracks: a track is a zone of the levels file; you choose what you want to learn
String track_file() { return dp("learnj_tracks.txt"); }

i64 zone_first(String z) { for d in 1..nl + 1 { if day_zone(d) == z { return d; } } return 0; }
i64 zone_last(String z) { i64 r = 0; for d in 1..nl + 1 { if day_zone(d) == z { r = d; } } return r; }

String[] zone_names() {
    String[] z = arr(8);
    for d in 1..nl + 1 {
        bool seen = false;
        for k in 0..z.len { if z[k] == day_zone(d) { seen = true; } }
        if !seen { z.push(day_zone(d) + ""); }
    }
    return z;
}

i64 saved_pos(String z) {                               // where you stopped in this track (its first level when new)
    i64 first = zone_first(z);
    switch Fs::read_lines(track_file()) {
        Result::Ok(ls): {
            for i in 0..ls.len {
                String[] w = ls[i].split("\t");
                if w.len >= 2 && w[0] == z { i64 p = w[1].to_int(); if p >= first && p <= zone_last(z) { return p; } }
            }
        }
        Result::Err(e): { }
    }
    return first;
}

void save_pos(String z, i64 d) {
    String out = "";
    bool done = false;
    switch Fs::read_lines(track_file()) {
        Result::Ok(ls): {
            for i in 0..ls.len {
                String[] w = ls[i].split("\t");
                if w.len >= 2 && w[0] == z { out = out + z + "\t" + str(d) + "\n"; done = true; }
                else if ls[i].len > 0 { out = out + ls[i] + "\n"; }
            }
        }
        Result::Err(e): { }
    }
    if !done { out = out + z + "\t" + str(d) + "\n"; }
    Fs::write_text(track_file(), out);
}

// returns the level where the chosen track continues
i64 choose_track(i64 current) {
    String[] z = zone_names();
    jout << "\n" << u("เลือกสิ่งที่อยากเรียน:", "Choose what you want to learn:") << "\n";
    for i in 0..z.len {
        i64 a = zone_first(z[i]);
        i64 b = zone_last(z[i]);
        i64 p = saved_pos(z[i]);
        jout << i + 1 << ") " << z[i] << "  (" << u("ระดับ ", "level ") << p - a + 1 << "/" << b - a + 1 << ")\n";
    }
    jout << u("พิมพ์เลข (Enter = ต่อจากเดิม): ", "Type a number (Enter = continue where you were): ");
    String a = read_line();
    i64 pick = 0 - 1;
    if a.len > 0 && a[0] >= '1' && a[0] <= '9' { pick = (i64)a[0] - (i64)'1'; }
    String zc = day_zone(current);
    if pick >= 0 && pick < z.len { zc = z[pick] + ""; current = saved_pos(zc); }
    lo = zone_first(zc);
    hi = zone_last(zc);
    return current;
}

void main() {
    String[] av = Env::args();
    if av.len > 1 && av[1] == "--version" { jout << "learnj 0.5.0\n"; return; }
    if av.len > 1 && av[1] == "fast" { slow = false; }
    if !load_lang() { choose_language(); }
    load_levels();
    if nl == 0 { jout << u("ไม่พบ levels.txt (ต้องอยู่โฟลเดอร์เดียวกัน)\n", "levels file not found (it must be in the same folder)\n"); return; }
    i64 day = load_day();
    day = choose_track(day);
    jout << u("learnj: ", "learnj: ") << nl << u(" ระดับ  เขต: คอมพื้นฐาน, เขียนโปรแกรม, โครงสร้างข้อมูล, เครื่องและความเร็ว, ภาษาอังกฤษ, jcmp\n", " levels. Tracks: computers, programs, data structures, the machine, English, jcmp\n");
    while true {
        jout << "\n== " << u("ระดับ ", "Level ") << day - lo + 1 << "/" << hi - lo + 1 << " [" << day_zone(day) << "]: " << day_title(day) << " ==\n";
        jout << u("1 อ่าน  2 ถามตอบ  3 สรุป  4 โจทย์โค้ด  5 ค้นคำ  6 ไปต่อ  7 สู้มังกร  8 ทบทวนข้อพลาด  9 ภาษา  t เขต  e สอบ  0 ออก   [", "1 read  2 quiz  3 summary  4 code task  5 find a word  6 next  7 fight  8 review misses  9 language  t track  e exam  0 quit   [") << rank() << ", XP " << xp << "]\n> ";
        String c = read_line();
        if c.len == 0 { break; }
        if c[0] == '0' { break; }
        else if c[0] == '1' { jout << "\n"; tw(day_text(day)); }
        else if c[0] == '2' { quiz(day); }
        else if c[0] == '3' { summary(day); }
        else if c[0] == '4' { code_task(day); }
        else if c[0] == '5' { ask(); }
        else if c[0] == '7' {
            if battle(day) {
                if day < hi { day += 1; jout << u("ปลดล็อกระดับ ", "Level unlocked: ") << day << "!\n"; } else { jout << u("คุณจบเขตนี้แล้ว! (เมนู t เลือกเขตอื่น)\n", "You finished this track! (menu t chooses another)\n"); }
            }
            save_day(day);
        }
        else if c[0] == '8' { review(); save_day(day); }
        else if c[0] == 'e' { exam(day); save_day(day); }
        else if c[0] == 't' { save_pos(day_zone(day), day); day = choose_track(day); save_day(day); }
        else if c[0] == '9' { choose_language(); load_levels(); if day > nl { day = nl; } }
        else if c[0] == '6' { if day < hi { day += 1; save_day(day); } else { jout << u("จบทุกระดับแล้ว! ทบทวนสรุปของคุณใน learnj_summaries.txt\n", "All levels done! Read your summaries in learnj_summaries.txt\n"); } }
    }
    save_day(day);
    jout << u("แล้วพบกันใหม่\n", "See you again\n");
}
