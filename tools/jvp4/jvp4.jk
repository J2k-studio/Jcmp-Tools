// jvp4: a video player made of J2K only (no codec of Android, no library of C). Plan: docs/jvp4-plan.md of the Jaric documents.
//   jvp4 info FILE      what is in a video file: the container (mp4 / mov), the tracks, the codecs, the size, the length
//   jvp4 play FILE      (next steps) decode and show; today it plays through the app (jaric video) while the own decoders are made
#import <stdlib>
#import <native>

i64 fail(String msg) {
    jerr << "jvp4: " << msg << "\n";
    return 1;
}

i64 g_fd;
i64 g_size;

// n bytes at the offset off of the file (pread); "" when they are not there
String read_at(i64 off, i64 n) {
    if n <= 0 || off < 0 || off + n > g_size { return ""; }
    String r = "";
    char buf[4096];
    i64 done = 0;
    while done < n {
        i64 want = n - done;
        if want > 4096 { want = 4096; }
        i64 got = Sys::call(67, g_fd, (i64)@buf, want, off + done, 0, 0);       // pread64
        if got <= 0 { return ""; }
        for i in 0..got { r.push(buf[i]); }
        done += got;
    }
    return r;
}

i64 be16(String s, i64 at) { return ((s[at] & 255) << 8) | (s[at + 1] & 255); }
i64 be32(String s, i64 at) { return (be16(s, at) << 16) | be16(s, at + 2); }
i64 be64(String s, i64 at) { return (be32(s, at) << 32) | be32(s, at + 4); }
String four(String s, i64 at) { return s.slice(at, at + 4); }

// ---------------------------------------------------------------- the boxes of mp4 / mov: size(4) type(4) [large size(8)] payload
i64 b_start;     // the start of the payload
i64 b_end;       // the end of the box
String b_type;

// the box that starts at off (inside the limit); false at the end
bool box_at(i64 off, i64 limit) {
    if off + 8 > limit { return false; }
    String h = read_at(off, 8);
    if h.len < 8 { return false; }
    i64 size = be32(h, 0);
    b_type = four(h, 4);
    b_start = off + 8;
    if size == 1 {
        String x = read_at(off + 8, 8);
        if x.len < 8 { return false; }
        size = be64(x, 0);
        b_start = off + 16;
    } else if size == 0 {
        size = limit - off;
    }
    if size < 8 || off + size > limit { return false; }
    b_end = off + size;
    return true;
}

// the first child box of this type inside [from, to): start and end of its payload in found_s / found_e; false when none
i64 found_s;
i64 found_e;
bool find_box(i64 from, i64 to, String type) {
    i64 off = from;
    while box_at(off, to) {
        if b_type == type { found_s = b_start; found_e = b_end; return true; }
        off = b_end;
    }
    return false;
}

String codec_name(String fourcc) {
    if fourcc == "avc1" || fourcc == "avc3" { return "H.264 (AVC)"; }
    if fourcc == "hev1" || fourcc == "hvc1" { return "H.265 (HEVC)"; }
    if fourcc == "vp09" { return "VP9"; }
    if fourcc == "av01" { return "AV1"; }
    if fourcc == "mp4v" { return "MPEG-4 part 2"; }
    if fourcc == "jpeg" || fourcc == "mjpa" { return "Motion JPEG"; }
    if fourcc == "mp4a" { return "AAC / MPEG-4 audio"; }
    if fourcc == "ac-3" { return "AC-3"; }
    if fourcc == "Opus" { return "Opus"; }
    if fourcc == "fLaC" { return "FLAC"; }
    if fourcc == ".mp3" { return "MP3"; }
    if fourcc == "sowt" || fourcc == "twos" || fourcc == "lpcm" { return "PCM"; }
    return "unknown";
}

String avc_profile(i64 p) {
    if p == 66 { return "Baseline"; }
    if p == 77 { return "Main"; }
    if p == 88 { return "Extended"; }
    if p == 100 { return "High"; }
    if p == 110 { return "High 10"; }
    if p == 122 { return "High 4:2:2"; }
    if p == 244 { return "High 4:4:4"; }
    return "profile " + str(p);
}

String clock_text(i64 ms) {
    i64 s = ms / 1000;
    String m = str(s / 60);
    String sec = str(s % 60);
    if sec.len < 2 { sec = "0" + sec; }
    return m + ":" + sec + "." + str((ms % 1000) / 100);
}

// one track: trak payload in [s, e)
void show_track(i64 s, i64 e, i64 n) {
    i64 width = 0;
    i64 height = 0;
    if find_box(s, e, "tkhd") {
        String t = read_at(found_s, found_e - found_s);
        i64 ver = t[0] & 255;
        i64 at = 76;                                                      // version 0: the width is the 16.16 number 76 bytes in
        if ver == 1 { at = 88; }
        if t.len >= at + 8 { width = be32(t, at) >> 16; height = be32(t, at + 4) >> 16; }
    }
    i64 timescale = 1;
    i64 duration = 0;
    String kind = "";
    i64 samples = 0;
    String fourcc = "";
    String extra = "";
    if find_box(s, e, "mdia") {
        i64 ms = found_s;
        i64 me = found_e;
        if find_box(ms, me, "mdhd") {
            String h = read_at(found_s, found_e - found_s);
            if (h[0] & 255) == 1 { timescale = be32(h, 20); duration = be64(h, 24); } else { timescale = be32(h, 12); duration = be32(h, 16); }
        }
        if find_box(ms, me, "hdlr") {
            String h = read_at(found_s, found_e - found_s);
            if h.len >= 12 { kind = four(h, 8); }
        }
        if find_box(ms, me, "minf") {
            i64 fs = found_s;
            i64 fe = found_e;
            if find_box(fs, fe, "stbl") {
                i64 ss = found_s;
                i64 se = found_e;
                if find_box(ss, se, "stsz") {
                    String z = read_at(found_s, 12);
                    if z.len >= 12 {
                        samples = be32(z, 8);
                        if be32(z, 4) == 0 && samples == 0 { samples = 0; }
                    }
                }
                if find_box(ss, se, "stsd") {
                    String d = read_at(found_s, found_e - found_s);
                    if d.len >= 16 {
                        fourcc = four(d, 12);
                        if kind == "vide" && d.len >= 8 + 8 + 78 {
                            // the sample entry: 8 header, 6 reserved, 2 index, 16 pre-defined, width(2) height(2) ...; the boxes follow after 78 bytes
                            i64 w2 = be16(d, 8 + 8 + 24);
                            i64 h2 = be16(d, 8 + 8 + 26);
                            if width == 0 { width = w2; height = h2; }
                            i64 entry = found_s + 8 + 8 + 78;
                            if find_box(entry, found_e, "avcC") {
                                String c = read_at(found_s, found_e - found_s);
                                if c.len >= 4 { extra = avc_profile(c[1] & 255) + ", level " + str((c[3] & 255) / 10) + "." + str((c[3] & 255) % 10); }
                            }
                        }
                        if kind == "soun" && d.len >= 8 + 8 + 20 {
                            i64 ch = be16(d, 8 + 8 + 16);
                            i64 rate = be16(d, 8 + 8 + 24);
                            extra = str(rate) + " Hz, " + str(ch) + " channels";
                        }
                    }
                }
            }
        }
    }
    String line = "track " + str(n) + ": ";
    if kind == "vide" { line = line + "video  " + fourcc + " " + codec_name(fourcc) + "  " + str(width) + "x" + str(height); }
    else if kind == "soun" { line = line + "audio  " + fourcc + " " + codec_name(fourcc); }
    else { line = line + kind + "  " + fourcc; }
    if extra.len > 0 { line = line + "  " + extra; }
    if duration > 0 && timescale > 0 {
        i64 ms = duration * 1000 / timescale;
        line = line + "  " + clock_text(ms);
        if kind == "vide" && samples > 0 && ms > 0 { line = line + "  " + str(samples) + " frames, " + str(samples * 10000 / ms / 10) + "." + str((samples * 10000 / ms) % 10) + " fps"; }
    }
    jout << line << "\n";
}

i64 do_info(String path) {
    g_fd = Sys::open_read(path.c());
    if g_fd < 0 { return fail("cannot read " + path); }
    Result<i64, Error> sz = Fs::size(path);
    if !sz.is_ok() { return fail("cannot read " + path); }
    g_size = sz.take();
    String head = read_at(0, 12);
    if head.len < 12 { return fail("too small to be a video"); }
    String t4 = four(head, 4);
    String t0 = four(head, 0);
    String t8 = four(head, 8);
    jout << path << " (" << g_size / 1024 << " KB)\n";
    if t4 == "ftyp" {
        jout << "container: mp4 / mov, brand " << four(head, 8) << "\n";
    } else if (head[0] & 255) == 26 && (head[1] & 255) == 69 && (head[2] & 255) == 223 && (head[3] & 255) == 163 {
        jout << "container: Matroska / WebM (the reader is the next step)\n";
        return 0;
    } else if t0 == "RIFF" && t8 == "AVI " {
        jout << "container: AVI (the reader is a later step)\n";
        return 0;
    } else if t4 == "moov" || t4 == "mdat" || t4 == "free" || t4 == "wide" {
        jout << "container: mov / mp4 without ftyp\n";
    } else {
        return fail(path + ": not a video file that jvp4 knows (mp4, mov; mkv, webm, avi are coming)");
    }
    if !find_box(0, g_size, "moov") { return fail("no moov box: a fragmented or damaged mp4 (not supported yet)"); }
    i64 ms = found_s;
    i64 me = found_e;
    if find_box(ms, me, "mvhd") {
        String h = read_at(found_s, found_e - found_s);
        i64 timescale = 1;
        i64 duration = 0;
        if (h[0] & 255) == 1 { timescale = be32(h, 20); duration = be64(h, 24); } else { timescale = be32(h, 12); duration = be32(h, 16); }
        if timescale > 0 { jout << "length: " << clock_text(duration * 1000 / timescale) << "\n"; }
    }
    i64 n = 0;
    i64 off = ms;
    while box_at(off, me) {
        if b_type == "trak" { n += 1; show_track(b_start, b_end, n); }
        off = b_end;
    }
    if n == 0 { jout << "no tracks\n"; }
    Sys::close(g_fd);
    return 0;
}

// ---- sound: a WAV file (PCM, 8 or 16 bits) through AAudio (libaaudio.so of Android, called with <native>; a program built with -dyn)
i64 le16(String d, i64 at) { return (d[at] & 255) | ((d[at + 1] & 255) << 8); }
i64 le32(String d, i64 at) { return le16(d, at) | (le16(d, at + 2) << 16); }

i64 play_wav(String path) {
    Result<String, Error> r = Fs::read_bytes(path);
    if !r.is_ok() { return fail("cannot read " + path); }
    String d = r.take();
    String riff = "";
    String wave = "";
    if d.len >= 12 { riff = d.slice(0, 4); wave = d.slice(8, 12); }
    if d.len < 44 || riff != "RIFF" || wave != "WAVE" { return fail(path + " is not a WAV file"); }
    i64 pos = 12;
    i64 channels = 0; i64 rate = 0; i64 bits = 0; i64 fmt = 0;
    i64 data_at = 0; i64 data_len = 0;
    while pos + 8 <= d.len {
        String id = d.slice(pos, pos + 4);
        i64 size = le32(d, pos + 4);
        if id == "fmt " { fmt = le16(d, pos + 8); channels = le16(d, pos + 10); rate = le32(d, pos + 12); bits = le16(d, pos + 22); }
        if id == "data" { data_at = pos + 8; data_len = size; if data_at + data_len > d.len { data_len = d.len - data_at; } break; }
        pos = pos + 8 + size + (size & 1);
    }
    if fmt != 1 || data_len == 0 { return fail("only PCM WAV files for now (format " + str(fmt) + ")"); }
    if bits != 16 { return fail("only 16 bit WAV files for now (this one has " + str(bits) + " bits)"); }
    i64 lib = Native::open("libaaudio.so");
    if lib == 0 { return fail("no libaaudio.so: this needs Android (build with jcmp -dyn)"); }
    i64 builder = 0;
    if Native::call1(Native::sym(lib, "AAudio_createStreamBuilder"), (i64)@builder) != 0 { return fail("AAudio: no stream builder"); }
    Native::call2(Native::sym(lib, "AAudioStreamBuilder_setSampleRate"), builder, rate);
    Native::call2(Native::sym(lib, "AAudioStreamBuilder_setChannelCount"), builder, channels);
    Native::call2(Native::sym(lib, "AAudioStreamBuilder_setFormat"), builder, 1);        // AAUDIO_FORMAT_PCM_I16
    i64 stream = 0;
    if Native::call2(Native::sym(lib, "AAudioStreamBuilder_openStream"), builder, (i64)@stream) != 0 { return fail("AAudio: cannot open the sound output"); }
    Native::call1(Native::sym(lib, "AAudioStream_requestStart"), stream);
    i64 write = Native::sym(lib, "AAudioStream_write");
    i64 frame = channels * 2;
    char buf[16384];
    i64 done = 0;
    i64 total = data_len / frame;
    jout << path << ": " << rate << " Hz, " << channels << " channels, " << total / rate << " s\n";
    while done < total {
        i64 n = 4096;
        if done + n > total { n = total - done; }
        for k in 0..n * frame { buf[k] = d[data_at + done * frame + k]; }
        i64 w = Native::call4(write, stream, (i64)@buf, n, 2000000000);
        if w <= 0 { break; }
        done += w;
    }
    Native::call1(Native::sym(lib, "AAudioStream_requestStop"), stream);
    Native::call1(Native::sym(lib, "AAudioStream_close"), stream);
    return 0;
}

i64 main() {
    String[] a = Env::args();
    if a.len > 1 && (a[1] == "--version" || a[1] == "-V") { jout << "jvp4 0.2.0\n"; return 0; }
    if a.len < 2 || a[1] == "--help" || a[1] == "-h" {
        jout << "jvp4: a video player made only of J2K.   jvp4 info FILE   what is in a video file (mp4 / mov);   jvp4 play FILE.wav   a sound file\n";
        jout << "  next: jvp4 play FILE (own decoders: H.264, AAC), see the plan docs/jvp4-plan.md\n";
        return 0;
    }
    if a[1] == "info" && a.len >= 3 { return do_info(a[2]); }
    String low = "";
    if a.len >= 3 { low = a[2].lower(); }
    if a[1] == "play" && a.len >= 3 && low.ends_with(".wav") { return play_wav(a[2]); }
    if a[1] == "play" && a.len >= 3 { return fail("the own decoders are not made yet; until then:  jaric video " + a[2]); }
    jerr << "usage: jvp4 info FILE\n";
    return 2;
}
