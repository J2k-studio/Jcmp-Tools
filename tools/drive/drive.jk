// drive: the drives of Jaric (f:/ 0:/ r:/ and the ones you make). The list is kept in ~/.jsh_drives, the file that jsh reads.
#import <stdlib>

String drive_version() { return "0.4.0"; }

String env_or(String name, String fallback) {
    switch Env::get(name) {
        Option::Some(v): { if v.len > 0 { return v; } }
        Option::None: { }
    }
    return fallback;
}

String list_file() { return env_or("HOME", "/") + "/.jsh_drives"; }
String drives_root() { return env_or("HOME", "/") + "/drives"; }       // where a new drive without a folder is made

int fail(String msg) { cerr << "drive: " << msg << "\n"; return 1; }

bool name_ok(String n) {
    if n.len == 0 || n.len > 12 { return false; }
    for i in 0..n.len {
        char c = n[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if !ok { return false; }
    }
    return true;
}

String read_list() {
    if !Fs::exists(list_file()) { return ""; }
    switch Fs::read_text(list_file()) {
        Result::Ok(t): { return t; }
        Result::Err(e): { return ""; }
    }
    return "";
}

// the path of a drive made by hand, "" when there is none
String made_path(String name) {
    String[] ls = read_list().split("\n");
    for i in 0..ls.len {
        String ln = ls[i].trim();
        if ln.starts_with(name + " ") { return ln.slice(name.len + 1, ln.len).trim() + ""; }
    }
    return "";
}

String system_path(String name) {
    if name == "f" { return env_or("HOME", "/"); }
    if name == "r" { return "/"; }
    if name == "0" {
        if Dir::exists("/storage/emulated/0") { return "/storage/emulated/0"; }
        if Dir::exists("/sdcard") { return "/sdcard"; }
    }
    return "";
}

String path_of(String name) {
    String p = system_path(name);
    if p.len > 0 { return p; }
    return made_path(name);
}

// ---- sizes: a limit per drive (kept in ~/.jsh_drive_sizes, lines  NAME BYTES). It is shown and checked here; the system does not stop a write yet.
String sizes_file() { return env_or("HOME", "/") + "/.jsh_drive_sizes"; }

// 2G, 500M, 64K, 1.5G, 100 (bytes) -> bytes; -1 when it is not a size
int parse_size(String t) {
    String x = t.trim().upper();
    if x.len == 0 { return 0 - 1; }
    int mul = 1;
    char last = x[x.len - 1];
    if last == 'B' && x.len > 1 { x = x.slice(0, x.len - 1); last = x[x.len - 1]; }
    if last == 'K' { mul = 1024; x = x.slice(0, x.len - 1); }
    else if last == 'M' { mul = 1048576; x = x.slice(0, x.len - 1); }
    else if last == 'G' { mul = 1073741824; x = x.slice(0, x.len - 1); }
    else if last == 'T' { mul = 1099511627776; x = x.slice(0, x.len - 1); }
    if x.len == 0 { return 0 - 1; }
    int dot = 0 - 1;
    for i in 0..x.len {
        char c = x[i];
        if c == '.' { if dot >= 0 { return 0 - 1; } dot = i; }
        else if c < '0' || c > '9' { return 0 - 1; }
    }
    if dot < 0 { return x.to_int() * mul; }
    int whole = x.slice(0, dot).to_int();
    String frac = x.slice(dot + 1, x.len);
    if frac.len > 3 { frac = frac.slice(0, 3); }
    int fv = 0;
    int scale = 1;
    for i in 0..frac.len { fv = fv * 10 + (frac[i] - '0'); scale = scale * 10; }
    return whole * mul + fv * mul / scale;
}

String size_text(int n) {
    if n >= 1073741824 { return str(n / 1073741824) + "." + str((n % 1073741824) * 10 / 1073741824) + " GB"; }
    if n >= 1048576 { return str(n / 1048576) + "." + str((n % 1048576) * 10 / 1048576) + " MB"; }
    if n >= 1024 { return str(n / 1024) + " KB"; }
    return str(n) + " B";
}

int limit_of(String name) {
    if !Fs::exists(sizes_file()) { return 0 - 1; }
    switch Fs::read_text(sizes_file()) {
        Result::Ok(t): {
            String[] ls = t.split("\n");
            String key = name + " ";
            for i in 0..ls.len {
                String ln = ls[i].trim();
                if ln.starts_with(key) { return ln.slice(key.len, ln.len).trim().to_int(); }
            }
        }
        Result::Err(e): { }
    }
    return 0 - 1;
}

void set_limit(String name, int bytes) {                  // bytes < 0: no limit
    String out = "";
    String key = name + " ";
    if Fs::exists(sizes_file()) {
        switch Fs::read_text(sizes_file()) {
            Result::Ok(t): {
                String[] ls = t.split("\n");
                for i in 0..ls.len {
                    String ln = ls[i].trim();
                    if ln.len > 0 && !ln.starts_with(key) { out = out + ln + "\n"; }
                }
            }
            Result::Err(e): { }
        }
    }
    if bytes >= 0 { out = out + name + " " + str(bytes) + "\n"; }
    Fs::write_text(sizes_file(), out);
}

int used_bytes(String dir) {
    int total = 0;
    switch Dir::list(dir) {
        Result::Ok(names): {
            for i in 0..names.len {
                String p = dir + "/" + names[i];
                if Dir::exists(p) { total += used_bytes(p); }
                else { switch Fs::size(p) { Result::Ok(n): { total += n; } Result::Err(e): { } } }
            }
        }
        Result::Err(e): { }
    }
    return total;
}

int count_entries(String dir) {
    switch Dir::list(dir) {
        Result::Ok(names): { return names.len; }
        Result::Err(e): { return 0; }
    }
    return 0;
}

// ---- paths: drive form  X:/rest  <->  the real path
// the real path of  :/bin  f:/x  0:/Music  work:/a  ~/b  (a path that starts with / is already real)
String real_of(String p) {
    String q = p.trim();
    String home = env_or("HOME", "/");
    if q == "~" || q == ":/" || q == ":" { return home + ""; }
    if q.starts_with("~/") { return Path::join(home, q.slice(2, q.len)); }
    if q.starts_with(":/") { return Path::join(home, q.slice(2, q.len)); }
    int colon = q.find(":");
    if colon > 0 && colon < 13 {
        String name = q.slice(0, colon) + "";
        String base = path_of(name);
        if base.len > 0 {
            String rest = q.slice(colon + 1, q.len);
            if rest.len == 0 || rest == "/" { return base + ""; }
            if rest.starts_with("/") { rest = rest.slice(1, rest.len); }
            if base == "/" { return "/" + rest; }
            return Path::join(base, rest);
        }
    }
    return q + "";
}

// the drive form of a real path: the drive with the longest folder that holds it (:/ for home)
String drive_of(String real) {
    String best = "";
    String bestname = "";
    String[] names = arr(8);
    names.push("f"); names.push("0"); names.push("r");
    String[] ls = read_list().split("\n");
    for i in 0..ls.len {
        String ln = ls[i].trim();
        int sp = ln.find(" ");
        if sp > 0 { names.push(ln.slice(0, sp) + ""); }
    }
    for i in 0..names.len {
        String root = path_of(names[i]);
        if root.len == 0 { continue; }
        String under = root + "/";
        bool inside = root == "/" || real == root || real.starts_with(under);
        if inside && root.len > best.len { best = root + ""; bestname = names[i] + ""; }
    }
    if bestname.len == 0 { return real + ""; }
    String rest = real.slice(best.len, real.len);
    if best == "/" { rest = real; }
    if rest.len == 0 { rest = "/"; }
    if bestname == "f" { return ":" + rest; }
    return bestname + ":" + rest;
}

// drive -all: every entry of the folder that holds home (the files of the app: usr, home, hidden ones like .local ...), with the real path;
// the folders are shown one level down for usr (bin, etc, lib ...)
void list_level(String dir, String indent, String shown) {
    switch Dir::list(dir) {
        Result::Ok(names): {
            names.sort();
            for i in 0..names.len {
                String p = Path::join(dir, names[i]);
                String mark = "";
                if Dir::exists(p) { mark = "/"; }
                cout << indent << shown << names[i] << mark << "\n";
            }
        }
        Result::Err(e): { cout << indent << "(cannot read " << dir << ")\n"; }
    }
}

int do_all() {
    String home = env_or("HOME", "/");
    String top = Path::parent(home);                    // the files folder of the app (home is files/home)
    cout << "the files of Jaric: " << top << "\n";
    list_level(top, "  ", "");
    String usr = env_or("PREFIX", top + "/usr");
    if Dir::exists(usr) {
        cout << "usr (" << usr << "):\n";
        list_level(usr, "  ", "");
        String ubin = usr + "/bin";
        if Dir::exists(ubin) { cout << "usr/bin: the commands (" << count_entries(ubin) << " files)\n"; }
    }
    cout << "home (" << home << ", also :/ and f:/), with the hidden files:\n";
    list_level(home, "  ", ":/");
    return 0;
}

int do_list() {
    cout << ":/   home (the same as ~/ and f:/)\n";
    String[] sys = "f 0 r".split(" ");
    for i in 0..sys.len {
        String p = system_path(sys[i]);
        if p.len > 0 { cout << sys[i] << ":/  " << p << "\n"; }
    }
    String[] ls = read_list().split("\n");
    for i in 0..ls.len {
        String ln = ls[i].trim();
        int sp = ln.find(" ");
        if sp > 0 {
            String nm = ln.slice(0, sp) + "";
            String extra = "";
            int lim = limit_of(nm);
            if lim >= 0 { extra = "   limit " + size_text(lim); }
            cout << nm << ":/  " << ln.slice(sp + 1, ln.len).trim() << extra << "\n";
        }
    }
    return 0;
}

int do_info(String name) {
    String p = path_of(name);
    if p.len == 0 { return fail("no drive " + name + " (drive shows them)"); }
    cout << name << ":/  " << p << "\n";
    if !Dir::exists(p) { cout << "  the folder is gone\n"; return 1; }
    cout << "  " << count_entries(p) << " entries\n";
    int used = used_bytes(p);
    int lim = limit_of(name);
    if lim < 0 { cout << "  used " << size_text(used) << "  (no limit;  drive size " << name << " 2G  sets one)\n"; return 0; }
    int pct = 0;
    if lim > 0 { pct = used * 100 / lim; }
    cout << "  used " << size_text(used) << " of " << size_text(lim) << "  (" << pct << "%)\n";
    if used > lim { cout << "  over the limit by " << size_text(used - lim) << "\n"; return 1; }
    return 0;
}

void write_without(String name, String add) {
    String out = "";
    String key = name + " ";
    String[] ls = read_list().split("\n");
    for i in 0..ls.len {
        String ln = ls[i].trim();
        if ln.len > 0 && !ln.starts_with(key) { out = out + ln + "\n"; }
    }
    if add.len > 0 { out = out + name + " " + add + "\n"; }
    Fs::write_text(list_file(), out);
}

int do_new(String[] a) {
    String name = a[2];
    if !name_ok(name) { return fail("the name is letters, digits and _ (up to 12)"); }
    if system_path(name).len > 0 || name == "f" || name == "r" || name == "0" { return fail(name + " is a drive of the system and cannot be changed"); }
    if made_path(name).len > 0 { return fail("the drive " + name + " is there already (drive remove " + name + " first)"); }
    String path = "";
    int limit = 0 - 1;
    String[] rest = arr(4);
    for i in 3..a.len { rest.push(a[i] + ""); }
    for i in 0..rest.len {                                       // a size (2G, 500M) may stand anywhere after the name
        if !rest[i].starts_with("/") && parse_size(rest[i]) >= 0 { limit = parse_size(rest[i]); rest[i] = ""; }
    }
    String given = "";
    for i in 0..rest.len { if rest[i].len > 0 { given = rest[i] + ""; } }
    if given.len > 0 {
        path = given;
        if !path.starts_with("/") { return fail("the folder must be a full path (it starts with /)"); }
        if !Dir::exists(path) { return fail(path + " is not a folder (drive new " + name + " makes a new one by itself)"); }
    } else {
        path = drives_root() + "/" + name;
        Dir::make_all(path);
        if !Dir::exists(path) { return fail("cannot make the folder " + path); }
    }
    write_without(name, path);
    if limit >= 0 { set_limit(name, limit); }
    cout << name << ":/ is " << path;
    if limit >= 0 { cout << "   limit " << size_text(limit); }
    cout << "\n";
    return 0;
}

void remove_tree(String dir) {
    switch Dir::list(dir) {
        Result::Ok(names): {
            for i in 0..names.len {
                String p = dir + "/" + names[i];
                if Dir::exists(p) { remove_tree(p); } else { Fs::remove(p); }
            }
        }
        Result::Err(e): { }
    }
    Dir::remove(dir);
}

// drive remove NAME: the drive goes; the folder stays.  With -d the folder goes too, but only a folder that  drive new  made (in ~/drives)
int do_remove(String[] a) {
    String name = a[2];
    String p = made_path(name);
    if p.len == 0 { return fail("no drive " + name + " was made"); }
    bool del = false;
    for i in 3..a.len { if a[i] == "-d" { del = true; } }
    String mine = drives_root() + "/";
    if del && !p.starts_with(mine) { return fail("-d deletes only folders that drive new made in " + drives_root()); }
    write_without(name, "");
    set_limit(name, 0 - 1);
    if del { remove_tree(p); cout << "removed the drive " << name << " and its folder\n"; return 0; }
    cout << "removed the drive " << name << " (the folder " << p << " stays)\n";
    return 0;
}

// drive check: every drive that has a limit, with what it uses; the exit code is the number of drives over their limit
int do_check() {
    int over = 0;
    String[] ls = read_list().split("\n");
    for i in 0..ls.len {
        String ln = ls[i].trim();
        int sp = ln.find(" ");
        if sp <= 0 { continue; }
        String nm = ln.slice(0, sp) + "";
        if limit_of(nm) < 0 { continue; }
        if do_info(nm) != 0 { over += 1; }
    }
    return over;
}

int main() {
    String[] a = Env::args();
    if a.len > 1 && (a[1] == "--version" || a[1] == "-V") { cout << "drive " << drive_version() << "\n"; return 0; }
    if a.len > 1 && (a[1] == "--help" || a[1] == "-h" || a[1] == "-help" || a[1] == "help") {
        cout << "drive: the drives of Jaric (f:/ 0:/ r:/ and your own)\n";
        cout << "  drive                       the list         drive NAME            where a drive is, how many entries\n";
        cout << "  drive -p :/bin              the real path of a path with a drive (-p, -path, -part);   drive -d /real/path   the path with the drive\n";
        cout << "  drive -all                  every entry of the files of Jaric (usr, home, hidden ones), the commands folder usr/bin\n";
        cout << "  drive new NAME              a new drive with a new folder (in ~/drives)\n";
        cout << "  drive new NAME PATH         a drive of a folder that is there\n";
        cout << "  drive new NAME 2G           a size (K, M, G; 1.5G) may be given: it is the limit of the drive (shown and checked, not enforced yet)\n";
        cout << "  drive size NAME 500M|none   change or clear the limit      drive check   the drives with a limit and what they use\n";
        cout << "  drive remove NAME [-d]      take a drive away (-d: delete its folder too, only a folder that drive new made)\n";
        return 0;
    }
    if a.len == 1 || a[1] == "list" { return do_list(); }
    if a[1] == "-all" || a[1] == "--all" || a[1] == "-a" { return do_all(); }
    if (a[1] == "-p" || a[1] == "-path" || a[1] == "-part") && a.len >= 3 { cout << real_of(a[2]) << "\n"; return 0; }     // drive -p :/bin  ->  the real path
    if (a[1] == "-d" || a[1] == "-drive") && a.len >= 3 {                                                          // drive -d /real/path  ->  the drive form
        String rp = a[2];
        if !rp.starts_with("/") { rp = Path::join(env_or("PWD", "/"), rp); }
        cout << drive_of(rp) << "\n";
        return 0;
    }
    if a[1] == "new" && a.len >= 3 { return do_new(a); }
    if a[1] == "remove" && a.len >= 3 { return do_remove(a); }
    if a[1] == "size" && a.len >= 4 {                             // drive size NAME 2G   /   drive size NAME none
        if path_of(a[2]).len == 0 { return fail("no drive " + a[2]); }
        if a[3] == "none" { set_limit(a[2], 0 - 1); cout << a[2] << ":/ has no limit\n"; return 0; }
        int b = parse_size(a[3]);
        if b < 0 { return fail("a size looks like 2G, 500M, 64K or 1.5G"); }
        set_limit(a[2], b);
        cout << a[2] << ":/ limit " << size_text(b) << "\n";
        return 0;
    }
    if a[1] == "check" { return do_check(); }
    if a[1].starts_with("-") { cerr << "drive: unknown option " << a[1] << "  (drive --help)\n"; return 2; }
    if a.len == 2 { return do_info(a[1]); }
    cerr << "usage: drive | drive NAME | drive new NAME [PATH] | drive remove NAME [-d]   (drive --help)\n";
    return 2;
}
