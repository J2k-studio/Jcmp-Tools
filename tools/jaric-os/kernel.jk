    if row == 0 { t8(28 + 0, 110, 0x6b73696420656854, 1, rgb(150, 175, 215)); t8(28 + 80, 110, 0x206f6e2073616820, 1, rgb(150, 175, 215)); t8(28 + 160, 110, 0x2e73656c6966, 1, rgb(150, 175, 215));
 }
