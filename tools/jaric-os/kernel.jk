#!library
// K7: a console. The kernel reads what you type from the UART (the keyboard of the machine), echoes it, and runs a few commands of its own on the JFS disk:
// ls, cat NAME, echo TEXT, help, exit. It is the first time Jaric OS answers to a person. (jsh on top of it is the next step: it needs the Linux calls
// open / read / write / exit ... in a process, K7b.) Texts are numbers of eight letters (a raw file has no data segment).
char sbuf[4608];
char fbuf[4096];
char line[128];
char name[48];
int nfiles;
int llen;

naked void start() {
    x28 = 0x4010_0000;
    call kmain;
}

void uputc(int c) {
    char^ uart = (char^)0x09000000;
    uart[0] = (char)c;
}

// ---- the screen. When the machine has one (the register WIDTH of the screen is not 0) the system draws its letters on it: a picture of 540 x 960 dots at 0x41000000, 54 x 48 cells of 10 x 20 dots;
// the letters are a smooth font (8 bits of cover for each dot) that the system reads from the file jaric-os-font of its disk. The machine shows the picture (FLUSH) when the system waits for a key.
int scr;                            
int cx;
int cy;
int gdirty;
int shown;
int scrH;                              // the height of the picture in dots (the width is 540)
int vrows;                             // the rows that are seen (the keyboard of the phone hides some)
int maxrows;
int sready;
int fontsize;                            // 1 when the font is loaded and the screen can be used
int seen;                              // the touch events that were looked at
int fsok;
int gohome;                            // the back button was tapped in the terminal app
int g_el;                              // what the start found, for the About app
int g_core;
int g_dsec;
int g_font;
int roff;                              // rows at the top of the screen that the apps use for their bar (4 rows = 80 dots)
int fgc;                            
char gcol[3800];                          
char gcells[3800];                  
char^ fnt;                          

void draw_cell(int col, int row, int c, int cur, int k) {
    int pb = 255;
    int pg = 228;
    int pr = 200;
    if k == 1 { pb = 130; pg = 225; pr = 110; }
    if k == 2 { pb = 170; pg = 150; pr = 125; }
    if k == 3 { pb = 100; pg = 100; pr = 240; }
    if k == 4 { pb = 255; pg = 190; pr = 100; }
    char^ fb = (char^)0x41000000;
    int g = 4 + (c - 32) * 200;
    if c < 32 || c > 126 { g = 4; }
    for gy in 0..20 {
        int o = (((row + roff) * 20 + gy) * 540 + col * 10) * 4;
        for gx in 0..10 {
            int a = fnt[g + gy * 10 + gx] & 255;
            if cur == 1 { a = 255 - a; if a < 90 { a = 90; } }
            fb[o] = (char)(20 + ((pb - 20) * a) / 255);
            fb[o + 1] = (char)(10 + ((pg - 10) * a) / 255);
            fb[o + 2] = (char)(8 + ((pr - 8) * a) / 255);
            fb[o + 3] = (char)255;
            o += 4;
        }
    }
}

void scroll_up() {
    int^ fb = (int^)0x41000000;
    int words = 540 * (vrows - 1) * 20 / 2;          // the rows that stay, two dots in a word
    int from = 540 * 20 / 2;
    int top = 540 * roff * 20 / 2;
    for i in 0..words { fb[top + i] = fb[top + i + from]; }
    int bg = 20 | (10 << 8) | (8 << 16) | (255 << 24);
    int two = bg | (bg << 32);
    for i in words..(540 * vrows * 20 / 2) { fb[top + i] = two; }
    for i in 0..(54 * (vrows - 1)) { gcells[i] = gcells[i + 54]; gcol[i] = gcol[i + 54]; }
    for i in (54 * (vrows - 1))..(54 * vrows) { gcells[i] = (char)32; gcol[i] = (char)0; }
}

// the part of the picture that is seen changed (the keyboard came or went): the rows follow, and the cursor is kept in sight
void view_set(int vh) {
    int r = vh / 20 - roff;
    if r < 6 { r = 6; }
    if r > maxrows { r = maxrows; }
    if shown == 1 { draw_cell(cx, cy, gcells[cy * 54 + cx] & 255, 0, gcol[cy * 54 + cx]); shown = 0; }
    vrows = r;
    while cy >= vrows { scroll_up(); cy -= 1; }
    int^ fb = (int^)0x41000000;
    int bg = 20 | (10 << 8) | (8 << 16) | (255 << 24);
    int two = bg | (bg << 32);
    for i in (540 * (vrows + roff) * 20 / 2)..(540 * scrH / 2) { fb[i] = two; }
    for i in (54 * vrows)..(54 * maxrows) { gcells[i] = (char)32; gcol[i] = (char)0; }
    gdirty = 1;
}

void newline() {
    cx = 0;
    cy += 1;
    if cy >= vrows { scroll_up(); cy = vrows - 1; }
}

void setcol(int k) {
    fgc = k;
    if scr == 0 {                                    // on the terminal: the colour is an escape code
        uputc(27); uputc(91);
        if k == 0 { uputc(48); }
        if k == 1 { uputc(51); uputc(50); }
        if k == 2 { uputc(57); uputc(48); }
        if k == 3 { uputc(51); uputc(49); }
        if k == 4 { uputc(51); uputc(54); }
        uputc(109);
    }
}

void putc(int c) {
    if scr == 0 { uputc(c); return; }
    if shown == 1 { draw_cell(cx, cy, gcells[cy * 54 + cx] & 255, 0, gcol[cy * 54 + cx]); shown = 0; }
    gdirty = 1;
    if c == 10 { newline(); return; }
    if c == 13 { cx = 0; return; }
    if c == 8 { if cx > 0 { cx -= 1; } return; }
    if c < 32 || c > 126 { return; }
    if cx >= 54 { newline(); }
    gcells[cy * 54 + cx] = (char)c;
    gcol[cy * 54 + cx] = (char)fgc;
    draw_cell(cx, cy, c, 0, fgc);
    cx += 1;
}

// the picture is shown (with the cursor) before the system waits for a key
void screen_show() {
    if scr == 0 || gdirty == 0 { return; }
    if cx >= 54 { newline(); }
    draw_cell(cx, cy, gcells[cy * 54 + cx] & 255, 1, 0);
    shown = 1;
    int^ fb = (int^)0x0B000000;
    fb[3] = 1;
    gdirty = 0;
}

int getc() {                                   // waits for a key: the flag register says when one is there; the touch device is looked at while waiting
    screen_show();
    int^ uart = (int^)0x09000000;
    int^ ui = (int^)0x0C000000;
    int fr = uart[3];
    while (fr & 16) != 0 {
        int sq = ui[0];
        if sq != seen {
            seen = sq;
            if ui[3] == 4 && scr == 1 { view_set(ui[2]); screen_show(); }
            if ui[3] == 1 && scr == 1 && ((ui[2] < 76 && ui[1] < 170) || ui[2] > scrH - 70) { gohome = 1; return 4; }
        }
        fr = uart[3];
    }
    return uart[0] & 255;
}

void say(int w) {
    for k in 0..8 {
        int c = (w >> (k * 8)) & 255;
        if c == 0 { return; }
        putc(c);
    }
}

void kputs(char^ s) {
    int i = 0;
    while s[i] != 0 { putc(s[i]); i += 1; }
}

bool disk_io(int cmd, int sector, int addr, int count) {
    int^ dev = (int^)0x0A000000;
    dev[1] = sector;
    dev[2] = addr;
    dev[3] = count;
    dev[0] = cmd;
    int st = dev[4];
    return st == 0;
}

int rd64(char^ p) {
    int v = 0;
    for k in 0..8 { v = v | ((p[k] & 255) << (k * 8)); }
    return v;
}

bool fs_mount() {
    if !disk_io(1, 0, (int)@sbuf, 9) { return false; }
    if sbuf[0] != 'J' || sbuf[1] != '2' || sbuf[2] != 'F' || sbuf[3] != 'S' { return false; }
    nfiles = rd64(@sbuf[8]);
    return true;
}

bool same(char^ a, char^ b) {
    int i = 0;
    while a[i] != 0 && b[i] != 0 { if a[i] != b[i] { return false; } i += 1; }
    return a[i] == b[i];
}

void fs_ls() {
    for i in 0..nfiles {
        char^ e = @sbuf[512 + i * 64];
        if e[0] == 'j' && e[1] == 'a' && e[2] == 'r' && e[3] == 'i' && e[4] == 'c' && e[5] == '-' { continue; }   
        kputs(e);
        putc(10);
    }
}

void fs_cat(char^ nm) {
    for i in 0..nfiles {
        char^ e = @sbuf[512 + i * 64];
        if same(e, nm) {
            int start = rd64(@e[48]);
            int size = rd64(@e[56]);
            int sectors = (size + 511) / 512;
            if sectors > 8 { sectors = 8; }
            if !disk_io(1, start, (int)@fbuf, sectors) { say(0x7272652064616572); say(0x726f); putc(10); return; }
            for k in 0..size { putc(fbuf[k]); }
            return;
        }
    }
    say(0x2068637573206f6e); say(0x656c6966); putc(10);
}

// the first word of the line packed into a number (up to eight letters)
int first_word() {
    int w = 0;
    int i = 0;
    while i < 8 && i < llen && line[i] != 32 { w = w | ((line[i] & 255) << (i * 8)); i += 1; }
    return w;
}

// where the arguments start (after the first word and the spaces)
int args_at() {
    int i = 0;
    while i < llen && line[i] != 32 { i += 1; }
    while i < llen && line[i] == 32 { i += 1; }
    return i;
}

// reads a line with an echo; false at the end of the input
bool read_line() {
    llen = 0;
    while true {
        int c = getc();
        if c == 4 { return false; }
        if c == 10 || c == 13 { putc(10); line[llen] = 0; return true; }
        if (c == 127 || c == 8) { if llen > 0 { llen -= 1; putc(8); putc(32); putc(8); } continue; }
        if llen < 120 { line[llen] = (char)c; llen += 1; putc(c); }
    }
    return false;
}

// the font: the file jaric-os-font of the disk, read to 0x42100000; the screen is on when it is there
void screen_start() {
    int^ fb = (int^)0x0B000000;
    int hh = fb[2];
    if fb[1] != 540 || hh < 480 || hh > 1400 { return; }
    char nm[16];
    nm[0] = 'j'; nm[1] = 'a'; nm[2] = 'r'; nm[3] = 'i'; nm[4] = 'c'; nm[5] = '-'; nm[6] = 'o'; nm[7] = 's'; nm[8] = '-'; nm[9] = 'f'; nm[10] = 'o'; nm[11] = 'n'; nm[12] = 't'; nm[13] = 0;
    for i in 0..nfiles {
        char^ e = @sbuf[512 + i * 64];
        int k = 0;
        while nm[k] != 0 && e[k] == nm[k] { k += 1; }
        if nm[k] == 0 && e[k] == 0 {
            int start = rd64(@e[48]);
            int size = rd64(@e[56]);
            if size < 4 || size > 60000 { return; }
            if !disk_io(1, start, 0x42100000, (size + 511) / 512) { return; }
            fnt = (char^)0x42100000;
            if (fnt[0] & 255) != 10 || (fnt[1] & 255) != 20 { return; }
            scrH = hh / 20 * 20;
            roff = 4;
            maxrows = scrH / 20 - roff;
            vrows = maxrows;
            fontsize = size;
            sready = 1;
            return;
        }
    }
}

// the screen is used from now on: cleared, the letters go to it and not to the terminal any more
void screen_on() {
    if sready == 0 { return; }
    int^ fb = (int^)0x0B000000;
    int^ px = (int^)0x41000000;
    int bg = 20 | (10 << 8) | (8 << 16) | (255 << 24);
    int two = bg | (bg << 32);
    for p in 0..(540 * scrH / 2) { px[p] = two; }
    for p in 0..(54 * maxrows) { gcells[p] = (char)32; gcol[p] = (char)0; }
    fb[0] = 0x41000000;
    fb[2] = scrH;                                    // the picture is whole rows of letters
    cx = 0;
    cy = 0;
    shown = 0;
    scr = 1;
}

// ---- the start: the system looks at what the machine has and writes what it finds, one line for each check, on the terminal: [ seconds ] [ OK ] what: the result
void putnum(int v) {
    if v >= 10 { putnum(v / 10); }
    putc(48 + v % 10);
}

void pad3(int v) {
    if v < 100 { putc(48); }
    if v < 10 { putc(48); }
    putnum(v);
}

int tfreq;

void stamp() {
    int ms = Sys::s3_3_c14_c0_2 / 1000;                  // the counter runs at 1 MHz
    setcol(2);
    putc(91);
    int sec = ms / 1000;
    if sec < 100 { putc(32); }
    if sec < 10 { putc(32); }
    putnum(sec);
    putc(46);
    pad3(ms % 1000);
    putc(93);
    putc(32);
    setcol(0);
}

void tag(bool good) {
    if good { setcol(1); say(0x205d204b4f205b); }
    else { setcol(3); say(0x205d4c4941465b); }
    setcol(0);
}

void logline() {
    putc(10);
}

void boot_log() {
    tfreq = Sys::s3_3_c14_c0_0;
    if tfreq < 1000 { tfreq = 1000000; }
    setcol(4); say(0x534f20636972614a); say(0x332e3020); setcol(2); say(0x7265776f70202020); say(0x614a207962206465); say(0x636972); setcol(0);
    logline();
    int el = Sys::s3_0_c4_c2_2 >> 2;
    int core = Sys::s3_0_c0_c0_5 & 255;
    g_el = el;
    g_core = core;
    stamp(); tag(el == 1); say(0x2020202020555043); say(0x202c34364d524120); say(0x6f69747065637865); say(0x206c6576656c206e); putnum(el); say(0x2065726f63202c); putnum(core);
    logline();
    int c0 = Sys::s3_3_c14_c0_2;
    int spin = 0;
    while spin < 100 { spin += 1; }
    int c1 = Sys::s3_3_c14_c0_2;
    stamp(); tag(c1 > c0); say(0x207265746e756f43); say(0x20); putnum(tfreq / 1000); say(0x6f63202c7a486b20); say(0x676e69746e75);
    logline();
    Sys::s3_3_c14_c3_0 = 2000;
    Sys::s3_3_c14_c3_1 = 3;
    int waits = 0;
    while (Sys::s3_3_c14_c3_1 & 4) == 0 && waits < 100000 { waits += 1; }
    bool fired = (Sys::s3_3_c14_c3_1 & 4) != 0;
    Sys::s3_3_c14_c3_1 = 0;
    stamp(); tag(fired); say(0x20202072656d6954); say(0x206b636974206120); say(0x73656d6f63);
    logline();
    int^ m1 = (int^)0x42000000;
    int^ m2 = (int^)0x43000000;
    int^ m3 = (int^)0x43FFFFF0;
    m1[0] = 0x5a5a5a5a5a5a5a5a;
    m2[0] = 0x3c3c3c3c3c3c3c3c;
    m3[0] = 0x1234567812345678;
    bool ram_ok = m1[0] == 0x5a5a5a5a5a5a5a5a && m2[0] == 0x3c3c3c3c3c3c3c3c && m3[0] == 0x1234567812345678;
    stamp(); tag(ram_ok); say(0x202079726f6d654d); say(0x202c424d20343620); say(0x6120646574736574); say(0x2065657268742074); say(0x736563616c70);
    logline();
    stamp(); tag(true); say(0x2020202054524155); say(0x656c6f736e6f6320); say(0x796461657220);
    logline();
    int^ dev = (int^)0x0A000000;
    int dsec = dev[5];
    g_dsec = dsec;
    g_font = fontsize;
    stamp(); tag(dsec > 0); say(0x202020206b736944); say(0x20); putnum(dsec); say(0x73726f7463657320); say(0x202c); putnum(dsec / 2); say(0x424b20);
    logline();
    stamp(); tag(fsok == 1); say(0x20202073656c6946); say(0x202c53464a20); putnum(nfiles); say(0x73656c696620);
    logline();
    int^ fbr = (int^)0x0B000000;
    if fbr[1] != 0 {
        stamp(); tag(sready == 1); say(0x20202020746e6f46); say(0x2c68746f6f6d7320); say(0x20); putnum(fontsize); say(0x736574796220);
        logline();
        stamp(); tag(sready == 1); say(0x20206e6565726353); say(0x20); putnum(fbr[1]); say(0x207820); putnum(fbr[2]); say(0x202c); putnum(54); say(0x207820); putnum(maxrows); say(0x736c6c656320);
        logline();
    }
    int^ uid = (int^)0x0C000000;
    int tq = uid[0];
    stamp(); tag(tq >= 0); say(0x2020206863756f54); say(0x2065636976656420); say(0x7964616572);
    logline();
    stamp(); tag(true); say(0x2020207475706e49); say(0x72616f6279656b20); say(0x79646165722064);
    logline();
    setcol(1); say(0x534f20636972614a); say(0x6461657220736920); say(0x2e79); setcol(0);
    logline();
}


// ---- the phone: a home screen with icons, a dock, and the apps. Everything is drawn here with the smooth font; the touch device tells where a finger is.
u32^ p32;
char tb[24];
char anames[256];                      // 16 apps, 16 letters each
int akind[16];                         // 0 terminal, 1 files, 2 clock, 3 about, 4 a .jc package (aidx = its place in the directory), 5 power
int aidx[16];
int napps;
int ev;                                // what wait_event found: 0 a key, 1 down, 2 move, 3 up (4, the seen height, is taken care of inside)
int ev_x;
int ev_y;
int ev_key;
int dn_x;
int dn_y;
int tap_x;
int tap_y;

int rgb(int r, int g, int b) { return b | (g << 8) | (r << 16) | (255 << 24); }

void fill(int x, int y, int w, int h, int c) {
    for yy in y..(y + h) {
        if yy >= 0 && yy < scrH {
            int base = yy * 540;
            for xx in x..(x + w) { if xx >= 0 && xx < 540 { p32[base + xx] = (u32)c; } }
        }
    }
}

void rrect(int x, int y, int w, int h, int r, int c) {
    for yy in y..(y + h) {
        if yy >= 0 && yy < scrH {
            int dy = 0;
            if yy < y + r { dy = y + r - 1 - yy; }
            if yy >= y + h - r { dy = yy - (y + h - r); }
            int base = yy * 540;
            for xx in x..(x + w) {
                if xx >= 0 && xx < 540 {
                    int dx = 0;
                    if xx < x + r { dx = x + r - 1 - xx; }
                    if xx >= x + w - r { dx = xx - (x + w - r); }
                    if dx * dx + dy * dy <= r * r { p32[base + xx] = (u32)c; }
                }
            }
        }
    }
}

// the page behind everything: dark blue that gets lighter downwards
void wallpaper() {
    for y in 0..scrH {
        int c = rgb(8 + y / 90, 10 + y / 50, 24 + y / 14);
        int base = y * 540;
        for x in 0..540 { p32[base + x] = (u32)c; }
    }
}

void blend(int x, int y, int c, int a) {
    if x < 0 || x >= 540 || y < 0 || y >= scrH { return; }
    int o = (int)p32[y * 540 + x];
    int ob = o & 255;
    int og = (o >> 8) & 255;
    int orr = (o >> 16) & 255;
    int cb = c & 255;
    int cg = (c >> 8) & 255;
    int cr = (c >> 16) & 255;
    int nb = ob + ((cb - ob) * a) / 255;
    int ng = og + ((cg - og) * a) / 255;
    int nr = orr + ((cr - orr) * a) / 255;
    p32[y * 540 + x] = (u32)(nb | (ng << 8) | (nr << 16) | (255 << 24));
}

void glyph(int x, int y, int ch, int sc, int c) {
    if ch < 32 || ch > 126 { return; }
    int g = 4 + (ch - 32) * 200;
    for gy in 0..20 {
        for gx in 0..10 {
            int a = fnt[g + gy * 10 + gx] & 255;
            if a > 6 {
                if sc == 1 { blend(x + gx, y + gy, c, a); }
                else {
                    for sy in 0..sc { for sx in 0..sc { blend(x + gx * sc + sx, y + gy * sc + sy, c, a); } }
                }
            }
        }
    }
}

void text(int x, int y, char^ s, int sc, int c) {
    int i = 0;
    while s[i] != 0 { glyph(x + i * 10 * sc, y, s[i] & 255, sc, c); i += 1; }
}

// up to eight letters that are in a number (the first one in the lowest byte)
void t8(int x, int y, int w, int sc, int c) {
    for k in 0..8 {
        int ch = (w >> (k * 8)) & 255;
        if ch == 0 { return; }
        glyph(x + k * 10 * sc, y, ch, sc, c);
    }
}

void num(int x, int y, int v, int sc, int c) {
    int n = 0;
    char d[20];
    if v == 0 { d[0] = '0'; n = 1; }
    while v > 0 { d[n] = (char)(48 + v % 10); v = v / 10; n += 1; }
    for k in 0..n { glyph(x + k * 10 * sc, y, d[n - 1 - k] & 255, sc, c); }
}

int digits(int v) {
    int n = 1;
    while v >= 10 { v = v / 10; n += 1; }
    return n;
}

void present() {
    int^ fb = (int^)0x0B000000;
    fb[3] = 1;
}

void keyboard(int on) {
    int^ fb = (int^)0x0B000000;
    fb[4] = on;                                    // the register KEYBOARD (0x20): the app shows or hides the keyboard
}

int icon_color(int i) {
    int k = i % 6;
    if k == 0 { return rgb(70, 150, 255); }
    if k == 1 { return rgb(90, 200, 140); }
    if k == 2 { return rgb(255, 160, 80); }
    if k == 3 { return rgb(190, 120, 240); }
    if k == 4 { return rgb(240, 100, 130); }
    return rgb(80, 200, 220);
}

void setname(int i, int w0, int w1) {
    for k in 0..8 { anames[i * 16 + k] = (char)((w0 >> (k * 8)) & 255); }
    for k in 0..8 { anames[i * 16 + 8 + k] = (char)((w1 >> (k * 8)) & 255); }
    anames[i * 16 + 15] = 0;
}

void addapp(int kind, int w0, int w1, int idx) {
    if napps >= 16 { return; }
    setname(napps, w0, w1);
    akind[napps] = kind;
    aidx[napps] = idx;
    napps += 1;
}

// the apps: the ones of the system, then the .jc packages that are on the disk
void build_apps() {
    napps = 0;
    addapp(0, 0x6c616e696d726554, 0, 0);
    addapp(1, 0x73656c6946, 0, 0);
    addapp(6, 0x65726f74736a, 0, 0);
    addapp(3, 0x74756f6241, 0, 0);
    addapp(2, 0x6b636f6c43, 0, 0);
    addapp(5, 0x7265776f50, 0, 0);
    for i in 0..nfiles {
        char^ e = @sbuf[512 + i * 64];
        int l = 0;
        while e[l] != 0 { l += 1; }
        if l > 3 && l < 18 && e[l - 3] == '.' && e[l - 2] == 'j' && e[l - 1] == 'c' && napps < 16 {
            for k in 0..(l - 3) { anames[napps * 16 + k] = e[k]; }
            anames[napps * 16 + l - 3] = 0;
            akind[napps] = 4;
            aidx[napps] = i;
            napps += 1;
        }
    }
}

// one icon: a rounded square in the colour of the app and its first letter; the name under it
void draw_icon(int x, int y, int app, int size) {
    int c = icon_color(app);
    if akind[app] == 5 { c = rgb(220, 70, 70); }
    rrect(x, y, size, size, size / 4, c);
    int ch = anames[app * 16] & 255;
    if ch >= 97 && ch <= 122 { ch = ch - 32; }
    glyph(x + (size - 30) / 2, y + (size - 60) / 2, ch, 3, rgb(255, 255, 255));
}

void label(int mx, int y, int app) {
    int l = 0;
    while anames[app * 16 + l] != 0 && l < 13 { tb[l] = anames[app * 16 + l]; l += 1; }
    tb[l] = 0;
    text(mx - l * 5, y, @tb, 1, rgb(225, 235, 250));
}

int dock_app(int i) { return i; }

void draw_home() {
    wallpaper();
    // the bar at the top: the name on the left, how long it is on on the right
    t8(16 + 0, 12, 0x534f20636972614a, 1, rgb(190, 205, 230));

    int up = Sys::s3_3_c14_c0_2 / 1000000;
    int mm = up / 60;
    int ss = up % 60;
    t8(400 + 0, 12, 0x7075, 1, rgb(190, 205, 230));

    num(430, 12, mm, 1, rgb(190, 205, 230));
    glyph(430 + digits(mm) * 10, 12, 58, 1, rgb(190, 205, 230));
    if ss < 10 { glyph(440 + digits(mm) * 10, 12, 48, 1, rgb(190, 205, 230)); num(450 + digits(mm) * 10, 12, ss, 1, rgb(190, 205, 230)); }
    else { num(440 + digits(mm) * 10, 12, ss, 1, rgb(190, 205, 230)); }
    // the greeting
    t8(28 + 0, 78, 0x534f20636972614a, 3, rgb(255, 255, 255));

    t8(30 + 0, 150, 0x2064657265776f70, 1, rgb(150, 175, 215)); t8(30 + 80, 150, 0x636972614a207962, 1, rgb(150, 175, 215));

    // a card with what the machine is
    rrect(20, 200, 500, 150, 30, rgb(26, 36, 66));
    t8(44 + 0, 218, 0x616d2034364d5241, 1, rgb(150, 175, 215)); t8(44 + 80, 218, 0x656e696863, 1, rgb(150, 175, 215));
    num(44, 252, g_dsec, 1, rgb(235, 242, 255));
    t8(44 + digits(g_dsec) * 10 + 10 + 0, 252, 0x2073726f74636573, 1, rgb(235, 242, 255)); t8(44 + digits(g_dsec) * 10 + 10 + 80, 252, 0x6b73696420666f, 1, rgb(235, 242, 255));
    t8(44 + 0, 286, 0x666f20424d203436, 1, rgb(235, 242, 255)); t8(44 + 80, 286, 0x79726f6d656d20, 1, rgb(235, 242, 255));
    num(44, 320, nfiles, 1, rgb(235, 242, 255));
    t8(44 + digits(nfiles) * 10 + 10 + 0, 320, 0x6e6f2073656c6966, 1, rgb(235, 242, 255)); t8(44 + digits(nfiles) * 10 + 10 + 80, 320, 0x7369642065687420, 1, rgb(235, 242, 255)); t8(44 + digits(nfiles) * 10 + 10 + 160, 320, 0x6b, 1, rgb(235, 242, 255));
    // the power icon and the apps that are packages (.jc)
    for a in 4..napps {
        int k = a - 4;
        int col = k % 4;
        int row = k / 4;
        int cell_x = col * 135;
        draw_icon(cell_x + 23, 390 + row * 160, a, 88);
        label(cell_x + 67, 390 + row * 160 + 98, a);
    }
    if napps <= 6 {
        t8(28 + 0, 600, 0x6120636a2e206f4e, 1, rgb(150, 175, 215)); t8(28 + 80, 600, 0x74206e6f20737070, 1, rgb(150, 175, 215)); t8(28 + 160, 600, 0x206b736964206568, 1, rgb(150, 175, 215)); t8(28 + 240, 600, 0x2e746579, 1, rgb(150, 175, 215));
        t8(28 + 0, 626, 0x6170206120747550, 1, rgb(150, 175, 215)); t8(28 + 80, 626, 0x6e28206567616b63, 1, rgb(150, 175, 215)); t8(28 + 160, 626, 0x2029636a2e656d61, 1, rgb(150, 175, 215)); t8(28 + 240, 626, 0x656874206e69, 1, rgb(150, 175, 215));
        t8(28 + 0, 652, 0x6f207265646c6f66, 1, rgb(150, 175, 215)); t8(28 + 80, 652, 0x7973206568742066, 1, rgb(150, 175, 215)); t8(28 + 160, 652, 0x2f7e203a6d657473, 1, rgb(150, 175, 215)); t8(28 + 240, 652, 0x6f2d636972616a2e, 1, rgb(150, 175, 215)); t8(28 + 320, 652, 0x73, 1, rgb(150, 175, 215));
    }
    // the dock
    rrect(20, scrH - 230, 500, 160, 34, rgb(26, 36, 66));
    for d in 0..4 {
        draw_icon(50 + d * 118, scrH - 214, d, 88);
        label(94 + d * 118, scrH - 214 + 98, d);
