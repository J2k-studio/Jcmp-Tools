#import <stdlib>
#import "zipcore"                       // the zip writer and reader of zipj (tools/zipj): the same source, built with  -I ../zipj
#import "axml"
#import "sign"
#import "der"
#import "runtime"
// apkj: the apk of a J2K program, made without aapt2, ecj, d8, zipalign or apksigner (docs/design/27-apkj.md).
//   apkj zip OUT.zip [-z] NAME=FILE...      a zip file (-z: deflate the files where it makes them smaller)   [step A1]
//   apkj manifest manifest.toml OUT.xml     the binary AndroidManifest.xml of an app (name, id, version, orientation, render)   [step A2]
//   apkj build manifest.toml OUT.apk [-k KEY] NAME=FILE...   a signed apk (v1, ECDSA P-256); classes.dex and resources.arsc are added   [steps A3-A5]
//   apkj key [FILE]                         make the signing key (default ~/.apkj.key) and show its fingerprint
//   apkj selftest                           sign and check some messages
//   apkj --version

String apkj_version() { return "0.2.0"; }

i64 do_zip(String[] a) {
    if a.len < 4 { jerr << "usage: apkj zip OUT.zip [-z] NAME=FILE...\n"; return 2; }
    bool deflate = false;
    zw_start();
    i64 count = 0;
    for i in 3..a.len {
        if a[i] == "-z" { deflate = true; continue; }
        i64 eq = a[i].find("=");
        if eq <= 0 { jerr << "apkj: '" << a[i] << "' is not NAME=FILE\n"; return 2; }
        String name = a[i].slice(0, eq) + "";
        String file = a[i].slice(eq + 1, a[i].len) + "";
        bool ok = false;
        bool^ okp = @ok;
        String data = read_bin(file, okp);
        if !ok { jerr << "apkj: cannot read " << file << "\n"; return 1; }
        zw_add(name, data, false, "");
        count += 1;
    }
    String z = zw_finish();
    switch Fs::write_bytes(a[2] + "", z) {
        Result::Ok(n): { jout << "apkj: " << a[2] << ": " << count << " files, " << z.len << " bytes\n"; }
        Result::Err(e): { jerr << "apkj: cannot write " << a[2] << ": " << e.message << "\n"; return 1; }
    }
    return 0;
}

// the value of  key = "text"  or  key = word  in a manifest.toml ("" when it is not there)
String toml_value(String text, String key) {
    String[] lines = text.split("\n");
    for i in 0..lines.len {
        String ln = lines[i].trim();
        if ln.len == 0 || ln[0] == '#' { continue; }
        i64 eq = ln.find("=");
        if eq <= 0 { continue; }
        if ln.slice(0, eq).trim() != key { continue; }
        String v = ln.slice(eq + 1, ln.len).trim();
        i64 hash = v.find(" #");
        if hash > 0 && v[0] != '"' { v = v.slice(0, hash).trim(); }
        if v.len >= 2 && v[0] == '"' { i64 close = v.slice(1, v.len).find("\""); if close >= 0 { return v.slice(1, 1 + close) + ""; } }
        return v + "";
    }
    return "";
}

// the manifest of an app: the activity is the GL runner (render = "gl") or the terminal runner
String build_manifest(String toml) {
    String name = toml_value(toml, "name");
    String id = toml_value(toml, "id");
    String ver = toml_value(toml, "version");
    String orient = toml_value(toml, "orientation");
    String render = toml_value(toml, "render");
    String controls = toml_value(toml, "controls");
    if name.len == 0 || id.len == 0 || ver.len == 0 { jerr << "apkj: manifest.toml needs name, id and version\n"; return ""; }
    if id.find(".") < 0 { jerr << "apkj: the id in manifest.toml needs a dot (for example com.you.myapp), got: " << id << "\n"; return ""; }
    String[] parts = ver.split(".");
    i64 code = 0;
    if parts.len > 0 { code = parts[0].to_int() * 10000; }
    if parts.len > 1 { code += parts[1].to_int() * 100; }
    if parts.len > 2 { code += parts[2].to_int(); }
    if code < 1 { code = 1; }
    i64 orientation = 0;                                   // 0 landscape
    if orient == "portrait" { orientation = 1; }
    String act = "com.j2k.gamerun.GameActivity";
    if render == "gl" { act = "com.j2k.gamerun.GlGameActivity"; }
    axml_begin();
    axml_open("manifest");
    axml_a_int("versionCode", code);
    axml_a_str("versionName", ver);
    axml_a_plain("package", id);
    axml_commit();
    axml_open("uses-sdk");
    axml_a_int("minSdkVersion", 29);
    axml_a_int("targetSdkVersion", 28);
    axml_commit();
    axml_close("uses-sdk");
    axml_open("uses-permission");
    axml_a_str("name", "android.permission.INTERNET");
    axml_commit();
    axml_close("uses-permission");
    axml_open("application");
    axml_a_ref("theme", 16973831);                        // @android:style/Theme.NoTitleBar.Fullscreen (0x01030007)
    axml_a_str("label", name);
    axml_a_bool("allowBackup", false);
    axml_commit();
    axml_open("meta-data");
    axml_a_str("name", "controls");
    axml_a_bool("value", controls != "false");
    axml_commit();
    axml_close("meta-data");
    axml_open("activity");
    axml_a_str("name", act);
    axml_a_bool("exported", true);
    axml_a_int("screenOrientation", orientation);
    axml_a_hex("configChanges", 4000);                    // 0x0fa0: orientation, screenSize, screenLayout, smallestScreenSize, keyboardHidden, uiMode
    axml_commit();
    axml_open("intent-filter");
    axml_commit();
    axml_open("action");
    axml_a_str("name", "android.intent.action.MAIN");
    axml_commit();
    axml_close("action");
    axml_open("category");
    axml_a_str("name", "android.intent.category.LAUNCHER");
    axml_commit();
    axml_close("category");
    axml_close("intent-filter");
    axml_close("activity");
    axml_close("application");
    axml_close("manifest");
    return axml_end();
}

i64 do_manifest(String[] a) {
    if a.len < 4 { jerr << "usage: apkj manifest manifest.toml OUT.xml\n"; return 2; }
    String toml = "";
    switch Fs::read_text(a[2] + "") {
        Result::Ok(t): { toml = t + ""; }
        Result::Err(e): { jerr << "apkj: cannot read " << a[2] << ": " << e.message << "\n"; return 1; }
    }
    String xml = build_manifest(toml);
    if xml.len == 0 { return 1; }
    switch Fs::write_bytes(a[3] + "", xml) {
        Result::Ok(n): { jout << "apkj: " << a[3] << ": " << xml.len << " bytes\n"; }
        Result::Err(e): { jerr << "apkj: cannot write " << a[3] << ": " << e.message << "\n"; return 1; }
    }
    return 0;
}

// the key file: the 32 bytes of the private key, then the certificate (DER). Made when it is not there.
String kl_cert;
bool key_load(String path, P256^ c, char^ d) {
    bool ok = false;
    String data = read_bin(path, @ok);
    if ok && data.len > 40 {
        for i in 0..32 { d[i] = data[i]; }
        kl_cert = data.slice(32, data.len) + "";
        return true;
    }
    p256_new_key(c, d);
    char serial[8];
    Sys::random((char^)@serial, 8);
    kl_cert = x509_make(c, d, (char^)@serial);
    String out = "";
    for i in 0..32 { out.push(d[i]); }
    out.append(kl_cert);
    switch Fs::write_bytes(path + "", out) {
        Result::Ok(n): { jout << "apkj: new key " << path << " (keep it: an update of an app needs the same key)\n"; }
        Result::Err(e): { jerr << "apkj: cannot write the key file " << path << ": " << e.message << " (give another place with -k FILE)\n"; return false; }
    }
    return true;
}

String default_key_path() {
    String home = ".";
    switch Env::get("HOME") {
        Option::Some(h): { home = h + ""; }
        Option::None: { }
    }
    return home + "/.apkj.key";
}

String empty_arsc() { return d_hex("02000c00280000000000000001001c001c0000000000000000000000000100001c00000000000000"); }

// apkj build manifest.toml OUT.apk [-k KEY] NAME=FILE...   (classes.dex and resources.arsc are added when not given; the files: lib/arm64-v8a/libgame.so, assets/...)
i64 do_build(String[] a) {
    if a.len < 4 { jerr << "usage: apkj build manifest.toml OUT.apk [-k KEYFILE] NAME=FILE...\n"; return 2; }
    String keyfile = default_key_path();
    String toml = "";
    switch Fs::read_text(a[2] + "") {
        Result::Ok(t): { toml = t + ""; }
        Result::Err(e): { jerr << "apkj: cannot read " << a[2] << ": " << e.message << "\n"; return 1; }
    }
    String xml = build_manifest(toml);
    if xml.len == 0 { return 1; }
    String[] names = arr(16);
    String[] datas = arr(16);
    names.push("AndroidManifest.xml"); datas.push(xml);
    bool have_arsc = false;
    bool have_dex = false;
    for i in 4..a.len {
        if a[i] == "-k" && i + 1 < a.len { keyfile = a[i + 1] + ""; i += 1; continue; }
        i64 eq = a[i].find("=");
        if eq <= 0 { jerr << "apkj: '" << a[i] << "' is not NAME=FILE\n"; return 2; }
        String name = a[i].slice(0, eq) + "";
        String file = a[i].slice(eq + 1, a[i].len) + "";
        bool ok = false;
        String data = read_bin(file, @ok);
        if !ok { jerr << "apkj: cannot read " << file << " (for " << name << ")\n"; return 1; }
        if name == "resources.arsc" { have_arsc = true; }
        if name == "classes.dex" { have_dex = true; }
        names.push(name); datas.push(data);
    }
    if !have_dex { names.push("classes.dex"); datas.push(runtime_dex()); }
    if !have_arsc { names.push("resources.arsc"); datas.push(empty_arsc()); }
    P256 c;
    p256_init(@c);
    char d[32];
    if !key_load(keyfile, @c, (char^)@d) { return 1; }
    String cert = kl_cert;
    // MANIFEST.MF and CERT.SF
    String mf = "Manifest-Version: 1.0\r\nCreated-By: apkj\r\n\r\n";
    String sections = "";
    for i in 0..names.len {
        String sec = jar_section(names[i], Base64::encode(sha256_of(datas[i])));
        mf.append(sec);
        sections.append(sec);
    }
    String sf = "Signature-Version: 1.0\r\nCreated-By: apkj\r\nSHA-256-Digest-Manifest: " + Base64::encode(sha256_of(mf)) + "\r\n\r\n";
    for i in 0..names.len {
        String sec = jar_section(names[i], Base64::encode(sha256_of(datas[i])));
        sf.append(jar_section(names[i], Base64::encode(sha256_of(sec))));
    }
    String block = pkcs7_make(@c, (char^)@d, cert, sf);
    zw_start();
    for i in 0..names.len {
        zw_add(names[i], datas[i], false, "");
    }
    zw_add("META-INF/MANIFEST.MF", mf, false, "");
    zw_add("META-INF/CERT.SF", sf, false, "");
    zw_add("META-INF/CERT.EC", block, false, "");
    String z = zw_finish();
    switch Fs::write_bytes(a[3] + "", z) {
        Result::Ok(n): { jout << "apkj: " << a[3] << ": " << (names.len + 3) << " files, " << z.len << " bytes, signed (v1, ECDSA P-256)\n"; }
        Result::Err(e): { jerr << "apkj: cannot write " << a[3] << ": " << e.message << "\n"; return 1; }
    }
    return 0;
}

// apkj key [FILE]: makes the signing key when it is not there, and tells where it is and its fingerprint
i64 do_key(String[] a) {
    String path = default_key_path();
    if a.len > 2 { path = a[2] + ""; }
    P256 c;
    p256_init(@c);
    char d[32];
    if !key_load(path, @c, (char^)@d) { return 1; }
    String fp = tohex_bytes(sha256_of(kl_cert));
    jout << "key: " << path << "\nSHA-256 of the certificate: " << fp << "\n";
    return 0;
}

i64 do_selftest() {
    P256 c;
    p256_init(@c);
    char d[32];
    char qx[32];
    char qy[32];
    char h[32];
    char r[32];
    char s[32];
    p256_new_key(@c, (char^)@d);
    if !p256_public(@c, (char^)@d, (char^)@qx, (char^)@qy) { jerr << "apkj: public key failed\n"; return 1; }
    i64 bad = 0;
    for m in 0..5 {
        char msg[8];
        msg[0] = (char)(65 + m);
        Crypto::sha256((char^)@msg, 1, (char^)@h);
        p256_sign(@c, (char^)@d, (char^)@h, (char^)@r, (char^)@s);
        if !Crypto::ecdsa_verify(256, (char^)@qx, (char^)@qy, (char^)@h, 32, (char^)@r, 32, (char^)@s, 32) { bad += 1; }
        h[0] = (char)(h[0] + 1);
        if Crypto::ecdsa_verify(256, (char^)@qx, (char^)@qy, (char^)@h, 32, (char^)@r, 32, (char^)@s, 32) { bad += 1; }
    }
    if bad == 0 { jout << "selftest ok\n"; } else { jout << "selftest FAILED\n"; }
    return bad;
}

i64 main() {
    String[] a = Env::args();
    if a.len > 1 && (a[1] == "--version" || a[1] == "-V") { jout << "apkj " << apkj_version() << "\n"; return 0; }
    if a.len > 1 && a[1] == "selftest" { return do_selftest(); }
    if a.len > 1 && a[1] == "key" { return do_key(a); }
    if a.len > 1 && a[1] == "build" { return do_build(a); }
    if a.len > 1 && a[1] == "zip" { return do_zip(a); }
    if a.len > 1 && a[1] == "manifest" { return do_manifest(a); }
    jout << "apkj: the apk of a J2K program (made by J2K alone)\n  apkj zip OUT.zip [-z] NAME=FILE...\n";
    if a.len > 1 { return 2; }
    return 0;
}
