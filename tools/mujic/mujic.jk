// mujic: a music player for the terminal. Songs in a folder (~/music), songs fetched from the web, lyrics (synced .lrc) shown while it plays.
//   mujic                the player (a list, the lyrics, the time)       mujic list        the songs
//   mujic catalog        free songs that can be fetched                  mujic get NAME|URL|archive:ID [-n NAME]
//   mujic find WORDS     search the Internet Archive                     mujic lyrics NAME [-q WORDS]   fetch the lyrics (lrclib.net)
// Sound: inside the Jaric app the app plays it; else termux-media-player, mpv, ffplay or mpg123 when one is installed.
#import <stdlib>


int fail(String msg) {
    cerr << "mujic: " << msg << "\n";
    return 1;
}

// ---------------------------------------------------------------- the folder and the songs
String music_dir() {
    switch Env::get("MUJIC_DIR") {
        Option::Some(d): { if d.len > 0 { return d; } }
        Option::None: { }
    }
    String home = "";
    switch Env::get("HOME") {
        Option::Some(h): { home = h; }
        Option::None: { home = "."; }
    }
    // the folder is hidden: ~/.music (an older ~/music is moved there once, so the songs are kept and the phone's gallery does not list them)
    String hidden = Path::join(home, ".music");
    String old = Path::join(home, "music");
    if !Dir::exists(hidden) && Dir::exists(old) { Fs::rename(old, hidden); }
    return hidden;
}

bool is_audio(String name) {
    String l = name.lower();
    return l.ends_with(".mp3") || l.ends_with(".ogg") || l.ends_with(".m4a") || l.ends_with(".flac") || l.ends_with(".wav") || l.ends_with(".opus") || l.ends_with(".aac");
}

String strip_ext(String name) {
    int dot = -1;
    for i in 0..name.len { if name[i] == '.' { dot = i; } }
    if dot <= 0 { return name; }
    return name.slice(0, dot);
}

String[] g_files;                       // the file names in the folder
bool g_files_ready;

// a song of the list is a name in the music folder ("song.mp3", "folder/song.mp3") or, after /scan, a full path ("/storage/emulated/0/Music/song.mp3")
String abs_of(String name) {
    if name.starts_with("/") { return name + ""; }
    return Path::join(music_dir(), name);
}

String song_title(String name) {                          // what the list shows: no folder of a full path, no extension
    if !name.starts_with("/") { return strip_ext(name); }
    int sl = 0 - 1;
    for i in 0..name.len { if name[i] == '/' { sl = i; } }
    return strip_ext(name.slice(sl + 1, name.len));
}

// the songs that /scan added: one full path a line in the file .library of the music folder
String library_file() { return Path::join(music_dir(), ".library"); }

String[] library_read() {
    String[] out = arr(16);
    if !Fs::exists(library_file()) { return out; }
    switch Fs::read_text(library_file()) {
        Result::Ok(t): {
            String[] ls = t.split("\n");
            for i in 0..ls.len { String ln = ls[i].trim(); if ln.len > 1 && ln.starts_with("/") { out.push(ln + ""); } }
        }
        Result::Err(e): { }
    }
    return out;
}

void library_write(String[] lines) {
    String t = "";
    for i in 0..lines.len { t = t + lines[i] + "\n"; }
    Dir::make_all(music_dir());
    Fs::write_text(library_file(), t);
}

void load_files() {
    g_files = arr(16);
    g_files_ready = true;
    String dir = music_dir();
    if !Dir::exists(dir) { return; }
    Result<String[], Error> r = Dir::list(dir);
    if !r.is_ok() { return; }
    String[] names = r.take();
    names.sort();
    for i in 0..names.len {
        if is_audio(names[i]) { g_files.push(names[i] + ""); }
        else if Dir::exists(Path::join(dir, names[i])) {
            // one level of folders: the songs in them are named  folder/song.mp3
            Result<String[], Error> r2 = Dir::list(Path::join(dir, names[i]));
            if r2.is_ok() {
                String[] sub = r2.take();
                sub.sort();
                for k in 0..sub.len { if is_audio(sub[k]) { g_files.push(names[i] + "/" + sub[k]); } }
            }
        }
    }
    String[] lib = library_read();                           // the songs that /scan found, still there
    for i in 0..lib.len { if Fs::exists(lib[i]) { g_files.push(lib[i] + ""); } }
}

// /mv NAME FOLDER: move a song into a folder of the music folder (made when it is not there); FOLDER "." brings it back
String move_song(String what, String folder) {
    int n = find_song(what);
    if n < 0 { return "no song like '" + what + "'"; }
    String file = g_files[n];
    if file.starts_with("/") { return "this song is not in the music folder (it came from /scan): /remove takes it out of the list"; }
    String base = file;
    int slash = -1;
    for i in 0..file.len { if file[i] == '/' { slash = i; } }
    if slash >= 0 { base = file.slice(slash + 1, file.len); }
    if folder.contains("..") || folder.starts_with("/") { return "the folder must be a plain name inside " + music_dir(); }
    String dest_dir = music_dir();
    if folder != "." && folder.len > 0 {
        dest_dir = Path::join(music_dir(), folder);
        Result<int, Error> mk = Dir::make_all(dest_dir);
        if !mk.is_ok() { return "cannot make the folder " + folder; }
    }
    // the files of the song that belong together: sound, lyrics (.lrc, .txt)
    String from_base = Path::join(music_dir(), strip_ext(file));
    String to_base = Path::join(dest_dir, strip_ext(base));
    Result<int, Error> r = Fs::rename(Path::join(music_dir(), file), Path::join(dest_dir, base));
    if !r.is_ok() { return "cannot move " + file; }
    Fs::rename(from_base + ".lrc", to_base + ".lrc");
    Fs::rename(from_base + ".txt", to_base + ".txt");
    g_files_ready = false;
    return "moved " + strip_ext(base) + " to " + folder;
}

// the song for a number, a name or a part of a name; -1 when none
// the real path of a file (a name next to you, a path of the virtual root): "" when there is no such file
String real_file(String name) {
    int fd = Sys::open_read(name.c());
    if fd < 0 { return ""; }
    String link = "/proc/self/fd/" + str(fd);
    char buf[4096];
    int n = Sys::readlink(link.c(), (char^)@buf, 4095);
    Sys::close(fd);
    if n <= 0 { return ""; }
    buf[n] = 0;
    String r = (char^)@buf;
    return r + "";
}

int find_song(String what) {
    if !g_files_ready { load_files(); }
    bool digits = what.len > 0;
    for i in 0..what.len { if what[i] < '0' || what[i] > '9' { digits = false; } }
    if digits {
        int n = what.to_int() - 1;
        if n >= 0 && n < g_files.len { return n; }
    }
    String w = what.lower();
    for i in 0..g_files.len { if song_title(g_files[i]).lower() == w { return i; } }
    for i in 0..g_files.len { if g_files[i].lower().contains(w) { return i; } }
    return -1;
}

// ---------------------------------------------------------------- text helpers
String url_encode(String s) {
    String r = "";
    String hex = "0123456789ABCDEF";
    for i in 0..s.len {
        int c = s[i] & 255;
        bool plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~';
        if plain { r.push((char)c); }
        else { r.push('%'); r.push(hex[c >> 4]); r.push(hex[c & 15]); }
    }
    return r;
}

int hexv(int c) {
    if c >= '0' && c <= '9' { return c - '0'; }
    if c >= 'a' && c <= 'f' { return c - 'a' + 10; }
    if c >= 'A' && c <= 'F' { return c - 'A' + 10; }
    return -1;
}

String url_decode(String s) {
    String r = "";
    int i = 0;
    while i < s.len {
        if s[i] == '%' && i + 2 < s.len + 0 && hexv(s[i + 1] & 255) >= 0 && hexv(s[i + 2] & 255) >= 0 {
            r.push((char)(hexv(s[i + 1] & 255) * 16 + hexv(s[i + 2] & 255)));
            i += 3;
        } else { r.push(s[i]); i += 1; }
    }
    return r;
}

// a name that is safe as a file name
String safe_file(String s) {
    String r = "";
    for i in 0..s.len {
        int c = s[i] & 255;
        if c == '/' || c == '\\' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' || c == '|' || c < 32 { r.push('_'); } else { r.push((char)c); }
    }
    return r.trim();
}

// the width of a letter on the screen: 0 for the marks of Thai that sit on a letter, 2 for the wide ones
int cp_width(int cp) {
    if cp == 3633 || (cp >= 3636 && cp <= 3642) || (cp >= 3655 && cp <= 3662) { return 0; }
    if (cp >= 4352 && cp <= 4447) || (cp >= 11904 && cp <= 42191) || (cp >= 44032 && cp <= 55203) || (cp >= 65280 && cp <= 65376) || cp >= 127744 { return 2; }
    return 1;
}

// the text cut so that it takes at most w places on the screen (UTF-8 is not cut in the middle of a letter)
String fit(String s, int w) {
    String r = "";
    int i = 0;
    int used = 0;
    while i < s.len {
        int b = s[i] & 255;
        int n = 1;
        int cp = b;
        if b >= 240 { n = 4; cp = ((b & 7) << 18) | ((s[i + 1] & 63) << 12) | ((s[i + 2] & 63) << 6) | (s[i + 3] & 63); }
        else if b >= 224 { n = 3; cp = ((b & 15) << 12) | ((s[i + 1] & 63) << 6) | (s[i + 2] & 63); }
        else if b >= 192 { n = 2; cp = ((b & 31) << 6) | (s[i + 1] & 63); }
        if i + n > s.len { break; }
        int cw = cp_width(cp);
        if used + cw > w { break; }
        for k in 0..n { r.push(s[i + k]); }
        used += cw;
        i += n;
    }
    return r;
}

int shown_width(String s) {
    int used = 0;
    int i = 0;
    while i < s.len {
        int b = s[i] & 255;
        int n = 1;
        int cp = b;
        if b >= 240 { n = 4; cp = ((b & 7) << 18) | ((s[i + 1] & 63) << 12) | ((s[i + 2] & 63) << 6) | (s[i + 3] & 63); }
        else if b >= 224 { n = 3; cp = ((b & 15) << 12) | ((s[i + 1] & 63) << 6) | (s[i + 2] & 63); }
        else if b >= 192 { n = 2; cp = ((b & 31) << 6) | (s[i + 1] & 63); }
        used += cp_width(cp);
        i += n;
    }
    return used;
}

String pad(String s, int w) {
    String r = fit(s, w);
    int used = shown_width(r);
    while used < w { r.push(' '); used += 1; }
    return r;
}

String two(int n) {
    String r = str(n);
    if r.len < 2 { r = "0" + r; }
    return r;
}

String clock(int ms) {
    if ms < 0 { ms = 0; }
    int s = ms / 1000;
    return two(s / 60) + ":" + two(s % 60);
}

// the document of a JSON text; an empty array when the text is not JSON
JsonDoc json_open(String text) {
    switch Json::parse(text) {
        Result::Ok(d): { return d; }
        Result::Err(e): { }
    }
    return Json::parse("[]").take();
}

// ---------------------------------------------------------------- lyrics
int[] lt;                                // the time of a line (ms), -1 when the lyrics have no times
String[] ltx;
int lcount;
bool lsynced;
String ltitle;                           // the song the lyrics belong to

void lyrics_clear() {
    lt = arr(64);
    ltx = arr(64);
    lcount = 0;
    lsynced = false;
}

void lyrics_add(int t, String text) {
    lt.push(t);
    ltx.push(text);
    lcount += 1;
}

// the text of a .lrc ([01:23.45]line, several times in front of one line are fine; tags like [ar:..] are skipped) or of a plain text
void lyrics_parse(String text) {
    lyrics_clear();
    String[] lines = text.replace("\r", "").split("\n");
    for i in 0..lines.len {
        String ln = lines[i];
        int p = 0;
        int[] stamps = arr(4);
        while p < ln.len && ln[p] == '[' {
            int close = -1;
            for k in p..ln.len { if ln[k] == ']' { close = k; break; } }
            if close < 0 { break; }
            String tag = ln.slice(p + 1, close);
            int colon = -1;
            for k in 0..tag.len { if tag[k] == ':' { colon = k; break; } }
            bool numeric = colon > 0;
            for k in 0..colon { if tag[k] < '0' || tag[k] > '9' { numeric = false; } }
            if !numeric {
                if stamps.len == 0 { p = close + 1; continue; }        // [ar:Name] and the like at the start
                break;
            }
            int mm = tag.slice(0, colon).to_int();
            String rest = tag.slice(colon + 1, tag.len);
            int dot = -1;
            for k in 0..rest.len { if rest[k] == '.' || rest[k] == ':' { dot = k; break; } }
            int ss = 0;
            int ms = 0;
            if dot < 0 { ss = rest.to_int(); }
            else {
                ss = rest.slice(0, dot).to_int();
                String frac = rest.slice(dot + 1, rest.len);
                if frac.len == 1 { ms = frac.to_int() * 100; }
                else if frac.len == 2 { ms = frac.to_int() * 10; }
                else if frac.len >= 3 { ms = frac.slice(0, 3).to_int(); }
            }
            stamps.push((mm * 60 + ss) * 1000 + ms);
            p = close + 1;
        }
        String body = ln.slice(p, ln.len).trim();
        if stamps.len > 0 {
            lsynced = true;
            for k in 0..stamps.len { lyrics_add(stamps[k], body + ""); }
        } else if p == 0 || body.len > 0 {
            lyrics_add(-1, ln + "");
        }
    }
    if lsynced {                                                   // in the order of time (a line with two stamps)
        for a in 1..lcount {
            int t = lt[a];
            String x = ltx[a];
            int b = a - 1;
            while b >= 0 && lt[b] > t { lt[b + 1] = lt[b]; ltx[b + 1] = ltx[b]; b -= 1; }
            lt[b + 1] = t;
            ltx[b + 1] = x;
        }
    }
}

bool lyrics_load_for(String file) {
    lyrics_clear();
    String base = strip_ext(abs_of(file));
    for i in 0..2 {
        String path = base + ".lrc";
        if i == 1 { path = base + ".txt"; }
        if Fs::exists(path) {
            Result<String, Error> r = Fs::read_text(path);
            if r.is_ok() { lyrics_parse(r.take()); return true; }
        }
    }
    return false;
}

// the line to show at the time t: the last one that has started; -1 before the first
int lyrics_at(int t) {
    if !lsynced { return -1; }
    int cur = -1;
    for i in 0..lcount { if lt[i] >= 0 && lt[i] <= t { cur = i; } }
    return cur;
}

// fetch the lyrics of a song from lrclib.net and keep them next to the song; the text of the answer is searched for the best one
int fetch_lyrics(String file, String query) {
    String q = query;
    if q.len == 0 { q = strip_ext(file).replace(" - ", " ").replace("_", " "); }
    cout << "searching lyrics for: " << q << "\n";
    String body = "";
    switch Net::http.try_get("https://lrclib.net/api/search?q=" + url_encode(q)) {
        Result::Ok(b): { body = b; }
        Result::Err(e): { return fail("lrclib.net: " + e.message); }
    }
    JsonDoc doc = json_open(body);
    int root = doc.root();
    int n = doc.len(root);
    int best = -1;
    int plain = -1;
    for i in 0..n {
        int item = doc.at(root, i);
        int sy = doc.get(item, "syncedLyrics");
        int pl = doc.get(item, "plainLyrics");
        if best < 0 && sy >= 0 && !doc.is_null(sy) {
            String st = doc.text(sy);
            if st.len > 0 { best = i; }
        }
        if plain < 0 && pl >= 0 && !doc.is_null(pl) {
            String pt = doc.text(pl);
            if pt.len > 0 { plain = i; }
        }
    }
    String base = strip_ext(abs_of(file));
    if best >= 0 {
        int item = doc.at(root, best);
        Fs::write_text(base + ".lrc", doc.text(doc.get(item, "syncedLyrics")));
        cout << "saved " << strip_ext(file) << ".lrc  (" << doc.text(doc.get(item, "artistName")) << " - " << doc.text(doc.get(item, "trackName")) << ", with times)\n";
        return 0;
    }
    if plain >= 0 {
        int item = doc.at(root, plain);
        Fs::write_text(base + ".txt", doc.text(doc.get(item, "plainLyrics")));
        cout << "saved " << strip_ext(file) << ".txt  (" << doc.text(doc.get(item, "artistName")) << " - " << doc.text(doc.get(item, "trackName")) << ", without times)\n";
        return 0;
    }
    return fail("no lyrics found; try  mujic lyrics NAME -q \"artist title\"");
}

// ---------------------------------------------------------------- fetching songs
// free songs (Kevin MacLeod, incompetech.com, CC BY 4.0: say "Music by Kevin MacLeod (incompetech.com), CC BY 4.0")
String[] cat_id;
String[] cat_title;
bool cat_ready;
void catalog_init() {
    if cat_ready { return; }
    cat_ready = true;
    cat_id = arr(8);
    cat_title = arr(8);
    String[] t = arr(8);
    t.push("Sneaky Snitch"); t.push("Monkeys Spinning Monkeys"); t.push("Carefree"); t.push("Fluffing a Duck");
    t.push("Wallpaper"); t.push("Pixelland"); t.push("Local Forecast - Elevator"); t.push("Scheming Weasel faster");
    for i in 0..t.len {
        cat_title.push(t[i] + "");
        cat_id.push(t[i].lower().replace(" - ", "-").replace(" ", "-"));
    }
}

int do_catalog() {
    catalog_init();
    cout << "Free songs (Kevin MacLeod, CC BY 4.0). Fetch one:  mujic get NAME\n";
    for i in 0..cat_id.len { cout << "  " << cat_id[i] << "   (" << cat_title[i] << ")\n"; }
    cout << "Credit when you share: Music by Kevin MacLeod (incompetech.com), licensed under CC BY 4.0.\n";
    return 0;
}

int download_to(String url, String name) {
    String dir = music_dir();
    if !Dir::exists(dir) { Dir::make_all(dir); }
    String to = Path::join(dir, name);
    cout << "fetching " << name << " ...\n";
    switch Net::http.try_download(url, to, 1) {
        Result::Ok(n): { }
        Result::Err(e): { Fs::remove(to); return fail(e.message); }
    }
    cout << "saved " << to << "\n";
    return 0;
}

// addresses that only a program such as yt-dlp can turn into a sound file
bool is_video_site(String u) {
    String l = u.lower();
    return l.contains("youtube.com/") || l.contains("youtu.be/") || l.contains("tiktok.com/") || l.contains("soundcloud.com/") || l.contains("music.youtube.com/");
}

// yt-dlp is the owner's own program (pip install yt-dlp); use it only for what you may download
int ytdlp_get(String url, String name) {
    String[] v = arr(1);
    v.push("--version");
    if !Proc::run("yt-dlp", v).is_ok() { return fail("yt-dlp is not installed  (pip install yt-dlp);  use it only for songs you may download"); }
    Dir::make_all(music_dir());
    String out = Path::join(music_dir(), "%(title)s.%(ext)s");
    if name.len > 0 { out = Path::join(music_dir(), name + ".%(ext)s"); }
    String[] a = arr(8);
    a.push("-f"); a.push("bestaudio[ext=m4a]/bestaudio");
    a.push("--no-playlist"); a.push("-o"); a.push(out); a.push(url);
    Result<int, Error> r = Proc::run("yt-dlp", a);
    if !r.is_ok() { return fail("yt-dlp could not run"); }
    if r.take() != 0 { return 1; }
    return 0;
}

// /import PATH: copy a song, or the songs of a folder, into the music folder
int do_import(String path) {
    Dir::make_all(music_dir());
    if Dir::exists(path) {
        Result<String[], Error> r = Dir::list(path);
        if !r.is_ok() { return fail("cannot read " + path); }
        String[] names = r.take();
        int n = 0;
        for i in 0..names.len {
            if is_audio(names[i]) {
                String[] a = arr(3);
                a.push(Path::join(path, names[i])); a.push(music_dir() + "/");
                Proc::run("cp", a);
                n += 1;
            }
        }
        cout << "mujic: " << n << " songs copied to " << music_dir() << "\n";
        return 0;
    }
    if !Fs::exists(path) || !is_audio(path) { return fail("not a song or a folder: " + path); }
    String[] a = arr(3);
    a.push(path); a.push(music_dir() + "/");
    Proc::run("cp", a);
    cout << "mujic: copied " << Path::name(path) << " to " << music_dir() << "\n";
    return 0;
}

int do_get(String[] a) {
    String what = "";
    String name = "";
    int i = 2;
    while i < a.len {
        if a[i] == "-n" && i + 1 < a.len { name = a[i + 1] + ""; i += 2; }
        else { what = a[i] + ""; i += 1; }
    }
    if what.len == 0 { return fail("usage: mujic get NAME|URL|archive:ID [-n NAME]   (mujic catalog lists names)"); }
    catalog_init();
    for k in 0..cat_id.len {
        if cat_id[k] == what.lower() {
            String file = name;
            if name.len == 0 { file = "Kevin MacLeod - " + cat_title[k]; }
            if !is_audio(file) { file = file + ".mp3"; }
            return download_to("https://incompetech.com/music/royalty-free/mp3-royaltyfree/" + url_encode(cat_title[k]) + ".mp3", safe_file(file));
        }
    }
    if what.starts_with("archive:") {
        String id = what.slice(8, what.len);
        String body = "";
        switch Net::http.try_get("https://archive.org/metadata/" + url_encode(id)) {
            Result::Ok(b): { body = b; }
            Result::Err(e): { return fail(e.message); }
        }
        JsonDoc doc = json_open(body);
        int files = doc.get(doc.root(), "files");
        if files < 0 { return fail("no such item: " + id); }
        for k in 0..doc.len(files) {
            int f = doc.at(files, k);
            String fname = doc.text(doc.get(f, "name"));
            String lname = fname.lower();
            if lname.ends_with(".mp3") || lname.ends_with(".ogg") {
                String to = name;
                if name.len == 0 { to = fname; }
                if !is_audio(to) { to = to + fname.slice(fname.len - 4, fname.len); }
                return download_to("https://archive.org/download/" + url_encode(id) + "/" + url_encode(fname), safe_file(to));
            }
        }
        return fail("the item has no mp3 or ogg file");
    }
    if is_video_site(what) { return ytdlp_get(what, name); }
    if what.starts_with("http://") || what.starts_with("https://") {
        String last = what;
        int q = -1;
        for k in 0..last.len { if last[k] == '?' { q = k; break; } }
        if q >= 0 { last = last.slice(0, q); }
        String file = name;
        if name.len == 0 { file = url_decode(Path::name(last)); }
        if file.len == 0 { file = "song.mp3"; }
        if !is_audio(file) { file = file + ".mp3"; }
        return download_to(what, safe_file(file));
    }
    return fail("'" + what + "' is not in the catalog, an address, or archive:ID");
}

int do_find(String[] a) {
    String words = "";
    for i in 2..a.len { if words.len > 0 { words = words + " "; } words = words + a[i]; }
    if words.len == 0 { return fail("usage: mujic find WORDS"); }
    String q = "(" + words + ") AND mediatype:audio";
    String body = "";
    switch Net::http.try_get("https://archive.org/advancedsearch.php?q=" + url_encode(q) + "&fl%5B%5D=identifier&fl%5B%5D=title&rows=15&output=json") {
        Result::Ok(b): { body = b; }
        Result::Err(e): { return fail(e.message); }
    }
    JsonDoc doc = json_open(body);
    int docs = doc.get(doc.get(doc.root(), "response"), "docs");
    if docs < 0 || doc.len(docs) == 0 { cout << "nothing found\n"; return 0; }
    for k in 0..doc.len(docs) {
        int d = doc.at(docs, k);
        cout << "  archive:" << doc.text(doc.get(d, "identifier")) << "   " << doc.text(doc.get(d, "title")) << "\n";
    }
    cout << "Fetch:  mujic get archive:ID   (check the licence of the item on archive.org first)\n";
    return 0;
}

// ---------------------------------------------------------------- the sound
int g_backend;                          // 0 none, 1 the Jaric app, 2 termux-media-player, 3 a program started here
int g_pid;
String g_player;
bool g_state_known;
int g_state;                            // 0 stopped, 1 playing, 2 paused
int g_pos;                              // ms at g_pos_at
int g_pos_at;
int g_len;                              // ms, 0 when unknown
String g_msg;
bool g_shuffle;
int g_repeat;                           // 0 off, 1 all, 2 one
int g_volume;                     // percent (the app)
String g_filter;                        // only the songs that contain these letters
int g_seed;

bool have_program(String name) {
    String path = "";
    switch Env::get("PATH") {
        Option::Some(p): { path = p; }
        Option::None: { path = "/usr/bin:/bin"; }
    }
    String[] dirs = path.split(":");
    for i in 0..dirs.len { if Fs::exists(Path::join(dirs[i], name)) { return true; } }
    return false;
}

void choose_backend() {
    g_backend = 0;
    switch Env::get("JARIC") {
        Option::Some(v): { g_backend = 1; return; }
        Option::None: { }
    }
    if have_program("termux-media-player") { g_backend = 2; return; }
    String[] progs = arr(4);
    progs.push("mpv"); progs.push("ffplay"); progs.push("mpg123");
    for i in 0..progs.len { if have_program(progs[i]) { g_backend = 3; g_player = progs[i] + ""; return; } }
}

void osc_audio(String cmd) {
    cout << "\e]7777;audio;" << cmd << "\a";
}

int now() { return Time::now_ms(); }

void stop_child() {
    if g_pid > 0 {
        Sys::kill(g_pid, 9);
        int st = 0;
        Sys::wait(g_pid, @st);
        g_pid = 0;
    }
}

void snd_play(String path) {
    g_state = 1; g_pos = 0; g_pos_at = now(); g_len = 0; g_msg = "";
    if g_backend == 1 { osc_audio("play;" + path); osc_audio("pos"); }
    else if g_backend == 2 {
        String[] a = arr(2);
        a.push("play"); a.push(path);
        Proc::run("termux-media-player", a);
    } else if g_backend == 3 {
        stop_child();
        String[] a = arr(8);
        if g_player == "mpv" { a.push("--no-video"); a.push("--really-quiet"); a.push("--no-input-default-bindings"); a.push("--input-terminal=no"); }
        else if g_player == "ffplay" { a.push("-nodisp"); a.push("-autoexit"); a.push("-nostdin"); a.push("-loglevel"); a.push("quiet"); }
        else { a.push("-q"); }
        a.push(path);
        g_pid = Proc::launch(g_player, a, -1);
        if g_pid < 0 { g_pid = 0; g_state = 0; g_msg = "cannot start " + g_player; }
    } else { g_state = 0; g_msg = "no way to play sound here (install mpv, ffplay or mpg123; the Jaric app plays by itself)"; }
}

void snd_pause() {
    if g_state == 1 {
        g_pos = g_pos + (now() - g_pos_at); g_pos_at = now(); g_state = 2;
        if g_backend == 1 { osc_audio("pause"); }
        else if g_backend == 2 { String[] a = arr(1); a.push("pause"); Proc::run("termux-media-player", a); }
        else if g_backend == 3 && g_pid > 0 { Sys::kill(g_pid, 19); }
    } else if g_state == 2 {
        g_pos_at = now(); g_state = 1;
        if g_backend == 1 { osc_audio("resume"); }
        else if g_backend == 2 { String[] a = arr(1); a.push("play"); Proc::run("termux-media-player", a); }
        else if g_backend == 3 && g_pid > 0 { Sys::kill(g_pid, 18); }
    }
}

void snd_stop() {
    g_state = 0;
    if g_backend == 1 { osc_audio("stop"); }
    else if g_backend == 2 { String[] a = arr(1); a.push("stop"); Proc::run("termux-media-player", a); }
    else if g_backend == 3 { stop_child(); }
}

void snd_volume(int delta) {
    g_volume += delta;
    if g_volume < 0 { g_volume = 0; }
    if g_volume > 100 { g_volume = 100; }
    if g_backend == 1 { osc_audio("volume;" + str(g_volume)); }
    g_msg = "volume " + str(g_volume) + "%";
    if g_backend != 1 { g_msg = g_msg + " (only in the Jaric app; use the phone's volume keys)"; }
}

void snd_seek(int delta) {
    if g_backend != 1 || g_state == 0 { return; }          // only the app can jump (the other players are started with a fixed way)
    int p = g_pos + delta;
    if g_state == 1 { p += now() - g_pos_at; }
    if p < 0 { p = 0; }
    if g_len > 0 && p > g_len - 500 { p = g_len - 500; }
    g_pos = p; g_pos_at = now();
    osc_audio("seek;" + str(p));
}

int cur_pos() {
    if g_state == 1 { return g_pos + (now() - g_pos_at); }
    return g_pos;
}

// asks the player where it is (the app answers on the input; termux-media-player on its output)
void snd_poll() {
    if g_backend == 1 { osc_audio("pos"); }
    else if g_backend == 2 && g_state != 0 {
        String[] a = arr(1);
        a.push("info");
        Result<String, Error> r = Proc::output("termux-media-player", a);
        if r.is_ok() {
            String t = r.take();
            if t.contains("Stopped") || t.contains("No track") { if g_pos > 0 || now() - g_pos_at > 3000 { g_state = 0; } }
            int at = -1;
            String key = "Current Position: ";
            for i in 0..t.len { if t.slice(i, i + key.len) == key { at = i + key.len; break; } }
            if at >= 0 {
                String[] tl = t.slice(at, t.len).split("\n");
                String[] two_parts = tl[0].split(" / ");
                if two_parts.len == 2 {
                    String[] c = two_parts[0].split(":");
                    String[] d = two_parts[1].split(":");
                    if c.len == 2 && d.len == 2 {
                        g_pos = (c[0].to_int() * 60 + c[1].to_int()) * 1000; g_pos_at = now();
                        g_len = (d[0].to_int() * 60 + d[1].to_int()) * 1000;
                    }
                }
            }
        }
    } else if g_backend == 3 && g_pid > 0 && g_state == 1 {
        int st = 0;
        int done = Sys::call(260, g_pid, (int)@st, 1, 0, 0, 0);        // wait4 with WNOHANG: the program has ended
        if done == g_pid { g_pid = 0; g_state = 0; }
    }
}

// ---------------------------------------------------------------- the terminal
char g_tio[64];
bool g_raw;

void raw_on() {
    if g_raw || Sys::isatty(0) != 0 { return; }
    Sys::call(29, 0, 21505, (int)@g_tio, 0, 0, 0);
    char r[64];
    for i in 0..64 { r[i] = g_tio[i]; }
    r[12] = r[12] & 244;                                          // no signals, no line editing, no echo
    Sys::call(29, 0, 21506, (int)@r, 0, 0, 0);
    g_raw = true;
}

void raw_off() {
    if !g_raw { return; }
    Sys::call(29, 0, 21506, (int)@g_tio, 0, 0, 0);
    g_raw = false;
}

int read_byte(int wait_ms) {
    if !Input::ready(wait_ms) { return -1; }
    char b[2];
    int n = Sys::read(0, @b, 1);
    if n <= 0 { return -9; }
    return b[0] & 255;
}

// one event: a key code (a letter is its code, 13 Enter, 27 Esc, 257 up 258 down 259 right 260 left, 3 Ctrl-C), -1 nothing came, -9 the input ended.
// A message of the app (ESC ] 7777 ; pos ; ms ; state ; length BEL) is taken here and gives -1.
String g_media;                         // "prev" / "pause" / "next" from the notification, done in the loop

int next_event(int wait_ms) {
    int c = read_byte(wait_ms);
    if c >= 194 && c < 248 {                                       // a letter that is not ASCII (Thai ...): the code point + 100000
        int need = 1;
        int cp = c & 31;
        if c >= 240 { need = 3; cp = c & 7; } else if c >= 224 { need = 2; cp = c & 15; }
        for k in 0..need {
            int cb = read_byte(30);
            if cb < 0 { return -1; }
            cp = (cp << 6) | (cb & 63);
        }
        return 100000 + cp;
    }
    if c != 27 { return c; }
    int d = read_byte(30);
    if d < 0 { return 27; }
    if d == '[' || d == 'O' {
        int e = read_byte(30);
        if e == 'A' { return 257; }
        if e == 'B' { return 258; }
        if e == 'C' { return 259; }
        if e == 'D' { return 260; }
        if e == 'H' { return 261; }
        if e == 'F' { return 262; }
        int num = 0;
        while e >= '0' && e <= '9' || e == ';' { if e >= '0' && e <= '9' { num = num * 10 + (e - '0'); } e = read_byte(30); }
        if e == '~' && num == 3 { return 263; }                           // Delete
        if e == '~' && num == 1 { return 261; }
        if e == '~' && num == 4 { return 262; }
        return -1;
    }
    if d == ']' {
        String m = "";
        int e = read_byte(60);
        while e >= 0 && e != 7 && e != 27 { m.push((char)e); e = read_byte(60); }
        if e == 27 { read_byte(30); }
        String[] p = m.split(";");
        if p.len >= 5 && p[0] == "7777" && p[1] == "pos" {
            int st = p[3].to_int();
            int len = p[4].to_int();
            g_pos = p[2].to_int(); g_pos_at = now(); g_len = len;
            if st == 0 && g_state == 1 && now() - g_pos_at >= 0 { g_state = 0; } else if st == 1 { g_state = 1; } else if st == 2 { g_state = 2; }
        } else if p.len >= 3 && p[0] == "7777" && p[1] == "media" { g_media = p[2] + "";          // a button of the notification of the app: prev, pause, next
        } else if p.len >= 3 && p[0] == "7777" && p[1] == "audio-error" { g_msg = p[2] + ""; g_state = 0; }
        return -1;
    }
    return -1;
}

// ---------------------------------------------------------------- the player: a screen with a typing box, menus and pickers (like the chat of Claude Code)
int g_sel;                              // the song under the cursor
int g_play;                             // the song that plays (-1: none)
bool g_quit;
int g_view;                             // 0 the songs, 1 the lyrics, 2 the output of !command

// the song after the current one (shuffle, repeat); -1 when the list ends
int next_song(int dir) {
    int n = g_files.len;
    if n == 0 { return -1; }
    if g_repeat == 2 && g_play >= 0 { return g_play; }
    if g_shuffle && n > 1 {
        g_seed = g_seed * 1103515245 + 12345 + now();
        int k = (g_seed >> 8) % n;
        if k < 0 { k = 0 - k; }
        if k == g_play { k = (k + 1) % n; }
        return k;
    }
    int k = g_play + dir;
    if k >= n || k < 0 {
        if g_repeat == 1 { return (k + n) % n; }
        return -1;
    }
    return k;
}

void play_index(int n) {
    if n < 0 || n >= g_files.len { return; }
    g_play = n;
    g_sel = n;
    lyrics_load_for(g_files[n]);
    ltitle = song_title(g_files[n]);
    snd_play(abs_of(g_files[n]));
}

String sgr(String code, String text) { return "\e[" + code + "m" + text + "\e[0m"; }

// ---- the commands (the menu that opens when the line starts with /)
String[] cmd_name;
String[] cmd_help;
bool cmd_ready;
void cmd_init() {
    if cmd_ready { return; }
    cmd_ready = true;
    cmd_name = arr(40);
    cmd_help = arr(40);
    cmd_name.push("play"); cmd_help.push("choose a song and play it  (/play NAME)");
    cmd_name.push("pause"); cmd_help.push("pause or go on");
    cmd_name.push("next"); cmd_help.push("the next song");
    cmd_name.push("prev"); cmd_help.push("the song before");
    cmd_name.push("stop"); cmd_help.push("stop the sound");
    cmd_name.push("queue"); cmd_help.push("show the songs");
    cmd_name.push("lyrics"); cmd_help.push("show the lyrics  (/lyrics get fetches them from the web)");
    cmd_name.push("remove"); cmd_help.push("take a song out of the list (the file stays; -f deletes the file):  /remove NAME");
    cmd_name.push("scan"); cmd_help.push("find songs everywhere (home and the storage of the phone), at least SECONDS long: /scan -s 60  [PATH ...]");
    cmd_name.push("dir"); cmd_help.push("browse folders and play a song from any folder  (/dir PATH)");
    cmd_name.push("cd"); cmd_help.push("go to a folder  (/cd PATH;  ~ :/ f: 0: r: work)");
    cmd_name.push("pwd"); cmd_help.push("the folder you are in;  !command runs a shell command there");
    cmd_name.push("get"); cmd_help.push("fetch a song: choose from the catalog, or give a name, an address, archive:ID (a YouTube / TikTok address needs yt-dlp)");
    cmd_name.push("find"); cmd_help.push("search the Internet Archive  (/find words)");
    cmd_name.push("import"); cmd_help.push("copy a song or a folder into the music folder  (/import PATH)");
    cmd_name.push("mv"); cmd_help.push("move a song into a folder  (/mv NAME FOLDER;  FOLDER . brings it back)");
    cmd_name.push("shuffle"); cmd_help.push("shuffle on / off");
    cmd_name.push("repeat"); cmd_help.push("repeat: off, all, one");
    cmd_name.push("volume"); cmd_help.push("the volume  (/volume 80)  in the Jaric app");
    cmd_name.push("seek"); cmd_help.push("jump  (/seek +10  /seek -10  /seek 1:30)  in the Jaric app");
    cmd_name.push("help"); cmd_help.push("the keys and the commands");
    cmd_name.push("quit"); cmd_help.push("leave  (Esc on an empty line, Ctrl-C)");
}

// ---- the typing box
String g_input;
int g_cur;                              // byte index in g_input
String[] g_hist;
int g_hist_i;
int g_menu_sel;
String g_note;                          // one line under the panel: what happened

// ---- a picker: a list to choose from (arrows, type to narrow, Enter, Esc)
bool g_pk_on;
int g_pk_kind;                          // 1 songs, 2 catalog, 3 archive results, 4 folders, 5 songs found by /scan
String g_pk_title;
String[] g_pk_show;
String[] g_pk_val;
String g_pk_filter;
int g_pk_sel;

void pk_open(int kind, String title) {
    g_pk_on = true;
    g_pk_kind = kind;
    g_pk_title = title;
    g_pk_show = arr(16);
    g_pk_val = arr(16);
    g_pk_filter = "";
    g_pk_sel = 0;
}

bool pk_match(int i) {
    if g_pk_filter.len == 0 { return true; }
    return g_pk_show[i].lower().contains(g_pk_filter.lower());
}

// the index (in the picker's list) of the k-th item that matches the filter; -1
int pk_nth(int k) {
    int seen = 0;
    for i in 0..g_pk_show.len {
        if pk_match(i) {
            if seen == k { return i; }
            seen += 1;
        }
    }
    return 0 - 1;
}

int pk_count() {
    int c = 0;
    for i in 0..g_pk_show.len { if pk_match(i) { c += 1; } }
    return c;
}

// ---- the folders and the shell: mujic is a small terminal (/dir /cd /pwd, !command, a song by its path)
String g_cwd;                           // the folder that  /dir  shows and  !command  runs in
String[] g_out;                         // the lines the last  !command  printed (view 3 of Tab)

// a path as the user types it: ~ and :/ are home, f: 0: r: are the drives, a relative path starts in g_cwd
String expand_path(String p) {
    String home = "/";
    switch Env::get("HOME") { Option::Some(v): { home = v; } Option::None: { } }
    String q = p.trim();
    if q == "~" || q == ":/" || q == ":" { return home + ""; }
    if q.starts_with("~/") { return Path::join(home, q.slice(2, q.len)); }
    if q.starts_with(":/") { return Path::join(home, q.slice(2, q.len)); }
    if q.starts_with("f:") { return Path::join(home, q.slice(2, q.len)); }
    if q.starts_with("0:") {
        String sd = "/storage/emulated/0";
        if !Dir::exists(sd) { sd = "/sdcard"; }
        return Path::join(sd, q.slice(2, q.len));
    }
    if q.starts_with("r:") { return "/" + q.slice(2, q.len); }
    if q.starts_with("/") { return q + ""; }
    return Path::join(g_cwd, q);
}

// the real folder of a path with .. and . taken out (cd and the picker use it)
String clean_path(String p) {
    String[] parts = p.split("/");
    String[] keep = arr(16);
    for i in 0..parts.len {
        if parts[i].len == 0 || parts[i] == "." { continue; }
        if parts[i] == ".." { if keep.len > 0 { keep.pop(); } continue; }
        keep.push(parts[i] + "");
    }
    String out = "";
    for i in 0..keep.len { out = out + "/" + keep[i]; }
    if out.len == 0 { return "/"; }
    return out;
}

void play_path(String full) {
    g_play = 0 - 1;
    lyrics_clear();
    String base = full;
    int sl = 0 - 1;
    for i in 0..full.len { if full[i] == '/' { sl = i; } }
    if sl >= 0 { base = full.slice(sl + 1, full.len); }
    ltitle = strip_ext(base);
    snd_play(full);
    g_note = "playing " + ltitle + "   (" + full + ")";
}

void dir_picker(String dir) {
    g_cwd = clean_path(dir);
    pk_open(4, g_cwd);
    g_pk_show.push(".."); g_pk_val.push("..");
    switch Dir::list(g_cwd) {
        Result::Ok(names): {
            names.sort();
            for i in 0..names.len {
                if names[i].len > 0 && names[i][0] == '.' { continue; }
                if Dir::exists(Path::join(g_cwd, names[i])) { g_pk_show.push(names[i] + "/"); g_pk_val.push(names[i] + "/"); }
            }
            for i in 0..names.len {
                String full = Path::join(g_cwd, names[i]);
                bool folder = Dir::exists(full);
                if is_audio(names[i]) && !folder { g_pk_show.push(names[i] + ""); g_pk_val.push(names[i] + ""); }
            }
        }
        Result::Err(e): { g_note = "cannot read " + g_cwd; g_pk_on = false; }
    }
    if g_pk_show.len > 1 { g_pk_sel = 1; }                    // the first real entry; ".." is one up
}

// !command: run it with the shell in g_cwd, keep the lines to show (jsh when it is there, so drives like 0:/ work)
void shell_line(String cmdline) {
    String sh = "sh";
    if have_program("jsh") { sh = "jsh"; }
    String[] a = arr(4);
    a.push("-c");
    a.push("cd '" + g_cwd + "' && " + cmdline);
    g_out = arr(32);
    g_out.push("$ " + cmdline);
    switch Proc::output(sh, a) {
        Result::Ok(t): {
            String[] ls = t.split("\n");
            for i in 0..ls.len { g_out.push(ls[i] + ""); }
        }
        Result::Err(e): { g_out.push("cannot run " + sh); }
    }
    g_view = 2;
    g_note = "output of: " + cmdline + "   (Tab: songs / lyrics / output)";
}

// ---------------------------------------------------------------- /scan: songs from everywhere, with a shortest length
// The length without playing: wav from its header, mp3 from the first frame (or the Xing / Info tag of a variable rate), any other format from the size at 128 kbit/s
// (shown with a ~).  Returns seconds; g_est tells if it is a guess.
bool g_est;

int be32(char^ b, int at) { return ((b[at] & 255) << 24) | ((b[at + 1] & 255) << 16) | ((b[at + 2] & 255) << 8) | (b[at + 3] & 255); }
int le32(char^ b, int at) { return (b[at] & 255) | ((b[at + 1] & 255) << 8) | ((b[at + 2] & 255) << 16) | ((b[at + 3] & 255) << 24); }

int song_seconds(String path, int size) {
    g_est = true;
    String l = path.lower();
    char^ buf = (char^)Mem::alloc(8192);
    int fd = Sys::open_read(path.c());
    if fd < 0 { Mem::free(buf); return size / 16000; }
    int got = Sys::read(fd, buf, 8192);
    int secs = size / 16000;                                  // 128 kbit/s is 16000 bytes a second
    if got >= 44 && l.ends_with(".wav") && buf[0] == 'R' && buf[1] == 'I' && buf[8] == 'W' {
        int rate = le32(buf, 28);
        if rate > 0 { secs = (size - 44) / rate; g_est = false; }
    } else if got >= 10 && l.ends_with(".mp3") {
        int at = 0;
        if buf[0] == 'I' && buf[1] == 'D' && buf[2] == '3' {
            at = 10 + (((buf[6] & 127) << 21) | ((buf[7] & 127) << 14) | ((buf[8] & 127) << 7) | (buf[9] & 127));
        }
        int tag = at;
        if at >= 8192 {
            // the tag is big (a picture): read the place after it
            Sys::close(fd);
            fd = Sys::open_read(path.c());
            Sys::call(62, fd, at, 0, 0, 0, 0);                  // lseek
            got = Sys::read(fd, buf, 8192);
            at = 0;
        }
        int i = at;
        while i + 4 < got && !((buf[i] & 255) == 255 && (buf[i + 1] & 224) == 224 && ((buf[i + 1] >> 1) & 3) == 1) { i += 1; }
        if i + 4 < got {
            int ver = (buf[i + 1] >> 3) & 3;                    // 3 = MPEG 1, 2 = MPEG 2, 0 = MPEG 2.5
            int bri = (buf[i + 2] >> 4) & 15;
            int sri = (buf[i + 2] >> 2) & 3;
            int mono = 0;
            if ((buf[i + 3] >> 6) & 3) == 3 { mono = 1; }
            int kbps = 0;
            int hz = 0;
            if bri > 0 && bri < 15 && sri < 3 && ver != 1 {
                if ver == 3 {
                    int t1[15] = {0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320};
                    kbps = t1[bri];
                    int h1[3] = {44100, 48000, 32000};
                    hz = h1[sri];
                } else {
                    int t2[15] = {0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160};
                    kbps = t2[bri];
                    int h2[3] = {22050, 24000, 16000};
                    hz = h2[sri];
                    if ver == 0 { hz = hz / 2; }
                }
                int spf = 1152;
                if ver != 3 { spf = 576; }
                int audio = size - (tag + i - at);
                if kbps > 0 { secs = audio * 8 / (kbps * 1000); g_est = false; }
                // a variable rate file has a Xing / Info tag with the number of frames
                int side = 32;
                if ver == 3 && mono == 1 { side = 17; }
                if ver != 3 { side = 17; if mono == 1 { side = 9; } }
                int x = i + 4 + side;
                if x + 12 < got && ((buf[x] == 'X' && buf[x + 1] == 'i') || (buf[x] == 'I' && buf[x + 1] == 'n')) && (buf[x + 7] & 1) == 1 && hz > 0 {
                    int frames = be32(buf, x + 8);
                    secs = frames * spf / hz;
                    g_est = false;
                }
            }
        }
    }
    Sys::close(fd);
    Mem::free(buf);
    return secs;
}

String[] sc_path;                       // the songs found
int[] sc_secs;
bool[] sc_est;
int sc_dirs;

void scan_dir(String dir, int depth, int minsec, int limit) {
    if depth > 8 || sc_path.len >= limit { return; }
    switch Dir::list(dir) {
        Result::Ok(names): {
            for i in 0..names.len {
                if sc_path.len >= limit { return; }
                String n = names[i];
                if n.len == 0 { continue; }
                String p = Path::join(dir, n);
                if Dir::exists(p) {
                    if n[0] == '.' && n != ".music" { continue; }                // hidden folders (not ours), caches
                    if n == "Android" || n == "proc" || n == "sys" || n == "dev" || n == "node_modules" { continue; }
                    sc_dirs += 1;
                    scan_dir(p, depth + 1, minsec, limit);
                } else if is_audio(n) {
                    int size = 0;
                    switch Fs::size(p) { Result::Ok(v): { size = v; } Result::Err(e): { size = 0; } }
                    if size < 20000 { continue; }                                // a click or a ringtone, not a song
                    int sec = song_seconds(p, size);
                    if sec >= minsec {
                        sc_path.push(p + "");
                        sc_secs.push(sec);
                        sc_est.push(g_est);
                    }
                }
            }
        }
        Result::Err(e): { }
    }
}

// /scan [-s SECONDS] [PATH ...]: look for songs at least SECONDS long (default 60) in the home folder and the storage of the phone, or in the PATHs
// adds the found songs to the list for good (the file .library); the ones in the music folder are in the list already. Returns how many are new.
int library_add() {
    String[] lib = library_read();
    String mdir = music_dir() + "/";
    int added = 0;
    for k in 0..sc_path.len {
        String p = sc_path[k];
        if p.starts_with(mdir) { continue; }
        bool have = false;
        for q in 0..lib.len { if lib[q] == p { have = true; } }
        if !have { lib.push(p + ""); added += 1; }
    }
    if added > 0 { library_write(lib); }
    return added;
}

// loads the list again and finds the song that plays by its name
void reload_keep() {
    String keep = "";
    if g_play >= 0 && g_play < g_files.len { keep = g_files[g_play] + ""; }
    load_files();
    g_play = 0 - 1;
    if keep.len > 0 { g_play = find_song(keep); }
    if g_sel >= g_files.len { g_sel = g_files.len - 1; }
    if g_sel < 0 { g_sel = 0; }
}

// /remove NAME: a song found by /scan leaves the list (the file stays); with -f the file is deleted too. A song of the music folder needs -f (the file is the song).
String remove_song(int n, bool force) {
    String name = g_files[n] + "";
    String title = song_title(name);
    String path = abs_of(name);
    if name.starts_with("/") {
        String[] lib = library_read();
        String[] keep = arr(16);
        for i in 0..lib.len { if lib[i] != name { keep.push(lib[i] + ""); } }
        library_write(keep);
    } else if !force {
        return title + " is a file in the music folder: /remove -f " + title + " deletes it";
    }
    if force {
        Fs::remove(path);
        String b = strip_ext(path);
        Fs::remove(b + ".lrc");
        Fs::remove(b + ".txt");
    }
    if g_play == n { snd_stop(); }
    reload_keep();
    if force { return "deleted " + title; }
    return "removed " + title + " from the list (the file stays)";
}

int scan_minsec;
bool scan_add;
void scan_collect(String arg) {
    int minsec = 60;
    String[] words = arg.split(" ");
    String[] roots = arr(4);
    int i = 0;
    while i < words.len {
        String w = words[i].trim();
        if w == "-s" && i + 1 < words.len { minsec = words[i + 1].to_int(); i += 2; continue; }
        if w == "--add" { scan_add = true; i += 1; continue; }
        if w.len > 0 { roots.push(clean_path(expand_path(w))); }
        i += 1;
    }
    if roots.len == 0 {
        String home = "/";
        switch Env::get("HOME") { Option::Some(h): { home = h; } Option::None: { } }
        roots.push(home + "");
        String sd = "/storage/emulated/0";
        if !Dir::exists(sd) { sd = "/sdcard"; }
        if Dir::exists(sd) { roots.push(sd + ""); }
    }
    sc_path = arr(64);
    sc_secs = arr(64);
    sc_est = arr(64);
    sc_dirs = 0;
    scan_minsec = minsec;
    for r in 0..roots.len { scan_dir(roots[r], 0, minsec, 3000); }
}

void do_scan(String arg) {
    scan_collect(arg);
    int minsec = scan_minsec;
    if sc_path.len == 0 { g_note = "no song of " + str(minsec) + " seconds or more in " + str(sc_dirs) + " folders  (/scan -s 30  looks for shorter ones)"; return; }
    // the songs go into the list at once (and stay there: /remove NAME takes one out)
    int added = library_add();
    String keep = "";
    if g_play >= 0 && g_play < g_files.len { keep = g_files[g_play] + ""; }
    load_files();
    g_play = 0 - 1;
    if keep.len > 0 { g_play = find_song(keep); }
    g_view = 0;
    if added > 0 {
        for i in 0..g_files.len { if g_files[i] == sc_path[0] { g_sel = i; } }
    }
    g_note = "scan: " + str(sc_path.len) + " songs of " + str(minsec) + " seconds or more in " + str(sc_dirs) + " folders, " + str(added) + " new in the list  (/remove NAME takes one out)";
}

// ---- the web search of the Internet Archive, into a picker
bool archive_picker(String words) {
    String q = "(" + words + ") AND mediatype:audio";
    String body = "";
    switch Net::http.try_get("https://archive.org/advancedsearch.php?q=" + url_encode(q) + "&fl%5B%5D=identifier&fl%5B%5D=title&rows=20&output=json") {
        Result::Ok(b): { body = b; }
        Result::Err(e): { g_note = "search failed: " + e.message; return false; }
    }
    JsonDoc doc = json_open(body);
    int docs = doc.get(doc.get(doc.root(), "response"), "docs");
    if docs < 0 || doc.len(docs) == 0 { g_note = "nothing found for " + words; return false; }
    pk_open(3, "Internet Archive: " + words + "   (check the licence of what you fetch)");
    for k in 0..doc.len(docs) {
        int d = doc.at(docs, k);
        String id = doc.text(doc.get(d, "identifier"));
        String title = doc.text(doc.get(d, "title"));
        g_pk_show.push(title + "   [" + id + "]");
        g_pk_val.push("archive:" + id);
    }
    return true;
}

// ---- fetch something with the screen of the player out of the way
void fetch_outside(String what) {
    String[] a = arr(4);
    a.push("mujic"); a.push("get"); a.push(what);
    raw_off();
    cout << "\e[?1049l\e[0m\e[?25h";
    int rc = do_get(a);
    if rc == 0 { Time::sleep_ms(700); } else { Time::sleep_ms(2200); }
    cout << "\e[?1049h\e[2J";
    raw_on();
    String keep = "";
    if g_play >= 0 { keep = g_files[g_play] + ""; }
    load_files();
    g_play = 0 - 1;
    if keep.len > 0 { g_play = find_song(keep); }
    if rc == 0 { g_note = "fetched: " + what; } else { g_note = "could not fetch " + what; }
}

void lyrics_outside(int which) {
    raw_off();
    cout << "\e[?1049l\e[0m\e[?25h";
    int rc = fetch_lyrics(g_files[which], "");
    if rc == 0 { Time::sleep_ms(700); } else { Time::sleep_ms(2200); }
    cout << "\e[?1049h\e[2J";
    raw_on();
    if which == g_play || g_play < 0 { lyrics_load_for(g_files[which]); }
    if rc == 0 { g_note = "lyrics saved"; } else { g_note = "no lyrics found"; }
}

// ---- the input line
void in_insert(String t) {
    g_input = g_input.slice(0, g_cur) + t + g_input.slice(g_cur, g_input.len);
    g_cur += t.len;
    g_menu_sel = 0;
}

int in_prev(int cur) {
    int c = cur - 1;
    while c > 0 && (g_input[c] & 192) == 128 { c -= 1; }
    if c < 0 { c = 0; }
    return c;
}
int in_next(int cur) {
    int c = cur + 1;
    while c < g_input.len && (g_input[c] & 192) == 128 { c += 1; }
    if c > g_input.len { c = g_input.len; }
    return c;
}

// the commands that match what is typed after the /
int menu_count() {
    if g_input.len == 0 || g_input[0] != '/' { return 0; }
    String w = g_input.slice(1, g_input.len);
    if w.contains(" ") { return 0; }
    int c = 0;
    for i in 0..cmd_name.len { if cmd_name[i].starts_with(w) { c += 1; } }
    return c;
}
int menu_nth(int k) {
    String w = g_input.slice(1, g_input.len);
    int seen = 0;
    for i in 0..cmd_name.len {
        if cmd_name[i].starts_with(w) {
            if seen == k { return i; }
            seen += 1;
        }
    }
    return 0 - 1;
}

void say_help() {
    g_note = "keys: Enter play, Space pause, Left/Right seek, Tab songs/lyrics, / commands, Esc leave   (type a name and Enter to find a song)";
}

// ---- running a command
void run_command(String line) {
    String cmd = line;
    String arg = "";
    int sp = line.find(" ");
    if sp >= 0 { cmd = line.slice(0, sp); arg = line.slice(sp + 1, line.len).trim(); }
    if cmd == "remove" {
        bool force = false;
        String what = arg;
        if what.starts_with("-f ") { force = true; what = what.slice(3, what.len).trim(); }
        if what.len == 0 { g_note = "/remove NAME   (a number or a part of the name; -f also deletes the file)"; }
        else {
            int n = find_song(what);
            if n < 0 { g_note = "no song like '" + what + "'"; } else { g_note = remove_song(n, force); }
        }
    }
    else if cmd == "scan" { g_note = "scanning ..."; do_scan(arg); }
    else if cmd == "dir" || cmd == "ls" {
        String ep = g_cwd;
        if arg.len > 0 { ep = expand_path(arg); }
        bool is_dir = Dir::exists(ep);
        bool there = Fs::exists(ep);
        if arg.len > 0 && there && !is_dir { play_path(ep); } else { dir_picker(ep); }
    } else if cmd == "cd" {
        String target = music_dir();
        if arg.len > 0 { target = expand_path(arg); }
        if Dir::exists(target) { g_cwd = clean_path(target); g_note = "in " + g_cwd; } else { g_note = "no folder " + target; }
    } else if cmd == "pwd" { g_note = g_cwd + "";
    } else if cmd == "play" {
        String pp = expand_path(arg);
        bool pathy = arg.contains("/") || arg.starts_with("~") || arg.contains(":");
        bool pfile = Fs::exists(pp) && !Dir::exists(pp);
        if arg.len > 0 && pathy && pfile {
            play_path(pp);
        } else if arg.len > 0 {
            int s = find_song(arg);
            if s >= 0 { play_index(s); g_note = "playing " + song_title(g_files[s]); } else { g_note = "no song like '" + arg + "' (/get fetches songs)"; }
        } else if g_files.len == 0 { g_note = "no songs yet: /get";
        } else {
            pk_open(1, "Choose a song");
            for i in 0..g_files.len { g_pk_show.push(song_title(g_files[i])); g_pk_val.push(str(i)); }
            g_pk_sel = g_sel;
        }
    } else if cmd == "pause" { snd_pause(); }
    else if cmd == "next" { int k = next_song(1); if k >= 0 { play_index(k); } else if g_files.len > 0 { play_index(0); } }
    else if cmd == "prev" { int k = next_song(0 - 1); if k >= 0 { play_index(k); } else if g_files.len > 0 { play_index(g_files.len - 1); } }
    else if cmd == "stop" { snd_stop(); g_note = "stopped"; }
    else if cmd == "queue" { g_view = 0; }
    else if cmd == "lyrics" {
        if arg == "get" {
            int which = g_sel;
            if g_play >= 0 { which = g_play; }
            if g_files.len > 0 { lyrics_outside(which); }
        } else { g_view = 1; }
    }
    else if cmd == "get" {
        if arg.len > 0 { fetch_outside(arg); }
        else {
            catalog_init();
            pk_open(2, "Free songs (Kevin MacLeod, CC BY 4.0)");
            for i in 0..cat_id.len { g_pk_show.push(cat_title[i] + ""); g_pk_val.push(cat_id[i] + ""); }
        }
    }
    else if cmd == "find" {
        if arg.len == 0 { g_note = "/find words  (for example /find piano)"; } else { g_note = "searching ..."; archive_picker(arg); }
    }
    else if cmd == "import" {
        if arg.len == 0 { g_note = "/import PATH   (a song or a folder of songs, copied into " + music_dir() + ")"; }
        else {
            raw_off();
            cout << "\e[?1049l\e[0m\e[?25h";
            int rc = do_import(arg);
            Time::sleep_ms(1200);
            cout << "\e[?1049h\e[2J";
            raw_on();
            load_files();
            if rc == 0 { g_note = "imported: " + arg; } else { g_note = "could not import " + arg; }
        }
    }
    else if cmd == "mv" {
        int sp = -1;
        for i in 0..arg.len { if arg[i] == ' ' { sp = i; } }
        if sp <= 0 { g_note = "/mv NAME FOLDER   (for example /mv rain relax;  /mv rain .  brings it back)"; }
        else { g_note = move_song(arg.slice(0, sp).trim(), arg.slice(sp + 1, arg.len).trim()); load_files(); }
    }
    else if cmd == "shuffle" { g_shuffle = !g_shuffle; if g_shuffle { g_note = "shuffle on"; } else { g_note = "shuffle off"; } }
    else if cmd == "repeat" { g_repeat = (g_repeat + 1) % 3; if g_repeat == 0 { g_note = "repeat off"; } else if g_repeat == 1 { g_note = "repeat all"; } else { g_note = "repeat one"; } }
    else if cmd == "volume" {
        if arg.len > 0 { g_volume = arg.to_int(); snd_volume(0); } else { g_note = "volume " + str(g_volume); }
    }
    else if cmd == "seek" {
        if arg.starts_with("+") { snd_seek(arg.slice(1, arg.len).to_int() * 1000); }
        else if arg.starts_with("-") { snd_seek(0 - arg.slice(1, arg.len).to_int() * 1000); }
        else if arg.contains(":") {
            String[] mm = arg.split(":");
            snd_seek(mm[0].to_int() * 60000 + mm[1].to_int() * 1000 - cur_pos());
        } else { g_note = "/seek +10   /seek -10   /seek 1:30"; }
    }
    else if cmd == "help" || cmd == "?" { say_help(); }
    else if cmd == "quit" || cmd == "exit" { g_quit = true; }
    else { g_note = "unknown command /" + cmd + "  (type / to see the commands)"; }
}

// plain words: one song that matches plays at once, several open the picker, none: say so
void run_words(String words) {
    cmd_init();
    if words.starts_with("!") { shell_line(words.slice(1, words.len).trim()); return; }
    String w1 = words;
    int fsp = words.find(" ");
    if fsp > 0 { w1 = words.slice(0, fsp); }
    if w1 == "dir" || w1 == "ls" || w1 == "cd" || w1 == "pwd" { run_command(words); return; }
    int hits = 0;
    int first = 0 - 1;
    String w = words.lower();
    for i in 0..g_files.len { if g_files[i].lower().contains(w) { hits += 1; if first < 0 { first = i; } } }
    if hits == 1 { play_index(first); g_note = "playing " + song_title(g_files[first]); }
    else if hits == 0 { g_note = "no song like '" + words + "'  -  /get fetches songs, /find searches the web"; }
    else {
        pk_open(1, "Songs with '" + words + "'");
        for i in 0..g_files.len { if g_files[i].lower().contains(w) { g_pk_show.push(song_title(g_files[i])); g_pk_val.push(str(i)); } }
    }
}

void pk_choose() {
    int i = pk_nth(g_pk_sel);
    if i < 0 { return; }
    String v = g_pk_val[i];
    int kind = g_pk_kind;
    g_pk_on = false;
    if kind == 5 { play_path(v); return; }
    if kind == 4 {
        if v == ".." { dir_picker(Path::join(g_cwd, "..")); }
        else if v.ends_with("/") { dir_picker(Path::join(g_cwd, v)); }
        else { play_path(Path::join(g_cwd, v)); }
        return;
    }
    if kind == 1 { int s = v.to_int(); play_index(s); g_note = "playing " + song_title(g_files[s]); }
    else { fetch_outside(v); }
}

// ---- drawing
String repeat_text(String s, int n) {
    String r = "";
    for i in 0..n { r = r + s; }
    return r;
}

void draw() {
    cmd_init();
    int cols = Term::cols();
    int rows = Term::rows();
    if cols < 24 { cols = 24; }
    if rows < 10 { rows = 10; }
    String f = "";
    // header
    String head = " ♪ mujic 0.3   " + str(g_files.len) + " songs";
    if g_backend == 0 { head = head + "   (no sound here)"; }
    if g_shuffle { head = head + "   shuffle"; }
    if g_repeat == 1 { head = head + "   repeat all"; }
    if g_repeat == 2 { head = head + "   repeat one"; }
    if g_backend == 1 { head = head + "   vol " + str(g_volume); }
    f = f + "\e[1;1H" + sgr("1;30;47", pad(head, cols));
    // now playing
    int pos = cur_pos();
    String title = "nothing is playing";
    if g_play >= 0 { title = song_title(g_files[g_play]); }
    String mark = " ■ ";
    if g_state == 1 { mark = " ▶ "; } else if g_state == 2 { mark = " ❙❙ "; }
    f = f + "\e[2;1H" + sgr("1", pad(mark + title, cols));
    String t = clock(pos);
    if g_len > 0 { t = t + " / " + clock(g_len); }
    int barw = cols - shown_width(t) - 4;
    if barw < 4 { barw = 4; }
    int filled = 0;
    if g_len > 0 { filled = pos * barw / g_len; }
    if filled > barw { filled = barw; }
    f = f + "\e[3;1H " + sgr("36", repeat_text("━", filled) + repeat_text("─", barw - filled)) + " " + pad(t, cols - barw - 3);
    // the panel: rows 5 .. rows - 6
    int top = 5;
    int bottom = rows - 6;
    int ph = bottom - top + 1;
    for r in 0..ph { f = f + "\e[" + str(top + r) + ";1H" + pad("", cols); }
    if g_pk_on {
        f = f + "\e[" + str(top) + ";1H" + sgr("1;36", pad(" " + g_pk_title, cols));
        int n = pk_count();
        if g_pk_sel >= n { g_pk_sel = n - 1; }
        if g_pk_sel < 0 { g_pk_sel = 0; }
        int vis = ph - 3;
        int first = 0;
        if g_pk_sel >= vis { first = g_pk_sel - vis + 1; }
        for r in 0..vis {
            int k = first + r;
            String line = pad("", cols);
            if k < n {
                int i = pk_nth(k);
                String lead2 = "    ";
                if k == g_pk_sel { lead2 = "  ❯ "; }
                line = pad(lead2 + g_pk_show[i], cols);
                if k == g_pk_sel { line = sgr("7", line); }
            }
            f = f + "\e[" + str(top + 1 + r) + ";1H" + line;
        }
        f = f + "\e[" + str(bottom - 1) + ";1H" + sgr("2", pad("  type to narrow:  " + g_pk_filter + "   (" + str(n) + " of " + str(g_pk_show.len) + ")", cols));
        f = f + "\e[" + str(bottom) + ";1H" + sgr("2", pad("  up/down choose   Enter select   Esc close", cols));
    } else if g_view == 2 {
        int total = g_out.len;
        int from = total - ph;
        if from < 0 { from = 0; }
        if total == 0 { f = f + "\e[" + str(top) + ";1H" + sgr("2", pad("  no output yet:  !command  runs a shell command in " + g_cwd, cols)); }
        for r in 0..ph {
            int i = from + r;
            if i < total { f = f + "\e[" + str(top + r) + ";1H" + pad(" " + fit(g_out[i], cols - 2), cols); }
        }
    } else if g_view == 1 && lcount > 0 {
        int cur = lyrics_at(pos + 200);
        int start = 0;
        int mid = 0;
        if cur >= 0 { mid = cur; }
        start = mid - ph / 2;
        if start < 0 { start = 0; }
        if start + ph > lcount { start = lcount - ph; }
        if start < 0 { start = 0; }
        for r in 0..ph {
            int i = start + r;
            if i < lcount {
                String text = ltx[i];
                if text.len == 0 { text = " "; }
                int lead = (cols - shown_width(text)) / 2;
                if lead < 0 { lead = 0; }
                String ln = pad(repeat_text(" ", lead) + text, cols);
                if i == cur { ln = sgr("1;93", ln); } else { ln = sgr("2", ln); }
                f = f + "\e[" + str(top + r) + ";1H" + ln;
            }
        }
    } else if g_view == 1 {
        f = f + "\e[" + str(top + ph / 2) + ";1H" + sgr("2", pad("  no lyrics for this song.   /lyrics get  fetches them", cols));
    } else {
        int n = g_files.len;
        if n == 0 { f = f + "\e[" + str(top) + ";1H" + sgr("2", pad("  no songs in " + music_dir() + "   -   /get fetches free songs", cols)); }
        int first = 0;
        if g_sel >= ph { first = g_sel - ph + 1; }
        for r in 0..ph {
            int i = first + r;
            if i < n {
                String m = "    ";
                if i == g_play { m = "  ▶ "; if g_state == 2 { m = "  ❙ "; } }
                String line = pad(m + str(i + 1) + ". " + song_title(g_files[i]), cols);
                if i == g_sel { line = sgr("7", line); } else if i == g_play { line = sgr("1;32", line); }
                f = f + "\e[" + str(top + r) + ";1H" + line;
            }
        }
    }
    // the menu of commands, over the bottom of the panel
    int mc = menu_count();
    if mc > 0 && !g_pk_on {
        if g_menu_sel >= mc { g_menu_sel = mc - 1; }
        int show = mc;
        if show > 7 { show = 7; }
        if show > ph { show = ph; }
        int firstm = 0;
        if g_menu_sel >= show { firstm = g_menu_sel - show + 1; }
        for r in 0..show {
            int ci = menu_nth(firstm + r);
            String entry = pad("  /" + cmd_name[ci], 12) + cmd_help[ci];
            String ln = pad(entry, cols);
            if firstm + r == g_menu_sel { ln = sgr("7", ln); } else { ln = sgr("2", ln); }
            f = f + "\e[" + str(bottom - show + 1 + r) + ";1H" + ln;
        }
    }
    // the note, the box and the hint
    f = f + "\e[" + str(rows - 4) + ";1H" + sgr("33", pad(" " + g_note, cols));
    f = f + "\e[" + str(rows - 3) + ";1H" + sgr("2", "╭" + repeat_text("─", cols - 2) + "╮");
    String shown_in = fit(g_input, cols - 6);
    f = f + "\e[" + str(rows - 2) + ";1H" + sgr("2", "│") + " " + sgr("1;36", ">") + " " + pad(shown_in, cols - 5) + sgr("2", "│");
    f = f + "\e[" + str(rows - 1) + ";1H" + sgr("2", "╰" + repeat_text("─", cols - 2) + "╯");
    String hint = "  / commands   Enter play   Space pause   ← → seek   Tab lyrics   Esc leave";
    if g_input.len > 0 { hint = "  Enter run   Esc clear   ↑ ↓ history"; }
    f = f + "\e[" + str(rows) + ";1H" + sgr("2", pad(hint, cols));
    // the cursor in the box
    int cx = 5 + shown_width(fit(g_input.slice(0, g_cur), cols - 6));
    f = f + "\e[" + str(rows - 2) + ";" + str(cx) + "H\e[?25h";
    cout << f;
}

// the letter typed (a code of next_event) as text: ASCII, or a Unicode letter sent as 100000 + the code point
String key_text(int ev) {
    String r = "";
    if ev >= 100000 {
        int cp = ev - 100000;
        if cp < 2048 { r.push((char)(192 | (cp >> 6))); r.push((char)(128 | (cp & 63))); }
        else if cp < 65536 { r.push((char)(224 | (cp >> 12))); r.push((char)(128 | ((cp >> 6) & 63))); r.push((char)(128 | (cp & 63))); }
        else { r.push((char)(240 | (cp >> 18))); r.push((char)(128 | ((cp >> 12) & 63))); r.push((char)(128 | ((cp >> 6) & 63))); r.push((char)(128 | (cp & 63))); }
    } else { r.push((char)ev); }
    return r;
}

int do_player(String start) {
    lyrics_clear();
    g_msg = "";
    g_note = "";
    g_media = "";
    g_out = arr(8);
    g_cwd = music_dir();
    g_play = 0 - 1;
    g_sel = 0;
    g_view = 0;
    g_volume = 100;
    g_filter = "";
    g_player = "";
    ltitle = "";
    g_input = "";
    g_cur = 0;
    g_pk_title = "";
    g_pk_filter = "";
    g_hist = arr(16);
    load_files();
    choose_backend();
    cmd_init();
    if start.len > 0 {
        int s = find_song(start);
        if s < 0 {                                               // not in the list: a file of any folder (mujic play Blonde.mp3 where the file is)
            String here = real_file(start);
            if here.len > 0 && is_audio(here) {
                g_files.push(here + "");
                s = g_files.len - 1;
            }
        }
        if s < 0 { return fail("no song like '" + start + "' in " + music_dir() + " (and no such file here)"); }
        g_sel = s;
    }
    raw_on();
    cout << "\e[?1049h\e[2J";
    if start.len > 0 { play_index(g_sel); }
    if g_files.len == 0 { g_note = "no songs yet:  /get  fetches free songs,  /find  searches the web,  or put files in " + music_dir(); }
    int last_poll = now();
    g_quit = false;
    while !g_quit {
        draw();
        int ev = next_event(250);
        if ev == -9 || ev == 3 { g_quit = true; }
        else if ev >= 0 {
            if g_pk_on {
                // the picker has the keys
                if ev == 27 { g_pk_on = false; }
                else if ev == 257 { if g_pk_sel > 0 { g_pk_sel -= 1; } }
                else if ev == 258 { if g_pk_sel < pk_count() - 1 { g_pk_sel += 1; } }
                else if ev == 13 || ev == 10 { pk_choose(); }
                else if ev == 127 || ev == 8 { if g_pk_filter.len > 0 { g_pk_filter = g_pk_filter.slice(0, g_pk_filter.len - 1); g_pk_sel = 0; } }
                else if ev >= 32 && ev != 127 && ev < 257 || ev >= 100000 { g_pk_filter = g_pk_filter + key_text(ev); g_pk_sel = 0; }
            } else if g_input.len == 0 && ev != 47 && ev != 127 && ev != 8 && (ev < 32 || ev >= 257 || ev == ' ') {
                // an empty box: the keys of the player
                if ev == 27 { g_quit = true; }
                else if ev == 257 { if g_sel > 0 { g_sel -= 1; } }
                else if ev == 258 { if g_sel < g_files.len - 1 { g_sel += 1; } }
                else if ev == 13 || ev == 10 { if g_files.len > 0 { play_index(g_sel); } }
                else if ev == ' ' { if g_state == 0 && g_play < 0 { if g_files.len > 0 { play_index(g_sel); } } else { snd_pause(); } }
                else if ev == 259 { snd_seek(10000); }
                else if ev == 260 { snd_seek(0 - 10000); }
                else if ev == 9 { g_view = (g_view + 1) % 3; }
                else if ev == 14 { run_command("next"); }
                else if ev == 16 { run_command("prev"); }
            } else {
                // typing
                int mc = menu_count();
                if ev == 27 { g_input = ""; g_cur = 0; }
                else if ev == 13 || ev == 10 {
                    String line = g_input.trim();
                    if mc > 0 && !line.contains(" ") {
                        int ci = menu_nth(g_menu_sel);
                        line = cmd_name[ci] + "";                          // the chosen command of the menu
                        g_input = ""; g_cur = 0;
                        // a command that needs words waits for them
                        if line == "find" { g_input = "/find "; g_cur = g_input.len; }
                        else { run_command(line); }
                    } else {
                        g_input = ""; g_cur = 0;
                        if line.len > 0 {
                            g_hist.push(line + "");
                            g_hist_i = g_hist.len;
                            if line[0] == '/' { run_command(line.slice(1, line.len)); } else { run_words(line); }
                        }
                    }
                }
                else if ev == 9 && mc > 0 {
                    int ci = menu_nth(g_menu_sel);
                    g_input = "/" + cmd_name[ci] + " ";
                    g_cur = g_input.len;
                }
                else if ev == 257 { if mc > 0 { if g_menu_sel > 0 { g_menu_sel -= 1; } } else if g_hist_i > 0 { g_hist_i -= 1; g_input = g_hist[g_hist_i] + ""; g_cur = g_input.len; } }
                else if ev == 258 { if mc > 0 { if g_menu_sel < mc - 1 { g_menu_sel += 1; } } else if g_hist_i < g_hist.len { g_hist_i += 1; if g_hist_i == g_hist.len { g_input = ""; } else { g_input = g_hist[g_hist_i] + ""; } g_cur = g_input.len; } }
                else if ev == 259 { g_cur = in_next(g_cur); }
                else if ev == 260 { g_cur = in_prev(g_cur); }
                else if ev == 127 || ev == 8 { if g_cur > 0 { int pc = in_prev(g_cur); g_input = g_input.slice(0, pc) + g_input.slice(g_cur, g_input.len); g_cur = pc; g_menu_sel = 0; } }
                else if ev == 1 { g_cur = 0; }
                else if ev == 5 { g_cur = g_input.len; }
                else if ev == 21 { g_input = ""; g_cur = 0; }
                else if (ev >= 32 && ev < 127) || ev >= 128 && ev < 257 || ev >= 100000 { in_insert(key_text(ev)); }
            }
        }
        if g_media.len > 0 { String mk = g_media + ""; g_media = ""; run_command(mk); }
        int tnow = now();
        if tnow - last_poll >= 700 { snd_poll(); last_poll = tnow; }
        // the song ended: the next one
        bool ended = g_state == 0 && g_play >= 0 && g_msg.len == 0 && (g_len > 0 || g_backend != 1);
        if g_backend == 1 && g_state == 1 && g_len > 0 && cur_pos() >= g_len + 1500 { ended = true; }
        if ended && g_files.len > 0 && g_pos_at > 0 && now() - g_pos_at > 1500 {
            int k = next_song(1);
            if k >= 0 { play_index(k); } else { g_play = 0 - 1; g_pos = 0; }
        }
        if g_msg.len > 0 { g_note = g_msg + ""; g_msg = ""; }
    }
    snd_stop();
    cout << "\e[?25h\e[?1049l";
    raw_off();
    return 0;
}

// mujic play NAME -b  /  mujic bg NAME: the song plays in the background and the prompt is free (the Jaric app keeps it going with its notification)
int do_background(String what) {
    load_files();
    choose_backend();
    String full = "";
    int s = find_song(what);
    if s >= 0 { full = abs_of(g_files[s]); }
    else {
        String here = real_file(what);
        if here.len > 0 && is_audio(here) { full = here + ""; }
    }
    if full.len == 0 { return fail("no song like '" + what + "' in " + music_dir() + " (and no such file here)"); }
    if g_backend == 1 {
        // the app plays the whole list from this song: the next song starts by itself, the control panel and the notification have the buttons
        String all = "";
        int at = 0;
        for i in 0..g_files.len {
            String one = abs_of(g_files[i]);
            if one == full { at = i; }
            all += one + "\n";
        }
        if s < 0 { all = full + "\n"; at = 0; }
        osc_audio("playlist;" + str(at) + ";" + Base64::encode(all));
    } else {
        snd_play(full);
        if g_msg.len > 0 { return fail(g_msg); }
    }
    cout << "playing " << song_title(full) << " in the background";
    if g_backend == 1 { cout << "   (mujic pause | resume | next | prev | stop)"; }
    cout << "\n";
    return 0;
}

// mujic pause | resume | next | prev | stop: the music that plays in the background (the Jaric app, or termux-media-player)
int do_remote(String what) {
    choose_backend();
    if g_backend != 1 && g_backend != 2 { return fail("only the Jaric app (or termux-media-player) can be controlled from another prompt"); }
    if what == "next" || what == "prev" { if g_backend == 1 { osc_audio(what); } else { return fail("next and prev need the Jaric app"); } return 0; }
    if what == "pause" { g_state = 1; snd_pause(); }
    else if what == "resume" { g_state = 2; snd_pause(); }
    else { snd_stop(); }
    return 0;
}

int do_list() {
    load_files();
    if g_files.len == 0 { cout << "no songs in " << music_dir() << ".  mujic catalog shows free ones, mujic get NAME fetches.\n"; return 0; }
    for i in 0..g_files.len {
        String base = strip_ext(abs_of(g_files[i]));
        String mark = "";
        if Fs::exists(base + ".lrc") { mark = "  [lyrics, synced]"; } else if Fs::exists(base + ".txt") { mark = "  [lyrics]"; }
        cout << "  " << i + 1 << ". " << song_title(g_files[i]) << mark << "\n";
    }
    return 0;
}

int do_lyrics(String[] a) {
    String what = "";
    String q = "";
    int i = 2;
    while i < a.len {
        if a[i] == "-q" && i + 1 < a.len { q = a[i + 1] + ""; i += 2; }
        else { what = a[i] + ""; i += 1; }
    }
    if what.len == 0 { return fail("usage: mujic lyrics NAME [-q \"artist title\"]"); }
    int s = find_song(what);
    if s < 0 { return fail("no song like '" + what + "'"); }
    return fetch_lyrics(g_files[s], q);
}

// mujic scan [-s SECONDS] [PATH ...]: the same search, printed (length, path), for scripts
int do_scan_cli(String[] a) {
    String arg = "";
    for i in 2..a.len { arg = arg + a[i] + " "; }
    g_cwd = music_dir();
    scan_collect(arg.trim());
    int added = 0;
    if scan_add { added = library_add(); }
    for k in 0..sc_path.len {
        String mark = " ";
        if sc_est[k] { mark = "~"; }
        cout << mark << clock(sc_secs[k] * 1000) << "  " << sc_path[k] << "\n";
    }
    cerr << sc_path.len << " songs of " << scan_minsec << " seconds or more in " << sc_dirs << " folders";
    if scan_add { cerr << ", " << added << " added to the list"; }
    cerr << "\n";
    return 0;
}

// mujic remove [-f] NAME: takes a song out of the list (the file stays; -f deletes it)
int do_remove_cli(String[] a) {
    bool force = false;
    String what = "";
    for i in 2..a.len {
        if a[i] == "-f" { force = true; continue; }
        if what.len > 0 { what = what + " "; }
        what = what + a[i];
    }
    if what.len == 0 { return fail("usage: mujic remove [-f] NAME"); }
    int n = find_song(what);
    if n < 0 { return fail("no song like '" + what + "'"); }
    cout << remove_song(n, force) << "\n";
    return 0;
}

int main() {
    String VERSION = "0.8.0";
    String[] args = Env::args();
    if args.len > 1 && (args[1] == "--version" || args[1] == "-v") { cout << "mujic " << VERSION << "\n"; return 0; }
    // mujic -session [arguments]: in the Jaric app the player opens in a tab of its own and this shell stays free; elsewhere it runs here
    if args.len > 1 && args[1] == "-session" {
        bool in_app = false;
        switch Env::get("JARIC") {
            Option::Some(j): { if j.len > 0 { in_app = true; } }
            Option::None: { }
        }
        if in_app {
            String rest = "mujic";
            for i in 2..args.len { rest = rest + " " + args[i]; }
            cout << "\e]7777;session;new;" << rest << "\a";
            return 0;
        }
        String[] shifted = arr(args.len);
        shifted.push(args[0]);
        for i in 2..args.len { shifted.push(args[i]); }
        args = shifted;
    }
    if args.len > 1 {
        String c = args[1];
        if c == "scan" { return do_scan_cli(args); }
        if c == "remove" { return do_remove_cli(args); }
        if c == "list" { return do_list(); }
        if c == "catalog" { return do_catalog(); }
        if c == "get" { return do_get(args); }
        if c == "find" { return do_find(args); }
        if c == "lyrics" { return do_lyrics(args); }
        if c == "pause" || c == "resume" || c == "stop" || c == "next" || c == "prev" { return do_remote(c); }
        if c == "bg" && args.len > 2 { return do_background(args[2]); }
        if c == "play" {
            String w = "";
            if args.len > 2 { w = args[2] + ""; }
            bool bgmode = false;
            for i in 2..args.len { if args[i] == "-b" || args[i] == "--background" { bgmode = true; } }
            if bgmode && w.len > 0 && w != "-b" && w != "--background" { return do_background(w); }
            return do_player(w);
        }
        if c == "help" || c == "-h" || c == "--help" {
            cout << "mujic: a music player for the terminal (songs in " << music_dir() << ")\n";
            cout << "  mujic                 the player      mujic play NAME   start with a song\n";
            cout << "  mujic list            the songs       mujic catalog     free songs to fetch\n";
            cout << "  mujic play NAME -b    play in the background (the prompt stays free)   mujic pause | resume | next | prev | stop\n";
            cout << "  mujic get NAME|URL|archive:ID [-n NAME]   fetch a song      mujic find WORDS   search archive.org\n";
            cout << "  mujic lyrics NAME [-q WORDS]              fetch the lyrics (kept as NAME.lrc)\n";
            cout << "  keys in the player: up/down enter space n p < > l g v s q;  put your own .lrc/.txt next to a song\n";
            return 0;
        }
        return do_player(c);
    }
    return do_player("");
}
