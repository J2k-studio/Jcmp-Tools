#import <stdlib>
#import <files>
#import <retrieve>

// ask: find the answer in your own documents (BM25, no model, nothing leaves the phone).   ask how do I open a file
//   ask [-n N] [-d DIR]... words of the question
// It reads the .md, .txt and .jk files of the folders (two levels down): ASK_DIRS (a list with :), else the docs of Jcmp and Jcmp-libs in your home.

String ask_version() { return "0.1.0"; }

Retrieve ask_r;

void ask_read_dir(String dir, int depth) {
    switch Dir::list(dir) {
        Result::Ok(names): {
            for i in 0..names.len {
                String name = names[i] + "";
                String path = dir + "/" + name;
                if Dir::exists(path) {
                    if depth < 2 && name[0] != '.' { ask_read_dir(path, depth + 1); }
                } else if name.ends_with(".md") || name.ends_with(".txt") || name.ends_with(".jk") {
                    switch Fs::read_text(path) {
                        Result::Ok(text): { ask_r.add(name, text); }
                        Result::Err(e): { }
                    }
                }
            }
        }
        Result::Err(e): { }
    }
}

int main() {
    String[] a = Env::args();
    int n = 3;
    String[] dirs = arr(4);
    String q = "";
    int i = 1;
    while i < a.len {
        if a[i] == "--version" || a[i] == "-V" { cout << "ask " << ask_version() << "\n"; return 0; }
        if a[i] == "-n" && i + 1 < a.len { n = a[i + 1].to_int(); i += 2; continue; }
        if a[i] == "-d" && i + 1 < a.len { dirs.push(a[i + 1] + ""); i += 2; continue; }
        if q.len > 0 { q.push(' '); }
        q.append(a[i]);
        i += 1;
    }
    if q.len == 0 {
        cout << "ask: find the answer in your own documents\n  ask how do I open a file\n  ask -n 5 -d ~/notes thread\n  folders: -d DIR (more than once), or ASK_DIRS=a:b, else ~/Jcmp/docs and ~/Jcmp-libs/docs, lessons\n";
        return 0;
    }
    if dirs.len == 0 {
        String home = "";
        switch Env::get("HOME") { Option::Some(h): { home = h + ""; } Option::None: { } }
        switch Env::get("ASK_DIRS") {
            Option::Some(list): {
                String[] parts = list.split(":");
                for k in 0..parts.len { if parts[k].len > 0 { dirs.push(parts[k] + ""); } }
            }
            Option::None: {
                dirs.push(home + "/Jcmp/docs");
                dirs.push(home + "/Jcmp-libs/docs");
                dirs.push(home + "/Jcmp-libs/lessons");
                dirs.push(home + "/Jcmp-libs/examples");
            }
        }
    }
    ask_r = Retrieve::make();
    for d in 0..dirs.len { ask_read_dir(dirs[d] + "", 0); }
    ask_r.build();
    Hits h = ask_r.search(q, n);
    if h.n == 0 { cout << "ask: nothing found for: " << q << "\n"; return 1; }
    for k in 0..h.n {
        cout << "== " << h.names[k] << "  (" << h.scores[k] << ")\n" << h.texts[k] << "\n\n";
    }
    return 0;
}
