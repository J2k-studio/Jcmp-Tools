#!/bin/sh
# makej: a build tool for J2K projects. The build file is the file "makej" (a simple TOML, written by hand: nano makej) or "makej.jk" (a J2K program).
#   makej [init [-ai]] [target] [-v] [-n] [-j N]   makej list   makej clean   makej install FOLDER   makej --version
# This file is the whole tool: the library of makej is inside it and is written to a cache folder at the first run.
MAKEJ_VERSION=@VERSION@
case "${1:-}" in --version|-version) echo "makej $MAKEJ_VERSION"; exit 0 ;; esac
home="${MAKEJ_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/makej/$MAKEJ_VERSION}"
if [ ! -f "$home/makej_file.jk" ]; then
    mkdir -p "$home"
cat > "$home/makej.j" <<'MAKEJ_LIB_EOF'
@LIB_J@
MAKEJ_LIB_EOF
cat > "$home/makej_file.jk" <<'MAKEJ_FILE_EOF'
@LIB_JK@
MAKEJ_FILE_EOF
fi
export J2K_PATH="$home${J2K_PATH:+:$J2K_PATH}"
if [ "${1:-}" = "init" ] && [ "${2:-}" = "-ai" ]; then
    [ -e makej ] && { echo "makej: the file makej is there already" >&2; exit 2; }
    mkdir -p src data
cat > makej <<'MAKEJ_AI_EOF'
# an AI project (makej init -ai). makej builds the program; makej train trains the model on data/data.json; makej ask asks it.
# The model is the file NAME.jw (the weights); the library is  #import <neuron>  (in work: see the spec, section 93).
[makej]
out = "_out"

[program.chat]
main = "src/chat.jk"
flags = ""

[step.train]
run = "_out/chat train data/data.json chat.jw"
needs = "chat"

[step.ask]
run = "_out/chat ask chat.jw"
needs = "chat"
MAKEJ_AI_EOF
cat > src/chat.jk <<'MAKEJ_AI_SRC_EOF'
// The program of the AI: chat train DATA.json OUT.jw   |   chat ask MODEL.jw
// Planned (the library neuron is not finished): the model is declared like this and trained with one line:
//     model Chat { embed(256, 64); dense(64, 128); relu; dense(128, 256); }
//     train Chat on data epochs 10 rate 0.01;
#import <stdlib>

int main() {
    String[] a = Env::args();
    if a.len < 3 { cerr << "usage: chat train DATA.json OUT.jw | chat ask MODEL.jw\n"; return 2; }
    if a[1] == "train" && a.len >= 4 {
        switch Fs::read_text(a[2]) {
            Result::Ok(t): { cout << "data: " << t.len << " bytes (training comes with the library neuron)\n"; }
            Result::Err(e): { cerr << "cannot read " << a[2] << "\n"; return 1; }
        }
        return 0;
    }
    if a[1] == "ask" { cout << "no model yet: " << a[2] << "\n"; return 0; }
    return 2;
}
MAKEJ_AI_SRC_EOF
cat > data/data.json <<'MAKEJ_AI_DATA_EOF'
[
  {"in": "hello", "out": "hi, how can I help?"},
  {"in": "what is J2K", "out": "a language and its compiler jcmp"}
]
MAKEJ_AI_DATA_EOF
    echo "makej: wrote makej, src/chat.jk, data/data.json (makej train, makej ask)"; exit 0
fi
if [ "${1:-}" = "init" ]; then
    [ -e makej ] && { echo "makej: the file makej is there already" >&2; exit 2; }
cat > makej <<'MAKEJ_INIT_EOF'
# the build file of this project (nano makej). Run it with:  makej   or   makej NAME   (-v shows the commands)
[makej]
out = "_out"

[program.hello]
main = "src/hello.jk"
flags = ""

[step.run]
run = "_out/hello"
needs = "hello"
MAKEJ_INIT_EOF
    echo "makej: wrote the file makej"; exit 0
fi
mkdir -p _out
if [ -f makej.jk ]; then src=makej.jk
elif [ -f makej ]; then src="$home/makej_file.jk"
else echo "makej: there is no makej.jk and no file makej in this folder (makej init writes one)" >&2; exit 2; fi
jcmp "$src" -o _out/.makej_run >/dev/null 2>_out/.makej_err || { cat _out/.makej_err >&2; echo "makej: the build file does not compile" >&2; exit 2; }
exec _out/.makej_run "$@"
