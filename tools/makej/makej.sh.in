#!/bin/sh
# makej: a build tool for J2K projects. The build file is the file "makej" (a simple TOML, written by hand: nano makej) or "makej.jk" (a J2K program).
#   makej [init [-ai|-apk|-game [-os android|jaric|linux]|-pro [NAME]]] [apk|pack|linux|dist|targets] [target] [-v] [-n] [-j N]   makej list   makej clean   makej install FOLDER   makej --version
# This file is the whole tool: the library of makej is inside it and is written to a cache folder at the first run.
MAKEJ_VERSION=@VERSION@
case "${1:-}" in --version|-version) echo "makej $MAKEJ_VERSION"; exit 0 ;; esac
case "${1:-}" in -h|--help|help)
    echo "makej: a build tool for J2K projects (the build file is the file makej in the folder)"
    echo "  makej [target] [-v] [-n] [-j N]     build (-n: only show, -v: say more, -j: many jobs; -j alone = all cores)"
    echo "  makej list | clean | install FOLDER | run | test"
    echo "  makej init [-pro NAME | -game | -apk | -ai]     start a project (-apk: an Android app);   makej apk | pack | dist | targets   (for games)"
    echo "  makej --version"
    exit 0 ;;
esac
case "${1:-}" in -pro|-game|-ai|-apk) first=$1; shift; set -- init "$first" "$@" ;; esac
# makej is built with jcmp 1.2.0.0 or newer (its library uses forms that older compilers do not know: they stop with "unknown escape sequence")
need_jcmp() {
    have="$(jcmp -version 2>/dev/null | cut -d' ' -f2)"
    if [ -z "$have" ]; then echo "makej: the compiler jcmp is not installed (or not in the PATH): jget tool jcmp" >&2; exit 2; fi
    major=${have%%.*}; rest=${have#*.}; minor=${rest%%.*}
    case "$major$minor" in *[!0-9]*) return 0 ;; esac
    if [ "$major" -lt 1 ] || { [ "$major" -eq 1 ] && [ "$minor" -lt 2 ]; }; then
        echo "makej: your jcmp is $have; makej $MAKEJ_VERSION needs jcmp 1.2.0.0 or newer." >&2
        # at a terminal makej offers to update it at once (MAKEJ_UPDATE_JCMP=yes does it without asking, =no never)
        want="${MAKEJ_UPDATE_JCMP:-ask}"
        if [ "$want" = ask ] && [ -t 0 ] && [ -t 2 ] && command -v jget >/dev/null 2>&1; then
            printf 'makej: update jcmp now with  jget tool jcmp ?  [Y/n] ' >&2; read -r ans || ans=n
            case "$ans" in n|N|no) want=no ;; *) want=yes ;; esac
        fi
        if [ "$want" = yes ] && command -v jget >/dev/null 2>&1; then
            jget tool jcmp >&2 && { echo "makej: jcmp is updated; run makej again" >&2; exit 2; }
        fi
        echo "makej: update it with:  jget tool jcmp   (or: jcmp -update)" >&2
        exit 2
    fi
}
case "${1:-}" in --version|-version|-h|--help|help) ;; *) need_jcmp ;; esac
home="${MAKEJ_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/makej/$MAKEJ_VERSION}"
if [ ! -f "$home/makej_file.jk" ]; then
    mkdir -p "$home"
cat > "$home/makej.j" <<'MAKEJ_LIB_EOF'
@LIB_J@
MAKEJ_LIB_EOF
cat > "$home/makej_file.jk" <<'MAKEJ_FILE_EOF'
@LIB_JK@
MAKEJ_FILE_EOF
fi
export J2K_PATH="$home${J2K_PATH:+:$J2K_PATH}"
if [ "${1:-}" = "init" ] && [ "${2:-}" = "-pro" ]; then
    # makej init -pro [NAME]: the structure of a real project
    nm=${3:-}
    if [ -n "$nm" ]; then [ -e "$nm" ] && { echo "makej: $nm exists already" >&2; exit 2; }; mkdir -p "$nm" && cd "$nm"; else nm=$(basename "$PWD"); [ -e makej ] && { echo "makej: the file makej is there already" >&2; exit 2; }; fi
    mkdir -p src/lib tests docs assets scripts
cat > makej <<MAKEJ_PRO_EOF
# the build file of $nm (makej init -pro). makej list shows everything.
#   makej            build the program          makej run     build and run          makej test    build and run the tests
#   makej release    test, then build the files for the systems in manifest.toml (makej dist)
[makej]
out = "_out"

[program.$nm]
main = "src/main.jk"
flags = ""

[program.tests]
main = "tests/run_tests.jk"
flags = "-I src/lib"

[step.run]
run = "_out/$nm"
needs = "$nm"

[step.test]
run = "_out/tests"
needs = "tests"

[step.release]
run = "sh scripts/release.sh"
needs = "tests"
MAKEJ_PRO_EOF
cat > src/main.jk <<'MAKEJ_PRO_MAIN_EOF'
// The program starts here. Put the parts in src/lib/ (each file one idea) and import them next to this file:  #import "lib/util"
#import <stdlib>
#import "lib/util"

int main() {
    cout << "hello, " << greeting("project") << "\n";
    return 0;
}
MAKEJ_PRO_MAIN_EOF
cat > src/lib/util.j <<'MAKEJ_PRO_UTIL_EOF'
// A part of the program. A function here is used from main.jk and from the tests.
String greeting(String who) {
    return "welcome to " + who;
}

int add(int a, int b) {
    return a + b;
}
MAKEJ_PRO_UTIL_EOF
cat > tests/run_tests.jk <<'MAKEJ_PRO_TEST_EOF'
// The tests. makej test builds and runs this; every check that fails is printed and the exit code is 1.
#import <stdlib>
#import "util"          // found through  flags = "-I src/lib"  in the file makej

int failed;

void check(bool ok, String what) {
    if !ok { cerr << "FAIL: " << what << "\n"; failed += 1; }
}

int main() {
    check(add(2, 3) == 5, "add(2, 3) is 5");
    check(greeting("x") == "welcome to x", "greeting");
    if failed == 0 { cout << "all tests passed\n"; return 0; }
    return 1;
}
MAKEJ_PRO_TEST_EOF
cat > scripts/release.sh <<'MAKEJ_PRO_REL_EOF'
#!/bin/sh
# release: the tests first (makej release does that), then the files for the systems of manifest.toml. Raise VERSION and CHANGELOG.md before.
set -eu
cd "$(dirname "$0")/.."
makej dist
echo "release $(cat VERSION): files are in _out/"
MAKEJ_PRO_REL_EOF
cat > manifest.toml <<MAKEJ_PRO_MAN_EOF
# what this project is (read by makej dist / apk / pack)
name = "$nm"
id = "com.example.$(printf '%s' "$nm" | tr -c 'a-z0-9' '_')"
version = "0.1.0"
type = "app"
entry = "_out/$nm"
os = "linux"
MAKEJ_PRO_MAN_EOF
    echo "0.1.0" > VERSION
cat > CHANGELOG.md <<MAKEJ_PRO_CH_EOF
# Changelog

## 0.1.0
* The first version.
MAKEJ_PRO_CH_EOF
cat > README.md <<MAKEJ_PRO_RD_EOF
# $nm

What it is, in two lines.

## Build and run
\`makej\` builds, \`makej run\` runs, \`makej test\` runs the tests, \`makej release\` tests and builds the files for the systems in \`manifest.toml\`.

## Layout
* \`src/main.jk\` the program; \`src/lib/*.j\` its parts
* \`tests/\` the tests (\`makej test\`)
* \`docs/\` design and usage notes
* \`assets/\` pictures, sounds, data the program reads
* \`scripts/\` helper scripts (release)
* \`manifest.toml\` the name, id, version and the systems; \`VERSION\`, \`CHANGELOG.md\`
MAKEJ_PRO_RD_EOF
cat > docs/design.md <<'MAKEJ_PRO_DOC_EOF'
# Design

Why the program is made this way: the parts, the decisions, what is left. Keep it short and true.
MAKEJ_PRO_DOC_EOF
cat > docs/usage.md <<'MAKEJ_PRO_USE_EOF'
# Usage

How to use the program, with examples that work.
MAKEJ_PRO_USE_EOF
printf '_out/\n*.apk\n*.jc\n.makej_*\n' > .gitignore
    echo "makej: wrote the structure of $nm (makej, src/, tests/, docs/, assets/, scripts/, manifest.toml, VERSION, CHANGELOG.md, README.md). Try: makej test, makej run"
    exit 0
fi
if [ "${1:-}" = "init" ] && [ "${2:-}" = "-ai" ]; then
    [ -e makej ] && { echo "makej: the file makej is there already" >&2; exit 2; }
    mkdir -p data
cat > makej <<'MAKEJ_AI_EOF'
# an AI project (makej init -ai). The steps below run only when you name them; each one installs the tool neuron (jget tool neuron) when it is missing.
#   makej train     learns the talk in data/chat.txt and writes the model assistant.jw   (all the AI in one .jw file)
#   makej chat      talks with the model;   makej install   makes it the assistant of this phone (xr, neuron chat)
[makej]
out = "_out"

[step.train]
run = "command -v neuron >/dev/null 2>&1 || jget tool neuron; neuron train data/chat.txt -o assistant.jw -k 12 -d 8 -h 64 -e 6 -r 0.08"

[step.chat]
run = "command -v neuron >/dev/null 2>&1 || jget tool neuron; neuron chat assistant.jw"

[step.install]
run = "command -v neuron >/dev/null 2>&1 || jget tool neuron; neuron install assistant.jw"
MAKEJ_AI_EOF
cat > data/chat.txt <<'MAKEJ_AI_CHAT_EOF'
You: hello
Bot: Hi! I am your helper.
You: what is your name
Bot: I am a small model made with neuron.
You: how are you
Bot: I am fine, thank you.
You: bye
Bot: Goodbye! See you.
You: hello
Bot: Hi! I am your helper.
You: how are you
Bot: I am fine, thank you.
You: what is your name
Bot: I am a small model made with neuron.
You: bye
Bot: Goodbye! See you.
You: hello
Bot: Hi! I am your helper.
You: bye
Bot: Goodbye! See you.
MAKEJ_AI_CHAT_EOF
    echo "makej: wrote makej and data/chat.txt (the talk to learn). Next: jget tool neuron; makej train (writes assistant.jw), makej chat, makej install"; exit 0
fi
if [ "${1:-}" = "targets" ]; then
    cat <<'MAKEJ_TARGETS_EOF'
makej builds a game or program for these systems (set  os = "android jaric linux"  in manifest.toml, or  makej init -game -os android):
  android   makej apk     an Android app, _out/NAME.apk (the runner + your program + jpty + assets)
  jaric     makej pack    a .jc, the package of Jaric OS (a zip: manifest.toml, the program, assets/); the program is ARM64 today and
                          becomes the code for the Jaric OS / the Jaric CPU when the compiler has that target
  linux     makej linux   the program and assets/ in _out/NAME-linux/ (any ARM64 Linux, also Termux)
  makej dist  builds all the systems named in manifest.toml
MAKEJ_TARGETS_EOF
    exit 0
fi
if [ "${1:-}" = "linux" ]; then
    prog=${2:-game}
    sh "$0" "$prog" || exit 2
    nm=$(sed -n 's/^name *= *"\([^"]*\)".*/\1/p' manifest.toml 2>/dev/null | head -1); [ -n "$nm" ] || nm=$prog
    safe=$(printf '%s' "$nm" | tr -c 'A-Za-z0-9._-' '_')
    rm -rf "_out/$safe-linux"; mkdir -p "_out/$safe-linux"
    cp "_out/$prog" "_out/$safe-linux/$prog"
    [ -d assets ] && cp -r assets "_out/$safe-linux/assets"
    echo "makej: built _out/$safe-linux/ (run $prog there; JC_ASSETS=assets finds the data)"
    exit 0
fi
if [ "${1:-}" = "dist" ]; then
    [ -f manifest.toml ] || { echo "makej: there is no manifest.toml here" >&2; exit 2; }
    oses=$(sed -n 's/^os *= *"\([^"]*\)".*/\1/p' manifest.toml | head -1)
    [ -n "$oses" ] || oses="android jaric linux"
    for o in $oses; do
        case "$o" in
            android) sh "$0" apk || exit 2 ;;
            jaric) sh "$0" pack || exit 2 ;;
            linux) sh "$0" linux || exit 2 ;;
            *) echo "makej: unknown system '$o' (makej targets lists them)" >&2; exit 2 ;;
        esac
    done
    exit 0
fi
if [ "${1:-}" = "apk" ]; then
    # makej apk [PROGRAM]: an Android app (an .apk) from the game: the runner (GameActivity) + the program + jpty + assets/. Needs aapt2 ecj d8 zipalign apksigner and android.jar.
    prog=${2:-game}
    [ -f manifest.toml ] || { echo "makej: there is no manifest.toml here (makej init -game writes one)" >&2; exit 2; }
    mk() { sed -n "s/^$1 *= *\"\([^\"]*\)\".*/\1/p" manifest.toml | head -1; }
    mkb() { sed -n "s/^$1 *= *\([a-z]*\).*/\1/p" manifest.toml | head -1; }
    name=$(mk name); id=$(mk id); ver=$(mk version); orient=$(mk orientation); ctrl=$(mkb controls)
    [ -n "$name" ] && [ -n "$id" ] && [ -n "$ver" ] || { echo "makej: manifest.toml needs name, id and version" >&2; exit 2; }
    case "$id" in *.*) ;; *) echo "makej: the id in manifest.toml needs a dot (for example com.you.mygame)" >&2; exit 2 ;; esac
    [ -n "$orient" ] || orient=landscape
    [ -n "$ctrl" ] || ctrl=true
    for t in aapt2 ecj d8 zipalign apksigner keytool; do command -v $t >/dev/null 2>&1 || { echo "makej: $t is needed to make an apk (pkg install aapt2 ecj dx apksigner zipalign openjdk-17)" >&2; exit 2; }; done
    jar=${ANDROID_JAR:-}
    for c in ./android.jar "$HOME/android.jar" "$HOME/.local/share/android/android.jar" "$HOME/Jaric/android.jar" "${PREFIX:-/usr}/share/android/android.jar"; do [ -n "$jar" ] || { [ -f "$c" ] && jar=$c; }; done
    [ -f "$jar" ] || { echo "makej: android.jar was not found; put it in this folder or set ANDROID_JAR=path (it is in the Android SDK: platforms/android-34/android.jar)" >&2; exit 2; }
    jpty=${JPTY:-$(command -v jpty || true)}
    [ -x "$jpty" ] || { echo "makej: jpty was not found (jget tool jpty)" >&2; exit 2; }
    sh "$0" "$prog" || exit 2
    [ -f "_out/$prog" ] || { echo "makej: _out/$prog was not built" >&2; exit 2; }
    w=_out/apk; rm -rf "$w"; mkdir -p "$w/classes" "$w/dex" "$w/gen" "$w/assets/bin" "$w/src/com/j2k/gamerun" "$w/res"
    cp "_out/$prog" "$w/assets/bin/game"; cp "$jpty" "$w/assets/bin/jpty"
    [ -d assets ] && { mkdir -p "$w/assets/data"; cp -r assets/. "$w/assets/data/"; }
cat > "$w/src/com/j2k/gamerun/GameActivity.java" <<'MAKEJ_GA_EOF'
@GAMEACTIVITY@
MAKEJ_GA_EOF
    major=$(echo "$ver" | cut -d. -f1); minor=$(echo "$ver" | cut -d. -f2); patch=$(echo "$ver" | cut -d. -f3)
    code=$(( ${major:-0} * 10000 + ${minor:-0} * 100 + ${patch:-0} )); [ "$code" -ge 1 ] || code=1
    esc_name=$(printf '%s' "$name" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/"/\&quot;/g')
    iconattr=""
    if [ -f icon.png ]; then mkdir -p "$w/res/mipmap-xxhdpi"; cp icon.png "$w/res/mipmap-xxhdpi/ic_launcher.png"; iconattr='android:icon="@mipmap/ic_launcher"'; fi
cat > "$w/AndroidManifest.xml" <<MAKEJ_AM_EOF
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="$id" android:versionCode="$code" android:versionName="$ver">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application $iconattr android:label="$esc_name" android:allowBackup="false" android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <meta-data android:name="controls" android:value="$ctrl" />
        <activity android:name="com.j2k.gamerun.GameActivity" android:exported="true" android:screenOrientation="$orient"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
MAKEJ_AM_EOF
    resarg=""
    if [ -d "$w/res/mipmap-xxhdpi" ]; then aapt2 compile --dir "$w/res" -o "$w/res.zip" || exit 2; resarg="$w/res.zip"; fi
    aapt2 link -o "$w/base.apk" -I "$jar" --manifest "$w/AndroidManifest.xml" --min-sdk-version 29 --target-sdk-version 28 -A "$w/assets" --java "$w/gen" $resarg || { echo "makej: aapt2 failed" >&2; exit 2; }
    ecj -nowarn -source 1.7 -target 1.7 -cp "$jar" -d "$w/classes" "$w/src/com/j2k/gamerun/GameActivity.java" $(find "$w/gen" -name '*.java') || { echo "makej: the runner did not compile" >&2; exit 2; }
    d8 --lib "$jar" --min-api 29 --output "$w/dex" $(find "$w/classes" -name '*.class') || exit 2
    ( cd "$w/dex" && zip -q ../base.apk classes.dex )
    zipalign -f 4 "$w/base.apk" "$w/aligned.apk" || exit 2
    ks=${MAKEJ_KEYSTORE:-$HOME/.jaric-debug.keystore}
    [ -f "$ks" ] || keytool -genkeypair -keystore "$ks" -storepass jaric00 -keypass jaric00 -alias jaric -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=makej debug" >/dev/null 2>&1
    safe=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')
    apksigner sign --ks "$ks" --ks-pass pass:jaric00 --key-pass pass:jaric00 --out "_out/$safe.apk" "$w/aligned.apk" || { echo "makej: signing failed" >&2; exit 2; }
    rm -f "_out/$safe.apk.idsig"
    echo "makej: built _out/$safe.apk ($(wc -c < "_out/$safe.apk") bytes). Install: cp _out/$safe.apk /sdcard/ and open it, or  pm install -r _out/$safe.apk"
    exit 0
fi
APK_INIT=0
if [ "${1:-}" = "init" ] && [ "${2:-}" = "-apk" ]; then      # makej init -apk: a project for an Android app (the same files as -game, os = android)
    APK_INIT=1
    set -- init -game -os android
fi
if [ "${1:-}" = "init" ] && [ "${2:-}" = "-game" ]; then
    [ -e makej ] && { echo "makej: the file makej is there already" >&2; exit 2; }
    gos="android jaric linux"
    if [ "${3:-}" = "-os" ]; then
        case "${4:-}" in android|jaric|linux) gos=$4 ;; all) ;; *) echo "makej: -os needs android, jaric, linux or all (makej targets)" >&2; exit 2 ;; esac
    fi
    mkdir -p src lessons assets
cat > makej <<'MAKEJ_GAME_EOF'
# a game project (makej init -game): Jaric Engine, the library gamej.  Needs it:  jget -li install gamej
#   makej game          build the game          makej run           build and play
#   makej lesson1 ..    build lesson 1 to 5     makej play1 ..      play lesson 1 to 5
#   makej dist          build for every system in manifest.toml (os = ...); makej targets lists them
#   makej apk           build an Android app _out/NAME.apk (needs aapt2 ecj d8 zipalign apksigner and android.jar)
#   makej pack          build NAME.jc, the package of the game (a zip with manifest.toml, the program and assets/)
[makej]
out = "_out"

[program.game]
main = "src/main.jk"
flags = ""

[program.lesson1]
main = "lessons/lesson1.jk"
flags = ""

[program.lesson2]
main = "lessons/lesson2.jk"
flags = ""

[program.lesson3]
main = "lessons/lesson3.jk"
flags = ""

[program.lesson4]
main = "lessons/lesson4.jk"
flags = ""

[program.lesson5]
main = "lessons/lesson5.jk"
flags = ""

[step.run]
run = "_out/game"
needs = "game"

[step.play1]
run = "_out/lesson1"
needs = "lesson1"

[step.play2]
run = "_out/lesson2"
needs = "lesson2"

[step.play3]
run = "_out/lesson3"
needs = "lesson3"

[step.play4]
run = "_out/lesson4"
needs = "lesson4"

[step.play5]
run = "_out/lesson5"
needs = "lesson5"

[step.pack]
run = "zipj -q _out/game.jc manifest.toml _out/game assets"
needs = "game"
MAKEJ_GAME_EOF
cat > manifest.toml <<'MAKEJ_GAME_MANIFEST_EOF'
# the manifest of a .jc package (like AndroidManifest.xml of an apk): what it is and what to run
name = "My Game"
id = "com.example.mygame"
version = "0.1.0"
type = "game"
entry = "_out/game"
icon = "assets/icon.txt"
permissions = ["audio"]        # what the program asks for when jc installs it: files network audio camera location clipboard run sessions assistant
os = "$gos"                    # the systems makej dist builds for: android (apk), jaric (jc), linux  (makej targets)
orientation = "landscape"      # landscape | portrait | sensorLandscape | unspecified (for makej apk)
controls = true                # arrows and two buttons on the screen of the Android app
MAKEJ_GAME_MANIFEST_EOF
sed -i "s/^os = .*/os = \"$gos\"                    # the systems makej dist builds for: android (apk), jaric (jc), linux  (makej targets)/" manifest.toml
printf 'GAME\n' > assets/icon.txt
cat > lessons/lesson1.jk <<'MAKEJ_L1_EOF'
// Lesson 1: a window and a loop.   makej play1   (Esc ends the game)
// A game is a loop: every turn reads the keys, changes the world, draws it. gamej does the rest (the screen, the time, 60 turns a second).
#import <stdlib>
#import <gamej>

int main() {
    Game g = Game::open("lesson 1");          // the whole terminal is the screen; a pixel is half a text cell
    while g.running() {                       // false after Esc or Ctrl-C
        g.begin();                            // reads the keys, measures the time since the last turn (g.dt)
        g.clear(Game::rgb(10, 20, 40));       // colours are rgb(red, green, blue), each 0 .. 255
        g.rect(10, 8, 20, 10, Game::rgb(255, 200, 60));        // x y width height colour
        g.text(12, 12, "HELLO", Game::rgb(0, 0, 0));            // a small font: capitals, digits, signs
        g.end();                              // draws the turn and waits for the next one
    }
    g.close();                                // gives the terminal back
    return 0;
}
MAKEJ_L1_EOF
cat > lessons/lesson2.jk <<'MAKEJ_L2_EOF'
// Lesson 2: move with the keys.   makej play2   (arrows or w a s d; Esc ends)
// g.held(key) is true while a key is pressed lately; g.hit(key) once for each press. Move by speed * g.dt so that the speed is the same on every phone.
#import <stdlib>
#import <gamej>

int main() {
    Game g = Game::open("lesson 2");
    double x = 20.0;
    double y = 20.0;
    double speed = 30.0;                      // pixels per second
    while g.running() {
        g.begin();
        if g.held(Key::left()) || g.held('a') { x -= speed * g.dt; }
        if g.held(Key::right()) || g.held('d') { x += speed * g.dt; }
        if g.held(Key::up()) || g.held('w') { y -= speed * g.dt; }
        if g.held(Key::down()) || g.held('s') { y += speed * g.dt; }
        g.clear(Game::rgb(10, 20, 40));
        g.rect((int)x, (int)y, 6, 6, Game::rgb(120, 220, 255));
        g.end();
    }
    g.close();
    return 0;
}
MAKEJ_L2_EOF
cat > lessons/lesson3.jk <<'MAKEJ_L3_EOF'
// Lesson 3: gravity and a jump.   makej play3   (space jumps, left/right move)
// A speed that changes every turn: gravity adds to vy, the floor stops it.
#import <stdlib>
#import <gamej>

int main() {
    Game g = Game::open("lesson 3");
    double x = 10.0;
    double y = 0.0;
    double vy = 0.0;
    int floor = g.h - 8;
    while g.running() {
        g.begin();
        if g.held(Key::left()) { x -= 30.0 * g.dt; }
        if g.held(Key::right()) { x += 30.0 * g.dt; }
        vy += 120.0 * g.dt;                                     // gravity
        y += vy * g.dt;
        if y >= (double)(floor - 6) { y = (double)(floor - 6); vy = 0.0; if g.hit(Key::space()) { vy = -60.0; } }
        g.clear(Game::rgb(20, 24, 40));
        g.rect(0, floor, g.w, 8, Game::rgb(60, 140, 60));       // the ground
        g.rect((int)x, (int)y, 6, 6, Game::rgb(255, 120, 80));
        g.end();
    }
    g.close();
    return 0;
}
MAKEJ_L3_EOF
cat > lessons/lesson4.jk <<'MAKEJ_L4_EOF'
// Lesson 4: things that fall, a hit, a score.   makej play4   (left/right catch the stars)
// Game::overlap(a, b) tells if two boxes touch. Random numbers: Random::range.
#import <stdlib>
#import <gamej>

int main() {
    Game g = Game::open("lesson 4");
    double px = 30.0;
    double sx = 20.0;
    double sy = 0.0;
    int score = 0;
    while g.running() {
        g.begin();
        if g.held(Key::left()) { px -= 50.0 * g.dt; }
        if g.held(Key::right()) { px += 50.0 * g.dt; }
        if px < 0.0 { px = 0.0; }
        if px > (double)(g.w - 12) { px = (double)(g.w - 12); }
        sy += 40.0 * g.dt;
        if Game::overlap((int)px, g.h - 6, 12, 4, (int)sx, (int)sy, 3, 3) { score += 1; sy = 0.0; sx = (double)(Random::range(2, g.w - 4)); }
        if sy > (double)g.h { sy = 0.0; sx = (double)(Random::range(2, g.w - 4)); score = 0; }       // missed: start again
        g.clear(Game::rgb(8, 8, 24));
        g.rect((int)px, g.h - 6, 12, 4, Game::rgb(120, 220, 255));
        g.circle((int)sx, (int)sy, 1, Game::rgb(255, 230, 80));
        g.text(2, 2, "SCORE " + str(score), Game::rgb(255, 255, 255));
        g.end();
    }
    g.close();
    return 0;
}
MAKEJ_L4_EOF
cat > lessons/lesson5.jk <<'MAKEJ_L5_EOF'
// Lesson 5: pictures made of letters, and a sound.   makej play5   (space makes the sound in the Jaric app)
// g.art(x, y, rows, legend): each letter of the rows is a colour of the legend  <letter>#RRGGBB ; '.' is empty.
#import <stdlib>
#import <gamej>

int main() {
    Game g = Game::open("lesson 5");
    String ship = "..w..\n.www.\nwwrww\nw.w.w";
    String legend = "w#e0e0ffr#ff4040";            // w = pale blue, r = red
    double x = 30.0;
    while g.running() {
        g.begin();
        if g.held(Key::left()) { x -= 40.0 * g.dt; }
        if g.held(Key::right()) { x += 40.0 * g.dt; }
        if g.hit(Key::space()) { g.sound("beep.mp3"); }        // put beep.mp3 in the folder; the Jaric app plays it
        g.clear(Game::rgb(5, 5, 20));
        g.art((int)x, g.h - 8, ship, legend);
        g.text(2, 2, "SHIP", Game::rgb(255, 255, 255));
        g.end();
    }
    g.close();
    return 0;
}
MAKEJ_L5_EOF
cat > src/main.jk <<'MAKEJ_GAME_SRC_EOF'
// Your game. Start from here: makej run (build and play), makej pack (make game.jc). The lessons are in lessons/ (makej play1 .. play5).
//   Dodge the blocks: left/right move, space speeds up the world. Esc ends.
#import <stdlib>
#import <gamej>

int main() {
    Game g = Game::open("My Game");
    double px = 40.0;
    double[] bx = arr(8);
    double[] by = arr(8);
    for i in 0..6 { bx.push((double)Random::range(2, g.w - 6)); by.push(0.0 - (double)(i * 12)); }
    int best = 0;
    double alive_time = 0.0;
    double speed = 30.0;
    while g.running() {
        g.begin();
        if g.held(Key::left()) { px -= 60.0 * g.dt; }
        if g.held(Key::right()) { px += 60.0 * g.dt; }
        if px < 0.0 { px = 0.0; }
        if px > (double)(g.w - 8) { px = (double)(g.w - 8); }
        alive_time += g.dt;
        speed = 30.0 + alive_time * 2.0;
        bool dead = false;
        for i in 0..6 {
            by[i] = by[i] + speed * g.dt;
            if by[i] > (double)g.h { by[i] = -4.0; bx[i] = (double)Random::range(2, g.w - 6); }
            if Game::overlap((int)px, g.h - 6, 8, 4, (int)bx[i], (int)by[i], 4, 4) { dead = true; }
        }
        if dead {
            if (int)alive_time > best { best = (int)alive_time; }
            alive_time = 0.0;
            for i in 0..6 { by[i] = 0.0 - (double)(i * 12); }
        }
        g.clear(Game::rgb(12, 14, 30));
        g.rect((int)px, g.h - 6, 8, 4, Game::rgb(120, 220, 255));
        for i in 0..6 { g.rect((int)bx[i], (int)by[i], 4, 4, Game::rgb(255, 90, 90)); }
        g.text(2, 2, "TIME " + str((int)alive_time) + "  BEST " + str(best), Game::rgb(255, 255, 255));
        g.end();
    }
    g.close();
    return 0;
}
MAKEJ_GAME_SRC_EOF
cat > README.md <<'MAKEJ_GAME_README_EOF'
# My game (made with makej init -game and Jaric Engine)

* `jget -li install gamej` once; then `makej run` plays the game, `makej apk` makes an Android app (`_out/NAME.apk`: install it on the phone), `makej pack` makes `game.jc` (the package of the game: a zip with `manifest.toml`, the program and `assets/`).
* Learn: `makej play1` ... `makej play5` (the files are in `lessons/`, each short, with comments): 1 window and loop, 2 move, 3 gravity and jump, 4 falling things, hit and score, 5 pictures and sound.
* Jaric Engine = the library `<gamej>`: see `jcmp -showlib gamej` or the top of `~/.j2k/Library/gamej.j`. Draw: clear pixel rect frame_rect line circle text art. Input: held hit. Time: g.dt. Collision: Game::overlap. Sound: g.sound.
* ภาษาไทย: ไลบรารีชื่อ `<gamej>` วาดบนเทอร์มินัลทั้งจอ (1 ช่อง = 2 พิกเซล) เกมคือลูป: อ่านปุ่ม -> เปลี่ยนโลก -> วาด; ใช้ `g.dt` เพื่อให้ความเร็วเท่ากันทุกเครื่อง
MAKEJ_GAME_README_EOF
    echo "makej: wrote makej, manifest.toml, src/main.jk, lessons/lesson1..5.jk, README.md (jget -li install gamej; then makej run, makej play1)"
    if [ "$gos" = "android" ] || [ "$APK_INIT" = 1 ]; then
        echo "makej: this is an Android app project: makej run tries it here, makej apk builds _out/NAME.apk"
        miss=""
        for t in aapt2 ecj d8 zipalign apksigner keytool; do command -v $t >/dev/null 2>&1 || miss="$miss $t"; done
        [ -f "${ANDROID_JAR:-$HOME/android.jar}" ] || [ -f "$HOME/android-jar/android.jar" ] || miss="$miss android.jar"
        [ -z "$miss" ] && echo "makej: every tool for an apk is there" || echo "makej: to build the apk you still need:$miss   (pkg install aapt2 ecj dx apksigner; android.jar: see README.md)"
    fi
    exit 0
fi
if [ "${1:-}" = "init" ]; then
    [ -e makej ] && { echo "makej: the file makej is there already" >&2; exit 2; }
cat > makej <<'MAKEJ_INIT_EOF'
# the build file of this project (nano makej). Run it with:  makej   or   makej NAME   (-v shows the commands)
[makej]
out = "_out"

[program.hello]
main = "src/hello.jk"
flags = ""

[step.run]
run = "_out/hello"
needs = "hello"
MAKEJ_INIT_EOF
    echo "makej: wrote the file makej"; exit 0
fi
mkdir -p _out
if [ -f makej.jk ]; then src=makej.jk
elif [ -f makej ]; then src="$home/makej_file.jk"
else echo "makej: there is no makej.jk and no file makej in this folder (makej init writes one)" >&2; exit 2; fi
jcmp "$src" -o _out/.makej_run >/dev/null 2>_out/.makej_err || { cat _out/.makej_err >&2; echo "makej: the build file does not compile" >&2; exit 2; }
exec _out/.makej_run "$@"
