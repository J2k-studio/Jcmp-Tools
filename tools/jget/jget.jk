// jget -- download files from the web, and libraries for the J2K language
//
//   jget URL                      save the file at URL in the current folder (the name is the last part of the address);
//                                 when the output goes to a pipe or a file (jget URL | sh) the data goes there instead
//   jget -O URL                   save the file with the name in the address, even when the output goes to a pipe
//   jget URL -o FILE              save it as FILE   (-o - writes it to the screen)
//   jget -h URL ...               the same (-h = http: the address follows)
//   (a downloaded script or program is made executable by itself, unless it already is; -x does it for any file)
//   jget -m URL ...               songs from links go to the music folder (~/music, or $MUJIC_DIR): mujic plays them
//   jget -sh URL [args]           download a shell script and run it at once (what  curl URL | sh  does), then delete it
//   jget -jsh URL [args]          the same, run by jsh (the shell of Jaric)
//   jget --install [DIR]          copy this program into DIR (default: $PREFIX/bin on Termux, else ~/.local/bin)
//   jget --update                 replace this program by the latest release
//   jget -q ...                   no progress bar
//   jget -li list                 the libraries of the index (a * marks the installed ones)
//   jget -li install NAME         download a library, check its SHA-256 against the index, put it in the library folder
//   jget -li unstall NAME         delete an installed library (remove and uninstall work too)
//   jget -li installed            the libraries in the library folder
//   jget --version | --help
//
// A progress bar (percent, size, speed) is drawn on the screen when the error output is a terminal.
// http:// and https:// addresses are fetched by jget itself (it looks the name up with DNS, speaks TLS 1.3 with the check of the
// certificate, and HTTP/1.1: redirects, chunked answers; big files are written to disk as they arrive). A server that cannot talk
// TLS 1.3 with ChaCha20, and the other kinds of address (file://, ftp://), are fetched by curl, or by wget when there is no curl.
// The trusted roots are those of the system (or the file named in J2K_CA). A certificate that is refused is never retried with curl.
//
// Libraries: the index is a text file, a line for each library:  NAME VERSION URL SHA256   (# starts a comment).
//   URL may be several addresses separated by | (mirrors, tried in order).
//   JGET_INDEX  one or more addresses of an index, separated by spaces (mirrors) - default: the index of the project
//   JGET_LIB    the library folder - default: ~/.j2k/Library, where `#import <name>` looks for libraries
// A library is one J2K source file NAME.j. Nothing from a library is run when it is installed.
#import <stdlib>
#import <deflate>
using stdlib;

String jget_version() { return "0.7.6"; }
String default_index() { return "https://raw.githubusercontent.com/J2k-studio/Jcmp-libs/main/index.txt"; }

int g_quiet;                 // -q: no progress bar
int g_exec;                  // -x: make the downloaded file executable

// the error output (the language has no cerr yet)
void err(String m) {
    Sys::write(2, m.c(), m.len);
}

bool is_tty() {
    return Sys::isatty(2) == 0;
}

String lib_dir() {
    switch Env::get("JGET_LIB") {
        Option::Some(d): return d;
        Option::None: { }
    }
    switch Env::get("HOME") {
        Option::Some(h): return h + "/.j2k/Library";
        Option::None: return "./Library";
    }
    return "./Library";
}

// the addresses of the index, in the order to try
String[] index_addresses() {
    String spec = default_index();
    switch Env::get("JGET_INDEX") {
        Option::Some(u): { if u.trim().len > 0 { spec = u; } }
        Option::None: { }
    }
    String[] all = spec.split(" ");
    String[] r = arr(0);
    for i in 0..all.len {
        String a = all[i].trim();
        if a.len > 0 { r.push(a); }
    }
    return r;
}

// a name is letters, digits and _ only: it becomes a file name, so no / and no ..
bool name_ok(String n) {
    if n.len == 0 || n.len > 60 { return false; }
    for i in 0..n.len {
        int c = n[i];
        bool good = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if !good { return false; }
    }
    return true;
}

// run a program and give its exit code (127: it was not found or could not start)
int run_prog(String cmd, String[] args) {
    switch Proc::run(cmd, args) {
        Result::Ok(code): return code;
        Result::Err(e): return 127;
    }
    return 127;
}

// the name of the file for an address: the last part of the path, without ? and #; index.html when there is none
String name_of(String url) {
    String u = url;
    int q = u.find("?");
    if q >= 0 { u = u.slice(0, q); }
    int h = u.find("#");
    if h >= 0 { u = u.slice(0, h); }
    int scheme = u.find("://");
    if scheme >= 0 { u = u.slice(scheme + 3, u.len); }
    int slash = u.find("/");
    if slash < 0 { return "index.html"; }
    String path = u.slice(slash, u.len);
    int last = 0;
    for i in 0..path.len {
        if path[i] == '/' { last = i + 1; }
    }
    String n = url_decode(path.slice(last, path.len));
    if n.len == 0 || n == "." || n == ".." { return "index.html"; }
    return n;
}

int hex_digit(int c) {
    if c >= '0' && c <= '9' { return c - '0'; }
    if c >= 'a' && c <= 'f' { return c - 'a' + 10; }
    if c >= 'A' && c <= 'F' { return c - 'A' + 10; }
    return -1;
}

// %20 -> a space, %E0%B8... -> the letters; a / or a zero byte in it becomes _ (the name stays one file name)
String url_decode(String s) {
    String r = "";
    int i = 0;
    while i < s.len {
        if s[i] == '%' && i + 2 < s.len && hex_digit(s[i + 1] & 255) >= 0 && hex_digit(s[i + 2] & 255) >= 0 {
            int c = hex_digit(s[i + 1] & 255) * 16 + hex_digit(s[i + 2] & 255);
            if c == '/' || c == 0 { c = '_'; }
            r.push((char)c);
            i += 3;
        } else { r.push(s[i]); i += 1; }
    }
    return r;
}

// the folder for songs: $MUJIC_DIR, else ~/music
String music_folder() {
    switch Env::get("MUJIC_DIR") {
        Option::Some(d): { if d.len > 0 { return d; } }
        Option::None: { }
    }
    String home = ".";
    switch Env::get("HOME") {
        Option::Some(h): { home = h; }
        Option::None: { }
    }
    return Path::join(home, "music");
}

bool has_audio_ext(String n) {
    String l = n.lower();
    return l.ends_with(".mp3") || l.ends_with(".ogg") || l.ends_with(".m4a") || l.ends_with(".flac") || l.ends_with(".wav") || l.ends_with(".opus") || l.ends_with(".aac");
}

// jget -m URL ...: songs from links go to the music folder (the name from the link; .mp3 is added when it has no sound extension)
int cmd_music(String[] av, int at) {
    if av.len <= at { return usage(); }
    String dir = music_folder();
    if !Dir::exists(dir) { Dir::make_all(dir); }
    int rc = 0;
    for i in at..av.len {
        String n = name_of(av[i]);
        if n == "index.html" { n = "song"; }
        if !has_audio_ext(n) { n = n + ".mp3"; }
        String to = Path::join(dir, n);
        if download(av[i], to, g_quiet == 1) { cout << "saved " << to << nl; } else { rc = 1; }
    }
    return rc;
}

// move a finished file into place (a rename: the file is whole or it is not there)
bool put_in_place(String part, String to) {
    int r = Sys::rename(part.c(), to.c());
    if r < 0 {
        err("jget: cannot write " + to + ": " + Error::reason(r) + "\n");
        Sys::unlink(part.c());
        return false;
    }
    return true;
}

// curl, or wget when there is no curl; the file is written to to.part and renamed when it is whole. false (with a message) when it cannot
bool download_external(String address, String to, bool quiet) {
    bool show = !quiet && is_tty() && to != "-";
    String target = to + ".part";
    String[] a = arr(0);
    a.push("-fL");
    if show { a.push("--progress-bar"); } else { a.push("-sS"); }
    if to != "-" {
        a.push("-o");
        a.push(target);
    }
    a.push(address);
    int code = run_prog("curl", a);
    if code == 127 {
        String[] w = arr(0);
        if !show { w.push("-q"); }
        w.push("-O");
        if to == "-" { w.push("-"); } else { w.push(target); }
        w.push(address);
        code = run_prog("wget", w);
        if code == 127 {
            err("jget: neither curl nor wget was found; jget fetches http:// and https:// addresses by itself, but this one failed and the other kinds of address need curl or wget: " + address + "\n");
            return false;
        }
    }
    if code != 0 {
        if to != "-" { Sys::unlink(target.c()); }
        err("jget: cannot fetch " + address + " (exit code " + str(code) + ")\n");
        return false;
    }
    if to == "-" { return true; }
    return put_in_place(target, to);
}

// a refusal because of the certificate or the proof of the key: curl would not be asked then (the answer is "no")
bool security_refusal(String why) {
    return why.contains("certificate") || why.contains("not trusted") || why.contains("did not prove");
}

// fetch one address; to = "-" writes it to the screen. false (with a message) when it cannot
bool download_one(String address, String to, bool quiet) {
    String native_err = "";
    if address.starts_with("http://") || address.starts_with("https://") {
        if to == "-" {
            switch Net::http.try_get(address) {
                Result::Ok(body): { Sys::write(1, body.c(), body.len); return true; }
                Result::Err(e): { native_err = e.message; }
            }
        } else {
            int show = 1;
            if quiet { show = 0; }
            switch Net::http.try_download(address, to, show) {
                Result::Ok(n): { return true; }
                Result::Err(e): { native_err = e.message; }
            }
        }
        // the server answered with an error (curl would get the same answer), or the certificate was refused
        if native_err.starts_with("HTTP ") || security_refusal(native_err) {
            err("jget: " + native_err + "\n");
            return false;
        }
    }
    // other addresses (file://, ftp://), and a failure of the native client that curl or wget may do better (a server with an older TLS)
    if download_external(address, to, quiet) { return true; }
    if native_err.len > 0 { err("jget: " + native_err + "\n"); }
    return false;
}

// spec = one address, or several separated by | (the same file on several servers): the first that works
bool download(String spec, String to, bool quiet) {
    String[] list = spec.split("|");
    for i in 0..list.len {
        if list[i].trim().len > 0 {
            if download_one(list[i].trim(), to, quiet) { return true; }
        }
    }
    return false;
}

bool make_dir(String dir) {
    switch Dir::make_all(dir) {
        Result::Ok(x): return true;
        Result::Err(e): { err("jget: cannot make the folder " + dir + ": " + e.message + "\n"); return false; }
    }
    return false;
}

// the text of the index, from the first address that works
String fetch_index(String dir) {
    String[] where = index_addresses();
    String tmp = dir + "/.index.tmp";
    for i in 0..where.len {
        if download_one(where[i], tmp, true) {
            switch Fs::read_text(tmp) {
                Result::Ok(t): { Fs::remove(tmp); return t; }
                Result::Err(e): { err("jget: cannot read the index: " + e.message + "\n"); }
            }
        }
    }
    err("jget: the index of libraries could not be fetched; set JGET_INDEX to the address (or the path) of an index\n");
    return "";
}

// the line of the index for `name`, split in four; an empty list when there is none
String[] find_entry(String index, String name) {
    String[] lines = index.split("\n");
    for i in 0..lines.len {
        String line = lines[i].trim();
        if line.len == 0 || line.starts_with("#") { continue; }
        String[] w = line.split(" ");
        if w.len >= 4 && w[0] == name { return w; }
    }
    String[] none = arr(0);
    return none;
}

// the libraries that come with the compiler (its folder Library): #import <name> needs no install
bool builtin_name(String n) {
    String[] b = "stdlib std core number text files system time data crypto net math cpu vector matrix".split(" ");
    for i in 0..b.len {
        if b[i] == n { return true; }
    }
    return false;
}

int cmd_install(String name) {
    if name == "gfx" {
        // the graphics library is made of canvas and screen
        int a = cmd_install("canvas");
        int b = cmd_install("screen");
        if a != 0 { return a; }
        return b;
    }
    if builtin_name(name) {
        cout << name << " is part of the standard library (installed with the compiler): write  #import <" << name << ">  in your program; nothing to install" << nl;
        return 0;
    }
    if !name_ok(name) {
        err("jget: '" + name + "' is not a library name (letters, digits and _ only)\n");
        return 1;
    }
    String dir = lib_dir();
    if !make_dir(dir) { return 1; }
    String index = fetch_index(dir);
    if index.len == 0 { return 1; }
    String[] e = find_entry(index, name);
    if e.len < 4 {
        err("jget: the index has no library named '" + name + "' (try: jget -li list)\n");
        return 1;
    }
    String tmp = dir + "/." + name + ".tmp";
    if !download(e[2], tmp, g_quiet == 1) { return 1; }
    switch Sha256::file(tmp) {
        Result::Ok(h): {
            if h != e[3] {
                Fs::remove(tmp);
                err("jget: the checksum of " + name + " does not match the index, nothing was installed\n");
                err("  index: " + e[3] + "\n");
                err("  file : " + h + "\n");
                return 1;
            }
        }
        Result::Err(er): {
            err("jget: cannot check the file: " + er.message + "\n");
            return 1;
        }
    }
    String target = dir + "/" + name + ".j";
    switch Fs::rename(tmp, target) {
        Result::Ok(x): { cout << "installed " << name << " " << e[1] << " in " << target << nl; return 0; }
        Result::Err(er): { err("jget: cannot install: " + er.message + "\n"); return 1; }
    }
    return 1;
}

int cmd_remove(String name) {
    if !name_ok(name) {
        err("jget: '" + name + "' is not a library name\n");
        return 1;
    }
    String target = lib_dir() + "/" + name + ".j";
    if !Fs::exists(target) {
        err("jget: " + name + " is not installed\n");
        return 1;
    }
    switch Fs::remove(target) {
        Result::Ok(x): { cout << "removed " << name << nl; return 0; }
        Result::Err(er): { err("jget: cannot remove: " + er.message + "\n"); return 1; }
    }
    return 1;
}

int cmd_list() {
    String dir = lib_dir();
    if !make_dir(dir) { return 1; }
    String index = fetch_index(dir);
    if index.len == 0 { return 1; }
    String[] lines = index.split("\n");
    for i in 0..lines.len {
        String line = lines[i].trim();
        if line.len == 0 || line.starts_with("#") { continue; }
        String[] w = line.split(" ");
        if w.len < 4 { continue; }
        String mark = " ";
        if Fs::exists(dir + "/" + w[0] + ".j") { mark = "*"; }
        cout << mark << " " << w[0] << " " << w[1] << nl;
    }
    return 0;
}

int cmd_installed() {
    String dir = lib_dir();
    switch Dir::list(dir) {
        Result::Ok(names): {
            for i in 0..names.len {
                if names[i].ends_with(".j") && !names[i].starts_with(".") {
                    cout << names[i].slice(0, names[i].len - 2) << nl;
                }
            }
            return 0;
        }
        Result::Err(er): { cout << "(no libraries installed)" << nl; return 0; }
    }
    return 0;
}

int usage() {
    err("usage: jget URL [-o FILE]               download a file (to a pipe or a file when the output goes there: jget URL | sh)\n");
    err("       jget -O URL                      save it with the name in the address (even in a pipe)\n");
    err("       jget -x URL                      and make the file executable\n");
    err("       jget -m URL ...                  songs from links go to ~/music (or $MUJIC_DIR)\n");
    err("       jget -sh URL [args]              download a script and run it at once\n");
    err("       jget -jsh URL [args]             the same with jsh (a script of Jaric, first line [#jsh])\n");
    err("       jget -q URL                      without the progress bar\n");
    err("       jget --install [DIR] | --update  install this program / replace it by the latest release\n");
    err("       jget tool list | NAME ...        the tools of Jcmp-Tools (jsh, jbox, coderin, makej ...): install them next to jget
       jget -li list | installed        libraries (the index / the installed ones)\n");
    err("       jget -li install NAME            install a library\n");
    err("       jget -li unstall NAME            remove a library\n");
    err("       jget untar FILE [DIR]            open a .tar or a .tar.gz (.tgz) here or in DIR\n");
    err("       jget --version\n");
    return 1;
}

bool is_address(String s) {
    return s.starts_with("http://") || s.starts_with("https://") || s.starts_with("ftp://") || s.starts_with("file://");
}

// does the file start with #! (a script) or with the mark of a program (ELF)?
bool is_program(String path) {
    int fd = Sys::open_read(path.c());
    if fd < 0 { return false; }
    char four[8];
    int n = Sys::read(fd, @four, 4);
    Sys::close(fd);
    if n >= 2 && four[0] == '#' && four[1] == '!' { return true; }
    return n == 4 && four[0] == 127 && four[1] == 'E' && four[2] == 'L' && four[3] == 'F';
}

// after a download: a script or a program that is not executable becomes executable (where it can be read);
// one that already is executable is left alone; -x does it for any file
void after_download(String to) {
    if to == "-" { return; }
    int st[18];
    if Sys::stat(to.c(), @st) != 0 { return; }
    int mode = st[2] & 0xFFFFFFFF;
    if g_exec != 1 {
        if (mode & 73) != 0 { return; }                   // already executable (0111): not touched
        if !is_program(to) { return; }
    }
    int fresh = (mode & 4095) | ((mode & 292) >> 2);       // x where r is (0444 -> 0111)
    if g_exec == 1 { fresh = (mode & 4095) | 73 | ((mode & 292) >> 2); }
    int r = Sys::chmod(to.c(), fresh);
    if r < 0 { err("jget: cannot make " + to + " executable: " + Error::reason(r) + "\n"); }
}

// jget URL [-o FILE]  (-h before the address is allowed: it only says that an address follows)
// Where the data goes: -o FILE; else -O (the name in the address); else, when the output of jget goes to another program or a file (jget URL | sh),
// to the output; else (a terminal) to a file named like the end of the address.
int cmd_fetch(String[] av, int at) {
    String url = "";
    String to = "";
    bool by_name = false;
    int i = at;
    while i < av.len {
        if av[i] == "-h" { i += 1; }
        else if av[i] == "-O" { by_name = true; i += 1; }
        else if av[i] == "-o" && av.len > i + 1 { to = av[i + 1]; i += 2; }
        else if url.len == 0 { url = av[i]; i += 1; }
        else { return usage(); }
    }
    if url.len == 0 { return usage(); }
    if to.len == 0 {
        if by_name || Sys::isatty(1) == 0 { to = name_of(url); } else { to = "-"; }
    }
    if download(url, to, g_quiet == 1) {
        after_download(to);
        return 0;
    }
    return 1;
}

// jget -sh URL [args]: download a script, run it with sh (-jsh: with jsh, the shell of Jaric), delete it
int cmd_run_script(String[] av, int at, String shell) {
    if av.len <= at { return usage(); }
    String url = av[at];
    String tmp = "/data/local/tmp/.jget_script";
    switch Env::get("TMPDIR") {
        Option::Some(t): { tmp = t + "/.jget_script." + str(Sys::getpid()); }
        Option::None: { tmp = "/tmp/.jget_script." + str(Sys::getpid()); }
    }
    if !download(url, tmp, true) { return 1; }
    String[] args = arr(0);
    args.push(tmp);
    for i in at + 1..av.len { args.push(av[i]); }
    int code = run_prog(shell, args);
    Fs::remove(tmp);
    return code;
}

// the path of this program
String self_path() {
    char buf[300];
    int n = Sys::readlink("/proc/self/exe", @buf, 290);
    String r = "";
    if n <= 0 { return r; }
    for i in 0..n { r.push(buf[i]); }
    return r;
}

String default_bin_dir() {
    switch Env::get("PREFIX") {
        Option::Some(p): { if p.len > 0 { return p + "/bin"; } }
        Option::None: { }
    }
    switch Env::get("HOME") {
        Option::Some(h): return h + "/.local/bin";
        Option::None: return "./bin";
    }
    return "./bin";
}

// copy the file `from` to `to` (to.new first, then renamed), with the permissions of an executable; any bytes
bool install_file(String from, String to) {
    int in = Sys::open_read(from.c());
    if in < 0 { err("jget: cannot read " + from + ": " + Error::reason(in) + "\n"); return false; }
    String tmp = to + ".new";
    int out = Sys::open(tmp.c(), 577, 493);
    if out < 0 {
        Sys::close(in);
        err("jget: cannot write " + tmp + ": " + Error::reason(out) + "\n");
        return false;
    }
    char buf[8192];
    bool ok = true;
    while true {
        int n = Sys::read(in, @buf, 8192);
        if n < 0 { ok = false; break; }
        if n == 0 { break; }
        int off = 0;
        while off < n {
            int w = Sys::write(out, @buf + off, n - off);
            if w <= 0 { ok = false; break; }
            off += w;
        }
        if !ok { break; }
    }
    Sys::close(in);
    Sys::close(out);
    if !ok {
        Sys::unlink(tmp.c());
        err("jget: cannot copy " + from + "\n");
        return false;
    }
    Sys::chmod(tmp.c(), 493);
    return put_in_place(tmp, to);
}

// jget --install [DIR]
int cmd_install_self(String[] av, int at) {
    String dir = default_bin_dir();
    if av.len > at { dir = av[at]; }
    if !make_dir(dir) { return 1; }
    String me = self_path();
    if me.len == 0 { err("jget: cannot find where this program is\n"); return 1; }
    if !install_file(me, dir + "/jget") { return 1; }
    cout << "installed jget in " << dir << "/jget" << nl;
    return 0;
}

// jget --update: the latest release replaces this program (checked with its SHA-256)
int cmd_update_self() {
    String me = self_path();
    if me.len == 0 { err("jget: cannot find where this program is\n"); return 1; }
    // the newest version of jget is the text of tools/jget/LATEST in the repository of the tools (a release of another tool cannot be mistaken for it)
    String lv = me + ".latest";
    if !download("https://raw.githubusercontent.com/J2k-studio/Jcmp-Tools/main/tools/jget/LATEST", lv, true) { return 1; }
    String ver = "";
    switch Fs::read_text(lv) {
        Result::Ok(t): { ver = t.trim(); }
        Result::Err(e): { }
    }
    Fs::remove(lv);
    if ver.len == 0 { err("jget: cannot read the newest version\n"); return 1; }
    String base = "https://github.com/J2k-studio/Jcmp-Tools/releases/download/jget-v" + ver;
    String tmp = me + ".new";
    String sums = me + ".sums";
    if !download(base + "/SHA256SUMS", sums, true) { return 1; }
    if !download(base + "/jget", tmp, g_quiet == 1) { Fs::remove(sums); return 1; }
    String want = "";
    switch Fs::read_text(sums) {
        Result::Ok(t): {
            String[] lines = t.split("\n");
            for i in 0..lines.len {
                String[] w = lines[i].trim().split(" ");
                if w.len >= 2 && w[w.len - 1] == "jget" { want = w[0]; }
            }
        }
        Result::Err(e): { }
    }
    Fs::remove(sums);
    String have = "";
    switch Sha256::file(tmp) {
        Result::Ok(h): { have = h; }
        Result::Err(e): { }
    }
    if want.len == 0 || want != have {
        Fs::remove(tmp);
        err("jget: the checksum of the new program does not match, nothing was changed\n");
        return 1;
    }
    Sys::chmod(tmp.c(), 493);
    if !put_in_place(tmp, me) { return 1; }
    cout << "jget is updated" << nl;
    return 0;
}

// ---- tar files (no compression): the files that belong to a tool, such as the library of the compiler
bool read_exact(int fd, char^ buf, int n) {
    int got = 0;
    while got < n {
        int r = Sys::read(fd, buf + got, n - got);
        if r <= 0 { return false; }
        got += r;
    }
    return true;
}
int tar_number(char^ p, int len) {
    int v = 0;
    for i in 0..len {
        int c = p[i] & 255;
        if c >= '0' && c <= '7' { v = v * 8 + (c - '0'); } else if v > 0 { break; }
    }
    return v;
}
// puts the files of the tar into the folder dir; a name with .. or a name that starts with / is refused
// a tar that is packed with gzip (the files of a tool, a .tar.gz): unpacked next to itself first, then read as a tar
bool untar(String path, String dir) {
    int g = Sys::open_read(path.c());
    if g < 0 { err("jget: cannot read " + path + "\n"); return false; }
    char magic[2];
    int got = Sys::read(g, @magic, 2);
    Sys::close(g);
    if got == 2 && (magic[0] & 255) == 31 && (magic[1] & 255) == 139 {
        Result<String, Error> rz = Fs::read_bytes(path);
        if !rz.is_ok() { err("jget: cannot read " + path + "\n"); return false; }
        bool zok = false;
        String plain = Gzip::unpack(rz.take(), @zok);
        if !zok { err("jget: the gzip file " + path + " is damaged\n"); return false; }
        String tmp = path + ".plain";
        if !Fs::write_bytes(tmp, plain).is_ok() { err("jget: cannot write " + tmp + "\n"); return false; }
        plain = "";
        bool good = untar_plain(tmp, dir);
        Fs::remove(tmp);
        return good;
    }
    return untar_plain(path, dir);
}

bool untar_plain(String path, String dir) {
    int fd = Sys::open_read(path.c());
    if fd < 0 { err("jget: cannot read " + path + "\n"); return false; }
    char h[512];
    char blk[4096];
    bool ok = true;
    while ok {
        if !read_exact(fd, @h, 512) { break; }
        if h[0] == 0 { break; }
        String name = "";
        for i in 0..100 { if h[i] != 0 { name.push(h[i]); } else { break; } }
        String prefix = "";
        if h[257] == 'u' && h[258] == 's' && h[259] == 't' {
            for i in 345..500 { if h[i] != 0 { prefix.push(h[i]); } else { break; } }
        }
        if prefix.len > 0 { name = prefix + "/" + name; }
        int size = tar_number(@h + 124, 12);
        int kind = h[156] & 255;
        bool bad = name.len == 0 || name[0] == '/';
        for i in 0..name.len { if name[i] == '.' && i + 1 < name.len && name[i + 1] == '.' { bad = true; } }
        if bad { err("jget: a file name in the tar is not allowed: " + name + "\n"); ok = false; break; }
        String full = dir + "/" + name;
        if kind == '5' || name[name.len - 1] == '/' {
            if !make_dir(full) { ok = false; }
        } else if kind == '0' || kind == 0 {
            int slash = 0 - 1;
            for i in 0..full.len { if full[i] == '/' { slash = i; } }
            if slash > 0 { make_dir(full.slice(0, slash)); }
            int out = Sys::open_write(full.c());
            if out < 0 { err("jget: cannot write " + full + "\n"); ok = false; break; }
            int left = size;
            while left > 0 {
                int n = left;
                if n > 4096 { n = 4096; }
                if !read_exact(fd, @blk, n) { ok = false; break; }
                Sys::write(out, @blk, n);
                left -= n;
            }
            Sys::close(out);
            int mode = tar_number(@h + 100, 8);
            if (mode & 64) != 0 { Sys::chmod(full.c(), 493); }          // the x bit of the tar: a program stays a program (0755)
            int pad = (512 - size % 512) % 512;
            if pad > 0 && ok { if !read_exact(fd, @blk, pad) { ok = false; } }
        } else {
            int skip = (size + 511) / 512 * 512;                    // another kind of entry (a link ...): skipped
            while skip > 0 {
                int n = skip;
                if n > 4096 { n = 4096; }
                if !read_exact(fd, @blk, n) { ok = false; break; }
                skip -= n;
            }
        }
    }
    Sys::close(fd);
    return ok;
}

// jget tool list | jget tool NAME ... : the tools of Jcmp-Tools (jsh, jbox, coderin, makej ...), put next to jget, checked with their SHA-256
int cmd_tool(String[] av, int at) {
    String me = self_path();
    if me.len == 0 { err("jget: cannot find where this program is\n"); return 1; }
    String dir = default_bin_dir();
    int slash = 0 - 1;
    for i in 0..me.len { if me[i] == '/' { slash = i; } }
    if slash > 0 { dir = me.slice(0, slash); }                      // the tools go where jget is
    String list = me + ".tools";
    if !download("https://raw.githubusercontent.com/J2k-studio/Jcmp-Tools/main/tools.txt", list, true) { return 1; }
    String text = "";
    switch Fs::read_text(list) {
        Result::Ok(t): { text = t; }
        Result::Err(e): { }
    }
    Fs::remove(list);
    if av.len <= at || av[at] == "list" {
        String[] ls = text.split("\n");
        for i in 0..ls.len {
            if ls[i].len == 0 || ls[i][0] == '#' { continue; }
            String[] parts = ls[i].split("|");
            if parts.len >= 2 { cout << "  " << parts[0] << "   " << parts[1] << nl; }
        }
        if av.len <= at { cout << "jget tool NAME installs one (more than one: jget tool jsh jbox coderin)" << nl; }
        return 0;
    }
    // `all` is every tool but jget itself
    String[] wanted = arr(8);
    for k in at..av.len {
        if av[k] == "all" {
            String[] tl = text.split("\n");
            for i in 0..tl.len {
                if tl[i].len == 0 || tl[i][0] == '#' { continue; }
                String[] parts = tl[i].split("|");
                if parts.len >= 2 && parts[0] != "jget" { wanted.push(parts[0]); }
            }
        } else { wanted.push(av[k]); }
    }
    int rc = 0;
    for k in 0..wanted.len {
        String name = wanted[k];
        bool known = false;
        String[] ls = text.split("\n");
        for i in 0..ls.len { if ls[i].starts_with(name + "|") { known = true; } }
        if !known { err("jget: there is no tool '" + name + "' (jget tool list shows them)\n"); rc = 1; continue; }
        String lv = dir + "/." + name + ".latest";
        if !download("https://raw.githubusercontent.com/J2k-studio/Jcmp-Tools/main/tools/" + name + "/LATEST", lv, true) { rc = 1; continue; }
        String ver = "";
        switch Fs::read_text(lv) {
            Result::Ok(t): { ver = t.trim(); }
            Result::Err(e): { }
        }
        Fs::remove(lv);
        if ver.len == 0 { err("jget: cannot read the newest version of " + name + "\n"); rc = 1; continue; }
        String base = "https://github.com/J2k-studio/Jcmp-Tools/releases/download/" + name + "-v" + ver;
        String tmp = dir + "/." + name + ".new";
        String sums = dir + "/." + name + ".sums";
        if !download(base + "/SHA256SUMS", sums, true) { rc = 1; continue; }
        if !download(base + "/" + name, tmp, g_quiet == 1) { Fs::remove(sums); rc = 1; continue; }
        String want = "";
        switch Fs::read_text(sums) {
            Result::Ok(t): {
                String[] sl = t.split("\n");
                for i in 0..sl.len {
                    String[] w = sl[i].trim().split(" ");
                    if w.len >= 2 && w[w.len - 1] == name { want = w[0]; }
                    String tarname = name + "-files.tar";
                    if w.len >= 2 && w[w.len - 1] == tarname { Fs::write_text(sums + ".keep", w[0]); }
                }
            }
            Result::Err(e): { }
        }
        Fs::remove(sums);
        String have = "";
        switch Sha256::file(tmp) {
            Result::Ok(h): { have = h; }
            Result::Err(e): { }
        }
        if want.len == 0 || want != have {
            Fs::remove(tmp);
            Fs::remove(sums + ".keep");
            err("jget: the checksum of " + name + " does not match, nothing was installed\n");
            rc = 1;
            continue;
        }
        Sys::chmod(tmp.c(), 493);
        if !put_in_place(tmp, dir + "/" + name) { rc = 1; continue; }
        // the files of the tool (the library of the compiler): NAME-files.tar, when it is in the release; it goes into the folder of the tool
        String extra = "";
        switch Fs::read_text(sums + ".keep") {
            Result::Ok(t): { extra = t; }
            Result::Err(e): { }
        }
        if extra.len > 0 {
            String tarfile = dir + "/." + name + ".files.tar";
            if download(base + "/" + name + "-files.tar", tarfile, g_quiet == 1) {
                String thave = "";
                switch Sha256::file(tarfile) {
                    Result::Ok(h): { thave = h; }
                    Result::Err(e): { }
                }
                if thave == extra { if !untar(tarfile, dir) { rc = 1; } } else { err("jget: the checksum of the files of " + name + " does not match\n"); rc = 1; }
                Fs::remove(tarfile);
            } else { rc = 1; }
            Fs::remove(sums + ".keep");
        }
        cout << "installed " << name << " " << ver << " in " << dir << nl;
        if name == "jbox" || name == "zipj" || name == "tarj" {                                             // its commands as links next to it
            String[] ja = arr(2);
            ja.push("--install");
            ja.push(dir);
            Proc::run(dir + "/" + name, ja);
        }
    }
    return rc;
}

int cmd_library(String[] av, int at) {
    if av.len <= at { return usage(); }
    String cmd = av[at];
    if cmd == "list" { return cmd_list(); }
    if cmd == "installed" { return cmd_installed(); }
    if cmd == "install" || cmd == "remove" || cmd == "unstall" || cmd == "uninstall" {
        if av.len <= at + 1 { return usage(); }
        String name = av[at + 1];
        if cmd == "install" { return cmd_install(name); }
        return cmd_remove(name);
    }
    return usage();
}

int main() {
    String[] all = Env::args();
    String[] av = arr(0);
    for i in 0..all.len {
        if i > 0 && all[i] == "-q" { g_quiet = 1; }
        else if i > 0 && all[i] == "-x" { g_exec = 1; }
        else { av.push(all[i]); }
    }
    if av.len < 2 { return usage(); }
    String first = av[1];
    if first == "--version" || first == "-V" { cout << "jget " << jget_version() << nl; return 0; }
    if first == "--help" { usage(); return 0; }
    if first == "-li" { return cmd_library(av, 2); }
    if first == "-sh" { return cmd_run_script(av, 2, "sh"); }
    if first == "-jsh" { return cmd_run_script(av, 2, "jsh"); }
    if first == "tool" { return cmd_tool(av, 2); }
    if first == "untar" {                                  // jget untar FILE [DIR] : a .tar or a gzip-packed tar (.tar.gz, .tgz)
        if av.len < 3 { return usage(); }
        String into = ".";
        if av.len >= 4 { into = av[3]; }
        make_dir(into);
        if untar(av[2], into) { return 0; }
        return 1;
    }
    if first == "-m" { return cmd_music(av, 2); }
    if first == "--install" { return cmd_install_self(av, 2); }
    if first == "--update" { return cmd_update_self(); }
    if first == "-h" || first == "-O" || is_address(first) { return cmd_fetch(av, 1); }
    return cmd_library(av, 1);
}
