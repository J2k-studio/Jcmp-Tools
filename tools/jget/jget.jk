// jget -- download files from the web, and libraries for the J2K language
//
//   jget URL                      save the file at URL in the current folder (the name is the last part of the address);
//                                 when the output goes to a pipe or a file (jget URL | sh) the data goes there instead
//   jget -O URL                   save the file with the name in the address, even when the output goes to a pipe
//   jget URL -o FILE              save it as FILE   (-o - writes it to the screen)
//   jget URL URL ...              several files, each under its own name;  -P DIR  into the folder DIR;  -l LIST  the addresses are in the file LIST
//   jget -r N URL                 try again up to N times when a download fails
//   jget -h URL ...               the same (-h = http: the address follows)
//   (a downloaded script or program is made executable by itself, unless it already is; -x does it for any file)
//   jget -X POST -H "Name: v" -d DATA URL   a request like curl (request.j): the answer goes to the screen; -I -i -u -A -f -L --no-location -o -O
//   jget -m URL ...               songs from links go to the music folder (~/music, or $MUJIC_DIR): mujic plays them
//   jget -sh URL [args]           download a shell script and run it at once (what  curl URL | sh  does), then delete it
//   jget -jsh URL [args]          the same, run by jsh (the shell of Jaric)
//   jget --install [DIR]          copy this program into DIR (default: $PREFIX/bin on Termux, else ~/.local/bin)
//   jget --update                 replace this program by the latest release
//   jget -q ...                   no progress bar
//   jget -li list                 the libraries of the index (a * marks the installed ones)
//   jget -li install NAME         download a library, check its SHA-256 against the index, put it in the library folder
//   jget -li unstall NAME         delete an installed library (remove and uninstall work too)
//   jget -li installed            the libraries in the library folder
//   jget --version | --help
//
// A progress bar (percent, size, speed) is drawn on the screen when the error output is a terminal.
// http:// and https:// addresses are fetched by jget itself (it looks the name up with DNS, speaks TLS 1.3 with the check of the
// certificate, and HTTP/1.1: redirects, chunked answers; big files are written to disk as they arrive). A server that cannot talk
// TLS 1.3 with ChaCha20, and the other kinds of address (file://, ftp://), are fetched by curl, or by wget when there is no curl.
// The trusted roots are those of the system (or the file named in J2K_CA). A certificate that is refused is never retried with curl.
//
// Libraries: the index is a text file, a line for each library:  NAME VERSION URL SHA256   (# starts a comment).
//   URL may be several addresses separated by | (mirrors, tried in order).
//   JGET_INDEX  one or more addresses of an index, separated by spaces (mirrors) - default: the index of the project
//   JGET_LIB    the library folder - default: ~/.j2k/Library, where `#import <name>` looks for libraries
// A library is one J2K source file NAME.j. Nothing from a library is run when it is installed.
#import <stdlib>
#import <deflate>
using stdlib;
#import "core"
#import "request"

String jget_version() { return "1.2.0"; }

// the folder for songs: $MUJIC_DIR, else ~/music
String music_folder() {
    switch Env::get("MUJIC_DIR") {
        Option::Some(d): { if d.len > 0 { return d; } }
        Option::None: { }
    }
    String home = ".";
    switch Env::get("HOME") {
        Option::Some(h): { home = h; }
        Option::None: { }
    }
    return Path::join(home, "music");
}

bool has_audio_ext(String n) {
    String l = n.lower();
    return l.ends_with(".mp3") || l.ends_with(".ogg") || l.ends_with(".m4a") || l.ends_with(".flac") || l.ends_with(".wav") || l.ends_with(".opus") || l.ends_with(".aac");
}

// jget -m URL ...: songs from links go to the music folder (the name from the link; .mp3 is added when it has no sound extension)
i64 cmd_music(String[] av, i64 at) {
    if av.len <= at { return usage(); }
    String dir = music_folder();
    if !Dir::exists(dir) { Dir::make_all(dir); }
    i64 rc = 0;
    for i in at..av.len {
        String n = name_of(av[i]);
        if n == "index.html" { n = "song"; }
        if !has_audio_ext(n) { n = n + ".mp3"; }
        String to = Path::join(dir, n);
        if download(av[i], to, g_quiet == 1) { jout << "saved " << to << nl; } else { rc = 1; }
    }
    return rc;
}

i64 usage() {
    err("usage: jget URL [-o FILE]               download a file (to a pipe or a file when the output goes there: jget URL | sh)\n");
    err("       jget -O URL                      save it with the name in the address (even in a pipe)\n");
    err("       jget URL URL ...                 several files, each under its own name;  -P DIR: into the folder DIR;  -l LIST: the addresses are in the file LIST\n");
    err("       jget -r N URL                    try again up to N times when a download fails   (URL1|URL2: a mirror, tried in order)\n");
    err("       jget -x URL                      and make the file executable\n");
    err("       jget -m URL ...                  songs from links go to ~/music (or $MUJIC_DIR)\n");
    err("       jget -sh URL [args]              download a script and run it at once\n");
    err("       jget -jsh URL [args]             the same with jsh (a script of Jaric, first line [#jsh])\n");
    err("       jget -q URL                      without the progress bar (-s too)\n");
    err("       jget -X POST -H \"A: b\" -d DATA URL   a request like curl: -X -H -d (@file) -I -i -u user:pw -A agent -f -w \"%{{http_code}}\" -o FILE\n");
    err("       jget untar FILE [DIR]            open a .tar or a .tar.gz (.tgz) here or in DIR\n");
    err("       jget --install [DIR] | --update  install this program / replace it by the latest release\n");
    err("       jget --version\n");
    err("jget only downloads. Tools and libraries are installed by jc:  jc install NAME   jc lib install NAME   jc update\n");
    return 1;
}

// the old forms  jget tool ...  and  jget -li ...  are sent to jc (it installs the tools and the libraries since jget 1.0.0)
i64 forward_to_jc(String[] av) {
    String[] a = arr(8);
    String first = av[1];
    if first == "tool" {
        if av.len <= 2 { a.push("list"); }
        else if av[2] == "list" { a.push("list"); }
        else if av[2] == "update" || av[2] == "all" { a.push("update"); for k in 3..av.len { a.push(av[k] + ""); } }
        else if av[2] == "unstall" || av[2] == "uninstall" || av[2] == "remove" { a.push("unstall"); for k in 3..av.len { a.push(av[k] + ""); } }
        else { a.push("install"); for k in 2..av.len { a.push(av[k] + ""); } }
    } else {
        a.push("lib");
        for k in 2..av.len { a.push(av[k] + ""); }
    }
    Result<i64, Error> r = Proc::run("jc", a);
    if !r.is_ok() {
        err("jget: jget only downloads now: tools and libraries are installed by jc, and jc is not here.\n  get it:  curl -fsSL https://raw.githubusercontent.com/J2k-studio/Jcmp-Tools/main/install.sh | sh -s jc\n");
        return 2;
    }
    return r.take();
}

bool is_address(String s) {
    return s.starts_with("http://") || s.starts_with("https://") || s.starts_with("ftp://") || s.starts_with("file://");
}

// does the file start with #! (a script) or with the mark of a program (ELF)?
bool is_program(String path) {
    i64 fd = Sys::open_read(path.c());
    if fd < 0 { return false; }
    char four[8];
    i64 n = Sys::read(fd, @four, 4);
    Sys::close(fd);
    if n >= 2 && four[0] == '#' && four[1] == '!' { return true; }
    return n == 4 && four[0] == 127 && four[1] == 'E' && four[2] == 'L' && four[3] == 'F';
}

// after a download: a script or a program that is not executable becomes executable (where it can be read);
// one that already is executable is left alone; -x does it for any file
void after_download(String to) {
    if to == "-" { return; }
    i64 st[18];
    if Sys::stat(to.c(), @st) != 0 { return; }
    i64 mode = st[2] & 0xFFFFFFFF;
    if g_exec != 1 {
        if (mode & 73) != 0 { return; }                   // already executable (0111): not touched
        if !is_program(to) { return; }
    }
    i64 fresh = (mode & 4095) | ((mode & 292) >> 2);       // x where r is (0444 -> 0111)
    if g_exec == 1 { fresh = (mode & 4095) | 73 | ((mode & 292) >> 2); }
    i64 r = Sys::chmod(to.c(), fresh);
    if r < 0 { err("jget: cannot make " + to + " executable: " + Error::reason(r) + "\n"); }
}

// the addresses in a list file: one a line, an empty line and a line that starts with # are skipped
String[] urls_of_file(String path, i64^ rc) {
    String[] out = arr(8);
    Result<String, Error> r = Fs::read_text(path);
    switch r {
        Result::Ok(t): {
            String[] ls = t.split("\n");
            for i in 0..ls.len {
                String ln = ls[i].trim();
                if ln.len > 0 && ln[0] != '#' { out.push(ln + ""); }
            }
        }
        Result::Err(e): { err("jget: cannot read the list " + path + ": " + e.message + "\n"); rc[0] = 1; }
    }
    return out;
}

// jget URL [URL ...] [-o FILE] [-P DIR] [-l LIST] [-r N]  (-h before the address is allowed)
// Where the data goes: -o FILE (one address only); else -O (the name in the address); else, when the output of jget goes to another program or a file
// (jget URL | sh), to the output; else (a terminal) to a file named like the end of the address. Several addresses: each is saved under its own name.
//   -P DIR   the files go into the folder DIR (it is made when it is not there)
//   -l LIST  the addresses are read from the file LIST (one a line; # starts a comment); they come after the ones on the line
//   -r N     a download that fails is tried again, up to N more times (a mirror list  A|B  is tried in order each time)
i64 cmd_fetch(String[] av, i64 at) {
    String[] urls = arr(8);
    String to = "";
    String dir = "";
    String list = "";
    i64 retries = 0;
    bool by_name = false;
    i64 i = at;
    while i < av.len {
        if av[i] == "-h" { i += 1; }
        else if av[i] == "-O" { by_name = true; i += 1; }
        else if av[i] == "-o" && av.len > i + 1 { to = av[i + 1]; i += 2; }
        else if av[i] == "-P" && av.len > i + 1 { dir = av[i + 1]; i += 2; }
        else if (av[i] == "-l" || av[i] == "--list") && av.len > i + 1 { list = av[i + 1]; i += 2; }
        else if av[i] == "-r" && av.len > i + 1 { retries = av[i + 1].to_int(); i += 2; }
        else if av[i].len > 1 && av[i][0] == '-' && av[i] != "-" { return usage(); }
        else { urls.push(av[i] + ""); i += 1; }
    }
    i64 rc = 0;
    if list.len > 0 {
        String[] more = urls_of_file(list, @rc);
        if rc != 0 { return 1; }
        for k in 0..more.len { urls.push(more[k] + ""); }
    }
    if urls.len == 0 { return usage(); }
    if to.len > 0 && urls.len > 1 { err("jget: -o names one file; with several addresses each is saved under its own name (or use -P DIR)\n"); return 1; }
    if dir.len > 0 && !Dir::exists(dir) { switch Dir::make_all(dir) { Result::Ok(v): { } Result::Err(e): { err("jget: cannot make the folder " + dir + ": " + e.message + "\n"); return 1; } } }
    i64 done = 0;
    for u in 0..urls.len {
        String dest = to;
        if dest.len == 0 {
            if by_name || urls.len > 1 || dir.len > 0 || Sys::isatty(1) == 0 { dest = name_of(urls[u]); } else { dest = "-"; }
            if dir.len > 0 && dest != "-" { dest = Path::join(dir, dest); }
        }
        bool ok = download(urls[u], dest, g_quiet == 1);
        i64 again = 0;
        while !ok && again < retries {
            again += 1;
            err("jget: " + urls[u] + ": again (" + str(again) + " of " + str(retries) + ")\n");
            ok = download(urls[u], dest, g_quiet == 1);
        }
        if ok { after_download(dest); done += 1; } else { rc = 1; }
    }
    if urls.len > 1 { err("jget: " + str(done) + " of " + str(urls.len) + " downloaded\n"); }
    return rc;
}

// The policy for scripts from the net (setting "run_net" in etc/config.local of the Jaric app; JGET_CONFIG names another file):
//   ask (default): at a terminal the size and the first 20 lines are shown and Enter / y runs it, anything else does not;
//                  without a terminal (a script runs jget) nothing can be asked, so it runs as before
//   never: refuse      allow: run at once
String conf_value(String key) {
    String file = "";
    switch Env::get("JGET_CONFIG") {
        Option::Some(f): { file = f; }
        Option::None: { }
    }
    if file.len == 0 {
        switch Env::get("PREFIX") {
            Option::Some(p): { if p.len > 0 { file = p + "/etc/config.local"; } }
            Option::None: { }
        }
    }
    if file.len == 0 || !Fs::exists(file) { return ""; }
    Result<String, Error> r = Fs::read_text(file);
    if !r.is_ok() { return ""; }
    String[] ls = r.take().split("\n");
    for i in 0..ls.len {
        String ln = ls[i].trim();
        i64 eq = ln.find("=");
        if eq <= 0 || ln[0] == '#' { continue; }
        if ln.slice(0, eq).trim() == key { return ln.slice(eq + 1, ln.len).trim().replace("\"", ""); }
    }
    return "";
}

// true when the downloaded script may be run
bool run_net_allowed(String tmp, String url) {
    String policy = conf_value("run_net");
    if policy == "never" { err("jget: running scripts from the net is switched off (jaric setting: run scripts from the net = never)\n"); return false; }
    if policy == "allow" { return true; }
    if Sys::isatty(0) != 0 || Sys::isatty(2) != 0 { return true; }       // nobody to ask
    Result<String, Error> r = Fs::read_text(tmp);
    String text = "";
    if r.is_ok() { text = r.take(); }
    String[] ls = text.split("\n");
    err("jget: " + url + "  (" + str(text.len) + " bytes) is a script. The first lines:\n");
    for i in 0..ls.len { if i < 20 { err("  | " + ls[i] + "\n"); } }
    err("Run it? [y/N] ");
    String a = Input::line().trim();
    return a == "y" || a == "Y" || a == "yes";
}

// jget -sh URL [args]: download a script, run it with sh (-jsh: with jsh, the shell of Jaric), delete it
i64 cmd_run_script(String[] av, i64 at, String shell) {
    if av.len <= at { return usage(); }
    String url = av[at];
    String tmp = "/data/local/tmp/.jget_script";
    switch Env::get("TMPDIR") {
        Option::Some(t): { tmp = t + "/.jget_script." + str(Sys::getpid()); }
        Option::None: { tmp = "/tmp/.jget_script." + str(Sys::getpid()); }
    }
    if !download(url, tmp, true) { return 1; }
    if !run_net_allowed(tmp, url) { Fs::remove(tmp); err("jget: not run\n"); return 1; }
    String[] args = arr(0);
    args.push(tmp);
    for i in at + 1..av.len { args.push(av[i]); }
    i64 code = run_prog(shell, args);
    Fs::remove(tmp);
    return code;
}

// jget --install [DIR]
i64 cmd_install_self(String[] av, i64 at) {
    String dir = default_bin_dir();
    if av.len > at { dir = av[at]; }
    if !make_dir(dir) { return 1; }
    String me = self_path();
    if me.len == 0 { err("jget: cannot find where this program is\n"); return 1; }
    if !install_file(me, dir + "/jget") { return 1; }
    jout << "installed jget in " << dir << "/jget" << nl;
    return 0;
}

// jget --update: the latest release replaces this program (checked with its SHA-256)
i64 cmd_update_self() {
    String me = self_path();
    if me.len == 0 { err("jget: cannot find where this program is\n"); return 1; }
    // the newest version of jget is the text of tools/jget/LATEST in the repository of the tools (a release of another tool cannot be mistaken for it)
    String lv = me + ".latest";
    if !download("https://raw.githubusercontent.com/J2k-studio/Jcmp-Tools/main/tools/jget/LATEST", lv, true) { return 1; }
    String ver = "";
    switch Fs::read_text(lv) {
        Result::Ok(t): { ver = t.trim(); }
        Result::Err(e): { }
    }
    Fs::remove(lv);
    if ver.len == 0 { err("jget: cannot read the newest version\n"); return 1; }
    String base = "https://github.com/J2k-studio/Jcmp-Tools/releases/download/jget-v" + ver;
    String tmp = me + ".new";
    String sums = me + ".sums";
    if !download(base + "/SHA256SUMS", sums, true) { return 1; }
    if !download(base + "/jget", tmp, g_quiet == 1) { Fs::remove(sums); return 1; }
    String want = "";
    switch Fs::read_text(sums) {
        Result::Ok(t): {
            String[] lines = t.split("\n");
            for i in 0..lines.len {
                String[] w = lines[i].trim().split(" ");
                if w.len >= 2 && w[w.len - 1] == "jget" { want = w[0]; }
            }
        }
        Result::Err(e): { }
    }
    Fs::remove(sums);
    String have = "";
    switch Sha256::file(tmp) {
        Result::Ok(h): { have = h; }
        Result::Err(e): { }
    }
    if want.len == 0 || want != have {
        Fs::remove(tmp);
        err("jget: the checksum of the new program does not match, nothing was changed\n");
        return 1;
    }
    Sys::chmod(tmp.c(), 493);
    if !put_in_place(tmp, me) { return 1; }
    jout << "jget is updated" << nl;
    return 0;
}

i64 main() {
    String[] all = Env::args();
    String[] av = arr(0);
    for i in 0..all.len {
        if i > 0 && (all[i] == "-q" || all[i] == "-s") { g_quiet = 1; }
        else if i > 0 && all[i] == "-x" { g_exec = 1; }
        else { av.push(all[i]); }
    }
    if av.len < 2 { return usage(); }
    String first = av[1];
    if first == "--version" || first == "-V" { jout << "jget " << jget_version() << nl; return 0; }
    if first == "--help" { usage(); return 0; }
    if first == "-li" || first == "tool" { return forward_to_jc(av); }
    if first == "-sh" { return cmd_run_script(av, 2, "sh"); }
    if first == "-jsh" { return cmd_run_script(av, 2, "jsh"); }
    if first == "untar" {                                  // jget untar FILE [DIR] : a .tar or a gzip-packed tar (.tar.gz, .tgz)
        if av.len < 3 { return usage(); }
        String into = ".";
        if av.len >= 4 { into = av[3]; }
        make_dir(into);
        if untar(av[2], into) { return 0; }
        return 1;
    }
    if first == "-m" { return cmd_music(av, 2); }
    if first == "--install" { return cmd_install_self(av, 2); }
    if first == "--update" { return cmd_update_self(); }
    if req_wanted(av, 1) { return cmd_request(av, 1); }
    if first == "-h" || first == "-O" || first == "-P" || first == "-l" || first == "--list" || first == "-r" || is_address(first) { return cmd_fetch(av, 1); }
    return usage();
}
