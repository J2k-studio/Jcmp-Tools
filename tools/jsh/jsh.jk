// jsh: the shell of Jaric (a working name). Step 1 to 4 of docs/os-structure.md section 10: a prompt, line editing and history,
// built-ins (cd pwd exit help history echo), programs with arguments, `$?`, pipes ( | ), redirection ( > >> < ), background ( & ).
// It runs on the host today (Termux) and inside jemu / Jaric OS later: it uses only Sys:: calls and the library.
#import <stdlib>
using Input;

String[] history;
int last_status;
int running;
String[] envv;                                                // the environment of the shell: "NAME=value" (children get a copy)
String[] alias_n;
String[] alias_v;
int loop_ctl;                                                 // 1: break, 2: continue (until the loop takes it)
int interrupted;                                              // Ctrl-C came while a script ran
int[] jobs;                                                   // the process numbers of the commands started with &
int returning;                                                // 1 while a function returns
String[] fn_names;
String[] fn_bodies;                                           // the tokens of the body joined by the character 1

// ---------------------------------------------------------------- the line editor
// raw terminal keys: read.key() gives letters as they are, arrows 257 up 258 down 259 right 260 left, 261 Home, 262 End, 263 Delete
String esc() {
    String e = "";
    e.push((char)27);
    return e;
}

// UTF-8: a byte 10xxxxxx continues a character; the cursor moves by characters, and the screen by columns
bool is_cont(String s, int i) { return i >= 0 && i < s.len && (s[i] & 192) == 128; }
int prev_char(String s, int at) {
    if at <= 0 { return 0; }
    at -= 1;
    while at > 0 && is_cont(s, at) { at -= 1; }
    return at;
}
int next_char(String s, int at) {
    if at >= s.len { return s.len; }
    at += 1;
    while at < s.len && is_cont(s, at) { at += 1; }
    return at;
}
int cols_of(String s, int a, int b) {
    int n = 0;
    int i = a;
    while i < b {
        int c = s[i] & 255;
        int len = 1;
        int cp = c;
        if c >= 240 { len = 4; } else if c >= 224 { len = 3; } else if c >= 192 { len = 2; }
        if len == 2 && i + 1 < s.len { cp = ((c & 31) << 6) | (s[i + 1] & 63); }
        if len == 3 && i + 2 < s.len { cp = ((c & 15) << 12) | ((s[i + 1] & 63) << 6) | (s[i + 2] & 63); }
        if len == 4 && i + 3 < s.len { cp = ((c & 7) << 18) | ((s[i + 1] & 63) << 12) | ((s[i + 2] & 63) << 6) | (s[i + 3] & 63); }
        int w = 1;
        if cp == 3633 || (cp >= 3636 && cp <= 3642) || (cp >= 3655 && cp <= 3662) { w = 0; }            // the marks of Thai that sit on a letter
        else if (cp >= 4352 && cp <= 4447) || (cp >= 11904 && cp <= 42191) || (cp >= 44032 && cp <= 55203) || (cp >= 65280 && cp <= 65376) || cp >= 127744 { w = 2; }
        n += w;
        i += len;
    }
    return n;
}

// the width on the screen of a text that holds escapes (colours, the message of the app): they take no place
int visible_width(String s) {
    int n = 0;
    int i = 0;
    while i < s.len {
        int c = s[i] & 255;
        if c == 27 {
            if i + 1 < s.len && s[i + 1] == '[' {
                i += 2;
                while i < s.len && ((s[i] & 255) < 64 || (s[i] & 255) > 126) { i += 1; }
                i += 1;
            } else if i + 1 < s.len && s[i + 1] == ']' {
                i += 2;
                while i < s.len && s[i] != 7 { i += 1; }
                i += 1;
            } else { i += 2; }
            continue;
        }
        int len = 1;
        if c >= 240 { len = 4; } else if c >= 224 { len = 3; } else if c >= 192 { len = 2; }
        n += cols_of(s, i, i + len);
        i += len;
    }
    return n;
}

// ---------------------------------------------------------------- the ghost text and completion
int here_n;
String[] here_files;
String[] cmd_cache;
bool cmd_cached;

void add_unique(String[] list, String name) {
    for i in 0..list.len { if list[i] == name { return; } }
    list.push(name);
}

// the names of the commands: built-ins, jbox and the programs of the PATH (listed once)
String[] command_names() {
    if cmd_cached { return cmd_cache; }
    cmd_cache = arr(64);
    String fixed_text = "exit cd pwd echo history help install jaric-setup-folder export unset env alias unalias type which source dir tree cat head tail wc mkdir rmdir rm touch cp mv grep sort uniq tee seq basename dirname sleep clear true false";
    String[] fixed = fixed_text.split(" ");
    for q in 0..fixed.len { cmd_cache.push(fixed[q]); }
    String path = getv("PATH");
    int start = 0;
    for k in 0..path.len + 1 {
        if k == path.len || path[k] == ':' {
            String dir = path.slice(start, k);
            start = k + 1;
            if dir.len == 0 || !Dir::exists(dir) { continue; }
            Result<String[], Error> r = Dir::list(dir);
            if r.is_ok() {
                String[] names = r.take();
                for i in 0..names.len { add_unique(cmd_cache, names[i]); }
            }
        }
    }
    for i in 0..alias_n.len { add_unique(cmd_cache, alias_n[i]); }
    cmd_cache.sort();
    cmd_cached = true;
    return cmd_cache;
}

// what could the last word of the line become: commands (first word) or files
String[] candidates(String line) {
    String[] out = arr(8);
    int sp = 0 - 1;
    for i in 0..line.len { if line[i] == ' ' { sp = i; } }
    String word = line.slice(sp + 1, line.len);
    bool first = true;
    for i in 0..sp + 1 { if line[i] != ' ' { first = false; } }
    bool bare = true;
    for i in 0..word.len { if word[i] == '/' { bare = false; } }
    if first && bare {
        String[] all = command_names();
        for i in 0..all.len { if all[i].starts_with(word) && all[i].len > word.len { out.push(all[i]); } }
        return out;
    }
    int slash = 0 - 1;
    for i in 0..word.len { if word[i] == '/' { slash = i; } }
    String dir = ".";
    String part = word;
    if slash >= 0 { dir = word.slice(0, slash + 1); part = word.slice(slash + 1, word.len); }
    if word.len > 0 && word[0] == '~' && slash < 0 { return out; }
    if !Dir::exists(dir) { return out; }
    Result<String[], Error> r = Dir::list(dir);
    if r.is_ok() {
        String[] names = r.take();
        for i in 0..names.len {
            String n = names[i];
            if n.len > 0 && n[0] == '.' && (part.len == 0 || part[0] != '.') { continue; }
            if n.starts_with(part) && (n.len > part.len || part.len == 0) {
                String full = n;
                if Dir::exists(Path::join(dir, n)) { full = n + "/"; }
                out.push(full);
            }
        }
    }
    return out;
}

// the grey text after the cursor: the newest history line that continues the line, else the first completion
String suggestion_for(String line) {
    if line.len == 0 { return ""; }
    int i = history.len - 1;
    while i >= 0 {
        if history[i].len > line.len && history[i].starts_with(line) { return history[i].slice(line.len, history[i].len); }
        i -= 1;
    }
    String[] c = candidates(line);
    if c.len == 0 { return ""; }
    int sp = 0 - 1;
    for k in 0..line.len { if line[k] == ' ' { sp = k; } }
    String word = line.slice(sp + 1, line.len);
    int slash = 0 - 1;
    for k in 0..word.len { if word[k] == '/' { slash = k; } }
    String part = word.slice(slash + 1, word.len);
    if part.len == 0 { return ""; }                                   // nothing typed in this word yet: no guess
    return c[0].slice(part.len, c[0].len);
}

// colours while typing: the first word is green when it is a command (a built-in, an alias, a program), red when it is not (once it is followed by a space)
String known_word;
bool known_ok;
bool known_ready;
bool command_known(String w) {
    if known_ready && w == known_word { return known_ok; }
    bool ok = w.len == 0 || is_builtin_name(w) || is_jbox_name(w) || find_alias(w) >= 0 || have_program(w);
    if !ok {
        for k in 0..w.len { if w[k] == '=' || w[k] == '$' || w[k] == '(' || w[k] == '{' || w[k] == '[' || w[k] == '"' || w[k] == 39 { ok = true; } }
        if w.starts_with("./") || w.starts_with("/") || w.starts_with("~") || w.starts_with("../") { ok = Fs::exists(w) || w.starts_with("~"); }
        if w == "if" || w == "for" || w == "while" || w == "case" || w == "function" || w == "then" || w == "do" || w == "done" || w == "fi" || w == "else" || w == "elif" || w == "esac" { ok = true; }
    }
    known_word = w + "";
    known_ok = ok;
    known_ready = true;
    return ok;
}

int redraw_row;              // the row of the cursor, counted from the first row of the typed line (a long line wraps over several rows)
int redraw_end;              // the row where the printed text ends

// the line with its prompt again, also when it is longer than a row: go up to the first row, print, put the cursor where the text cursor is
void redraw(String prompt, String line, int cursor) {
    int cols = Term::cols();
    if cols < 10 { cols = 80; }
    int pw = visible_width(prompt);
    if redraw_row > 0 { cout << esc() << "[" << redraw_row << "A"; }
    int ws = 0;
    while ws < line.len && line[ws] == ' ' { ws += 1; }
    int we = ws;
    while we < line.len && line[we] != ' ' { we += 1; }
    cout << "\r";
    if we < line.len && we > ws && Sys::isatty(1) == 0 {
        String code = "[38;2;120;220;130m";
        if !command_known(line.slice(ws, we)) { code = "[38;2;255;110;110m"; }
        cout << prompt << line.slice(0, ws) << esc() << code << line.slice(ws, we) << esc() << "[0m" << line.slice(we, line.len);
    } else {
        cout << prompt << line;
    }
    int lw = cols_of(line, 0, line.len);
    int endw = pw + lw;
    if cursor == line.len {
        String ghost = suggestion_for(line);
        if ghost.len > 0 {
            cout << esc() << "[38;2;110;110;110m" << ghost << esc() << "[0m";
            endw += cols_of(ghost, 0, ghost.len);
        }
    }
    cout << esc() << "[J";
    if endw > 0 && endw % cols == 0 { cout << " \r"; }               // the cursor waits after the last place of a full row: make it go to the next row
    int endrow = endw / cols;
    int tw = pw + cols_of(line, 0, cursor);
    int tr = tw / cols;
    int tc = tw % cols;
    if endrow > tr { cout << esc() << "[" << endrow - tr << "A"; }
    cout << "\r";
    if tc > 0 { cout << esc() << "[" << tc << "C"; }
    redraw_row = tr;
    redraw_end = endrow;
}

// Enter: the cursor goes to the end of the text, then to the next line
void finish_line() {
    if redraw_end > redraw_row { cout << esc() << "[" << redraw_end - redraw_row << "B"; }
    redraw_row = 0;
    redraw_end = 0;
    cout << "\n";
}

// returns false at the end of the input (Ctrl-D on an empty line)
String got_line;                                              // the line that read_command read
// Enter (13) and the key New line (10, Ctrl-J) must be told apart: while a line is read the terminal does not turn 13 into 10
void set_icrnl(bool on) {
    if Sys::isatty(0) != 0 { return; }
    char t[64];
    Sys::call(29, 0, 21505, (int)@t, 0, 0, 0);                   // TCGETS
    if on { t[1] = t[1] | 1; t[12] = t[12] | 1; } else { t[1] = t[1] & 254; t[12] = t[12] & 254; }       // iflag ICRNL (0x100); lflag ISIG (1): while a line is read Ctrl-C is a key
    Sys::call(29, 0, 21506, (int)@t, 0, 0, 0);                   // TCSETS
}

bool read_command(String prompt) {
    String line = "";
    String pending = "";                                         // the lines before this one (the key New line)
    String shown = prompt;
    int cursor = 0;
    int hist = history.len;
    set_icrnl(false);
    redraw_row = 0;
    redraw_end = 0;
    cout << prompt;
    while true {
        int k = read.key();
        if k < 0 { cout << "\n"; set_icrnl(true); return false; }
        if k == 13 { finish_line(); got_line = pending + line; set_icrnl(true); return true; }       // Enter: run
        if k == 10 {                                                                                   // New line: another line of the same command
            pending = pending + line + "\n";
            line = "";
            cursor = 0;
            shown = ".. " + prompt_mark();
            finish_line();
            cout << shown;
            continue;
        }
        if k == 4 {
            if line.len == 0 && pending.len == 0 { finish_line(); set_icrnl(true); return false; }
            continue;
        }
        if k == 3 { finish_line(); cout << "^C\n"; got_line = ""; set_icrnl(true); return true; }
        if k == 127 || k == 8 {
            if cursor > 0 {
                int pc = prev_char(line, cursor);
                line = line.slice(0, pc) + line.slice(cursor, line.len);
                cursor = pc;
            }
        } else if k == 263 {
            if cursor < line.len { line = line.slice(0, cursor) + line.slice(next_char(line, cursor), line.len); }
        } else if k == 260 {
            if cursor > 0 { cursor = prev_char(line, cursor); }
        } else if k == 259 {
            if cursor < line.len { cursor = next_char(line, cursor); }
        } else if k == 261 || k == 1 {
            cursor = 0;
        } else if k == 262 || k == 5 {
            cursor = line.len;
        } else if k == 21 {
            line = "";
            cursor = 0;
        } else if k == 257 {
            if hist > 0 { hist -= 1; line = history[hist]; cursor = line.len; }
        } else if k == 258 {
            if hist < history.len {
                hist += 1;
                if hist == history.len { line = ""; } else { line = history[hist]; }
                cursor = line.len;
            }
        } else if k == 9 {
            String ghost = "";
            if cursor == line.len { ghost = suggestion_for(line); }
            if ghost.len > 0 {
                line = line + ghost;                                  // Tab takes the grey text
                cursor = line.len;
            } else if cursor == line.len && line.len > 0 && line[line.len - 1] != ' ' {
                String[] c = candidates(line);
                if c.len > 1 {                                        // several: take what they share, show them under the line
                    int sp2 = 0 - 1;
                    for i in 0..line.len { if line[i] == ' ' { sp2 = i; } }
                    String word2 = line.slice(sp2 + 1, line.len);
                    int sl2 = 0 - 1;
                    for i in 0..word2.len { if word2[i] == '/' { sl2 = i; } }
                    int shared = c[0].len;
                    for i in 1..c.len {
                        int m = 0;
                        while m < shared && m < c[i].len && c[i][m] == c[0][m] { m += 1; }
                        shared = m;
                    }
                    int have = word2.len - (sl2 + 1);
                    if shared > have {
                        line = line + c[0].slice(have, shared);
                        cursor = line.len;
                    } else {
                        finish_line();
                        for i in 0..c.len { cout << c[i] << "  "; }
                        cout << "\n";
                    }
                }
            } else {
                line = line.slice(0, cursor) + "  " + line.slice(cursor, line.len);
                cursor += 2;
            }
        } else if k >= 32 && k < 257 {
            String ch = "";
            ch.push((char)k);
            line = line.slice(0, cursor) + ch + line.slice(cursor, line.len);
            cursor += 1;
        }
        redraw(shown, line, cursor);
    }
    return false;
}

// ---------------------------------------------------------------- reading the words of a line
// single and double quotes group words; a backslash escapes the next character; the characters of | < > >> & are words of their own
String[] words_of(String line) {
    String[] w = arr(8);
    String cur = "";
    bool have = false;
    int i = 0;
    while i < line.len {
        char c = line[i];
        if c == '\'' {
            have = true;
            i += 1;
            while i < line.len && line[i] != '\'' { cur.push(line[i]); i += 1; }
        } else if c == '"' {
            have = true;
            i += 1;
            while i < line.len && line[i] != '"' {
                if line[i] == '\\' && i + 1 < line.len { i += 1; }
                cur.push(line[i]);
                i += 1;
            }
        } else if c == '\\' && i + 1 < line.len {
            have = true;
            i += 1;
            cur.push(line[i]);
        } else if c == '$' && i + 1 < line.len && line[i + 1] == '(' {
            have = true;                                            // $( ... ) with its spaces is one word (it is run later, by expand)
            int depth = 0;
            while i < line.len {
                char d = line[i];
                cur.push(d);
                if d == '(' { depth += 1; }
                if d == ')' { depth -= 1; if depth == 0 { break; } }
                i += 1;
            }
        } else if c == '#' && !have {
            i = line.len;                                           // a comment: the rest of the line is ignored
        } else if c == ' ' || c == '\t' {
            if have { w.push(cur); cur = ""; have = false; }
        } else if (c == '2' || c == '1') && !have && i + 1 < line.len && line[i + 1] == '>' {
            String op = "";                                         // 2> 2>> 2>&1 1>&2 (a number right in front of >)
            op.push(c);
            op.push('>');
            i += 1;
            if i + 1 < line.len && line[i + 1] == '>' { op.push('>'); i += 1; }
            else if i + 2 < line.len && line[i + 1] == '&' && (line[i + 2] == '1' || line[i + 2] == '2') { op.push('&'); op.push(line[i + 2]); i += 2; }
            w.push(op);
        } else if c == '|' || c == '<' || c == '&' || c == '>' || c == ';' {
            if have { w.push(cur); cur = ""; have = false; }
            String op = "";
            op.push(c);
            if c == '>' && i + 1 < line.len && line[i + 1] == '>' { op.push('>'); i += 1; }
            else if c == '>' && i + 2 < line.len && line[i + 1] == '&' && (line[i + 2] == '1' || line[i + 2] == '2') { op.push('&'); op.push(line[i + 2]); i += 2; }
            else if c == '&' && i + 1 < line.len && line[i + 1] == '>' { op.push('>'); i += 1; if i + 1 < line.len && line[i + 1] == '>' { op.push('>'); i += 1; } }
            else if c == '<' && i + 2 < line.len && line[i + 1] == '<' && line[i + 2] == '<' { op.push('<'); op.push('<'); i += 2; }
            else if (c == '|' || c == '&') && i + 1 < line.len && line[i + 1] == c { op.push(c); i += 1; }
            w.push(op);
        } else {
            have = true;
            cur.push(c);
        }
        i += 1;
    }
    if have { w.push(cur); }
    return w;
}

// Ctrl-C while the shell runs a script: a flag (the program in front gets the signal itself and ends)
void on_sigint(int sig) {
    interrupted = 1;
}

// ---------------------------------------------------------------- the environment, aliases
int findv(String name) {
    String key = name + "=";
    for i in 0..envv.len { if envv[i].starts_with(key) { return i; } }
    return 0 - 1;
}
String getv(String name) {
    int k = findv(name);
    if k < 0 { return ""; }
    return envv[k].slice(name.len + 1, envv[k].len);
}
void setv(String name, String val) {
    int k = findv(name);
    String e = name + "=" + val;
    if k >= 0 { envv[k] = e; } else { envv.push(e); }
}
void unsetv(String name) {
    int k = findv(name);
    if k < 0 { return; }
    String[] r = arr(envv.len + 1);
    for i in 0..envv.len { if i != k { r.push(envv[i]); } }
    envv = r;
}
int find_alias(String name) {
    for i in 0..alias_n.len { if alias_n[i] == name { return i; } }
    return 0 - 1;
}

// * and ? in a file name: does the pattern p match the name s
bool wild(String p, int pi, String s, int si) {
    while pi < p.len {
        if p[pi] == '*' {
            for k in si..s.len + 1 { if wild(p, pi + 1, s, k) { return true; } }
            return false;
        }
        if si >= s.len { return false; }
        if p[pi] != '?' && p[pi] != s[si] { return false; }
        pi += 1;
        si += 1;
    }
    return si == s.len;
}

// a word with * or ? becomes the names that match (sorted); no match: the word stays as it is
void glob_into(String[] w, String word) {
    int slash = 0 - 1;
    for i in 0..word.len { if word[i] == '/' { slash = i; } }
    String dir = ".";
    String pat = word;
    String prefix = "";
    if slash >= 0 { dir = word.slice(0, slash + 1); pat = word.slice(slash + 1, word.len); prefix = dir; }
    int before = w.len;
    if Dir::exists(dir) {
        String[] names = arr(4);
        Result<String[], Error> r = Dir::list(dir);
        if r.is_ok() { names = r.take(); }
        for i in 0..names.len {
            String n = names[i];
            if n.len > 0 && n[0] == '.' && pat[0] != '.' { continue; }
            if wild(pat, 0, n, 0) { w.push(prefix + n); }
        }
    }
    if w.len == before { w.push(word); }
}

// $? and $NAME in a word
String expand(String w) {
    String r = "";
    int i = 0;
    if w.len > 0 && w[0] == '~' && (w.len == 1 || w[1] == '/') { r = getv("HOME"); i = 1; }
    while i < w.len {
        if w[i] == '$' && i + 1 < w.len {
            if w[i + 1] == '(' && i + 2 < w.len && w[i + 2] == '(' {  // $(( expression ))
                int depth = 0;
                int j = i + 1;
                while j < w.len {
                    if w[j] == '(' { depth += 1; }
                    if w[j] == ')' { depth -= 1; if depth == 0 { break; } }
                    j += 1;
                }
                r = r + str(arith(w.slice(i + 3, j - 1)));
                i = j + 1;
                continue;
            }
            if w[i + 1] == '(' {                                     // command substitution: the output of the command
                int depth = 0;
                int j = i + 1;
                while j < w.len {
                    if w[j] == '(' { depth += 1; }
                    if w[j] == ')' { depth -= 1; if depth == 0 { break; } }
                    j += 1;
                }
                r = r + capture(w.slice(i + 2, j));
                i = j + 1;
                continue;
            }
            if w[i + 1] == '?' { r = r + str(last_status); i += 2; continue; }
            int j = i + 1;
            String name = "";
            while j < w.len && ((w[j] >= 'A' && w[j] <= 'Z') || (w[j] >= 'a' && w[j] <= 'z') || w[j] == '_' || (w[j] >= '0' && w[j] <= '9')) { name.push(w[j]); j += 1; }
            if name.len > 0 {
                r = r + getv(name);
                i = j;
                continue;
            }
        }
        r.push(w[i]);
        i += 1;
    }
    return r;
}

// ---------------------------------------------------------------- starting programs
int^ build_argv(String[] a, int n) {
    int^ av = (int^)Mem::alloc(8 * (n + 1));
    for i in 0..n { av[i] = (int)a[i].c(); }
    av[n] = 0;
    return av;
}

// tries name in every folder of the PATH (it returns only when none worked)
void exec_path(String name, int^ av, int^ envp) {
    String path = getv("PATH");
    if path.len == 0 { path = "/bin:/usr/bin"; }
    int start = 0;
    for i in 0..path.len + 1 {
        if i == path.len || path[i] == ':' {
            String full = path.slice(start, i) + "/" + name;
            Sys::execve(full.c(), av, envp);
            start = i + 1;
        }
    }
}

// one program: fork, set the files, exec (the PATH is searched)
int spawn(String[] argv, int in_fd, int out_fd, int out_flags_append, String in_file, String out_file, String err_file, int err_mode) {          // err_mode: 0 as is, 1 file, 2 file (append), 3 stderr to where stdout goes, 4 stdout to where stderr goes
    int^ av = build_argv(argv, argv.len);
    int ne = envv.len;
    int^ envp = (int^)Mem::alloc(8 * (ne + 1));
    for i in 0..ne { envp[i] = (int)envv[i].c(); }
    envp[ne] = 0;
    int pid = Sys::fork();
    if pid == 0 {
        char act[32];
        for q in 0..32 { act[q] = 0; }
        Sys::call(134, 2, (int)@act, 0, 8, 0, 0);               // SIGINT back to the default for the program
        if in_fd >= 0 { Sys::dup2(in_fd, 0); }
        if out_fd >= 0 { Sys::dup2(out_fd, 1); }
        if in_file.len > 0 {
            int f = Sys::open_read(in_file.c());
            if f < 0 { cerr << "jsh: cannot read " << in_file << "\n"; Sys::exit(1); }
            Sys::dup2(f, 0);
        }
        if out_file.len > 0 {
            int g = 0;
            if out_flags_append == 1 { g = Sys::open_append(out_file.c()); } else { g = Sys::open_write(out_file.c()); }
            if g < 0 { cerr << "jsh: cannot write " << out_file << "\n"; Sys::exit(1); }
            Sys::dup2(g, 1);
        }
        if err_mode == 1 || err_mode == 2 {
            int h = 0;
            if err_mode == 2 { h = Sys::open_append(err_file.c()); } else { h = Sys::open_write(err_file.c()); }
            if h < 0 { cerr << "jsh: cannot write " << err_file << "\n"; Sys::exit(1); }
            Sys::dup2(h, 2);
        } else if err_mode == 3 { Sys::dup2(1, 2); }
        else if err_mode == 4 { Sys::dup2(2, 1); }
        bool slash = false;
        for i in 0..argv[0].len { if argv[0][i] == '/' { slash = true; } }
        if slash {
            Sys::execve(argv[0].c(), av, envp);
        } else {
            exec_path(argv[0], av, envp);
            // not in the PATH: the small commands of Jaric (jbox NAME args), from the PATH or from the folder of jsh
            String[] jargv = arr(argv.len + 1);
            jargv.push("jbox");
            for i in 0..argv.len { jargv.push(argv[i]); }
            int^ jav = build_argv(jargv, jargv.len);
            exec_path("jbox", jav, envp);
            String self = "";
            self.append((char^)Sys::arg(0));
            Sys::execve(Path::join(Path::parent(self), "jbox").c(), jav, envp);
        }
        String hint = "";
        if is_jbox_name(argv[0]) { hint = "  (install jbox)"; }
        if argv[0] == "jcmp" { hint = "  (install jcmp: the language)"; }
        if argv[0] == "makej" || argv[0] == "coderin" || argv[0] == "jget" { hint = "  (install " + argv[0] + ")"; }
        cerr << "jsh: " << argv[0] << ": command not found" << hint << "\n";
        Sys::exit(127);
    }
    Mem::free(av);
    Mem::free(envp);
    return pid;
}

int status_of(int raw) {
    if (raw & 127) == 0 { return (raw >> 8) & 255; }
    return 128 + (raw & 127);
}

// ---------------------------------------------------------------- jaric setting: one screen for the look of the app and the prompt
// The settings are plain files (change them by hand too): $PREFIX/etc/config.local (theme, font, topbar, animation ...), $PREFIX/etc/theme.toml
// (background, text, accent ... as #RRGGBB) and ~/.jshrc (JSH_COLOR_* of the prompt). The app reads them again when this screen is left.
String cfg_dir() {
    String p = getv("PREFIX");
    if p.len == 0 { p = "."; }
    return p + "/etc";
}

// the value of  key = value  in a file ("" when none); quotes are taken away
String kv_get(String file, String key, bool export_form) {
    if !Fs::exists(file) { return ""; }
    Result<String, Error> r = Fs::read_text(file);
    if !r.is_ok() { return ""; }
    String[] lines = r.take().split("\n");
    String want = key;
    for i in 0..lines.len {
        String ln = lines[i].trim();
        if export_form {
            if !ln.starts_with("export " + key + "=") { continue; }
            return ln.slice(8 + key.len, ln.len).replace("\"", "");
        }
        int eq = ln.find("=");
        if eq <= 0 || ln[0] == '#' { continue; }
        if ln.slice(0, eq).trim() == want { return ln.slice(eq + 1, ln.len).trim().replace("\"", ""); }
    }
    return "";
}

// sets (value.len > 0) or removes (value "") the line of a key; the other lines stay
void kv_set(String file, String key, String value, bool export_form) {
    String text = "";
    if Fs::exists(file) {
        Result<String, Error> r = Fs::read_text(file);
        if r.is_ok() { text = r.take(); }
    }
    String[] lines = text.split("\n");
    String out = "";
    bool done = false;
    String newline = key + " = " + value;
    if export_form { newline = "export " + key + "=" + value; }
    for i in 0..lines.len {
        String ln = lines[i].trim();
        bool mine = false;
        if export_form { mine = ln.starts_with("export " + key + "="); }
        else {
            int eq = ln.find("=");
            if eq > 0 && ln[0] != '#' {
                String k0 = ln.slice(0, eq).trim();
                if k0 == key { mine = true; }
            }
        }
        if mine {
            if value.len > 0 && !done { out = out + newline + "\n"; done = true; }
        } else if !(i == lines.len - 1 && ln.len == 0) {
            out = out + lines[i] + "\n";
        }
    }
    if value.len > 0 && !done { out = out + newline + "\n"; }
    String dir = Path::parent(file);
    if dir.len > 0 && !Dir::exists(dir) { Dir::make_all(dir); }
    Fs::write_text(file, out);
}

String rgb_to_hex(String rgb) {
    String[] p = rgb.split(";");
    String hex = "0123456789abcdef";
    String r = "#";
    for i in 0..3 {
        int v = 0;
        if i < p.len { v = p[i].to_int() & 255; }
        r.push(hex[v >> 4]);
        r.push(hex[v & 15]);
    }
    return r;
}

String swatch(String spec, String fallback_rgb) {
    String rgb = colour_rgb(spec, fallback_rgb);
    return esc() + "[48;2;" + rgb + "m    " + esc() + "[0m";
}

String setting_label(int i) {
    String[] t = arr(16);
    t.push("theme"); t.push("font size"); t.push("background"); t.push("text colour"); t.push("accent colour");
    t.push("top bar (tabs)"); t.push("animation"); t.push("animation ms");
    t.push("prompt: jc"); t.push("prompt: path"); t.push("prompt: mark >"); t.push("prompt: mark after an error");
    t.push("reset everything");
    return t[i];
}

String setting_cfg() { return cfg_dir() + "/config.local"; }
String setting_theme() { return cfg_dir() + "/theme.toml"; }

// the value as shown
String setting_value(int i) {
    if i == 0 { String v = kv_get(setting_cfg(), "theme", false); if v.len == 0 { v = "black"; } return v; }
    if i == 1 { String v = kv_get(setting_cfg(), "font", false); if v.len == 0 { v = "11"; } return v; }
    if i == 2 { String v = kv_get(setting_theme(), "background", false); if v.len == 0 { v = "(theme)"; } return v; }
    if i == 3 { String v = kv_get(setting_theme(), "text", false); if v.len == 0 { v = "(theme)"; } return v; }
    if i == 4 { String v = kv_get(setting_theme(), "accent", false); if v.len == 0 { v = "(theme)"; } return v; }
    if i == 5 { String v = kv_get(setting_cfg(), "topbar", false); if v.len == 0 { v = "hidden"; } return v; }
    if i == 6 { String v = kv_get(setting_cfg(), "animation", false); if v.len == 0 { v = "on"; } return v; }
    if i == 7 { String v = kv_get(setting_cfg(), "animation_ms", false); if v.len == 0 { v = "220"; } return v; }
    String home_rc = getv("HOME") + "/.jshrc";
    String key = "JSH_COLOR_NAME";
    if i == 9 { key = "JSH_COLOR_PATH"; } else if i == 10 { key = "JSH_COLOR_MARK"; } else if i == 11 { key = "JSH_COLOR_ERROR"; }
    if i >= 8 && i <= 11 {
        String v = kv_get(home_rc, key, true);
        if v.len == 0 { v = "(default)"; }
        return v;
    }
    return "";
}

String[] colour_names() {
    String[] c = arr(16);
    c.push("white"); c.push("grey"); c.push("black"); c.push("red"); c.push("green"); c.push("blue"); c.push("sky");
    c.push("cyan"); c.push("yellow"); c.push("orange"); c.push("magenta");
    return c;
}

// the new value of an item: dir = +1 / -1 (the arrows) or 0 (Enter: type it); "" removes the setting
void setting_change(int i, int dir) {
    String cfg = setting_cfg();
    String th = setting_theme();
    String home_rc = getv("HOME") + "/.jshrc";
    String cur = setting_value(i);
    if i == 0 {
        String[] n = arr(8);
        n.push("black"); n.push("soft"); n.push("amber"); n.push("green"); n.push("ice");
        int at = 0;
        for k in 0..n.len { if n[k] == cur { at = k; } }
        if dir == 0 { cout << "\ntheme (black soft amber green ice): "; String t = Input::line().trim(); if t.len > 0 { kv_set(cfg, "theme", t, false); } return; }
        kv_set(cfg, "theme", n[(at + dir + n.len) % n.len], false);
        return;
    }
    if i == 1 {
        int f = cur.to_int();
        if dir == 0 { cout << "\nfont size (6 .. 40): "; f = Input::line().trim().to_int(); } else { f += dir; }
        if f < 6 { f = 6; }
        if f > 40 { f = 40; }
        kv_set(cfg, "font", str(f), false);
        return;
    }
    if i == 5 { if cur == "shown" { kv_set(cfg, "topbar", "hidden", false); } else { kv_set(cfg, "topbar", "shown", false); } return; }
    if i == 6 { if cur == "on" { kv_set(cfg, "animation", "off", false); } else { kv_set(cfg, "animation", "on", false); } return; }
    if i == 7 {
        int ms = cur.to_int();
        if dir == 0 { cout << "\nanimation time in ms (0 = none): "; ms = Input::line().trim().to_int(); } else { ms += dir * 40; }
        if ms < 0 { ms = 0; }
        if ms > 2000 { ms = 2000; }
        kv_set(cfg, "animation_ms", str(ms), false);
        return;
    }
    if i == 12 {
        cout << "\nreset the theme, the font, the colours and the prompt colours? [y/n] ";
        String a = Input::line().trim();
        if a == "y" || a == "Y" {
            if Fs::exists(cfg) { Fs::remove(cfg); }
            if Fs::exists(th) { Fs::remove(th); }
            kv_set(home_rc, "JSH_COLOR_NAME", "", true); kv_set(home_rc, "JSH_COLOR_PATH", "", true);
            kv_set(home_rc, "JSH_COLOR_MARK", "", true); kv_set(home_rc, "JSH_COLOR_ERROR", "", true);
            setv("JSH_COLOR_NAME", ""); setv("JSH_COLOR_PATH", ""); setv("JSH_COLOR_MARK", ""); setv("JSH_COLOR_ERROR", "");
        }
        return;
    }
    // the colours: a name from the list, "(theme)" / "(default)" (nothing set), or typed (#rrggbb, r,g,b, a name)
    String[] names = colour_names();
    String chosen = cur;
    if dir == 0 {
        cout << "\ncolour (a name: white grey black red green blue sky cyan yellow orange magenta, #rrggbb, r,g,b; empty = the default): ";
        chosen = Input::line().trim();
    } else {
        int at = -1;
        for k in 0..names.len { if names[k] == cur { at = k; } }
        if cur == "(theme)" || cur == "(default)" { at = -1; if dir > 0 { chosen = names[0]; } else { chosen = names[names.len - 1]; } }
        else if at >= 0 {
            int nx = at + dir;
            if nx < 0 || nx >= names.len { chosen = ""; } else { chosen = names[nx]; }
        }
    }
    if i >= 2 && i <= 4 {                                                  // the colours of the app: theme.toml wants #RRGGBB
        String key = "background";
        if i == 3 { key = "text"; } else if i == 4 { key = "accent"; }
        if chosen.len == 0 || chosen == "(theme)" { kv_set(th, key, "", false); }
        else { kv_set(th, key, "\"" + rgb_to_hex(colour_rgb(chosen, "0;0;0")) + "\"", false); }
        return;
    }
    String key = "JSH_COLOR_NAME";
    if i == 9 { key = "JSH_COLOR_PATH"; } else if i == 10 { key = "JSH_COLOR_MARK"; } else if i == 11 { key = "JSH_COLOR_ERROR"; }
    if chosen == "(default)" { chosen = ""; }
    kv_set(home_rc, key, chosen, true);
    setv(key, chosen);                                                      // the next prompt uses it
}

void setting_draw(int sel) {
    String e = esc();
    String out = e + "[2J" + e + "[H" + e + "[1mjaric setting" + e + "[0m   (the files: " + cfg_dir() + "/config.local, theme.toml, ~/.jshrc)\n\n";
    for i in 0..13 {
        String val = setting_value(i);
        String line = "  " + setting_label(i);
        while line.len < 34 { line = line + " "; }
        line = line + val;
        String sw = "";
        if i >= 2 && i <= 4 && val != "(theme)" { sw = " " + swatch(val, "0;0;0"); }
        if i >= 8 && i <= 11 && val != "(default)" { sw = " " + swatch(val, "255;255;255"); }
        if i == sel { out = out + e + "[7m> " + line.slice(2, line.len) + e + "[0m" + sw + "\n"; }
        else { out = out + line + sw + "\n"; }
    }
    out = out + "\n  up/down choose    left/right change    Enter type a value    q leave (the app reads the files again)\n";
    cout << out;
}

void setting_screen() {
    if Sys::isatty(0) != 0 { cout << "jaric setting needs a terminal\n"; return; }
    int sel = 0;
    bool run = true;
    while run {
        setting_draw(sel);
        int k = Input::key();
        if k == 'q' || k == 'Q' || k == 27 || k < 0 { run = false; }
        else if k == 257 { if sel > 0 { sel -= 1; } }
        else if k == 258 { if sel < 12 { sel += 1; } }
        else if k == 259 { setting_change(sel, 1); }
        else if k == 260 { setting_change(sel, 0 - 1); }
        else if k == 13 || k == 10 { setting_change(sel, 0); }
    }
    cout << esc() << "[2J" << esc() << "[H";
    cout << esc() << "]7777;reload" << (char)7;                             // the app reads config.local and theme.toml again
}

// ---------------------------------------------------------------- built-ins
int bcode;                                                    // the exit code of a built-in
// is there a program of this name in the PATH (or is it a file named like that in the folder of jsh)
bool have_program(String name) {
    String path = getv("PATH");
    int start = 0;
    for k in 0..path.len + 1 {
        if k == path.len || path[k] == ':' {
            String cand = path.slice(start, k) + "/" + name;
            if k > start && Fs::exists(cand) { return true; }
            start = k + 1;
        }
    }
    return false;
}

bool is_builtin_name(String n) {
    return n == "exit" || n == "cd" || n == "pwd" || n == "echo" || n == "history" || n == "help" || n == "export" || n == "unset"
        || n == "env" || n == "jaric" || n == "install" || n == "break" || n == "continue" || n == "read" || n == "jobs" || n == "wait" || n == "test" || n == "[" || n == "return" || n == "jaric-core" || n == "jaric-setup-folder" || n == "alias" || n == "unalias" || n == "type" || n == "which" || n == "source" || n == ".";
}
bool is_jbox_name(String n) {
    return n == "dir" || n == "cat" || n == "head" || n == "tail" || n == "wc" || n == "mkdir" || n == "rmdir" || n == "rm" || n == "touch"
        || n == "cp" || n == "mv" || n == "grep" || n == "sort" || n == "uniq" || n == "tee" || n == "seq" || n == "basename"
        || n == "dirname" || n == "kill" || n == "sleep" || n == "clear" || n == "true" || n == "false";
}
bool builtin(String[] a) {
    String name = a[0];
    if name == "exit" {
        running = 0;
        bcode = last_status;
        if a.len > 1 { bcode = a[1].to_int(); }
        return true;
    }
    if name == "cd" {
        String target = "";
        if a.len > 1 { target = a[1]; }
        else {
            target = getv("HOME");
        }
        if Sys::call(49, (int)target.c(), 0, 0, 0, 0, 0) < 0 {
            cerr << "jsh: cd: " << target << ": cannot enter this folder\n";
            bcode = 1;
            if target.starts_with("/sdcard") || target.starts_with("/storage") {        // the files of the phone: the app asks to be allowed (once)
                cout << esc() << "]7777;setup-folder" << (char)7;
            }
        } else {
            bcode = 0;
            char cwdbuf[512];
            if Sys::getcwd(@cwdbuf, 512) > 0 { setv("PWD", (char^)@cwdbuf); }
        }
        return true;
    }
    if name == "pwd" {
        char buf[512];
        if Sys::getcwd(@buf, 512) > 0 { cout << (char^)@buf << "\n"; }
        bcode = 0;
        return true;
    }
    if name == "echo" {
        for i in 1..a.len {
            if i > 1 { cout << " "; }
            cout << a[i];
        }
        cout << "\n";
        bcode = 0;
        return true;
    }
    if name == "history" {
        for i in 0..history.len { cout << i + 1 << "  " << history[i] << "\n"; }
        bcode = 0;
        return true;
    }
    int eq0 = 0 - 1;                                          // NAME=value alone sets a variable
    for k in 0..name.len {
        char ch = name[k];
        bool ident = (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || ch == '_' || (k > 0 && ch >= '0' && ch <= '9');
        if ch == '=' && k > 0 && eq0 < 0 { eq0 = k; }
        if !ident && eq0 < 0 { break; }
    }
    if eq0 > 0 && a.len == 1 {
        setv(name.slice(0, eq0), name.slice(eq0 + 1, name.len));
        bcode = 0;
        return true;
    }
    if name == "jaric-core" {                                  // a request to the Jaric app: call its library (J2K, through JNI)
        cout << esc() << "]7777;core" << (char)7;
        bcode = 0;
        return true;
    }
    if name == "jaric-setup-folder" {                          // a request to the Jaric app (other terminals ignore the sequence)
        cout << esc() << "]7777;setup-folder" << (char)7;
        bcode = 0;
        return true;
    }
    bool no_clear = !have_program("clear");
    if name == "clear" && no_clear {            // a few commands that a fresh install needs before jbox is installed
        cout << esc() << "[2J" << esc() << "[H";
        bcode = 0;
        return true;
    }
    bool no_dir = !have_program("dir");
    if name == "dir" && no_dir {                // dir [-a] [FOLDER]: the names, a folder with a / (install jbox for more: dir -l, cat, cp, mv ...)
        bool all = false;
        String where = ".";
        for i in 1..a.len {
            if a[i] == "-a" { all = true; } else { where = a[i]; }
        }
        bcode = 0;
        if !Dir::exists(where) {
            if Fs::exists(where) { cout << where << "\n"; } else { cerr << "dir: " << where << ": no such file or folder\n"; bcode = 1; }
            return true;
        }
        Result<String[], Error> lr = Dir::list(where);
        if lr.is_ok() {
            String[] names = lr.take();
            for i in 0..names.len {
                String n = names[i];
                if !all && n.len > 0 && n[0] == '.' { continue; }
                if Dir::exists(Path::join(where, n)) { cout << n << "/\n"; } else { cout << n << "\n"; }
            }
        } else { cerr << "dir: cannot read " << where << "\n"; bcode = 1; }
        return true;
    }
    if name == "install" {                                    // install NAME ...: the tools of Jcmp-Tools (jget does the work)
        String[] jw = arr(a.len + 2);
        jw.push("jget");
        jw.push("tool");
        if a.len == 1 { jw.push("list"); }
        for i in 1..a.len { jw.push(a[i]); }
        run_words(jw);
        bcode = last_status;
        return true;
    }
    if name == "test" || name == "[" {
        bcode = test_eval(a);
        return true;
    }
    if name == "break" || name == "continue" {
        if name == "break" { loop_ctl = 1; } else { loop_ctl = 2; }
        bcode = 0;
        return true;
    }
    if name == "read" {                                       // read NAME: a line of the input into the variable
        String got = "";
        char one[2];
        int n = Sys::read(0, @one, 1);
        while n > 0 && one[0] != 10 {
            one[1] = 0;
            got.append((char^)@one);
            n = Sys::read(0, @one, 1);
        }
        if a.len > 1 { setv(a[1], got); }
        bcode = 0;
        if n <= 0 && got.len == 0 { bcode = 1; }
        return true;
    }
    if name == "jobs" {
        for i in 0..jobs.len { cout << "[" << i + 1 << "] " << jobs[i] << "\n"; }
        bcode = 0;
        return true;
    }
    if name == "wait" {
        for i in 0..jobs.len {
            int st = 0;
            Sys::wait(jobs[i], @st);
            last_status = status_of(st);
        }
        jobs = arr(8);
        bcode = last_status;
        return true;
    }
    if name == "return" {
        if a.len > 1 { last_status = a[1].to_int(); }
        returning = 1;
        bcode = last_status;
        return true;
    }
    if name == "export" {
        bcode = 0;
        if a.len == 1 { for i in 0..envv.len { cout << "export " << envv[i] << "\n"; } }
        for i in 1..a.len {
            int eq = 0 - 1;
            for k in 0..a[i].len { if a[i][k] == '=' && eq < 0 { eq = k; } }
            if eq > 0 { setv(a[i].slice(0, eq), a[i].slice(eq + 1, a[i].len)); }
        }
        return true;
    }
    if name == "unset" {
        for i in 1..a.len { unsetv(a[i]); }
        bcode = 0;
        return true;
    }
    if name == "env" {
        for i in 0..envv.len { cout << envv[i] << "\n"; }
        bcode = 0;
        return true;
    }
    if name == "alias" {
        bcode = 0;
        if a.len == 1 { for i in 0..alias_n.len { cout << "alias " << alias_n[i] << "='" << alias_v[i] << "'\n"; } }
        for i in 1..a.len {
            int eq = 0 - 1;
            for k in 0..a[i].len { if a[i][k] == '=' && eq < 0 { eq = k; } }
            if eq > 0 {
                String n = a[i].slice(0, eq);
                String v = a[i].slice(eq + 1, a[i].len);
                int at = find_alias(n);
                if at >= 0 { alias_v[at] = v; } else { alias_n.push(n); alias_v.push(v); }
            } else {
                int at = find_alias(a[i]);
                if at >= 0 { cout << "alias " << alias_n[at] << "='" << alias_v[at] << "'\n"; } else { bcode = 1; }
            }
        }
        return true;
    }
    if name == "unalias" {
        for i in 1..a.len {
            int at = find_alias(a[i]);
            if at >= 0 {
                String[] nn = arr(alias_n.len + 1);
                String[] vv = arr(alias_n.len + 1);
                for k in 0..alias_n.len { if k != at { nn.push(alias_n[k]); vv.push(alias_v[k]); } }
                alias_n = nn;
                alias_v = vv;
            }
        }
        bcode = 0;
        return true;
    }
    if name == "type" || name == "which" {
        bcode = 0;
        for i in 1..a.len {
            String what = a[i];
            if find_alias(what) >= 0 { cout << what << " is an alias for " << alias_v[find_alias(what)] << "\n"; continue; }
            if is_builtin_name(what) { cout << what << " is a jsh built-in\n"; continue; }
            String found = "";
            String path = getv("PATH");
            int start = 0;
            for k in 0..path.len + 1 {
                if k == path.len || path[k] == ':' {
                    String full = path.slice(start, k) + "/" + what;
                    if found.len == 0 && Fs::exists(full) { found = full; }
                    start = k + 1;
                }
            }
            if found.len > 0 { cout << what << " is " << found << "\n"; }
            else if is_jbox_name(what) { cout << what << " is a jbox command\n"; }
            else { cerr << "jsh: " << what << ": not found\n"; bcode = 1; }
        }
        return true;
    }
    if name == "source" || name == "." {
        if a.len < 2 { cerr << "jsh: source: a file name is needed\n"; bcode = 2; return true; }
        bcode = run_file(a[1]);
        return true;
    }
    if name == "jaric" {                                         // settings of the Jaric app (other terminals ignore the sequences)
        bcode = 0;
        if a.len >= 2 && (a[1] == "setting" || a[1] == "settings") {
            setting_screen();
        } else if a.len >= 2 && a[1] == "theme" {
            if a.len == 2 { cout << "themes: black soft amber green ice   (jaric theme NAME)\n"; }
            else { cout << esc() << "]7777;theme;" << a[2] << (char)7; }
        } else if a.len >= 2 && a[1] == "video" {
            if a.len < 3 { cout << "jaric video FILE|URL   play a video over the terminal (the back key closes it);  jaric video stop\n"; }
            else if a[2] == "stop" { cout << esc() << "]7777;video;stop" << (char)7; }
            else {
                String v = a[2];
                if !v.starts_with("/") && !v.starts_with("http://") && !v.starts_with("https://") {
                    char buf[512];
                    if Sys::getcwd(@buf, 512) > 0 { String cwd = (char^)@buf; v = cwd + "/" + v; }
                }
                cout << esc() << "]7777;video;play;" << v << (char)7;
            }
        } else if a.len >= 3 && a[1] == "font" {
            cout << esc() << "]7777;font;" << a[2] << (char)7;
        } else if a.len >= 2 && (a[1] == "-restart" || a[1] == "restart") {
            cout << esc() << "]7777;restart" << (char)7;
        } else if a.len >= 2 && a[1] == "core" {
            cout << esc() << "]7777;core" << (char)7;
        } else {
            cout << "jaric setting       one screen for everything: theme, font, colours, top bar, animation, the prompt\n";
            cout << "jaric -restart       start the app again\n";
            cout << "jaric theme [NAME]   the colours (black soft amber green ice)\n";
            cout << "jaric font SIZE      the size of the letters (8 .. 28; a pinch on the screen does it too)\n";
            cout << "jaric video FILE|URL   play a video (mp4, webm, 3gp, ...) over the terminal\n";
            cout << "jaric core           call the library of the app (J2K through JNI)\n";
        }
        return true;
    }
    if name == "help" {
        cout << "jsh, the shell of Jaric\n\n";
        cout << "  built-ins   cd pwd echo history export unset env alias unalias type which source install test [ ] read break continue return jobs wait exit\n";
        cout << "  scripts     if / elif / else / fi    while / until / for ... do ... done    name() { ... }    $(command)  $((1 + 2))\n";
        cout << "  lines       a | b    a > file    a >> file    a < file    a &    a ; b    a && b    a || b    * ? ~ globs\n";
        cout << "  keys        Tab takes the grey text    arrows: history, move    Ctrl-J another line    Ctrl-C cancel    Ctrl-D leave\n";
        cout << "  tools       install NAME ...  (install alone lists them; install all takes every one)\n";
        cout << "  the app     jaric theme | font | core\n";
        bcode = 0;
        return true;
    }
    return false;
}

// ---------------------------------------------------------------- one line
// ---------------------------------------------------------------- scripts: if / while / until / for, functions, $( )

bool is_number(String s) {
    if s.len == 0 { return false; }
    for i in 0..s.len {
        if !((s[i] >= '0' && s[i] <= '9') || (i == 0 && s[i] == '-' && s.len > 1)) { return false; }
    }
    return true;
}

// test and [ ]: -f -d -e -z -n, = != , -eq -ne -lt -gt -le -ge, ! in front
int test_eval(String[] a) {
    String[] t = arr(a.len);
    for i in 1..a.len { t.push(a[i]); }
    if a[0] == "[" {
        if t.len > 0 && t[t.len - 1] == "]" { t.pop(); }
    }
    bool neg = false;
    if t.len > 0 && t[0] == "!" {
        neg = true;
        String[] u = arr(t.len);
        for i in 1..t.len { u.push(t[i]); }
        t = u;
    }
    bool r = false;
    if t.len == 1 { r = t[0].len > 0; }
    else if t.len == 2 {
        String o = t[0];
        String x = t[1];
        if o == "-f" { r = Fs::exists(x) && !Dir::exists(x); }
        else if o == "-d" { r = Dir::exists(x); }
        else if o == "-e" { r = Fs::exists(x) || Dir::exists(x); }
        else if o == "-z" { r = x.len == 0; }
        else if o == "-n" { r = x.len > 0; }
    } else if t.len == 3 {
        String o = t[1];
        if o == "=" || o == "==" { r = t[0] == t[2]; }
        else if o == "!=" { r = t[0] != t[2]; }
        else if is_number(t[0]) && is_number(t[2]) {
            int x = t[0].to_int();
            int y = t[2].to_int();
            if o == "-eq" { r = x == y; }
            else if o == "-ne" { r = x != y; }
            else if o == "-lt" { r = x < y; }
            else if o == "-gt" { r = x > y; }
            else if o == "-le" { r = x <= y; }
            else if o == "-ge" { r = x >= y; }
        }
    }
    if neg { r = !r; }
    if r { return 0; }
    return 1;
}

// $(( expression )): whole numbers with + - * / % ( ) and the comparisons < > <= >= == != (1 or 0); a name is the value of the variable
int ar_pos;
String ar_text;
int ar_skip() {
    while ar_pos < ar_text.len && ar_text[ar_pos] == ' ' { ar_pos += 1; }
    return ar_pos;
}
int ar_factor() {
    ar_skip();
    if ar_pos >= ar_text.len { return 0; }
    char c = ar_text[ar_pos];
    if c == '-' { ar_pos += 1; return 0 - ar_factor(); }
    if c == '(' {
        ar_pos += 1;
        int v = ar_cmp();
        ar_skip();
        if ar_pos < ar_text.len && ar_text[ar_pos] == ')' { ar_pos += 1; }
        return v;
    }
    if c == '$' { ar_pos += 1; ar_skip(); c = ar_text[ar_pos]; }
    if c >= '0' && c <= '9' {
        int v = 0;
        while ar_pos < ar_text.len && ar_text[ar_pos] >= '0' && ar_text[ar_pos] <= '9' { v = v * 10 + (ar_text[ar_pos] - '0'); ar_pos += 1; }
        return v;
    }
    String name = "";
    while ar_pos < ar_text.len && ((ar_text[ar_pos] >= 'a' && ar_text[ar_pos] <= 'z') || (ar_text[ar_pos] >= 'A' && ar_text[ar_pos] <= 'Z') || ar_text[ar_pos] == '_' || (ar_text[ar_pos] >= '0' && ar_text[ar_pos] <= '9')) { name.push(ar_text[ar_pos]); ar_pos += 1; }
    if name.len == 0 { ar_pos += 1; return 0; }
    String val = getv(name);
    if is_number(val) { return val.to_int(); }
    return 0;
}
int ar_term() {
    int v = ar_factor();
    while true {
        ar_skip();
        if ar_pos >= ar_text.len { return v; }
        char c = ar_text[ar_pos];
        if c == '*' { ar_pos += 1; v = v * ar_factor(); }
        else if c == '/' { ar_pos += 1; int d = ar_factor(); if d == 0 { cerr << "jsh: division by 0\n"; d = 1; } v = v / d; }
        else if c == '%' { ar_pos += 1; int d2 = ar_factor(); if d2 == 0 { cerr << "jsh: division by 0\n"; d2 = 1; } v = v % d2; }
        else { return v; }
    }
    return v;
}
int ar_sum() {
    int v = ar_term();
    while true {
        ar_skip();
        if ar_pos >= ar_text.len { return v; }
        char c = ar_text[ar_pos];
        if c == '+' { ar_pos += 1; v = v + ar_term(); }
        else if c == '-' { ar_pos += 1; v = v - ar_term(); }
        else { return v; }
    }
    return v;
}
int ar_cmp() {
    int v = ar_sum();
    ar_skip();
    if ar_pos >= ar_text.len { return v; }
    char c = ar_text[ar_pos];
    char d = 0;
    if ar_pos + 1 < ar_text.len { d = ar_text[ar_pos + 1]; }
    if c == '<' && d == '=' { ar_pos += 2; if v <= ar_sum() { return 1; } return 0; }
    if c == '>' && d == '=' { ar_pos += 2; if v >= ar_sum() { return 1; } return 0; }
    if c == '=' && d == '=' { ar_pos += 2; if v == ar_sum() { return 1; } return 0; }
    if c == '!' && d == '=' { ar_pos += 2; if v != ar_sum() { return 1; } return 0; }
    if c == '<' { ar_pos += 1; if v < ar_sum() { return 1; } return 0; }
    if c == '>' { ar_pos += 1; if v > ar_sum() { return 1; } return 0; }
    return v;
}
int arith(String text) {
    ar_text = text;
    ar_pos = 0;
    return ar_cmp();
}

// the output of a command (without the new lines at its end)
String capture(String cmd) {
    int fds[1];
    Sys::pipe(@fds);
    int rd = fds[0] & 4294967295;
    int wr = fds[0] >> 32;
    int pid = Sys::fork();
    if pid == 0 {
        Sys::close(rd);
        Sys::dup2(wr, 1);
        Sys::close(wr);
        run_script_text(cmd);
        Sys::exit(last_status);
    }
    Sys::close(wr);
    String out = "";
    char b[4097];
    int n = Sys::read(rd, @b, 4096);
    while n > 0 {
        b[n] = 0;
        out.append((char^)@b);
        n = Sys::read(rd, @b, 4096);
    }
    Sys::close(rd);
    int st = 0;
    Sys::wait(pid, @st);
    last_status = status_of(st);
    while out.len > 0 && out[out.len - 1] == 10 { out = out.slice(0, out.len - 1); }
    return out;
}

// a word is a keyword (if, then, fi, do, done ...) only where a command may start: at the beginning, after ; or after another keyword
bool cmd_pos(String[] t, int k) {
    if k == 0 { return true; }
    String p = t[k - 1];
    return p == ";" || p == "then" || p == "do" || p == "else" || p == "elif" || p == "{" || p == "&&" || p == "||" || p == "|" || p == "!" || p == "if" || p == "while" || p == "until";
}

String[] slice_t(String[] t, int a, int b) {
    String[] r = arr(b - a + 1);
    for i in a..b { r.push(t[i]); }
    return r;
}

// the closing word that goes with the opening word at i (if .. fi, while / until / for .. done, { .. }); -1 if there is none
int match_end(String[] t, int i) {
    String open = t[i];
    bool loop = open == "while" || open == "until" || open == "for";
    int depth = 0;
    for k in i..t.len {
        String w = t[k];
        if k > i && !cmd_pos(t, k) { continue; }
        if open == "if" && w == "if" { depth += 1; }
        if loop && (w == "while" || w == "until" || w == "for") { depth += 1; }
        if open == "{" && w == "{" { depth += 1; }
        if (open == "if" && w == "fi") || (loop && w == "done") || (open == "{" && w == "}") {
            depth -= 1;
            if depth == 0 { return k; }
        }
    }
    return 0 - 1;
}

// the first of the words k1 / k2 at the level of the block itself (not inside an if / while / for / { } in it)
int find_kw(String[] t, int from, String k1, String k2) {
    int depth = 0;
    for k in from..t.len {
        String w = t[k];
        if k > 0 && !cmd_pos(t, k) { continue; }
        if depth == 0 && (w == k1 || (k2.len > 0 && w == k2)) { return k; }
        if w == "if" || w == "while" || w == "until" || w == "for" || w == "{" { depth += 1; }
        else if w == "fi" || w == "done" || w == "}" { depth -= 1; }
    }
    return 0 - 1;
}

int bad_script(String what) {
    cerr << "jsh: " << what << "\n";
    last_status = 2;
    return 2;
}

void run_if(String[] b) {
    int pos = 0;
    while returning == 0 {
        int th = find_kw(b, pos, "then", "");
        if th < 0 { bad_script("if without then"); return; }
        run_tokens(slice_t(b, pos, th));
        int ok = last_status;
        int nx = find_kw(b, th + 1, "elif", "else");
        int stop = nx;
        if nx < 0 { stop = b.len; }
        if ok == 0 { run_tokens(slice_t(b, th + 1, stop)); return; }
        if nx < 0 { last_status = 0; return; }
        if b[nx] == "else" { run_tokens(slice_t(b, nx + 1, b.len)); return; }
        pos = nx + 1;
    }
}

void run_while(String[] b, bool until) {
    int d = find_kw(b, 0, "do", "");
    if d < 0 { bad_script("while without do"); return; }
    String[] cond = slice_t(b, 0, d);
    String[] body = slice_t(b, d + 1, b.len);
    int rounds = 0;
    last_status = 0;
    while running == 1 && returning == 0 && interrupted == 0 && rounds < 1000000 {
        run_tokens(cond);
        bool yes = last_status == 0;
        if until { yes = !yes; }
        if !yes { last_status = 0; return; }
        run_tokens(body);
        rounds += 1;
        if loop_ctl == 1 { loop_ctl = 0; return; }
        if loop_ctl == 2 { loop_ctl = 0; }
        if interrupted == 1 { return; }
    }
}

void run_for(String[] b) {
    int d = find_kw(b, 0, "do", "");
    if d < 2 || b[1] != "in" { bad_script("for NAME in WORDS; do ... done"); return; }
    String name = b[0];
    String[] vals = arr(8);
    for i in 2..d {
        if b[i] == ";" { continue; }
        String x = expand(b[i]);
        bool star = false;
        for k in 0..x.len { if x[k] == '*' || x[k] == '?' { star = true; } }
        if star { glob_into(vals, x); } else { vals.push(x); }
    }
    String[] body = slice_t(b, d + 1, b.len);
    last_status = 0;
    for i in 0..vals.len {
        if running == 0 || returning == 1 { return; }
        setv(name, vals[i]);
        run_tokens(body);
        if loop_ctl == 1 { loop_ctl = 0; return; }
        if loop_ctl == 2 { loop_ctl = 0; }
        if interrupted == 1 { return; }
    }
}

int find_fn(String name) {
    for i in 0..fn_names.len { if fn_names[i] == name { return i; } }
    return 0 - 1;
}

void call_fn(int f, String[] words) {
    String[] body = fn_bodies[f].split("\x01");
    for i in 1..words.len {
        if i < 10 { setv(str(i), expand(words[i])); }
    }
    for i in words.len..10 { unsetv(str(i)); }
    setv("#", str(words.len - 1));
    run_tokens(body);
    returning = 0;
    loop_ctl = 0;
}

// the statements of a list of words (the new lines are ";"): the compound ones here, the simple ones by run_andor
int run_tokens(String[] t) {
    int i = 0;
    while i < t.len && running == 1 && returning == 0 && loop_ctl == 0 && interrupted == 0 {
        String w = t[i];
        if w == ";" { i += 1; continue; }
        if w == "if" || w == "while" || w == "until" || w == "for" {
            int e = match_end(t, i);
            if e < 0 { return bad_script("a " + w + " that is not closed"); }
            String[] inner = slice_t(t, i + 1, e);
            if w == "if" { run_if(inner); }
            else if w == "for" { run_for(inner); }
            else { run_while(inner, w == "until"); }
            i = e + 1;
        } else if w.len > 2 && w.ends_with("()") && i + 1 < t.len && t[i + 1] == "{" {
            int e = match_end(t, i + 1);
            if e < 0 { return bad_script("a function that is not closed with }"); }
            String name = w.slice(0, w.len - 2);
            String joined = "";
            for k in i + 2..e { if k > i + 2 { joined = joined + "\x01"; } joined = joined + t[k]; }
            int f = find_fn(name);
            if f >= 0 { fn_bodies[f] = joined; } else { fn_names.push(name); fn_bodies.push(joined); }
            i = e + 1;
        } else {
            int k = i;
            while k < t.len && t[k] != ";" && t[k] != "&" { k += 1; }
            if k < t.len && t[k] == "&" { k += 1; }                    // a command with & ends there (it runs in the background)
            run_andor(slice_t(t, i, k));
            i = k;
        }
    }
    return last_status;
}

// a text of one or many lines (a script, a pasted block, the line of the keyboard)
int run_script_text(String text) {
    String[] ls = text.split("\n");
    String[] all = arr(16);
    int i = 0;
    while i < ls.len {
        String line = ls[i];
        i += 1;
        int hd = 0 - 1;                                              // a here-document:  command <<WORD  ... lines ...  WORD
        for k in 0..line.len {
            if hd < 0 && k + 1 < line.len && line[k] == '<' && line[k + 1] == '<' && (k + 2 >= line.len || line[k + 2] != '<') && (k == 0 || line[k - 1] != '<') { hd = k; }
        }
        if hd >= 0 {
            int a = hd + 2;
            bool dash = a < line.len && line[a] == '-';
            if dash { a += 1; }
            while a < line.len && line[a] == ' ' { a += 1; }
            int b = a;
            while b < line.len && line[b] != ' ' && line[b] != ';' && line[b] != '|' { b += 1; }
            String word = line.slice(a, b);
            bool quoted = false;
            if word.len >= 2 && (word[0] == '\'' || word[0] == '"') { quoted = true; word = word.slice(1, word.len - 1); }
            String body = "";
            while i < ls.len {
                String bl = ls[i];
                i += 1;
                String cmp = bl;
                if dash { cmp = bl.trim(); }
                if cmp == word { break; }
                if dash { bl = bl.trim(); }
                if !quoted { bl = expand(bl); }
                body = body + bl + "\n";
            }
            here_n += 1;
            String tmp = Path::join(getv("HOME"), ".jsh_here_" + str(here_n));
            Fs::write_text(tmp, body);
            here_files.push(tmp);
            line = line.slice(0, hd) + "< " + tmp + line.slice(b, line.len);
        }
        String[] w = words_of(line);
        for k in 0..w.len { all.push(w[k]); }
        all.push(";");
    }
    return run_tokens(all);
}

void run_words(String[] raw0) {
    String[] raw = raw0;
    if raw.len == 0 { return; }
    int fnx = find_fn(raw[0]);
    if fnx >= 0 { call_fn(fnx, raw); return; }
    int al = find_alias(raw[0]);
    if al >= 0 {
        String[] spliced = words_of(alias_v[al]);
        for i in 1..raw.len { spliced.push(raw[i]); }
        raw = spliced;
        if raw.len == 0 { return; }
    }
    String[] w = arr(raw.len);
    for i in 0..raw.len {
        String e = raw[i];
        if e == "|" || e == "<" || e == ">" || e == ">>" || e == "&" || e == "2>" || e == "2>>" || e == "2>&1" || e == "1>&2" || e == ">&2" || e == ">&1" || e == "1>" || e == "1>>" || e == "&>" || e == "&>>" || e == "<<<" { w.push(e); }
        else {
            String x = expand(e);
            bool star = false;
            for k in 0..x.len { if x[k] == '*' || x[k] == '?' { star = true; } }
            if star { glob_into(w, x); } else { w.push(x); }
        }
    }
    bool background = w[w.len - 1] == "&";
    int nwords = w.len;
    if background { nwords -= 1; }
    // the commands between the pipes
    int in_pipe = 0 - 1;
    int pids[16];
    int npid = 0;
    int i = 0;
    while i < nwords {
        String[] argv = arr(4);
        String in_file = "";
        String out_file = "";
        String err_file = "";
        int err_mode = 0;
        int append = 0;
        while i < nwords && w[i] != "|" {
            if w[i] == "<" && i + 1 < nwords { in_file = w[i + 1]; i += 2; }
            else if (w[i] == ">" || w[i] == "1>") && i + 1 < nwords { out_file = w[i + 1]; i += 2; }
            else if (w[i] == ">>" || w[i] == "1>>") && i + 1 < nwords { out_file = w[i + 1]; append = 1; i += 2; }
            else if w[i] == "2>" && i + 1 < nwords { err_file = w[i + 1]; err_mode = 1; i += 2; }
            else if w[i] == "2>>" && i + 1 < nwords { err_file = w[i + 1]; err_mode = 2; i += 2; }
            else if w[i] == "2>&1" || w[i] == ">&1" { err_mode = 3; i += 1; }
            else if w[i] == "1>&2" || w[i] == ">&2" { err_mode = 4; i += 1; }
            else if w[i] == "&>" && i + 1 < nwords { out_file = w[i + 1]; err_mode = 3; i += 2; }
            else if w[i] == "&>>" && i + 1 < nwords { out_file = w[i + 1]; append = 1; err_mode = 3; i += 2; }
            else if w[i] == "<<<" && i + 1 < nwords {                                  // a here-string: the word and a new line become the input
                here_n += 1;
                in_file = Path::join(getv("HOME"), ".jsh_here_" + str(here_n));
                Fs::write_text(in_file, w[i + 1] + "\n");
                here_files.push(in_file);
                i += 2;
            }
            else { argv.push(w[i]); i += 1; }
        }
        bool more = i < nwords;
        if more { i += 1; }
        if argv.len == 0 { cerr << "jsh: an empty command\n"; last_status = 2; return; }
        int out_pipe_read = 0 - 1;
        int out_pipe_write = 0 - 1;
        if more {
            int fds[1];
            Sys::pipe(@fds);
            out_pipe_read = fds[0] & 4294967295;
            out_pipe_write = fds[0] >> 32;
        }
        bool redirected = out_file.len > 0 || in_file.len > 0 || err_mode != 0;
        bool printing = argv[0] == "dir" || argv[0] == "echo" || argv[0] == "pwd" || argv[0] == "history" || argv[0] == "help" || argv[0] == "env"
            || argv[0] == "alias" || argv[0] == "type" || argv[0] == "which";
        if npid == 0 && !more && redirected && printing {
            // a built-in whose output goes to a file: it runs in a process of its own with the file as its output
            int cpid = Sys::fork();
            if cpid == 0 {
                if out_file.len > 0 {
                    int g = 0;
                    if append == 1 { g = Sys::open_append(out_file.c()); } else { g = Sys::open_write(out_file.c()); }
                    if g < 0 { cerr << "jsh: cannot write " << out_file << "\n"; Sys::exit(1); }
                    Sys::dup2(g, 1);
                }
                if err_mode == 1 || err_mode == 2 {
                    int h = 0;
                    if err_mode == 2 { h = Sys::open_append(err_file.c()); } else { h = Sys::open_write(err_file.c()); }
                    if h >= 0 { Sys::dup2(h, 2); }
                } else if err_mode == 3 { Sys::dup2(1, 2); }
                else if err_mode == 4 { Sys::dup2(2, 1); }
                builtin(argv);
                Sys::exit(bcode);
            }
            int rs = 0;
            Sys::wait(cpid, @rs);
            last_status = status_of(rs);
            return;
        }
        if npid == 0 && !more && builtin(argv) {
            last_status = bcode;
            return;
        }
        int pid = spawn(argv, in_pipe, out_pipe_write, append, in_file, out_file, err_file, err_mode);
        if npid < 16 { pids[npid] = pid; npid += 1; }
        if in_pipe >= 0 { Sys::close(in_pipe); }
        if out_pipe_write >= 0 { Sys::close(out_pipe_write); }
        in_pipe = out_pipe_read;
    }
    if background {
        jobs.push(pids[npid - 1]);
        cout << "[" << jobs.len << "] " << pids[npid - 1] << "\n";
        return;
    }
    for k in 0..npid {
        int raw_status = 0;
        Sys::wait(pids[k], @raw_status);
        if k == npid - 1 { last_status = status_of(raw_status); }
    }
    for h in 0..here_files.len { Fs::remove(here_files[h]); }
    here_files = arr(2);
}

// the prompt shows ~ for the home folder, $PREFIX for the programs, and a deeper path as ../parent/folder (pwd gives the full path)
String short_path(String d) {
    if d == "/" { return d; }
    String[] parts = d.split("/");
    int n = parts.len;
    if n <= 3 { return d; }                                       // /home, /usr/bin: as they are
    // a long path: the folder above by its first letter, the last name whole (it is the name of the folder you are in):  /f/home
    String a = parts[n - 2].slice(0, 1);
    return "/" + a + "/" + parts[n - 1];
}

// where the typing starts: a private sequence after the prompt (a terminal that does not know it ignores it); the Jaric app lets a tap
// move the cursor only inside the line that is being typed
String prompt_mark() {
    String m = esc();
    m = m + "]7777;prompt";
    m.push((char)7);
    return m;
}

// a colour as "R;G;B" from a name (white blue sky red green yellow cyan magenta orange grey black), #rrggbb or r,g,b; the fallback when it is not understood
String colour_rgb(String spec, String fallback) {
    String s = spec.lower().trim();
    if s.len == 0 { return fallback; }
    if s == "white" { return "255;255;255"; }
    if s == "grey" || s == "gray" { return "176;176;176"; }
    if s == "black" { return "20;20;20"; }
    if s == "red" { return "255;95;95"; }
    if s == "green" { return "120;220;130"; }
    if s == "blue" { return "90;150;255"; }
    if s == "sky" || s == "lightblue" { return "90;190;255"; }
    if s == "cyan" { return "80;220;220"; }
    if s == "yellow" { return "250;220;90"; }
    if s == "orange" { return "255;165;70"; }
    if s == "magenta" || s == "pink" { return "240;120;220"; }
    if s.starts_with("#") && s.len == 7 {
        int v = 0;
        for i in 1..7 {
            int c = s[i] & 255;
            int d = -1;
            if c >= '0' && c <= '9' { d = c - '0'; } else if c >= 'a' && c <= 'f' { d = c - 'a' + 10; }
            if d < 0 { return fallback; }
            v = v * 16 + d;
        }
        return str((v >> 16) & 255) + ";" + str((v >> 8) & 255) + ";" + str(v & 255);
    }
    String[] p = s.split(",");
    if p.len == 3 { return str(p[0].to_int() & 255) + ";" + str(p[1].to_int() & 255) + ";" + str(p[2].to_int() & 255); }
    return fallback;
}

// the colours of the prompt can be set in ~/.jshrc:  export JSH_COLOR_MARK=white   (JSH_COLOR_NAME, JSH_COLOR_PATH, JSH_COLOR_MARK, JSH_COLOR_ERROR)
String prompt_text() {
    char buf[512];
    String dir = "?";
    if Sys::getcwd(@buf, 512) > 0 { dir = (char^)@buf; }
    // the path is the real one; ":" in front of it says which drive (":/" is the root), the long ones are cut:  jc :/../files/home>
    dir = short_path(dir);
    String e = esc();
    String reset = e + "[0m";
    String c_name = colour_rgb(getv("JSH_COLOR_NAME"), "110;170;255");
    String c_path = colour_rgb(getv("JSH_COLOR_PATH"), "200;200;200");
    String c_mark = colour_rgb(getv("JSH_COLOR_MARK"), "255;255;255");               // the mark is white
    String c_err = colour_rgb(getv("JSH_COLOR_ERROR"), "255;95;95");                  // red after a failure (echo $? shows the code)
    String mark = e + "[1;38;2;" + c_mark + "m>" + reset;
    if last_status != 0 { mark = e + "[1;38;2;" + c_err + "m>" + reset; }
    return e + "[1;38;2;" + c_name + "mjc" + reset + " " + e + "[38;2;" + c_path + "m:" + dir + reset + mark + " " + prompt_mark();
}

// commands joined by && and || (the words are already split)
void run_andor(String[] all) {
    String[] cur = arr(8);
    int link = 0;                                             // how the command is joined to the one before: 0 first, 2 &&  3 ||
    for i in 0..all.len + 1 {
        bool end = i == all.len;
        String t = "";
        if !end { t = all[i]; }
        if end || t == ";" || t == "&&" || t == "||" {
            bool go = true;
            if link == 2 && last_status != 0 { go = false; }
            if link == 3 && last_status == 0 { go = false; }
            if go && cur.len > 0 { run_words(cur); }
            cur = arr(8);
            if t == "&&" { link = 2; } else if t == "||" { link = 3; } else { link = 0; }
        } else { cur.push(t); }
    }
}

void run_line(String text) {
    run_script_text(text);
}

// the lines of a file are run one by one (a script, .jshrc); the result is the status of the last line
int run_file(String path) {
    String text = "";
    Result<String, Error> r = Fs::read_text(path);
    if r.is_ok() { text = r.take(); }
    else { cerr << "jsh: " << path << ": cannot read it\n"; return 1; }
    return run_script_text(text);
}

int main() {
    history = arr(16);
    here_files = arr(4);
    envv = arr(32);
    alias_n = arr(8);
    alias_v = arr(8);
    fn_names = arr(8);
    jobs = arr(8);
    fn_bodies = arr(8);
    int nenv = 0;
    while Sys::arg(Sys::argc() + 1 + nenv) != null {          // the environment of the shell starts as the one it was given
        String ev = "";
        ev.append((char^)Sys::arg(Sys::argc() + 1 + nenv));
        envv.push(ev);
        nenv += 1;
    }
    char home0[512];
    String cwd0 = "/";
    if Sys::getcwd(@home0, 512) > 0 { cwd0 = (char^)@home0; }
    if findv("PATH") < 0 { setv("PATH", "/bin:/usr/bin"); }
    if findv("HOME") < 0 { setv("HOME", cwd0); }
    if findv("USER") < 0 { setv("USER", "jaric"); }
    if findv("TERM") < 0 { setv("TERM", "xterm-256color"); }
    setv("SHELL", "jsh");
    setv("PWD", cwd0);
    String[] cmdline = Env::args();
    if cmdline.len > 1 && (cmdline[1] == "--version" || cmdline[1] == "-V") { cout << "jsh 0.7.2\n"; return 0; }
    if cmdline.len > 1 && (cmdline[1] == "--help" || cmdline[1] == "-h") {
        cout << "jsh: a small shell.   jsh [FILE [arguments]]   run a script;   jsh   the prompt (type  help  inside)\n";
        cout << "  jsh install NAME ...   install tools      jsh --version      settings: jaric setting; colours in ~/.jshrc (JSH_COLOR_*)\n";
        return 0;
    }
    if cmdline.len > 1 && cmdline[1] == "install" {                              // jsh install NAME ...
        running = 1;
        String[] jw = arr(cmdline.len + 2);
        jw.push("jget");
        jw.push("tool");
        if cmdline.len == 2 { jw.push("list"); }
        for i in 2..cmdline.len { jw.push(cmdline[i]); }
        run_words(jw);
        return last_status;
    }
    if cmdline.len > 1 {                                      // jsh -c "commands"   or   jsh script
        running = 1;
        if cmdline[1] == "-c" && cmdline.len > 2 { run_line(cmdline[2]); return last_status; }
        return run_file(cmdline[1]);
    }
    running = 1;
    char act[32];
    for q in 0..32 { act[q] = 0; }
    void(int)^ onint = on_sigint;                                 // SIGINT: the program in front gets it and ends; the shell only notes it (a loop of a script stops)
    int^ actw = (int^)@act;
    actw[0] = (int)onint;
    actw[1] = 268435456;                                          // SA_RESTART
    Sys::call(134, 2, (int)@act, 0, 8, 0, 0);
    cout << "jsh 0.1 (the shell of Jaric): help shows the commands\n";
    bool tty = Sys::isatty(0) == 0;
    String rc_file = getv("HOME") + "/.jshrc";
    if tty && Fs::exists(rc_file) { run_file(rc_file); }      // the settings: aliases, export, ...
    while running == 1 {
        String line = "";
        if tty {
            if !read_command(prompt_text()) { break; }
            line = got_line;
        } else {
            line = read.line();
            if line.len == 0 { break; }
        }
        String t = line.trim();
        if t.len == 0 { continue; }
        history.push(t);
        interrupted = 0;
        run_script_text(t);
        interrupted = 0;
    }
    return last_status;
}
