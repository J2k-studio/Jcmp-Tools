// This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0. If a copy of the MPL was not
// distributed with this file, You can obtain one at https://mozilla.org/MPL/2.0/.
// jx86 -- an x86_64 emulator for Linux programs, written in J2K. It runs a static x86_64 ELF (no libc needed, or a freestanding program: the output of the x86 backend
// of jcmp) on any machine, for example this ARM phone.   jx86 PROGRAM [ARGS...]    jx86 --count PROGRAM   (instructions by opcode)   jx86 --limit N PROGRAM
// Step E1 of design 29: the integer core (the usual instructions of compilers, the string instructions with rep, the flags) and the common Linux system calls.
// Not yet: floating point and SIMD (E2, E3), threads (E4), a dynamic loader. An instruction it does not know stops the program with its address and bytes.
#import <stdlib>
using stdlib;

String jx86_version() { return "0.1.0"; }

// ---------- the guest: memory, registers, flags
char^ gm;                       // the guest memory: guest address a is gm[a]
i64 gsize;                      // its size in bytes
i64 r[16];                      // rax rcx rdx rbx rsp rbp rsi rdi r8 .. r15
i64 rip;
i64 cf; i64 zf; i64 sf; i64 of; i64 pf; i64 af; i64 df;
i64 fsbase;
i64 running;
i64 exit_code;
i64 g_min;                      // the top bit: unsigned comparison = signed comparison of (a xor g_min)
i64 brk_start; i64 brk_cur;
i64 mmap_next;
i64 icount;
i64 ilimit;
i64 want_count;
i64 ops[512];                   // how many times each opcode ran (0..255, and 256 + the second byte of 0F xx)
i64 trace;

void fault(String msg) {
    jerr << "jx86: " << msg << " at rip=0x" << tohex(rip) << "\n";
    running = 0;
    exit_code = 139;
}

bool ult(i64 a, i64 b) { return (a xor g_min) < (b xor g_min); }

i64 mask_of(i64 sz) {
    if sz == 8 { return -1; }
    return (1 << (sz * 8)) - 1;
}

i64 sign_of(i64 sz) { return 1 << (sz * 8 - 1); }

i64 shr(i64 x, i64 n) {
    if n <= 0 { return x; }
    if n >= 64 { return 0; }
    return (x >> n) & ((1 << (64 - n)) - 1);
}

// ---------- memory
i64 rd8(i64 a) {
    if a < 0 || a >= gsize { fault("read outside the memory (" + tohex(a) + ")"); return 0; }
    return gm[a] & 255;
}

void wr8(i64 a, i64 v) {
    if a < 0 || a >= gsize { fault("write outside the memory (" + tohex(a) + ")"); return; }
    gm[a] = (char)(v & 255);
}

i64 rd(i64 a, i64 sz) {
    if a < 0 || a + sz > gsize { fault("read outside the memory (" + tohex(a) + ")"); return 0; }
    i64 v = 0;
    i64 i = sz - 1;
    while i >= 0 { v = (v << 8) | (gm[a + i] & 255); i -= 1; }
    return v;
}

void wr(i64 a, i64 sz, i64 v) {
    if a < 0 || a + sz > gsize { fault("write outside the memory (" + tohex(a) + ")"); return; }
    for i in 0..sz { gm[a + i] = (char)(v & 255); v = v >> 8; }
}

// ---------- registers by size
i64 getr(i64 n, i64 sz, i64 rex) {
    if sz == 8 { return r[n]; }
    if sz == 4 { return r[n] & 0xffffffff; }
    if sz == 2 { return r[n] & 0xffff; }
    if rex == 0 && n >= 4 && n < 8 { return (r[n - 4] >> 8) & 255; }
    return r[n] & 255;
}

void setr(i64 n, i64 sz, i64 v, i64 rex) {
    if sz == 8 { r[n] = v; return; }
    if sz == 4 { r[n] = v & 0xffffffff; return; }
    if sz == 2 { r[n] = (r[n] & ~0xffff) | (v & 0xffff); return; }
    if rex == 0 && n >= 4 && n < 8 { r[n - 4] = (r[n - 4] & ~0xff00) | ((v & 255) << 8); return; }
    r[n] = (r[n] & ~0xff) | (v & 255);
}

// the value v of size sz, as a signed number
i64 sx(i64 v, i64 sz) {
    if sz == 8 { return v; }
    i64 s = sign_of(sz);
    v = v & mask_of(sz);
    if (v & s) != 0 { return v - (s << 1); }
    return v;
}

// ---------- flags
i64 parity(i64 v) {
    i64 b = v & 255;
    i64 c = 0;
    while b != 0 { c += b & 1; b = b >> 1; }
    if (c & 1) == 0 { return 1; }
    return 0;
}

void flags_zsp(i64 res, i64 sz) {
    i64 m = mask_of(sz);
    i64 v = res & m;
    zf = 0; if v == 0 { zf = 1; }
    sf = 0; if (v & sign_of(sz)) != 0 { sf = 1; }
    pf = parity(v);
}

// the ALU: 0 add 1 or 2 adc 3 sbb 4 and 5 sub 6 xor 7 cmp; returns the result (cmp: the difference)
i64 alu(i64 op, i64 a, i64 b, i64 sz) {
    i64 m = mask_of(sz);
    i64 s = sign_of(sz);
    a = a & m;
    b = b & m;
    i64 res = 0;
    if op == 0 || op == 2 {
        i64 c = 0;
        if op == 2 { c = cf; }
        res = (a + b + c) & m;
        cf = 0;
        if sz == 8 { if ult(res, a) || (c == 1 && res == a) { cf = 1; } }
        else { if (a + b + c) > m { cf = 1; } }
        of = 0; if (((a xor res) & (b xor res) & s) != 0) { of = 1; }
        af = 0; if (((a xor b xor res) & 16) != 0) { af = 1; }
    } else if op == 5 || op == 7 || op == 3 {
        i64 c = 0;
        if op == 3 { c = cf; }
        res = (a - b - c) & m;
        cf = 0;
        if sz == 8 { if ult(a, b) || (c == 1 && a == b) { cf = 1; } }
        else { if a < b + c { cf = 1; } }
        of = 0; if (((a xor b) & (a xor res) & s) != 0) { of = 1; }
        af = 0; if (((a xor b xor res) & 16) != 0) { af = 1; }
    } else {
        if op == 1 { res = a | b; }
        if op == 4 { res = a & b; }
        if op == 6 { res = a xor b; }
        cf = 0; of = 0; af = 0;
    }
    flags_zsp(res, sz);
    return res;
}

bool cond(i64 cc) {
    i64 v = 0;
    i64 c = cc >> 1;
    if c == 0 { v = of; }
    else if c == 1 { v = cf; }
    else if c == 2 { v = zf; }
    else if c == 3 { v = cf | zf; }
    else if c == 4 { v = sf; }
    else if c == 5 { v = pf; }
    else if c == 6 { if sf != of { v = 1; } }
    else { if zf == 1 || sf != of { v = 1; } }
    if (cc & 1) == 1 { return v == 0; }
    return v == 1;
}

// ---------- decoding
i64 pc;                         // the byte being read
i64 pfx66; i64 pfxf2; i64 pfxf3; i64 seg;
i64 rex; i64 rexw; i64 rexr; i64 rexx; i64 rexb;
i64 mdmod; i64 mdreg; i64 mdrm; i64 ea; i64 ismem;

i64 fetch8() { i64 v = rd8(pc); pc += 1; return v; }
i64 fetch16() { i64 v = rd(pc, 2); pc += 2; return v; }
i64 fetch32() { i64 v = rd(pc, 4); pc += 4; return v; }
i64 fetch64() { i64 v = rd(pc, 8); pc += 8; return v; }
i64 fetch_imm(i64 sz) {
    if sz == 1 { return sx(fetch8(), 1); }
    if sz == 2 { return sx(fetch16(), 2); }
    return sx(fetch32(), 4);                                  // 4 and 8: a 32 bit immediate, sign extended
}

// reads the ModRM byte (and SIB, displacement); immsz is the number of bytes of immediate that follow (the base of a rip relative address)
void modrm(i64 immsz) {
    i64 b = fetch8();
    mdmod = b >> 6;
    mdreg = ((b >> 3) & 7) | (rexr << 3);
    mdrm = b & 7;
    ismem = 1;
    if mdmod == 3 { ismem = 0; mdrm = mdrm | (rexb << 3); return; }
    i64 base = 0;
    if mdrm == 4 {
        i64 sib = fetch8();
        i64 scale = sib >> 6;
        i64 idx = ((sib >> 3) & 7) | (rexx << 3);
        i64 bs = sib & 7;
        i64 addr = 0;
        if idx != 4 { addr = r[idx] << scale; }
        if bs == 5 && mdmod == 0 { addr += sx(fetch32(), 4); }
        else { addr += r[bs | (rexb << 3)]; }
        base = addr;
    } else if mdrm == 5 && mdmod == 0 {
        i64 d = sx(fetch32(), 4);
        base = pc + immsz + d;                               // rip relative: the address after the instruction
    } else {
        base = r[mdrm | (rexb << 3)];
    }
    if mdmod == 1 { base += sx(fetch8(), 1); }
    if mdmod == 2 { base += sx(fetch32(), 4); }
    if seg == 1 { base += fsbase; }
    ea = base;
}

i64 rm_read(i64 sz) {
    if ismem == 0 { return getr(mdrm, sz, rex); }
    return rd(ea, sz);
}

void rm_write(i64 sz, i64 v) {
    if ismem == 0 { setr(mdrm, sz, v, rex); return; }
    wr(ea, sz, v);
}

void push(i64 v) { r[4] -= 8; wr(r[4], 8, v); }
i64 pop() { i64 v = rd(r[4], 8); r[4] += 8; return v; }

// ---------- 128 bit helpers
i64 mulhi_u(i64 a, i64 b) {
    i64 a0 = a & 0xffffffff; i64 a1 = shr(a, 32);
    i64 b0 = b & 0xffffffff; i64 b1 = shr(b, 32);
    i64 p00 = a0 * b0; i64 p01 = a0 * b1; i64 p10 = a1 * b0; i64 p11 = a1 * b1;
    i64 mid = shr(p00, 32) + (p01 & 0xffffffff) + (p10 & 0xffffffff);
    return p11 + shr(p01, 32) + shr(p10, 32) + shr(mid, 32);
}

i64 mulhi_s(i64 a, i64 b) {
    i64 h = mulhi_u(a, b);
    if a < 0 { h -= b; }
    if b < 0 { h -= a; }
    return h;
}

i64 q128; i64 rem128;
// the unsigned division of hi:lo by d (hi < d); the quotient in q128, the remainder in rem128
void udiv128(i64 hi, i64 lo, i64 d) {
    if hi == 0 && lo >= 0 && d > 0 { q128 = lo / d; rem128 = lo % d; return; }
    i64 rem = hi;
    i64 q = 0;
    for i in 0..64 {
        i64 top = shr(rem, 63);
        rem = (rem << 1) | shr(lo, 63);
        lo = lo << 1;
        q = q << 1;
        if top == 1 || !ult(rem, d) { rem = rem - d; q = q | 1; }
    }
    q128 = q;
    rem128 = rem;
}

// ---------- the system calls (Linux x86_64)
i64 guest_string_len(i64 a) { i64 n = 0; while rd8(a + n) != 0 && running == 1 { n += 1; } return n; }

i64 do_syscall() {
    i64 nr = r[0];
    i64 a1 = r[7]; i64 a2 = r[6]; i64 a3 = r[2]; i64 a4 = r[10];
    if nr == 1 {                                              // write
        if a2 < 0 || a2 + a3 > gsize { return -14; }
        if a3 <= 0 { return 0; }
        return Sys::write(a1, (void^)(gm + a2), a3);
    }
    if nr == 0 {                                              // read
        if a2 < 0 || a2 + a3 > gsize { return -14; }
        return Sys::read(a1, (void^)(gm + a2), a3);
    }
    if nr == 20 {                                             // writev
        i64 total = 0;
        for i in 0..a3 {
            i64 base = rd(a2 + i * 16, 8);
            i64 len = rd(a2 + i * 16 + 8, 8);
            if len > 0 {
                i64 w = Sys::write(a1, (void^)(gm + base), len);
                if w < 0 { return w; }
                total += w;
            }
        }
        return total;
    }
    if nr == 60 || nr == 231 { running = 0; exit_code = a1 & 255; return 0; }
    if nr == 12 {                                             // brk
        if a1 == 0 { return brk_cur; }
        if a1 >= brk_start && a1 < mmap_next - 4096 { brk_cur = a1; }
        return brk_cur;
    }
    if nr == 9 {                                              // mmap: anonymous only
        i64 len = (a2 + 4095) & ~4095;
        if (a4 & 32) == 0 { return -19; }
        i64 at = mmap_next;
        if at + len > gsize - 0x1000000 { return -12; }
        mmap_next = at + len;
        return at;
    }
    if nr == 11 || nr == 10 || nr == 28 { return 0; }         // munmap, mprotect, madvise: nothing to do
    if nr == 158 {                                            // arch_prctl
        if a1 == 0x1002 { fsbase = a2; return 0; }
        if a1 == 0x1003 { wr(a2, 8, fsbase); return 0; }
        return -22;
    }
    if nr == 228 {                                            // clock_gettime
        i64 ms = Time::now_ms();
        wr(a2, 8, ms / 1000);
        wr(a2 + 8, 8, (ms % 1000) * 1000000);
        return 0;
    }
    if nr == 39 || nr == 186 { return 4242; }                 // getpid, gettid
    if nr == 63 {                                             // uname
        wr8(a1, 0);
        String s = "Linux";
        for i in 0..s.len { wr8(a1 + i, s[i]); }
        wr8(a1 + s.len, 0);
        String m = "x86_64";
        for i in 0..m.len { wr8(a1 + 4 * 65 + i, m[i]); }
        wr8(a1 + 4 * 65 + m.len, 0);
        return 0;
    }
    if nr == 16 { return -25; }                               // ioctl: not a terminal
    if nr == 218 || nr == 273 || nr == 334 || nr == 302 { return -38; }
    if nr == 202 { return 0; }                                // futex: one thread
    if nr == 318 {                                            // getrandom
        for i in 0..a2 { wr8(a1 + i, (i * 37 + 11) & 255); }
        return a2;
    }
    if nr == 2 || nr == 257 || nr == 3 { return -2; }         // open, openat, close of files: not in E1
    jerr << "jx86: the system call " << nr << " is not implemented\n";
    return -38;
}

// ---------- one instruction
i64 rip_start;

void unknown(i64 op, i64 op2) {
    String bytes = "";
    for i in 0..8 { bytes = bytes + padl(tohex(rd8(rip_start + i)), 2) + " "; }
    jerr << "jx86: unknown instruction " << tohex(op) << " " << tohex(op2) << "  [" << bytes << "] at rip=0x" << tohex(rip_start) << "\n";
    running = 0;
    exit_code = 132;
}

i64 shift_op(i64 kind, i64 v, i64 cnt, i64 sz) {
    i64 m = mask_of(sz);
    i64 bits = sz * 8;
    i64 s = sign_of(sz);
    if sz == 8 { cnt = cnt & 63; } else { cnt = cnt & 31; }
    if cnt == 0 { return v & m; }
    i64 res = 0;
    v = v & m;
    if kind == 4 || kind == 6 {                                // shl
        if cnt > bits { cf = 0; } else { cf = shr(v, bits - cnt) & 1; }
        res = (v << cnt) & m;
        of = 0; if cnt == 1 { if ((res & s) != 0) != (cf == 1) { of = 1; } }
        flags_zsp(res, sz);
    } else if kind == 5 {                                      // shr
        cf = shr(v, cnt - 1) & 1;
        res = shr(v, cnt) & m;
        of = 0; if cnt == 1 { if (v & s) != 0 { of = 1; } }
        flags_zsp(res, sz);
    } else if kind == 7 {                                      // sar
        i64 sv = sx(v, sz);
        cf = (sv >> (cnt - 1)) & 1;
        res = (sv >> cnt) & m;
        of = 0;
        flags_zsp(res, sz);
    } else if kind == 0 {                                      // rol
        i64 c = cnt % bits;
        res = ((v << c) | shr(v, bits - c)) & m;
        if c == 0 { res = v; }
        cf = res & 1;
        of = 0; if cnt == 1 { if (((res & s) != 0) != (cf == 1)) { of = 1; } }
    } else if kind == 1 {                                      // ror
        i64 c = cnt % bits;
        res = (shr(v, c) | (v << (bits - c))) & m;
        if c == 0 { res = v; }
        cf = 0; if (res & s) != 0 { cf = 1; }
        of = 0; if cnt == 1 { if (((res & s) != 0) != ((res & (s >> 1)) != 0)) { of = 1; } }
    } else {
        fault("rcl and rcr are not implemented");
    }
    return res;
}

void do_string(i64 op, i64 sz) {
    i64 size = 1;
    if (op & 1) == 1 { size = sz; }
    i64 step = size;
    if df == 1 { step = 0 - size; }
    i64 rep = 0;
    if pfxf3 == 1 || pfxf2 == 1 { rep = 1; }
    i64 kind = op & 0xfe;                                      // a4 movs, a6 cmps, aa stos, ac lods, ae scas
    while true {
        if rep == 1 && r[1] == 0 { break; }
        if kind == 0xa4 { wr(r[7], size, rd(r[6], size)); r[6] += step; r[7] += step; }
        else if kind == 0xaa { wr(r[7], size, r[0]); r[7] += step; }
        else if kind == 0xac { i64 v = rd(r[6], size); setr(0, size, v, 1); r[6] += step; }
        else if kind == 0xa6 { alu(7, rd(r[6], size), rd(r[7], size), size); r[6] += step; r[7] += step; }
        else { alu(7, getr(0, size, 1), rd(r[7], size), size); r[7] += step; }
        if rep == 0 || running == 0 { break; }
        r[1] -= 1;
        if kind == 0xa6 || kind == 0xae {
            if pfxf3 == 1 && zf == 0 { break; }
            if pfxf2 == 1 && zf == 1 { break; }
        }
    }
}

void step() {
    rip_start = rip;
    pc = rip;
    pfx66 = 0; pfxf2 = 0; pfxf3 = 0; seg = 0;
    rex = 0; rexw = 0; rexr = 0; rexx = 0; rexb = 0;
    i64 op = fetch8();
    bool more = true;
    while more && running == 1 {
        if op == 0x66 { pfx66 = 1; op = fetch8(); }
        else if op == 0xf2 { pfxf2 = 1; op = fetch8(); }
        else if op == 0xf3 { pfxf3 = 1; op = fetch8(); }
        else if op == 0x64 { seg = 1; op = fetch8(); }
        else if op == 0x65 || op == 0x2e || op == 0x3e || op == 0x26 || op == 0x36 || op == 0xf0 || op == 0x67 { op = fetch8(); }
        else { more = false; }
    }
    if (op & 0xf0) == 0x40 {
        rex = op;
        rexw = (op >> 3) & 1; rexr = (op >> 2) & 1; rexx = (op >> 1) & 1; rexb = op & 1;
        op = fetch8();
    }
    i64 sz = 4;
    if rexw == 1 { sz = 8; } else if pfx66 == 1 { sz = 2; }
    if want_count == 1 { ops[op] += 1; }
    if op < 0x40 && (op & 7) < 6 {                              // add or adc sbb and sub xor cmp
        i64 g = op >> 3;
        i64 form = op & 7;
        i64 size = sz;
        if (form & 1) == 0 { size = 1; }
        if form >= 4 {
            i64 imm = 0;
            if size == 1 { imm = sx(fetch8(), 1); } else { imm = fetch_imm(size); }
            i64 a = getr(0, size, rex);
            i64 res = alu(g, a, imm, size);
            if g != 7 { setr(0, size, res, rex); }
        } else {
            modrm(0);
            if form < 2 {                                      // r/m, r
                i64 res = alu(g, rm_read(size), getr(mdreg, size, rex), size);
                if g != 7 { rm_write(size, res); }
            } else {                                           // r, r/m
                i64 res = alu(g, getr(mdreg, size, rex), rm_read(size), size);
                if g != 7 { setr(mdreg, size, res, rex); }
            }
        }
    } else if op >= 0x50 && op <= 0x57 { push(r[(op & 7) | (rexb << 3)]); }
    else if op >= 0x58 && op <= 0x5f { r[(op & 7) | (rexb << 3)] = pop(); }
    else if op == 0x63 { modrm(0); i64 v = sx(rm_read(4), 4); setr(mdreg, sz, v, rex); }
    else if op == 0x68 { push(fetch_imm(4)); }
    else if op == 0x6a { push(sx(fetch8(), 1)); }
    else if op == 0x69 || op == 0x6b {
        i64 immsz = 4; if op == 0x6b { immsz = 1; }
        modrm(immsz);
        i64 src = sx(rm_read(sz), sz);
        i64 imm = 0;
        if op == 0x6b { imm = sx(fetch8(), 1); } else { imm = fetch_imm(sz); }
        i64 res = src * imm;
        if sz == 8 { i64 hi = mulhi_s(src, imm); cf = 0; if hi != (res >> 63) { cf = 1; } }
        else { cf = 0; if res != sx(res, sz) { cf = 1; } }
        of = cf;
        setr(mdreg, sz, res, rex);
    }
    else if op >= 0x70 && op <= 0x7f { i64 d = sx(fetch8(), 1); if cond(op & 15) { pc += d; } }
    else if op == 0x80 || op == 0x81 || op == 0x83 {
        i64 size = sz; if op == 0x80 { size = 1; }
        i64 immsz = 1; if op == 0x81 { immsz = 4; if size == 2 { immsz = 2; } }
        modrm(immsz);
        i64 imm = 0;
        if op == 0x81 { imm = fetch_imm(size); } else { imm = sx(fetch8(), 1); }
        i64 res = alu(mdreg & 7, rm_read(size), imm, size);
        if (mdreg & 7) != 7 { rm_write(size, res); }
    }
    else if op == 0x84 || op == 0x85 {
        i64 size = sz; if op == 0x84 { size = 1; }
        modrm(0);
        alu(4, rm_read(size), getr(mdreg, size, rex), size);
    }
    else if op == 0x86 || op == 0x87 {
        i64 size = sz; if op == 0x86 { size = 1; }
        modrm(0);
        i64 a = rm_read(size); i64 b = getr(mdreg, size, rex);
        rm_write(size, b); setr(mdreg, size, a, rex);
    }
    else if op >= 0x88 && op <= 0x8b {
        i64 size = sz; if (op & 1) == 0 { size = 1; }
        modrm(0);
        if op < 0x8a { rm_write(size, getr(mdreg, size, rex)); } else { setr(mdreg, size, rm_read(size), rex); }
    }
    else if op == 0x8d { modrm(0); setr(mdreg, sz, ea - (seg * fsbase), rex); }
    else if op == 0x8f { modrm(0); rm_write(8, pop()); }
    else if op == 0x90 { }
    else if op > 0x90 && op <= 0x97 { i64 n = (op & 7) | (rexb << 3); i64 t = getr(0, sz, rex); setr(0, sz, getr(n, sz, rex), rex); setr(n, sz, t, rex); }
    else if op == 0x98 {
        if sz == 8 { r[0] = sx(r[0], 4); } else if sz == 4 { r[0] = sx(r[0], 2) & 0xffffffff; } else { setr(0, 2, sx(r[0], 1), 0); }
    }
    else if op == 0x99 {
        if sz == 8 { if r[0] < 0 { r[2] = -1; } else { r[2] = 0; } }
        else if sz == 4 { if (r[0] & 0x80000000) != 0 { r[2] = 0xffffffff; } else { r[2] = 0; } }
        else { if (r[0] & 0x8000) != 0 { setr(2, 2, 0xffff, 0); } else { setr(2, 2, 0, 0); } }
    }
    else if op == 0x9c { push((cf) | (pf << 2) | (af << 4) | (zf << 6) | (sf << 7) | (df << 10) | (of << 11) | 2); }
    else if op == 0x9d { i64 f = pop(); cf = f & 1; pf = (f >> 2) & 1; af = (f >> 4) & 1; zf = (f >> 6) & 1; sf = (f >> 7) & 1; df = (f >> 10) & 1; of = (f >> 11) & 1; }
    else if op == 0xa8 { alu(4, getr(0, 1, rex), sx(fetch8(), 1), 1); }
    else if op == 0xa9 { alu(4, getr(0, sz, rex), fetch_imm(sz), sz); }
    else if (op >= 0xa4 && op <= 0xa7) || (op >= 0xaa && op <= 0xaf) { do_string(op, sz); }
    else if op >= 0xb0 && op <= 0xb7 { setr((op & 7) | (rexb << 3), 1, fetch8(), rex); }
    else if op >= 0xb8 && op <= 0xbf {
        i64 n = (op & 7) | (rexb << 3);
        if sz == 8 { r[n] = fetch64(); } else if sz == 4 { r[n] = fetch32() & 0xffffffff; } else { setr(n, 2, fetch16(), rex); }
    }
    else if op == 0xc0 || op == 0xc1 || op == 0xd0 || op == 0xd1 || op == 0xd2 || op == 0xd3 {
        i64 size = sz; if (op & 1) == 0 { size = 1; }
        i64 immsz = 0; if op < 0xd0 { immsz = 1; }
        modrm(immsz);
        i64 cnt = 1;
        if op < 0xd0 { cnt = fetch8(); } else if op >= 0xd2 { cnt = r[1] & 255; }
        i64 res = shift_op(mdreg & 7, rm_read(size), cnt, size);
        rm_write(size, res);
    }
    else if op == 0xc3 { rip = pop(); return; }
    else if op == 0xc2 { i64 n = fetch16(); rip = pop(); r[4] += n; return; }
    else if op == 0xc6 { modrm(1); rm_write(1, fetch8()); }
    else if op == 0xc7 { i64 immsz = 4; if sz == 2 { immsz = 2; } modrm(immsz); rm_write(sz, fetch_imm(sz)); }
    else if op == 0xc9 { r[4] = r[5]; r[5] = pop(); }
    else if op == 0xcc { fault("int3"); }
    else if op == 0xe8 { i64 d = sx(fetch32(), 4); push(pc); pc += d; }
    else if op == 0xe9 { i64 d = sx(fetch32(), 4); pc += d; }
    else if op == 0xeb { i64 d = sx(fetch8(), 1); pc += d; }
    else if op == 0xf4 { running = 0; }
    else if op == 0xf5 { cf = 1 - cf; }
    else if op == 0xf8 { cf = 0; }
    else if op == 0xf9 { cf = 1; }
    else if op == 0xfc { df = 0; }
    else if op == 0xfd { df = 1; }
    else if op == 0xf6 || op == 0xf7 {
        i64 size = sz; if op == 0xf6 { size = 1; }
        i64 immsz = 0;
        i64 m0 = rd8(pc);
        if ((m0 >> 3) & 7) < 2 { immsz = size; if immsz == 8 { immsz = 4; } }
        modrm(immsz);
        i64 g = mdreg & 7;
        i64 m = mask_of(size);
        if g < 2 { alu(4, rm_read(size), fetch_imm(size), size); }
        else if g == 2 { rm_write(size, ~rm_read(size)); }
        else if g == 3 {
            i64 v = rm_read(size);
            i64 res = alu(5, 0, v, size);
            cf = 0; if (v & m) != 0 { cf = 1; }
            rm_write(size, res);
        }
        else if g == 4 || g == 5 {                              // mul, imul (one operand)
            i64 src = rm_read(size);
            if g == 5 { src = sx(src, size); }
            i64 a = getr(0, size, rex);
            if g == 5 { a = sx(a, size); }
            i64 lo = a * src;
            i64 hi = 0;
            if size == 8 { if g == 4 { hi = mulhi_u(a, src); } else { hi = mulhi_s(a, src); } }
            if size == 1 { setr(0, 2, lo, 0); }
            else if size == 2 { setr(0, 2, lo, 0); setr(2, 2, shr(lo, 16), 0); }
            else if size == 4 { r[0] = lo & 0xffffffff; r[2] = shr(lo, 32) & 0xffffffff; }
            else { r[0] = lo; r[2] = hi; }
            cf = 0;
            if g == 4 { if size == 8 { if hi != 0 { cf = 1; } } else if (shr(lo, size * 8) & mask_of(size)) != 0 { cf = 1; } }
            else { if size == 8 { if hi != (lo >> 63) { cf = 1; } } else if lo != sx(lo, size) { cf = 1; } }
            of = cf;
        }
        else {                                                  // div, idiv
            i64 src = rm_read(size);
            if g == 7 { src = sx(src, size); }
            if src == 0 { fault("division by zero"); return; }
            if size == 1 {
                i64 dividend = r[0] & 0xffff;
                if g == 7 { dividend = sx(dividend, 2); }
                i64 q = dividend / src; i64 rm = dividend % src;
                setr(0, 1, q, 0); setr(4, 1, rm, 0);            // al, ah
                r[0] = (r[0] & ~0xffff) | (q & 255) | ((rm & 255) << 8);
            } else if size == 2 {
                i64 dividend = ((r[2] & 0xffff) << 16) | (r[0] & 0xffff);
                if g == 7 { dividend = sx(dividend, 4); }
                i64 q = dividend / src; i64 rm = dividend % src;
                setr(0, 2, q, 0); setr(2, 2, rm, 0);
            } else if size == 4 {
                if g == 7 {
                    i64 dividend = (sx(r[2], 4) << 32) | (r[0] & 0xffffffff);
                    i64 q = dividend / src; i64 rm = dividend % src;
                    r[0] = q & 0xffffffff; r[2] = rm & 0xffffffff;
                } else {
                    udiv128(0, ((r[2] & 0xffffffff) << 32) | (r[0] & 0xffffffff), src & 0xffffffff);
                    r[0] = q128 & 0xffffffff; r[2] = rem128 & 0xffffffff;
                }
            } else {
                if g == 7 {
                    if r[2] == (r[0] >> 63) { i64 q = r[0] / src; i64 rm = r[0] % src; r[0] = q; r[2] = rm; }
                    else { fault("idiv of a 128 bit dividend is not implemented"); }
                } else {
                    udiv128(r[2], r[0], src);
                    r[0] = q128; r[2] = rem128;
                }
            }
        }
    }
    else if op == 0xfe || op == 0xff {
        i64 size = sz; if op == 0xfe { size = 1; }
        modrm(0);
        i64 g = mdreg & 7;
        if g < 2 {                                              // inc, dec: the carry flag stays
            i64 c = cf;
            i64 res = alu(0, rm_read(size), 1, size);
            if g == 1 { res = alu(5, rm_read(size), 1, size); }
            cf = c;
            rm_write(size, res);
        }
        else if g == 2 { i64 t = rm_read(8); push(pc); pc = t; }
        else if g == 4 { pc = rm_read(8); }
        else if g == 6 { push(rm_read(8)); }
        else { unknown(op, g); }
    }
    else if op == 0x0f {
        i64 op2 = fetch8();
        if want_count == 1 { ops[256 + op2] += 1; }
        if op2 == 0x05 { r[0] = do_syscall(); r[1] = pc; r[11] = (cf) | (pf << 2) | (af << 4) | (zf << 6) | (sf << 7) | 0x202; }
        else if op2 == 0x0b { fault("ud2"); }
        else if op2 == 0x1f || op2 == 0x1e || op2 == 0x18 { modrm(0); }
        else if op2 >= 0x40 && op2 <= 0x4f { modrm(0); i64 v = rm_read(sz); if cond(op2 & 15) { setr(mdreg, sz, v, rex); } else if sz == 4 { r[mdreg] = r[mdreg] & 0xffffffff; } }
        else if op2 >= 0x80 && op2 <= 0x8f { i64 d = sx(fetch32(), 4); if cond(op2 & 15) { pc += d; } }
        else if op2 >= 0x90 && op2 <= 0x9f { modrm(0); i64 v = 0; if cond(op2 & 15) { v = 1; } rm_write(1, v); }
        else if op2 == 0xa2 {                                   // cpuid: a plain x86_64 with SSE2
            i64 leaf = r[0] & 0xffffffff;
            if leaf == 0 { r[0] = 1; r[3] = 0x756e6547; r[2] = 0x49656e69; r[1] = 0x6c65746e; }
            else if leaf == 1 { r[0] = 0x000306a9; r[3] = 0; r[1] = 0; r[2] = (1 << 0) | (1 << 8) | (1 << 15) | (1 << 25) | (1 << 26); }
            else { r[0] = 0; r[3] = 0; r[1] = 0; r[2] = 0; }
        }
        else if op2 == 0xaf { modrm(0); i64 a = sx(getr(mdreg, sz, rex), sz); i64 b = sx(rm_read(sz), sz); i64 res = a * b; cf = 0;
            if sz == 8 { if mulhi_s(a, b) != (res >> 63) { cf = 1; } } else if res != sx(res, sz) { cf = 1; } of = cf; setr(mdreg, sz, res, rex); }
        else if op2 == 0xb6 { modrm(0); setr(mdreg, sz, rm_read(1), rex); }
        else if op2 == 0xb7 { modrm(0); setr(mdreg, sz, rm_read(2), rex); }
        else if op2 == 0xbe { modrm(0); setr(mdreg, sz, sx(rm_read(1), 1), rex); }
        else if op2 == 0xbf { modrm(0); setr(mdreg, sz, sx(rm_read(2), 2), rex); }
        else if op2 == 0xbc || op2 == 0xbd {                    // bsf, bsr (with F3: tzcnt, lzcnt)
            modrm(0);
            i64 v = rm_read(sz) & mask_of(sz);
            i64 bits = sz * 8;
            if v == 0 {
                zf = 1;
                if pfxf3 == 1 { cf = 1; setr(mdreg, sz, bits, rex); } else { cf = 0; }
            } else {
                zf = 0; cf = 0;
                i64 idx = 0;
                if op2 == 0xbc { while ((v >> idx) & 1) == 0 { idx += 1; } }
                else { idx = bits - 1; while ((shr(v, idx)) & 1) == 0 { idx -= 1; } }
                if pfxf3 == 1 && op2 == 0xbd { idx = bits - 1 - idx; }
                setr(mdreg, sz, idx, rex);
            }
        }
        else if op2 >= 0xc8 && op2 <= 0xcf {                    // bswap
            i64 n = (op2 & 7) | (rexb << 3);
            i64 v = r[n]; i64 res = 0;
            i64 bytes = 4; if rexw == 1 { bytes = 8; }
            for i in 0..bytes { res = (res << 8) | (v & 255); v = shr(v, 8); }
            r[n] = res;
        }
        else if op2 == 0xb0 || op2 == 0xb1 {                    // cmpxchg
            i64 size = sz; if op2 == 0xb0 { size = 1; }
            modrm(0);
            i64 cur = rm_read(size);
            alu(7, getr(0, size, rex), cur, size);
            if zf == 1 { rm_write(size, getr(mdreg, size, rex)); } else { setr(0, size, cur, rex); }
        }
        else if op2 == 0xc0 || op2 == 0xc1 {                    // xadd
            i64 size = sz; if op2 == 0xc0 { size = 1; }
            modrm(0);
            i64 a = rm_read(size); i64 b = getr(mdreg, size, rex);
            i64 res = alu(0, a, b, size);
            setr(mdreg, size, a, rex);
            rm_write(size, res);
        }
        else if op2 == 0xa3 || op2 == 0xab || op2 == 0xb3 || op2 == 0xbb || op2 == 0xba {   // bt, bts, btr, btc
            i64 immsz = 0; if op2 == 0xba { immsz = 1; }
            modrm(immsz);
            i64 bit = 0;
            i64 kind = 0;
            if op2 == 0xba { bit = fetch8(); kind = (mdreg & 7) - 4; }
            else { bit = getr(mdreg, sz, rex); if op2 == 0xab { kind = 1; } else if op2 == 0xb3 { kind = 2; } else if op2 == 0xbb { kind = 3; } }
            i64 bits = sz * 8;
            bit = bit % bits;
            i64 v = rm_read(sz);
            cf = shr(v, bit) & 1;
            if kind == 1 { rm_write(sz, v | (1 << bit)); }
            else if kind == 2 { rm_write(sz, v & ~(1 << bit)); }
            else if kind == 3 { rm_write(sz, v xor (1 << bit)); }
        }
        else if op2 == 0xa4 || op2 == 0xa5 || op2 == 0xac || op2 == 0xad {               // shld, shrd
            i64 immsz = 0; if (op2 & 1) == 0 { immsz = 1; }
            modrm(immsz);
            i64 cnt = 0;
            if (op2 & 1) == 0 { cnt = fetch8(); } else { cnt = r[1] & 255; }
            i64 bits = sz * 8;
            if sz == 8 { cnt = cnt & 63; } else { cnt = cnt & 31; }
            if cnt != 0 {
                i64 dst = rm_read(sz) & mask_of(sz);
                i64 src = getr(mdreg, sz, rex);
                i64 res = 0;
                if op2 < 0xa8 { res = ((dst << cnt) | shr(src & mask_of(sz), bits - cnt)) & mask_of(sz); cf = shr(dst, bits - cnt) & 1; }
                else { res = (shr(dst, cnt) | (src << (bits - cnt))) & mask_of(sz); cf = shr(dst, cnt - 1) & 1; }
                flags_zsp(res, sz);
                rm_write(sz, res);
            }
        }
        else { unknown(op, op2); }
    }
    else { unknown(op, 0); }
    if running == 1 { rip = pc; }
}

// ---------- the ELF loader
i64 load_elf(String path, String[] args, i64 first_arg) {
    Result<String, Error> rr = Fs::read_bytes(path);
    if rr.is_err() { jerr << "jx86: cannot read " << path << "\n"; return 0; }
    String f = rr.unwrap();
    if f.len < 64 || (f[0] & 255) != 0x7f || f[1] != 'E' || f[2] != 'L' || f[3] != 'F' { jerr << "jx86: " << path << " is not an ELF file\n"; return 0; }
    if (f[4] & 255) != 2 { jerr << "jx86: only 64 bit programs\n"; return 0; }
    i64 machine = ((f[19] & 255) << 8) | (f[18] & 255);
    if machine != 0x3e { jerr << "jx86: " << path << " is not an x86_64 program (machine " << machine << ")\n"; return 0; }
    i64 etype = ((f[17] & 255) << 8) | (f[16] & 255);
    if etype != 2 { jerr << "jx86: only static programs (ET_EXEC) in this version\n"; return 0; }
    i64 entry = 0;
    for i in 0..8 { entry = entry | ((f[24 + i] & 255) << (8 * i)); }
    i64 phoff = 0;
    for i in 0..8 { phoff = phoff | ((f[32 + i] & 255) << (8 * i)); }
    i64 phnum = ((f[57] & 255) << 8) | (f[56] & 255);
    i64 phent = ((f[55] & 255) << 8) | (f[54] & 255);
    i64 top = 0;
    for p in 0..phnum {
        i64 o = phoff + p * phent;
        i64 ptype = (f[o] & 255) | ((f[o + 1] & 255) << 8) | ((f[o + 2] & 255) << 16) | ((f[o + 3] & 255) << 24);
        if ptype != 1 { continue; }
        i64 off = 0; i64 vaddr = 0; i64 filesz = 0; i64 memsz = 0;
        for i in 0..8 {
            off = off | ((f[o + 8 + i] & 255) << (8 * i));
            vaddr = vaddr | ((f[o + 16 + i] & 255) << (8 * i));
            filesz = filesz | ((f[o + 32 + i] & 255) << (8 * i));
            memsz = memsz | ((f[o + 40 + i] & 255) << (8 * i));
        }
        if vaddr < 0 || vaddr + memsz > gsize / 2 { jerr << "jx86: a segment is outside the guest memory (0x" << tohex(vaddr) << ")\n"; return 0; }
        for i in 0..filesz { gm[vaddr + i] = f[off + i]; }
        if vaddr + memsz > top { top = vaddr + memsz; }
    }
    brk_start = (top + 4095) & ~4095;
    brk_cur = brk_start;
    mmap_next = gsize / 2;
    // the stack: the strings, then argc, argv, envp, auxv
    i64 sp = gsize - 4096;
    i64 n = args.len - first_arg;
    i64[] ptrs = arr(8);
    for i in 0..n {
        String s = args[first_arg + i];
        sp -= s.len + 1;
        for k in 0..s.len { gm[sp + k] = s[k]; }
        gm[sp + s.len] = 0;
        ptrs.push(sp);
    }
    sp -= 16;
    i64 rnd = sp;
    for k in 0..16 { gm[rnd + k] = (char)(k * 11 + 7); }
    sp = sp & ~15;
    i64 words = 1 + n + 1 + 1 + 6;                          // argc, argv, NULL, envp NULL, three auxv pairs
    if (words & 1) == 1 { sp -= 8; }
    sp -= words * 8;
    i64 w = sp;
    wr(w, 8, n); w += 8;
    for i in 0..n { wr(w, 8, ptrs[i]); w += 8; }
    wr(w, 8, 0); w += 8;
    wr(w, 8, 0); w += 8;                                     // envp: empty
    wr(w, 8, 6); wr(w + 8, 8, 4096); w += 16;                // AT_PAGESZ
    wr(w, 8, 25); wr(w + 8, 8, rnd); w += 16;                // AT_RANDOM
    wr(w, 8, 0); wr(w + 8, 8, 0);                            // AT_NULL
    r[4] = sp;
    rip = entry;
    return 1;
}

i64 main() {
    String[] a = Env::args();
    i64 at = 1;
    g_min = 1 << 63;
    while at < a.len && a[at].starts_with("--") {
        if a[at] == "--count" { want_count = 1; }
        else if a[at] == "--trace" { trace = 1; }
        else if a[at] == "--limit" && at + 1 < a.len { at += 1; ilimit = a[at].to_int(); }
        else if a[at] == "--version" { jout << "jx86 " << jx86_version() << "\n"; return 0; }
        else { jerr << "jx86: unknown option " << a[at] << "\n"; return 2; }
        at += 1;
    }
    if at >= a.len {
        jout << "jx86 " << jx86_version() << ": runs a static x86_64 Linux program\n  jx86 [--count] [--limit N] PROGRAM [ARGS...]\n";
        return 2;
    }
    gsize = 1 << 30;
    gm = (char^)Sys::mmap(gsize);
    if gm == null { gsize = 1 << 28; gm = (char^)Sys::mmap(gsize); }
    if gm == null { jerr << "jx86: cannot get memory for the guest\n"; return 1; }
    if load_elf(a[at], a, at) == 0 { return 1; }
    running = 1;
    exit_code = 0;
    while running == 1 {
        step();
        icount += 1;
        if ilimit > 0 && icount >= ilimit { jerr << "jx86: the limit of " << ilimit << " instructions is reached\n"; running = 0; exit_code = 124; }
    }
    if want_count == 1 {
        jerr << "jx86: " << icount << " instructions\n";
        for rank in 0..12 {
            i64 best = -1; i64 bc = 0;
            for k in 0..512 { if ops[k] > bc { bc = ops[k]; best = k; } }
            if best < 0 { break; }
            String name = tohex(best);
            if best >= 256 { name = "0f " + tohex(best - 256); }
            jerr << "  " << padl(str(bc), 12) << "  " << name << "\n";
            ops[best] = 0;
        }
    }
    return exit_code;
}
